{% comment %}
  ============================================================
  BURNLAB — Categories in Collections
  Supports: Shopify OS 2.0 | Min Width: 300px
  Block-based collection/category grid — each block is a card
  (image + title below it + link). No live Shopify collection
  data is pulled in; everything is merchant-configured via blocks
  so it can point anywhere (collections, pages, external URLs).
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id = 'burnlab-cic-' | append: section.id

  assign show_header      = section.settings.show_header
  assign eyebrow           = section.settings.eyebrow
  assign heading            = section.settings.heading
  assign subtitle           = section.settings.subtitle
  assign heading_align      = section.settings.heading_alignment | default: 'left'

  assign layout_style       = section.settings.layout_style | default: 'grid'
  assign cols_desktop       = section.settings.columns_desktop | default: 4
  assign cols_tablet        = section.settings.columns_tablet  | default: 3
  assign cols_mobile        = section.settings.columns_mobile  | default: 2
  assign card_gap           = section.settings.card_gap | default: 20

  assign aspect_ratio       = section.settings.image_aspect_ratio | default: '4/3'
  assign card_radius        = section.settings.card_radius | default: 14
  assign title_fs           = section.settings.title_font_size | default: 18

  assign bg_dark      = section.settings.bg_dark      | default: '#001a2e'
  assign text_dark     = section.settings.text_dark     | default: '#eaf4f5'
  assign card_bg_dark  = section.settings.card_bg_dark  | default: '#f4f6f8'
  assign accent_dark   = section.settings.accent_dark   | default: '#07d16e'

  assign bg_light      = section.settings.bg_light      | default: '#eaf4f5'
  assign text_light     = section.settings.text_light     | default: '#001a2e'
  assign card_bg_light  = section.settings.card_bg_light  | default: '#ffffff'
  assign accent_light   = section.settings.accent_light   | default: '#07d16e'

  assign enable_anims = section.settings.enable_animations

  assign padding_top      = section.settings.padding_top      | default: 60
  assign padding_bottom   = section.settings.padding_bottom   | default: 60
  assign padding_top_m    = section.settings.padding_top_mobile    | default: 36
  assign padding_bottom_m = section.settings.padding_bottom_mobile | default: 36
-%}

<style>
  #{{ section_id }} *, #{{ section_id }} *::before, #{{ section_id }} *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  /* ── Theme tokens — dark default, light override below ── */
  #{{ section_id }} {
    --cic-bg:        {{ bg_dark }};
    --cic-text:      {{ text_dark }};
    --cic-muted:     color-mix(in srgb, {{ text_dark }} 62%, transparent);
    --cic-card-bg:   {{ card_bg_dark }};
    --cic-accent:    {{ accent_dark }};
    --cic-cols-d:    {{ cols_desktop }};
    --cic-cols-t:    {{ cols_tablet }};
    --cic-cols-m:    {{ cols_mobile }};
    --cic-gap:       {{ card_gap }}px;
    --cic-radius:    {{ card_radius }}px;
    --cic-title-fs:  {{ title_fs }}px;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--cic-bg);
    color: var(--cic-text);
    font-family: 'DM Sans', sans-serif;
    transition: background-color 0.35s ease, color 0.35s ease;
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }

  [data-theme="light"] #{{ section_id }} {
    --cic-bg:      {{ bg_light }};
    --cic-text:    {{ text_light }};
    --cic-muted:   color-mix(in srgb, {{ text_light }} 62%, transparent);
    --cic-card-bg: {{ card_bg_light }};
    --cic-accent:  {{ accent_light }};
  }

  @media (max-width: 768px) {
    #{{ section_id }} {
      padding-top: {{ padding_top_m }}px !important;
      padding-bottom: {{ padding_bottom_m }}px !important;
    }
  }

  /* ── Container ── */
  #{{ section_id }} .cic-inner {
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.6rem, 5vw, 6rem);
  }

  /* ── Header ── */
  #{{ section_id }} .cic-header {
    margin-bottom: clamp(1.8rem, 4vw, 3.2rem);
    display: flex;
    flex-direction: column;
    text-align: {{ heading_align }};
    align-items: {% if heading_align == 'center' %}center{% elsif heading_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  #{{ section_id }} .cic-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cic-accent);
    margin-bottom: 0.8rem;
  }
  #{{ section_id }} .cic-heading {
    font-family: 'DM Sans', sans-serif;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    color: var(--cic-text);
    overflow-wrap: break-word;
  }
  #{{ section_id }} .cic-subtitle {
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: var(--cic-muted);
    margin-top: 0.7rem;
    line-height: 1.6;
    max-width: 56ch;
  }

  /* ── Grid / Flex layout ── */
  #{{ section_id }} .cic-grid[data-layout="grid"] {
    display: grid;
    grid-template-columns: repeat(var(--cic-cols-m), 1fr);
    gap: var(--cic-gap);
  }
  @media (min-width: 590px) {
    #{{ section_id }} .cic-grid[data-layout="grid"] { grid-template-columns: repeat(var(--cic-cols-t), 1fr); }
  }
  @media (min-width: 990px) {
    #{{ section_id }} .cic-grid[data-layout="grid"] { grid-template-columns: repeat(var(--cic-cols-d), 1fr); }
  }

  #{{ section_id }} .cic-grid[data-layout="flex"] {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cic-gap);
  }
  #{{ section_id }} .cic-grid[data-layout="flex"] .cic-card {
    flex: 0 1 calc((100% - (var(--cic-cols-m) - 1) * var(--cic-gap)) / var(--cic-cols-m));
  }
  @media (min-width: 590px) {
    #{{ section_id }} .cic-grid[data-layout="flex"] .cic-card {
      flex-basis: calc((100% - (var(--cic-cols-t) - 1) * var(--cic-gap)) / var(--cic-cols-t));
    }
  }
  @media (min-width: 990px) {
    #{{ section_id }} .cic-grid[data-layout="flex"] .cic-card {
      flex-basis: calc((100% - (var(--cic-cols-d) - 1) * var(--cic-gap)) / var(--cic-cols-d));
    }
  }

  /* ── Card ── */
  #{{ section_id }} .cic-card {
    display: block;
    text-decoration: none;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  #{{ section_id }} .cic-card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: {{ aspect_ratio }};
    overflow: hidden;
    border-radius: var(--cic-radius);
    background: var(--cic-card-bg);
    transition: background-color 0.35s ease, box-shadow 0.28s ease, transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  #{{ section_id }} .cic-card:hover .cic-card-img-wrap {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.16);
  }
  #{{ section_id }} .cic-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #{{ section_id }} .cic-card:hover .cic-card-img { transform: scale(1.05); }

  #{{ section_id }} .cic-card-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cic-accent);
    opacity: 0.45;
  }
  #{{ section_id }} .cic-card-placeholder svg {
    width: 40%;
    height: 40%;
  }

  #{{ section_id }} .cic-card-title {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: var(--cic-title-fs);
    color: var(--cic-text);
    text-align: center;
    margin-top: 1rem;
    line-height: 1.35;
    transition: color 0.35s ease;
    overflow-wrap: break-word;
  }
  #{{ section_id }} .cic-card:hover .cic-card-title { color: var(--cic-accent); }

  /* ── Reveal animation ── */
  {%- if enable_anims -%}
  #{{ section_id }} .cic-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #{{ section_id }} .cic-reveal.is-visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .cic-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  }
  {%- else -%}
  #{{ section_id }} .cic-reveal { opacity: 1; }
  {%- endif -%}
  .shopify-design-mode #{{ section_id }} .cic-reveal { opacity: 1 !important; transform: none !important; }
</style>

<section id="{{ section_id }}" class="cic-section">
  <div class="cic-inner">

    {%- if show_header and heading != blank or subtitle != blank -%}
    <div class="cic-header">
      {%- if eyebrow != blank -%}
        <p class="cic-eyebrow cic-reveal">{{ eyebrow | escape }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="cic-heading cic-reveal">{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="cic-subtitle cic-reveal">{{ subtitle | escape }}</p>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="cic-grid" data-layout="{{ layout_style }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          {%- assign card_img   = block.settings.image -%}
          {%- assign card_title = block.settings.title -%}
          {%- assign card_link  = block.settings.link -%}
          {%- assign card_tag   = 'div' -%}
          {%- if card_link != blank -%}{%- assign card_tag = 'a' -%}{%- endif -%}

          <{{ card_tag }}
            {%- if card_link != blank %} href="{{ card_link }}"{% endif -%}
            class="cic-card cic-reveal"
            {%- if card_link != blank and card_title == blank %} aria-label="View collection"{% endif -%}
            {{ block.shopify_attributes }}
          >
            <div class="cic-card-img-wrap">
              {%- if card_img != blank -%}
                {{ card_img | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  alt: card_img.alt | default: card_title | default: '',
                  class: 'cic-card-img',
                  widths: '400, 600, 800'
                }}
              {%- else -%}
                <div class="cic-card-placeholder">
                  <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="8" y="8" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
                    <rect x="36" y="8" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
                    <rect x="8" y="36" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
                    <rect x="36" y="36" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>
            {%- if card_title != blank -%}
              <p class="cic-card-title">{{ card_title | escape }}</p>
            {%- endif -%}
          </{{ card_tag }}>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
(function () {
  var SECTION = document.getElementById('{{ section_id }}');
  if (!SECTION) return;

  /* ── Theme toggle sync — mirrors header.liquid's data-theme attribute ── */
  var CIC_DARK = {
    bg:     '{{ bg_dark }}',
    text:   '{{ text_dark }}',
    card:   '{{ card_bg_dark }}',
    accent: '{{ accent_dark }}'
  };
  var CIC_LIGHT = {
    bg:     '{{ bg_light }}',
    text:   '{{ text_light }}',
    card:   '{{ card_bg_light }}',
    accent: '{{ accent_light }}'
  };

  function applyCicTheme() {
    var isLight = document.documentElement.getAttribute('data-theme') === 'light';
    var c = isLight ? CIC_LIGHT : CIC_DARK;
    SECTION.style.setProperty('--cic-bg', c.bg);
    SECTION.style.setProperty('--cic-text', c.text);
    SECTION.style.setProperty('--cic-card-bg', c.card);
    SECTION.style.setProperty('--cic-accent', c.accent);
    SECTION.style.backgroundColor = c.bg;
    SECTION.style.color = c.text;
  }

  applyCicTheme();
  var cicThemeObs = new MutationObserver(applyCicTheme);
  cicThemeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  /* ── Scroll reveal ── */
  {% if enable_anims %}
  var revealEls = SECTION.querySelectorAll('.cic-reveal');
  var revealObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry, i) {
      if (entry.isIntersecting) {
        entry.target.style.transitionDelay = (i % 12 * 0.06) + 's';
        entry.target.classList.add('is-visible');
        revealObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  revealEls.forEach(function (el) { revealObs.observe(el); });
  {% endif %}

  document.addEventListener('shopify:section:unload', function (e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      cicThemeObs.disconnect();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Categories in Collections",
  "tag": "section",
  "class": "burnlab-cic-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show section header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Collections"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore premium fitness essentials crafted for performance and recovery."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Card layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "flex", "label": "Flex" }
      ],
      "default": "grid",
      "info": "Grid keeps every row perfectly aligned. Flex lets the last row's cards wrap naturally."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — Desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Screens 990px and wider."
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — Tablet",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "info": "Screens 590px to 989px."
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "info": "Screens narrower than 590px."
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Card image aspect ratio",
      "options": [
        { "value": "1/1",  "label": "Square (1:1)" },
        { "value": "4/3",  "label": "Landscape (4:3)" },
        { "value": "3/4",  "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Widescreen (16:9)" }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colors — Dark Mode"
    },
    {
      "type": "color",
      "id": "bg_dark",
      "label": "Section background",
      "default": "#001a2e"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Text color",
      "default": "#eaf4f5"
    },
    {
      "type": "color",
      "id": "card_bg_dark",
      "label": "Card background",
      "default": "#f4f6f8"
    },
    {
      "type": "color",
      "id": "accent_dark",
      "label": "Accent (hover) color",
      "default": "#07d16e"
    },
    {
      "type": "header",
      "content": "Colors — Light Mode"
    },
    {
      "type": "color",
      "id": "bg_light",
      "label": "Section background",
      "default": "#eaf4f5"
    },
    {
      "type": "color",
      "id": "text_light",
      "label": "Text color",
      "default": "#001a2e"
    },
    {
      "type": "color",
      "id": "card_bg_light",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_light",
      "label": "Accent (hover) color",
      "default": "#07d16e"
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable scroll-reveal animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Shown below the card image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Where this card goes when clicked. Leave blank for no link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories in Collections",
      "blocks": [
        { "type": "card", "settings": { "title": "Dumbbell Sets" } },
        { "type": "card", "settings": { "title": "Equipments" } },
        { "type": "card", "settings": { "title": "Fitness Bundles" } },
        { "type": "card", "settings": { "title": "Fitness Kits For Home" } }
      ]
    }
  ]
}
{% endschema %}
