      "min": 30,
      "max": 65,
      "default": 30,
      "step": 5,
      "unit": "%",
      "visible_if": "{{section.settings.show_column_image == true}}"
    },
    {
      "type": "select",
      "id": "htp_image_ratio",
      "label": "Image aspect ratio",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "1", "label": "Square" },
      ]
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "label": "Padding top",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "label": "Padding bottom",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "label": "Padding top",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "label": "Padding bottom",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "default": 30,
      "unit": "px"
    }
  ],
  "blocks":[
    {
        "type": "product",
        "name":"Add product",
        "settings":[
            {
                "type": "product",
                "id": "product",
                "label": "Product"
            },
            {
                "type": "range",
                "label": "Vertical position",
                "id": "vertical_position",
                "min": 0,
                "max": 90,
                "default": 30,
                "unit": "%"
            },
            {
                "type": "range",
                "label": "Horizontal position",
                "id": "horizontal_position",
                "min": 0,
                "max": 90,
                "default": 30,
                "unit": "%"
            }
