{% comment %}
  ============================================================
  BURNLAB — CONTACT PAGE
  Supports: Shopify OS 2.0 | Min Width: 300px
  One file: card grid (blocks) + map/sidebar area. Font: Outfit.
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id        = 'burnlab-contact-page-' | append: section.id

  assign main_title        = section.settings.main_title        | default: 'Contact Us'
  assign show_title_line   = section.settings.show_title_line

  assign page_bg           = section.settings.page_bg           | default: '#f4f4f5'
  assign card_bg           = section.settings.card_bg           | default: '#ffffff'
  assign title_color       = section.settings.title_color       | default: '#111111'
  assign heading_color     = section.settings.heading_color     | default: '#111111'
  assign text_color        = section.settings.text_color        | default: '#6b7280'
  assign accent_color      = section.settings.accent_color      | default: '#2f6fed'
  assign icon_color        = section.settings.icon_color        | default: '#b9bcc2'

  assign card_columns      = section.settings.card_columns      | default: 3
  assign card_min_width    = section.settings.card_min_width    | default: 300
  assign card_gap          = section.settings.card_gap          | default: 24
  assign card_radius       = section.settings.card_radius       | default: 12

  assign map_source        = section.settings.map_source        | default: '18.5645,73.7769'
  assign map_zoom          = section.settings.map_zoom          | default: 15
  assign map_height        = section.settings.map_height        | default: 420

  assign stay_connected_title = section.settings.stay_connected_title | default: 'Stay Connected'

  assign enable_anim       = section.settings.enable_animations

  assign heading_size      = section.settings.heading_size      | default: 40
  assign heading_size_mobile = heading_size | minus: 12
  if heading_size_mobile < 22
    assign heading_size_mobile = 22
  endif

  assign map_input = map_source | strip
  assign map_src = ''
  if map_input contains '<iframe'
    assign map_split = map_input | split: 'src="'
    if map_split.size > 1
      assign map_src = map_split[1] | split: '"' | first
    endif
  elsif map_input contains '/maps/embed'
    assign map_src = map_input
  else
    assign encoded_query = map_input | url_encode
    assign map_src = 'https://maps.google.com/maps?q=' | append: encoded_query | append: '&z=' | append: map_zoom | append: '&output=embed'
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">

<style>
  #{{ section_id }} *, #{{ section_id }} *::before, #{{ section_id }} *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  #{{ section_id }} {
    --bcp-page-bg:     {{ page_bg }};
    --bcp-card-bg:     {{ card_bg }};
    --bcp-title:       {{ title_color }};
    --bcp-heading:     {{ heading_color }};
    --bcp-text:        {{ text_color }};
    --bcp-accent:      {{ accent_color }};
    --bcp-icon:        {{ icon_color }};
    --bcp-radius:      {{ card_radius }}px;
    --bcp-gap:          {{ card_gap }}px;
    --bcp-card-min:    {{ card_min_width }}px;
    --bcp-ease:        cubic-bezier(0.16, 1, 0.3, 1);

    position: relative;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background: var(--bcp-page-bg);
    font-family: 'Outfit', sans-serif;
  }

  #{{ section_id }} .bcp-container {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.6rem, 5vw, 4rem);
  }

  /* ── TITLE ─────────────────────────────────────────────── */
  #{{ section_id }} .bcp-title-row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
    margin-bottom: clamp(2.8rem, 5.5vw, 4.4rem);
  }
  #{{ section_id }} .bcp-main-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: clamp({{ heading_size_mobile }}px, 4vw, {{ heading_size }}px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--bcp-title);
    white-space: nowrap;
    overflow-wrap: break-word;
  }
  #{{ section_id }} .bcp-title-line {
    flex: 1;
    height: 1px;
    background: rgba(0,0,0,0.12);
    min-width: 24px;
  }

  /* ── CARD GRID ─────────────────────────────────────────── */
  #{{ section_id }} .bcp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--bcp-card-min), 100%), 1fr));
    gap: var(--bcp-gap);
    margin-bottom: clamp(3.2rem, 6vw, 5rem);
  }
  @media (min-width: 900px) {
    #{{ section_id }} .bcp-grid {
      grid-template-columns: repeat({{ card_columns }}, 1fr);
    }
  }

  #{{ section_id }} .bcp-card {
    background: var(--bcp-card-bg);
    border-radius: var(--bcp-radius);
    padding: clamp(2rem, 3vw, 2.8rem);
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    box-shadow: 0 1px 2px rgba(16,24,40,0.04);
    transition: box-shadow 0.35s var(--bcp-ease), transform 0.35s var(--bcp-ease);
    will-change: transform;
  }
  #{{ section_id }} .bcp-card:hover {
    box-shadow: 0 12px 28px rgba(16,24,40,0.09);
    transform: translateY(-3px);
  }

  #{{ section_id }} .bcp-card-icon {
    width: 40px;
    height: 40px;
    color: var(--bcp-icon);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.4rem;
  }
  #{{ section_id }} .bcp-card-icon svg { width: 100%; height: 100%; }

  #{{ section_id }} .bcp-card-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #{{ section_id }} .bcp-card-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    font-size: 20px;
    color: var(--bcp-heading);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  #{{ section_id }} .bcp-card-desc {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--bcp-text);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  #{{ section_id }} .bcp-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 0.3rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    font-size: 17px;
    color: var(--bcp-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: gap 0.25s var(--bcp-ease), opacity 0.2s ease;
  }
  #{{ section_id }} .bcp-card-cta:hover { gap: 10px; opacity: 0.82; }
  #{{ section_id }} .bcp-card-cta svg { width: 16px; height: 16px; flex-shrink: 0; }

  /* ── MAP + SIDEBAR ─────────────────────────────────────── */
  #{{ section_id }} .bcp-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(1.6rem, 3vw, 2.4rem);
    align-items: stretch;
  }

  #{{ section_id }} .bcp-map-wrap {
    border-radius: var(--bcp-radius);
    overflow: hidden;
    background: var(--bcp-card-bg);
    box-shadow: 0 1px 2px rgba(16,24,40,0.04);
    position: relative;
  }
  #{{ section_id }} .bcp-map-wrap iframe {
    display: block;
    width: 100%;
    height: {{ map_height }}px;
    border: 0;
  }

  #{{ section_id }} .bcp-sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2rem, 3vw, 2.8rem);
    height: 100%;
    padding: clamp(1.2rem, 2vw, 1.8rem) 0.4rem;
  }

  #{{ section_id }} .bcp-sidebar-block-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    font-size: 20px;
    color: var(--bcp-heading);
    margin-bottom: 0.6rem;
  }
  #{{ section_id }} .bcp-sidebar-block-text {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--bcp-text);
    white-space: pre-line;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  #{{ section_id }} .bcp-social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 1rem;
  }
  #{{ section_id }} .bcp-social-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bcp-heading);
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s var(--bcp-ease);
  }
  #{{ section_id }} .bcp-social-icon:hover {
    background: var(--bcp-accent);
    border-color: var(--bcp-accent);
    color: #fff;
    transform: translateY(-2px);
  }
  #{{ section_id }} .bcp-social-icon svg { width: 20px; height: 20px; }

  /* ── REVEAL ────────────────────────────────────────────── */
  #{{ section_id }} .bcp-reveal {
    opacity: 0;
    transform: translateY(24px);
    will-change: transform;
    transition: opacity 0.6s var(--bcp-ease), transform 0.6s var(--bcp-ease);
  }
  #{{ section_id }} .bcp-reveal.is-visible { opacity: 1; transform: none; }
  #{{ section_id }}.is-visible .bcp-reveal,
  .shopify-design-mode #{{ section_id }} .bcp-reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .bcp-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    #{{ section_id }} .bcp-card { transition: none; }
  }

  /* ── RESPONSIVE ────────────────────────────────────────── */
  @media (max-width: 1024px) {
    #{{ section_id }} .bcp-bottom {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 768px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
    }
    #{{ section_id }} .bcp-card-title,
    #{{ section_id }} .bcp-sidebar-block-title {
      font-size: 17px;
    }
    #{{ section_id }} .bcp-card-desc,
    #{{ section_id }} .bcp-card-cta {
      font-size: 15px;
    }
    #{{ section_id }} .bcp-sidebar-block-text {
      font-size: 13px;
    }
    #{{ section_id }} .bcp-card-cta svg { width: 14px; height: 14px; }
  }
  @media (max-width: 480px) {
    #{{ section_id }} .bcp-title-row { flex-wrap: wrap; }
    #{{ section_id }} .bcp-main-title { white-space: normal; font-size: clamp(1.6rem, 8vw, 2.2rem); }
    #{{ section_id }} .bcp-grid { grid-template-columns: 1fr; }
    #{{ section_id }} .bcp-card-cta { width: 100%; }
  }
</style>

<section
  id="{{ section_id }}"
  class="burnlab-contact-page"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="bcp-container">

    <div class="bcp-title-row bcp-reveal">
      <h1 class="bcp-main-title">{{ main_title }}</h1>
      {%- if show_title_line -%}
        <div class="bcp-title-line" aria-hidden="true"></div>
      {%- endif -%}
    </div>

    <div class="bcp-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'contact_card' -%}
          {%- liquid
            assign bk_icon    = block.settings.icon    | default: 'none'
            assign bk_title   = block.settings.title   | default: 'Card Title'
            assign bk_desc    = block.settings.description | default: ''
            assign bk_cta     = block.settings.cta_label | default: ''
            assign bk_url     = block.settings.cta_url
            assign bk_arrow   = block.settings.show_arrow
          -%}
          <div class="bcp-card bcp-reveal" data-card-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if bk_icon != 'none' -%}
            <div class="bcp-card-icon" aria-hidden="true">
              {%- case bk_icon -%}
                {%- when 'document' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M13 3v5h5M9 13h6M9 17h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                {%- when 'chat' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                {%- when 'phone-plus' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 3h6v6M21 3l-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M12.5 14.5c-3-3-4-5-4.4-6.4a1.5 1.5 0 0 1 .4-1.6L10 5 8.5 2.5a1.5 1.5 0 0 0-2-.4C4.7 3 3 5 3 7.5 3 14 10 21 16.5 21c2.5 0 4.5-1.7 5.4-3.5a1.5 1.5 0 0 0-.4-2L19 14l-1.5 1.5a1.5 1.5 0 0 1-1.6.4c-1.4-.4-3.4-1.4-3.4-1.4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 8h11v9H2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M13 11h4l4 4v2h-8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="6.5" cy="18.5" r="1.8" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="18.5" r="1.8" stroke="currentColor" stroke-width="1.5"/></svg>
                {%- when 'store' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 9l1.5-5h15L21 9" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M3 9a2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M5 9v10h14V9M10 19v-6h4v6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                {%- when 'mail' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'location' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </div>
            {%- endif -%}

            <div class="bcp-card-body">
              {%- if bk_title != blank -%}<h3 class="bcp-card-title">{{ bk_title }}</h3>{%- endif -%}
              {%- if bk_desc != blank -%}<p class="bcp-card-desc">{{ bk_desc }}</p>{%- endif -%}
            </div>

            {%- if bk_cta != blank -%}
            <a href="{{ bk_url | default: '#' }}" class="bcp-card-cta">
              {{ bk_cta }}
              {%- if bk_arrow -%}
              <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1 6H11M11 6L6.5 1.5M11 6L6.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endif -%}
            </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="bcp-bottom bcp-reveal">
      <div class="bcp-map-wrap">
        {%- if map_src != blank -%}
        <iframe
          src="{{ map_src }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          title="{{ main_title }} location map"
        ></iframe>
        {%- endif -%}
      </div>

      <div class="bcp-sidebar">
        {%- for block in section.blocks -%}
          {%- if block.type == 'sidebar_info' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
              <div class="bcp-sidebar-block-title">{{ block.settings.title }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
              <div class="bcp-sidebar-block-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- assign social_blocks = section.blocks | where: 'type', 'social_link' -%}
        {%- if social_blocks.size > 0 -%}
        <div>
          {%- if stay_connected_title != blank -%}
          <div class="bcp-sidebar-block-title">{{ stay_connected_title }}</div>
          {%- endif -%}
          <div class="bcp-social-row">
            {%- for block in social_blocks -%}
              {%- liquid
                assign platform = block.settings.platform | default: 'facebook'
                assign social_url = block.settings.url | default: '#'
              -%}
              <a href="{{ social_url }}" class="bcp-social-icon" aria-label="{{ platform }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                {%- case platform -%}
                  {%- when 'facebook' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.4-3H13.5V8.4c0-.87.24-1.46 1.5-1.46H16.5V4.35C16.24 4.32 15.34 4.24 14.3 4.24c-2.17 0-3.66 1.32-3.66 3.75v2.5H8v3h2.64V21h2.86Z"/></svg>
                  {%- when 'instagram' -%}
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
                  {%- when 'whatsapp' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                  {%- when 'twitter' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 4l7.1 9.4L4.4 20H7l5-5.5L16 20h4l-7.4-9.8L19.6 4H17l-4.6 5-4-5H4Z"/></svg>
                  {%- when 'youtube' -%}
                    <svg viewBox="0 0 24 24" fill="none"><rect x="2.5" y="6" width="19" height="12" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 9.5v5l4.5-2.5-4.5-2.5Z" fill="currentColor"/></svg>
                  {%- when 'pinterest' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a9 9 0 0 0-3.28 17.38c-.05-.75-.09-1.9.02-2.72.1-.75.65-4.78.65-4.78s-.17-.33-.17-.83c0-.78.45-1.36 1.02-1.36.48 0 .71.36.71.79 0 .48-.31 1.2-.46 1.87-.14.56.28 1.02.83 1.02 1 0 1.77-1.05 1.77-2.57 0-1.34-.97-2.28-2.35-2.28-1.6 0-2.54 1.2-2.54 2.44 0 .48.19.99.42 1.27a.17.17 0 0 1 .04.16l-.16.66c-.03.11-.09.14-.2.08-.75-.35-1.22-1.44-1.22-2.32 0-1.89 1.37-3.63 3.96-3.63 2.08 0 3.7 1.48 3.7 3.47 0 2.07-1.3 3.74-3.11 3.74-.61 0-1.18-.32-1.38-.69l-.37 1.44c-.14.52-.5 1.17-.75 1.57A9 9 0 1 0 12 3Z"/></svg>
                  {%- when 'linkedin' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.5 9h3v11.5h-3V9Zm6.5 0h2.9v1.6h.04c.4-.76 1.4-1.6 2.9-1.6 3.1 0 3.66 2 3.66 4.7v6.8h-3v-6c0-1.43-.03-3.27-2-3.27-2 0-2.3 1.56-2.3 3.18v6.1h-3V9Z"/></svg>
                  {%- when 'tiktok' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.5 3h2.6c.2 1.5 1.2 2.9 2.9 3.4v2.7c-1.2 0-2.3-.4-3.3-1v6.4a5.1 5.1 0 1 1-4.3-5v2.8a2.3 2.3 0 1 0 1.7 2.2V3Z"/></svg>
                {%- endcase -%}
              </a>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% if enable_anim %}
<script>
(function () {
  'use strict';
  var root = document.getElementById('{{ section_id }}');
  if (!root) return;

  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var revealEls = root.querySelectorAll('.bcp-reveal');

  if (!reducedMotion) {
    var cardEls = root.querySelectorAll('.bcp-card.bcp-reveal');
    cardEls.forEach(function (card) {
      var idx = parseInt(card.getAttribute('data-card-index') || '0', 10);
      card.style.transitionDelay = (idx * 0.08) + 's';
    });
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  revealEls.forEach(function (el) { observer.observe(el); });

  document.addEventListener('shopify:section:unload', function (e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      observer.disconnect();
    }
  });
})();
</script>
{% endif %}

