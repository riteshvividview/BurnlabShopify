{% comment %}
  ============================================================
  BURNLAB — Mystery Discount Popup (3-Step Flow)
  Deploy to: sections/timer-popup.liquid
  JS file:   assets/timer-popup.js

  Display 1 — Category selection (+ countdown timer)
  Display 2 — Email collection
  Display 3 — Discount revealed (code + copy + shop now)

  All three displays share the same card size and the same
  right-side fitness image; only the left content cross-fades
  between steps (fade+slide for 1↔2, fade+scale for 2→3).
  ============================================================
{% endcomment %}

{%- assign section_id = 'bl-popup-' | append: section.id -%}

{%- assign delay_sec      = section.settings.delay_seconds  | default: 20 -%}
{%- assign session_once   = section.settings.session_once -%}
{%- assign layout_style   = section.settings.layout_style   | default: 'split' -%}
{%- assign show_timer     = section.settings.show_timer -%}
{%- assign timer_days     = section.settings.timer_days     | default: 0 -%}
{%- assign timer_hours    = section.settings.timer_hours    | default: 0 -%}
{%- assign timer_mins_set = section.settings.timer_minutes  | default: 10 -%}
{%- assign close_on_timer = section.settings.close_on_timer_end -%}

{%- assign hours_secs = timer_hours | times: 3600 -%}
{%- assign mins_secs  = timer_mins_set | times: 60 -%}
{%- assign timer_total_secs = timer_days | times: 86400 | plus: hours_secs | plus: mins_secs -%}

{%- assign badge_text = section.settings.badge_text | default: 'Limited Time Offer' -%}

{%- comment -%} Display 1 — Category selection {%- endcomment -%}
{%- assign d1_heading  = section.settings.heading    | default: "🎉 You've Got a Mystery Discount!" -%}
{%- assign d1_desc     = section.settings.subheading | default: 'Choose your favorite workout category below to unlock your exclusive reward.' -%}
{%- assign d1_footer   = section.settings.d1_footer_text | default: 'Choose one category to continue.' -%}

{%- comment -%} Display 2 — Email collection {%- endcomment -%}
{%- assign d2_heading     = section.settings.d2_heading     | default: 'Almost There!' -%}
{%- assign d2_desc        = section.settings.d2_description | default: 'Enter your email address to reveal your exclusive mystery discount.' -%}
{%- assign d2_placeholder = section.settings.d2_email_placeholder | default: 'Enter your email address' -%}
{%- assign d2_btn_text    = section.settings.d2_button_text | default: 'Reveal My Discount' -%}
{%- assign d2_privacy     = section.settings.d2_privacy_text | default: 'We only use your email to send your exclusive offer. No spam.' -%}
{%- assign d2_back_text   = section.settings.d2_back_button_text | default: '← Choose Another Category' -%}

{%- comment -%} Display 3 — Discount revealed {%- endcomment -%}
{%- assign d3_heading   = section.settings.d3_heading     | default: '🎉 Congratulations!' -%}
{%- assign d3_desc      = section.settings.d3_description | default: 'Your mystery discount has been unlocked. Use this code during checkout.' -%}
{%- assign d3_shop_text = section.settings.d3_shop_button_text | default: 'Shop Now' -%}
{%- assign d3_shop_url  = section.settings.d3_shop_button_url | default: routes.all_products_collection_url -%}
{%- assign d3_footer    = section.settings.d3_footer_text | default: 'Code expires in 24 hours.' -%}

{%- assign copy_button_text        = section.settings.copy_button_text        | default: 'Copy Code' -%}
{%- assign copy_button_copied_text = section.settings.copy_button_copied_text | default: 'Copied!' -%}
{%- assign side_image = section.settings.side_image -%}

{%- assign category_style   = section.settings.category_button_style   | default: 'filled' -%}
{%- assign category_fs      = section.settings.category_font_size      | default: 18 -%}
{%- assign category_columns = section.settings.category_button_columns | default: '2' -%}

{%- comment -%}The first "Discount Code" block is the code shown + copied in Display 3{%- endcomment -%}
{%- assign _display_code = '' -%}
{%- assign _display_code_message = '' -%}
{%- assign _display_code_close = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'discount_code' and block.settings.code != blank -%}
    {%- assign _display_code = block.settings.code | strip | upcase -%}
    {%- assign _display_code_message = block.settings.success_message | default: 'Copied!' -%}
    {%- assign _display_code_close = block.settings.close_popup_on_apply -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign _display_code_chars = _display_code | split: '' -%}

{%- assign brand_name   = section.settings.brand_name   | default: 'BurnLab' -%}
{%- assign bg_color     = section.settings.bg_color     | default: '#001a2e' -%}
{%- assign card_color   = section.settings.card_color   | default: '#011c30' -%}
{%- assign text_color   = section.settings.text_color   | default: '#eaf4f5' -%}
{%- assign sub_color    = section.settings.subtext_color | default: '#7aabbf' -%}
{%- assign timer_bg     = section.settings.timer_bg     | default: '#eaf4f5' -%}
{%- assign timer_text_c = section.settings.timer_text_c | default: '#001a2e' -%}
{%- assign accent       = section.settings.accent_color | default: '#00e676' -%}
{%- assign split_bg     = section.settings.split_panel_bg   | default: '#07d16e' -%}
{%- assign split_text   = section.settings.split_panel_text | default: '#001a2e' -%}

{%- assign card_w_desktop   = section.settings.card_width_desktop  | default: 560 -%}
{%- assign card_h_desktop   = section.settings.card_height_desktop | default: 0 -%}
{%- assign card_w_mobile    = section.settings.card_width_mobile   | default: 92 -%}
{%- assign card_h_mobile    = section.settings.card_height_mobile  | default: 0 -%}

{%- if timer_days  < 10 -%}{%- assign d_pad = '0' -%}{%- else -%}{%- assign d_pad = '' -%}{%- endif -%}
{%- if timer_hours < 10 -%}{%- assign h_pad = '0' -%}{%- else -%}{%- assign h_pad = '' -%}{%- endif -%}
{%- if timer_mins_set < 10 -%}{%- assign m_pad = '0' -%}{%- else -%}{%- assign m_pad = '' -%}{%- endif -%}

{% style %}

#{{ section_id }} *,
#{{ section_id }} *::before,
#{{ section_id }} *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ══ Backdrop ══ */
#{{ section_id }} {
  --pop-bg:          {{ bg_color }};
  --pop-card:        {{ card_color }};
  --pop-text:        {{ text_color }};
  --pop-sub:         {{ sub_color }};
  --pop-accent:      {{ accent }};
  --pop-timer-bg:    {{ timer_bg }};
  --pop-timer-text:  {{ timer_text_c }};
  --pop-split-bg:    {{ split_bg }};
  --pop-split-text:  {{ split_text }};
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(1rem, 3vw, 2rem);
  background: rgba(0, 4, 12, 0.78);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.4s ease, visibility 0.4s;
  font-family: 'DM Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
}
#{{ section_id }}.bl-popup--open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
/* Reacts to the site-wide theme toggle (see header.liquid) — overrides the
   merchant's (dark-oriented) color settings so the popup stays readable
   and matches the current site theme instead of always looking dark. */
[data-theme="light"] #{{ section_id }} {
  --pop-bg:         #eef2f4;
  --pop-card:       #ffffff;
  --pop-text:       #0a1a24;
  --pop-sub:        #55707c;
  --pop-timer-bg:   #0a1a24;
  --pop-timer-text: #ffffff;
}

/* ══ Card ══ */
#{{ section_id }} .bl-popup__card {
  position: relative;
  background: var(--pop-card);
  border-radius: 20px;
  width: 100%;
  max-width: {{ card_w_desktop }}px;
  {% if card_h_desktop > 0 %}min-height: {{ card_h_desktop }}px;{% endif %}
  overflow: hidden;
  box-shadow:
    0 0 0 1px color-mix(in srgb, var(--pop-accent) 22%, transparent),
    0 32px 80px rgba(0, 0, 0, 0.55);
  transform: scale(0.92) translateY(20px);
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
@media (max-width: 640px) {
  #{{ section_id }} .bl-popup__card {
    max-width: {{ card_w_mobile }}vw;
    {% if card_h_mobile > 0 %}min-height: {{ card_h_mobile }}px;{% endif %}
  }
}
#{{ section_id }}.bl-popup--open .bl-popup__card {
  transform: scale(1) translateY(0);
}
/* Subtle radial glow inside card */
#{{ section_id }} .bl-popup__card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 80% 55% at 50% 0%, color-mix(in srgb, var(--pop-accent) 9%, transparent), transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* ══ Close button — bare icon, no circular bg/border ══ */
#{{ section_id }} .bl-popup__close {
  position: absolute;
  top: 0.7rem;
  right: 0.7rem;
  width: 3.2rem;
  height: 3.2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  border-radius: 0;
  cursor: pointer;
  color: color-mix(in srgb, var(--pop-text) 65%, transparent);
  transition: color 0.2s ease, transform 0.2s ease;
  padding: 0;
  z-index: 20;
  flex-shrink: 0;
}
#{{ section_id }} .bl-popup__close:hover {
  color: var(--pop-text);
  transform: rotate(90deg);
}
#{{ section_id }} .bl-popup__close svg { width: 2.1rem; height: 2.1rem; }

/* ══ Split layout — image panel on the right, stays visible on every step ══ */
#{{ section_id }}[data-layout="split"] .bl-popup__card {
  max-width: 720px;
  display: grid;
  grid-template-columns: 1fr 1fr;
}
#{{ section_id }}[data-layout="split"] .bl-popup__body { order: 1; }
#{{ section_id }}[data-layout="split"] .bl-popup__left { order: 2; }
#{{ section_id }}:not([data-layout="split"]) .bl-popup__left { display: none; }

#{{ section_id }} .bl-popup__left {
  background: var(--pop-split-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 2rem;
  position: relative;
  overflow: hidden;
  text-align: center;
}
#{{ section_id }} .bl-popup__left.has-image { padding: 0; }
#{{ section_id }} .bl-popup__left-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
#{{ section_id }} .bl-popup__left-ring {
  position: absolute;
  border-radius: 50%;
  border: 1.5px solid color-mix(in srgb, var(--pop-split-text) 18%, transparent);
  pointer-events: none;
  animation: bl-ring 7s ease-in-out infinite;
}
#{{ section_id }} .bl-popup__left-ring--1 { width: 120%; height: 120%; animation-delay: 0s; }
#{{ section_id }} .bl-popup__left-ring--2 { width: 85%;  height: 85%;  animation-delay: 1.5s; }
#{{ section_id }} .bl-popup__left-ring--3 { width: 55%;  height: 55%;  animation-delay: 3s; }
@keyframes bl-ring {
  0%, 100% { opacity: 0.5; transform: scale(1);    }
  50%       { opacity: 0.15; transform: scale(1.06); }
}
#{{ section_id }} .bl-popup__left-brand {
  font-family: 'DM Sans', sans-serif;
  font-weight: 800;
  font-size: 2.2rem;
  color: var(--pop-split-text);
  letter-spacing: -0.02em;
  line-height: 1;
  position: relative;
  z-index: 1;
  margin-bottom: 1rem;
}
#{{ section_id }} .bl-popup__left-tagline {
  font-size: 0.92rem;
  color: color-mix(in srgb, var(--pop-split-text) 72%, transparent);
  line-height: 1.5;
  max-width: 20ch;
  position: relative;
  z-index: 1;
}

/* ══ Sheet layout ══ */
#{{ section_id }}[data-layout="sheet"] {
  align-items: flex-end;
  padding: 0;
}
#{{ section_id }}[data-layout="sheet"] .bl-popup__card {
  max-width: 100%;
  border-radius: 20px 20px 0 0;
  max-height: 92vh;
  overflow-y: auto;
  transform: translateY(100%);
}
#{{ section_id }}[data-layout="sheet"].bl-popup--open .bl-popup__card {
  transform: translateY(0);
}
#{{ section_id }}[data-layout="sheet"] .bl-popup__card::after {
  content: '';
  display: block;
  width: 2.8rem;
  height: 4px;
  background: color-mix(in srgb, var(--pop-text) 20%, transparent);
  border-radius: 99px;
  margin: 1rem auto 0;
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  z-index: 5;
}

/* ══ Body ══ */
#{{ section_id }} .bl-popup__body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 2.4rem 2.2rem;
}
#{{ section_id }}[data-layout="sheet"] .bl-popup__body { padding-top: 2.4rem; }

/* ══ Displays — stacked, cross-fade between steps ══
   Only the active display is position:relative (in flow) — the other
   two steps are position:absolute and don't contribute to height — so
   this wrapper's height already comes from whichever step is showing.
   The large fixed min-heights previously here forced extra blank space
   below shorter steps (especially on mobile); removed so the popup
   hugs its actual content instead. */
#{{ section_id }} .bl-popup__displays {
  position: relative;
  width: 100%;
  display: flex;
}
#{{ section_id }} .bl-popup__display {
  position: absolute;
  top: 0; left: 0; right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
#{{ section_id }} .bl-popup__display.is-active {
  flex: 1 1 auto;
  width: 100%;
  opacity: 1;
  transform: none !important;
  pointer-events: auto;
  position: relative;
}
#{{ section_id }} .bl-popup__display[data-enter="right"]:not(.is-active) { transform: translateX(28px); }
#{{ section_id }} .bl-popup__display[data-enter="left"]:not(.is-active)  { transform: translateX(-28px); }
#{{ section_id }} .bl-popup__display[data-enter="scale"]:not(.is-active) { transform: scale(0.94); }
@media (prefers-reduced-motion: reduce) {
  #{{ section_id }} .bl-popup__display { transition: opacity 0.2s ease; }
  #{{ section_id }} .bl-popup__display[data-enter]:not(.is-active) { transform: none; }
  #{{ section_id }} .bl-popup__displays { transition: none; }
}

/* ══ Badge ══ */
#{{ section_id }} .bl-popup__badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  background: color-mix(in srgb, var(--pop-accent) 14%, transparent);
  color: var(--pop-accent);
  border: 1px solid color-mix(in srgb, var(--pop-accent) 32%, transparent);
  border-radius: 999px;
  padding: 0.6rem 1.4rem;
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 1.2rem;
  white-space: nowrap;
}
#{{ section_id }} .bl-popup__badge-icon { width: 1em; height: 1em; flex-shrink: 0; }

/* ══ D/H/M/S Countdown (Display 1 only) ══ */
#{{ section_id }} .bl-popup__countdown {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  margin-bottom: 1.6rem;
}
#{{ section_id }} .bl-popup__cd-unit {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.45rem;
}
#{{ section_id }} .bl-popup__cd-val {
  background: var(--pop-timer-bg);
  color: var(--pop-timer-text);
  font-family: 'DM Sans', sans-serif;
  font-size: 2.3rem;
  font-weight: 800;
  width: 4.5rem;
  height: 4.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.03em;
  line-height: 1;
  position: relative;
  overflow: hidden;
  box-shadow:
    0 6px 22px rgba(0,0,0,0.3),
    0 1px 0 rgba(255,255,255,0.1) inset,
    0 -1px 0 rgba(0,0,0,0.08) inset;
}
#{{ section_id }} .bl-popup__cd-val::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  top: 50%;
  height: 1px;
  background: rgba(0,0,0,0.1);
  pointer-events: none;
}
#{{ section_id }} .bl-popup__cd-val::before {
  content: '';
  position: absolute;
  inset: 0 0 50% 0;
  background: rgba(255,255,255,0.07);
  pointer-events: none;
}
#{{ section_id }} .bl-popup__cd-lbl {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--pop-sub);
  font-weight: 700;
}
#{{ section_id }} .bl-popup__cd-sep {
  font-family: 'DM Sans', sans-serif;
  font-size: 1.9rem;
  font-weight: 800;
  color: var(--pop-timer-bg);
  opacity: 0.5;
  line-height: 1;
  letter-spacing: -0.05em;
  margin-bottom: calc(0.6rem + 0.45rem);
  flex-shrink: 0;
}

/* ══ Heading / description / footer (shared across displays) ══ */
#{{ section_id }} .bl-popup__heading {
  font-family: 'DM Sans', sans-serif;
  font-weight: 800;
  font-size: 1.7rem;
  line-height: 1.15;
  color: var(--pop-text);
  letter-spacing: -0.02em;
  margin-bottom: 0.85rem;
  overflow-wrap: break-word;
  text-align: center;
  width: 100%;
}
#{{ section_id }} .bl-popup__display[data-display="1"] .bl-popup__heading,
#{{ section_id }} .bl-popup__display[data-display="2"] .bl-popup__heading,
#{{ section_id }} .bl-popup__display[data-display="3"] .bl-popup__heading {
  font-size: 2.05rem;
}
#{{ section_id }} .bl-popup__sub {
  font-size: 1.02rem;
  color: var(--pop-sub);
  line-height: 1.55;
  margin-bottom: 1.6rem;
  max-width: 42ch;
  text-align: center;
}
#{{ section_id }} .bl-popup__footer-text {
  font-size: 0.95rem;
  color: var(--pop-sub);
  margin-top: 1.1rem;
  text-align: center;
}

/* ══ Display 1 — Category buttons ══ */
#{{ section_id }} .bl-popup__categories {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.7rem;
  width: 100%;
}
#{{ section_id }} .bl-popup__categories[data-columns="1"] {
  grid-template-columns: 1fr;
}
#{{ section_id }} .bl-popup__categories:not([data-columns="1"]) .bl-popup__category-btn:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}
#{{ section_id }} .bl-popup__category-btn {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem 1rem;
  border-radius: 14px;
  font-family: 'DM Sans', sans-serif;
  font-size: var(--cat-btn-fs, 1.05rem);
  font-weight: 700;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1), border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease, color 0.22s ease;
}

/* Filled style (default) — inverts against the site's own theme toggle */
#{{ section_id }} .bl-popup__categories[data-style="filled"] .bl-popup__category-btn {
  background: #ffffff;
  color: #001529;
  border: 1.5px solid transparent;
}
[data-theme="light"] #{{ section_id }} .bl-popup__categories[data-style="filled"] .bl-popup__category-btn {
  background: #0a1a24;
  color: #ffffff;
}

/* Outlined style */
#{{ section_id }} .bl-popup__categories[data-style="outlined"] .bl-popup__category-btn {
  background: transparent;
  color: var(--pop-text);
  border: 2px solid color-mix(in srgb, var(--pop-text) 45%, transparent);
}

/* Minimal style — subtle tint, matches the original pill look */
#{{ section_id }} .bl-popup__categories[data-style="minimal"] .bl-popup__category-btn {
  background: color-mix(in srgb, var(--pop-text) 6%, transparent);
  border: 1.5px solid color-mix(in srgb, var(--pop-text) 14%, transparent);
  color: var(--pop-text);
}

/* Gradient style — solid accent gradient fill */
#{{ section_id }} .bl-popup__categories[data-style="gradient"] .bl-popup__category-btn {
  background: linear-gradient(135deg, var(--pop-accent), color-mix(in srgb, var(--pop-accent) 55%, #00b8ff));
  color: #001529;
  border: 1.5px solid transparent;
}

/* Neon style — dark tint with a glowing accent border */
#{{ section_id }} .bl-popup__categories[data-style="neon"] .bl-popup__category-btn {
  background: color-mix(in srgb, var(--pop-accent) 10%, transparent);
  color: var(--pop-accent);
  border: 1.5px solid var(--pop-accent);
  box-shadow: 0 0 14px color-mix(in srgb, var(--pop-accent) 45%, transparent);
}

#{{ section_id }} .bl-popup__category-btn:hover,
#{{ section_id }} .bl-popup__category-btn:focus-visible {
  transform: translateY(-3px) scale(1.01);
  border-color: var(--pop-accent);
  box-shadow: 0 10px 28px color-mix(in srgb, var(--pop-accent) 35%, transparent);
}
#{{ section_id }} .bl-popup__category-btn:active { transform: translateY(-1px) scale(1); }
#{{ section_id }} .bl-popup__category-icon { font-size: 1.2em; line-height: 1; }

/* ══ Display 2 — Email form ══ */
#{{ section_id }} .bl-popup__email-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  margin-bottom: 0.9rem;
}
#{{ section_id }} .bl-popup__email-input-wrap { position: relative; width: 100%; }
#{{ section_id }} .bl-popup__email-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  width: 1.1rem;
  height: 1.1rem;
  color: color-mix(in srgb, var(--pop-text) 45%, transparent);
  pointer-events: none;
}
#{{ section_id }} .bl-popup__email-input {
  width: 100%;
  padding: 1rem 1.1rem 1rem 2.8rem;
  background: color-mix(in srgb, var(--pop-text) 6%, transparent);
  border: 1.5px solid color-mix(in srgb, var(--pop-text) 16%, transparent);
  border-radius: 999px;
  color: var(--pop-text);
  font-family: 'DM Sans', sans-serif;
  font-size: 1.1rem;
  outline: none;
  transition: border-color 0.2s ease, background 0.2s ease;
}
#{{ section_id }} .bl-popup__email-input:focus {
  border-color: var(--pop-accent);
  background: color-mix(in srgb, var(--pop-text) 9%, transparent);
}
#{{ section_id }} .bl-popup__email-input::placeholder {
  color: color-mix(in srgb, var(--pop-text) 40%, transparent);
}
#{{ section_id }} .bl-popup__email-input.is-invalid {
  border-color: #ff6b6b;
}
#{{ section_id }} .bl-popup__reveal-btn {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 1rem 1.4rem;
  background: var(--pop-accent);
  color: var(--pop-card);
  border: none;
  border-radius: 999px;
  font-family: 'DM Sans', sans-serif;
  font-weight: 700;
  font-size: 1.1rem;
  cursor: pointer;
  transition: opacity 0.2s ease, transform 0.15s ease, filter 0.2s ease;
}
#{{ section_id }} .bl-popup__reveal-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
#{{ section_id }} .bl-popup__reveal-btn:not(:disabled):hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}
#{{ section_id }} .bl-popup__spinner {
  display: none;
  width: 1rem;
  height: 1rem;
  border: 2px solid color-mix(in srgb, var(--pop-card) 35%, transparent);
  border-top-color: var(--pop-card);
  border-radius: 50%;
  animation: bl-spin 0.7s linear infinite;
  flex-shrink: 0;
}
#{{ section_id }} .bl-popup__reveal-btn.is-loading .bl-popup__spinner { display: inline-block; }
@keyframes bl-spin { to { transform: rotate(360deg); } }
#{{ section_id }} .bl-popup__privacy-text {
  font-size: 0.9rem;
  color: var(--pop-sub);
  line-height: 1.5;
  margin-bottom: 1rem;
  text-align: center;
}
#{{ section_id }} .bl-popup__back-btn {
  background: none;
  border: none;
  color: var(--pop-sub);
  font-family: 'DM Sans', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.2s ease;
}
#{{ section_id }} .bl-popup__back-btn:hover { color: var(--pop-text); }

/* ══ Display 3 — Reveal badge ══ */
#{{ section_id }} .bl-popup__reveal-badge {
  width: 4.4rem;
  height: 4.4rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.9rem;
  background: color-mix(in srgb, var(--pop-accent) 16%, transparent);
  border: 2px solid var(--pop-accent);
  color: var(--pop-accent);
  font-family: 'DM Sans', sans-serif;
  font-weight: 800;
  font-size: 1.7rem;
  letter-spacing: -0.02em;
  transform: scale(0) rotate(-20deg);
}
#{{ section_id }} .bl-popup__display[data-display="3"].is-active .bl-popup__reveal-badge {
  animation: bl-badge-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}
@keyframes bl-badge-pop {
  0%   { transform: scale(0) rotate(-20deg); }
  60%  { transform: scale(1.15) rotate(6deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* ══ Discount code display + copy button ══ */
#{{ section_id }} .bl-popup__code {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1.2rem;
  width: 100%;
  margin-bottom: 0.9rem;
  padding: 1.3rem 1.6rem;
  background: color-mix(in srgb, var(--pop-accent) 9%, transparent);
  border-radius: 16px;
}
#{{ section_id }} .bl-popup__code-letters {
  display: flex;
  gap: 0.3em;
  flex-wrap: wrap;
  justify-content: center;
}
#{{ section_id }} .bl-popup__code-letter {
  font-family: 'DM Sans', sans-serif;
  font-weight: 800;
  font-size: 2.2rem;
  letter-spacing: -0.02em;
  line-height: 1;
  color: var(--pop-accent);
  border-bottom: 3px solid color-mix(in srgb, var(--pop-accent) 55%, transparent);
  padding: 0 0.06em 0.14em;
  min-width: 0.85em;
  text-align: center;
}
#{{ section_id }} .bl-popup__code-copy {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: color-mix(in srgb, var(--pop-accent) 16%, transparent);
  color: var(--pop-accent);
  border: 1.5px solid color-mix(in srgb, var(--pop-accent) 40%, transparent);
  border-radius: 999px;
  padding: 0.7rem 1.3rem;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.88rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  -webkit-tap-highlight-color: transparent;
}
#{{ section_id }} .bl-popup__code-copy:hover {
  background: color-mix(in srgb, var(--pop-accent) 22%, transparent);
  transform: translateY(-1px);
}
#{{ section_id }} .bl-popup__code-copy:active { transform: translateY(0); }
#{{ section_id }} .bl-popup__code-copy.is-copied {
  background: var(--pop-accent);
  color: var(--pop-card);
  border-color: var(--pop-accent);
}
#{{ section_id }} .bl-popup__code-copy-icon,
#{{ section_id }} .bl-popup__code-check-icon { width: 1rem; height: 1rem; flex-shrink: 0; }

#{{ section_id }} .bl-popup__code-msg {
  min-height: 1.2rem;
  margin-bottom: 0.9rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--pop-accent);
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.25s ease, transform 0.25s ease;
}
#{{ section_id }} .bl-popup__code-msg.is-visible { opacity: 1; transform: translateY(0); }

#{{ section_id }} .bl-popup__shop-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.9rem 2rem;
  background: transparent;
  color: var(--pop-text);
  border: 1.5px solid color-mix(in srgb, var(--pop-text) 25%, transparent);
  border-radius: 999px;
  font-family: 'DM Sans', sans-serif;
  font-weight: 700;
  font-size: 1.05rem;
  text-decoration: none;
  transition: border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
}
#{{ section_id }} .bl-popup__shop-btn:hover {
  border-color: var(--pop-accent);
  color: var(--pop-accent);
  transform: translateY(-1px);
}

/* Confetti canvas — overlays the whole card, never blocks interaction */
#{{ section_id }} .bl-popup__confetti {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 15;
}

/* ══ Mobile ══ */
@media (max-width: 640px) {
  /* No side image/brand panel on mobile at all — desktop-only, keeps the
     card compact so it never collides with the site header. */
  #{{ section_id }}[data-layout="split"] .bl-popup__card {
    grid-template-columns: 1fr;
  }
  #{{ section_id }} .bl-popup__left {
    display: none !important;
  }
  #{{ section_id }} .bl-popup__heading { font-size: 1.7rem; }
  #{{ section_id }} .bl-popup__display[data-display="1"] .bl-popup__heading,
  #{{ section_id }} .bl-popup__display[data-display="2"] .bl-popup__heading,
  #{{ section_id }} .bl-popup__display[data-display="3"] .bl-popup__heading { font-size: 1.9rem; }
  #{{ section_id }} .bl-popup__sub { font-size: 0.95rem; }
  #{{ section_id }} .bl-popup__category-btn { padding: 0.85rem 0.9rem; }
  #{{ section_id }} .bl-popup__code-letter { font-size: 1.8rem; }
  #{{ section_id }} .bl-popup__cd-val { width: 4rem; height: 4rem; font-size: 1.9rem; }
  #{{ section_id }} .bl-popup__cd-sep { font-size: 1.6rem; }
}
@media (max-width: 420px) {
  #{{ section_id }} .bl-popup__categories { grid-template-columns: 1fr; }
  #{{ section_id }} .bl-popup__category-btn:last-child:nth-child(odd) { grid-column: auto; }
}
@media (max-width: 400px) {
  #{{ section_id }} .bl-popup__cd-val { width: 3.5rem; height: 3.5rem; font-size: 1.6rem; border-radius: 10px; }
  #{{ section_id }} .bl-popup__cd-sep { font-size: 1.3rem; }
}

{% endstyle %}

<div id="{{ section_id }}"
     class="bl-popup"
     data-layout="{{ layout_style }}"
     role="dialog"
     aria-modal="true"
     aria-label="{{ d1_heading | strip_html | escape }}"
     aria-hidden="true">

  <div class="bl-popup__card">

    <!-- Confetti overlay — covers the whole card, never intercepts clicks -->
    <canvas class="bl-popup__confetti" data-confetti-canvas aria-hidden="true"></canvas>

    <!-- Close button -->
    <button class="bl-popup__close" aria-label="Close popup" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <!-- Right-side image panel — stays visible on every step -->
    <div class="bl-popup__left{% if side_image != blank %} has-image{% endif %}" aria-hidden="true">
      {%- if side_image != blank -%}
        {{ side_image | image_url: width: 800 | image_tag:
          loading: 'lazy', alt: '', class: 'bl-popup__left-img',
          widths: '400, 600, 800'
        }}
      {%- else -%}
        <span class="bl-popup__left-ring bl-popup__left-ring--1"></span>
        <span class="bl-popup__left-ring bl-popup__left-ring--2"></span>
        <span class="bl-popup__left-ring bl-popup__left-ring--3"></span>
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 240 | image_tag: loading: 'lazy', alt: brand_name }}
        {%- else -%}
          <div class="bl-popup__left-brand">{{ brand_name }}</div>
        {%- endif -%}
        <p class="bl-popup__left-tagline">Your mystery discount is waiting</p>
      {%- endif -%}
    </div>

    <!-- Main body — 3-step flow -->
    <div class="bl-popup__body">
      <div class="bl-popup__displays">

        <!-- ══ Display 1 — Category selection ══ -->
        <div class="bl-popup__display is-active" data-display="1">

          {%- if badge_text != blank -%}
            <span class="bl-popup__badge">
              <svg class="bl-popup__badge-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8" cy="8" r="6.5"/>
                <path d="M8 5v3l1.8 1.8"/>
              </svg>
              {{ badge_text }}
            </span>
          {%- endif -%}

          {%- if show_timer -%}
            <div class="bl-popup__countdown">
              {%- if timer_days > 0 or timer_total_secs >= 86400 -%}
                <div class="bl-popup__cd-unit">
                  <span class="bl-popup__cd-val" id="{{ section_id }}-days">{{ d_pad }}{{ timer_days }}</span>
                  <span class="bl-popup__cd-lbl">days</span>
                </div>
                <span class="bl-popup__cd-sep">:</span>
              {%- endif -%}
              <div class="bl-popup__cd-unit">
                <span class="bl-popup__cd-val" id="{{ section_id }}-hours">{{ h_pad }}{{ timer_hours }}</span>
                <span class="bl-popup__cd-lbl">hrs</span>
              </div>
              <span class="bl-popup__cd-sep">:</span>
              <div class="bl-popup__cd-unit">
                <span class="bl-popup__cd-val" id="{{ section_id }}-mins">{{ m_pad }}{{ timer_mins_set }}</span>
                <span class="bl-popup__cd-lbl">min</span>
              </div>
              <span class="bl-popup__cd-sep">:</span>
              <div class="bl-popup__cd-unit">
                <span class="bl-popup__cd-val" id="{{ section_id }}-secs">00</span>
                <span class="bl-popup__cd-lbl">sec</span>
              </div>
            </div>
          {%- endif -%}

          <h2 class="bl-popup__heading">{{ d1_heading }}</h2>
          <p class="bl-popup__sub">{{ d1_desc }}</p>

          <div class="bl-popup__categories" data-categories data-style="{{ category_style }}" data-columns="{{ category_columns }}" style="--cat-btn-fs: {{ category_fs }}px;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'category' and block.settings.label != blank -%}
                <button type="button" class="bl-popup__category-btn" data-category-btn data-category="{{ block.settings.label | escape }}" data-category-url="{{ block.settings.redirect_url }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}<span class="bl-popup__category-icon" aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
                  {{ block.settings.label | escape }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if d1_footer != blank -%}
            <p class="bl-popup__footer-text">{{ d1_footer }}</p>
          {%- endif -%}
        </div>

        <!-- ══ Display 2 — Email collection ══ -->
        <div class="bl-popup__display" data-display="2">
          <h2 class="bl-popup__heading">{{ d2_heading }}</h2>
          <p class="bl-popup__sub">{{ d2_desc }}</p>

          <form class="bl-popup__email-form" data-email-form novalidate>
            <div class="bl-popup__email-input-wrap">
              <svg class="bl-popup__email-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="M2 6l10 7 10-7"/>
              </svg>
              <input
                type="email"
                class="bl-popup__email-input"
                placeholder="{{ d2_placeholder | escape }}"
                autocomplete="email"
                data-email-input
                required
              >
            </div>
            <button type="submit" class="bl-popup__reveal-btn" data-reveal-btn disabled>
              <span class="bl-popup__spinner" aria-hidden="true"></span>
              <span data-reveal-label>{{ d2_btn_text | escape }}</span>
            </button>
          </form>

          {%- if d2_privacy != blank -%}
            <p class="bl-popup__privacy-text">{{ d2_privacy }}</p>
          {%- endif -%}

          {%- if d2_back_text != blank -%}
            <button type="button" class="bl-popup__back-btn" data-back-btn>{{ d2_back_text | escape }}</button>
          {%- endif -%}
        </div>

        <!-- ══ Display 3 — Discount revealed ══ -->
        <div class="bl-popup__display" data-display="3">
          <div class="bl-popup__reveal-badge" aria-hidden="true">%</div>

          <h2 class="bl-popup__heading">{{ d3_heading }}</h2>
          <p class="bl-popup__sub">{{ d3_desc }}</p>

          {%- if _display_code != blank -%}
            <div class="bl-popup__code" data-code-row>
              <div class="bl-popup__code-letters" data-code-text>
                {%- for ch in _display_code_chars -%}
                  <span class="bl-popup__code-letter">{{ ch }}</span>
                {%- endfor -%}
              </div>
              <button
                type="button"
                class="bl-popup__code-copy"
                data-copy-code="{{ _display_code }}"
                aria-label="{{ copy_button_text | escape }} {{ _display_code }}"
              >
                <svg class="bl-popup__code-copy-icon" data-copy-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="12" height="12" rx="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <svg class="bl-popup__code-check-icon" data-check-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
                  <path d="M20 6L9 17l-5-5"/>
                </svg>
                <span data-copy-label>{{ copy_button_text | escape }}</span>
              </button>
            </div>
            <p class="bl-popup__code-msg" data-code-msg aria-live="polite"></p>
          {%- endif -%}

          {%- if d3_shop_text != blank -%}
            <a href="{{ d3_shop_url }}" class="bl-popup__shop-btn" data-shop-btn>{{ d3_shop_text | escape }}</a>
          {%- endif -%}

          {%- if d3_footer != blank -%}
            <p class="bl-popup__footer-text">{{ d3_footer }}</p>
          {%- endif -%}
        </div>

      </div><!-- /.bl-popup__displays -->
    </div><!-- /.bl-popup__body -->
  </div><!-- /.bl-popup__card -->
</div>

{%- comment -%}
  The displayed/copied code comes from the first "Discount Code" block
  added in the theme editor, so it lives in Shopify settings — not
  hardcoded in JS. NOTE: it must also exist as a real discount in
  Shopify Admin → Discounts, or copying it here won't actually discount
  anything at checkout. Email capture posts to Shopify's native
  /contact newsletter endpoint (form_type=customer) — no app required.
{%- endcomment -%}
<script>
  window.BLPopupConfig = {
    sectionId:            '{{ section_id }}',
    delayMs:              {{ delay_sec | times: 1000 }},
    sessionOnce:          {{ session_once }},
    showTimer:            {{ show_timer }},
    timerTotalSecs:       {{ timer_total_secs }},
    closeOnTimerEnd:      {{ close_on_timer }},
    discountCode:         {{ _display_code | json }},
    codeMessage:          {{ _display_code_message | json }},
    closeOnCopy:          {{ _display_code_close }},
    copyButtonText:       {{ copy_button_text | json }},
    copyButtonCopiedText: {{ copy_button_copied_text | json }},
    shopButtonUrl:        {{ d3_shop_url | json }}
  };
</script>
<script src="{{ 'timer-popup.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Mystery Discount Popup",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Trigger"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Display after (seconds)",
      "min": 0, "max": 120, "step": 5, "unit": "s", "default": 20,
      "info": "How many seconds after page load before the popup appears."
    },
    {
      "type": "checkbox",
      "id": "session_once",
      "label": "Show once per browser session",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Popup layout",
      "options": [
        { "value": "split", "label": "Split — image panel + content" },
        { "value": "card",  "label": "Card — centered modal, no image" },
        { "value": "sheet", "label": "Bottom sheet — slides up, no image" }
      ],
      "default": "split"
    },
    {
      "type": "header",
      "content": "Countdown Timer",
      "info": "Only shown on the first step (category selection)."
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show countdown timer",
      "default": true
    },
    {
      "type": "range",
      "id": "timer_days",
      "label": "Days",
      "min": 0, "max": 30, "step": 1, "unit": "d", "default": 0
    },
    {
      "type": "range",
      "id": "timer_hours",
      "label": "Hours",
      "min": 0, "max": 23, "step": 1, "unit": "h", "default": 0
    },
    {
      "type": "range",
      "id": "timer_minutes",
      "label": "Minutes",
      "min": 0, "max": 59, "step": 1, "unit": "m", "default": 10
    },
    {
      "type": "checkbox",
      "id": "close_on_timer_end",
      "label": "Auto-close when timer reaches zero",
      "default": false
    },
    {
      "type": "header",
      "content": "Step 1 — Category Selection"
    },
    {
      "type": "select",
      "id": "category_button_style",
      "label": "Category button style",
      "options": [
        { "value": "filled",   "label": "Filled (inverts with theme toggle)" },
        { "value": "outlined", "label": "Outlined" },
        { "value": "minimal",  "label": "Minimal (subtle tint)" },
        { "value": "gradient", "label": "Gradient (accent gradient fill)" },
        { "value": "neon",     "label": "Neon (glowing accent border)" }
      ],
      "default": "filled",
      "info": "Filled swaps white-bg/dark-text in dark mode for dark-bg/light-text in light mode automatically."
    },
    {
      "type": "select",
      "id": "category_button_columns",
      "label": "Category button columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "1", "label": "1 column (full width)" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "category_font_size",
      "label": "Category button text size",
      "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge label",
      "default": "Limited Time Offer",
      "info": "Leave blank to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "🎉 You've Got a Mystery Discount!"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "Choose your favorite workout category below to unlock your exclusive reward."
    },
    {
      "type": "text",
      "id": "d1_footer_text",
      "label": "Footer text",
      "default": "Choose one category to continue."
    },
    {
      "type": "header",
      "content": "Step 2 — Email Collection"
    },
    {
      "type": "text",
      "id": "d2_heading",
      "label": "Heading",
      "default": "Almost There!"
    },
    {
      "type": "textarea",
      "id": "d2_description",
      "label": "Description",
      "default": "Enter your email address to reveal your exclusive mystery discount."
    },
    {
      "type": "text",
      "id": "d2_email_placeholder",
      "label": "Email input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "d2_button_text",
      "label": "Reveal button text",
      "default": "Reveal My Discount"
    },
    {
      "type": "textarea",
      "id": "d2_privacy_text",
      "label": "Privacy text",
      "default": "We only use your email to send your exclusive offer. No spam."
    },
    {
      "type": "text",
      "id": "d2_back_button_text",
      "label": "Back button text",
      "default": "← Choose Another Category",
      "info": "Leave blank to hide the back button."
    },
    {
      "type": "header",
      "content": "Step 3 — Discount Revealed"
    },
    {
      "type": "text",
      "id": "d3_heading",
      "label": "Heading",
      "default": "🎉 Congratulations!"
    },
    {
