{% comment %}
  ============================================================
  BURNLAB — Cart Drawer Snippet
  Replaces Evolve's snippets/cart-drawer.liquid.
  Preserves all Evolve HTML + custom elements exactly.
  CSS is embedded here so it always wins over Evolve's asset CSS.
  ============================================================
{% endcomment %}

<style>
/* ═══════════════════════════════════════════════════════════════
   BURNLAB CART DRAWER — embedded in snippet for CSS load priority
   All !important rules override Evolve's cart-drawer.css asset.
   ═══════════════════════════════════════════════════════════════ */

:root,
[data-theme="dark"] {
  --bl-cdr-bg:            #001828;
  --bl-cdr-text:          #eaf4f5;
  --bl-cdr-accent:        #07d16e;
  --bl-cdr-cta-text:      #001a2e;
  --bl-cdr-item-bg:       #001a2e;
  --bl-cdr-border:        rgba(51,104,112,0.22);
  --bl-cdr-muted:         rgba(234,244,245,0.50);
  --bl-cdr-overlay:       rgba(0,10,20,0.75);
  --bl-cdr-shadow:        -8px 0 48px rgba(0,0,0,0.50);
  --bl-cdr-inp-bg:        rgba(255,255,255,0.05);
}

[data-theme="light"] {
  --bl-cdr-bg:            #f0f5f8;
  --bl-cdr-text:          #001a2e;
  /* Teal instead of the same bright green used in dark mode — the
     green read as too light/washed out against a white background. */
  --bl-cdr-accent:        #336870;
  --bl-cdr-cta-text:      #ffffff;
  --bl-cdr-item-bg:       #ffffff;
  --bl-cdr-border:        rgba(0,26,46,0.12);
  --bl-cdr-muted:         rgba(0,26,46,0.50);
  --bl-cdr-overlay:       rgba(0,26,46,0.55);
  --bl-cdr-shadow:        -8px 0 48px rgba(0,26,46,0.22);
  --bl-cdr-inp-bg:        rgba(0,26,46,0.04);
}

/* ── Overlay backdrop ──
   z-index must beat header.liquid's own stacking (its section wrapper
   and outer bar force themselves to z-index:9999), otherwise the
   drawer — and its close button — render underneath the fixed header. */
#cart_drawer,
.cart_drawer_wrapper {
  position:   fixed !important;
  inset:      0 !important;
  z-index:    999999 !important;
  background-color: var(--bl-cdr-overlay) !important;
  background:       var(--bl-cdr-overlay) !important;
}

/* ── Slide-in panel ── */
.cart_drawer_inner,
.drawer-wrapper_inner.cart_drawer_inner {
  position:   fixed !important;
  top:        0 !important;
  right:      0 !important;
  height:     100vh !important;
  height:     100dvh !important;
  z-index:    1000000 !important;
  background-color: var(--bl-cdr-bg) !important;
  background:       var(--bl-cdr-bg) !important;
  color:            var(--bl-cdr-text) !important;
  font-family:      'DM Sans', sans-serif !important;
  border-left:      1px solid var(--bl-cdr-border) !important;
  box-shadow:       var(--bl-cdr-shadow) !important;
  border-radius:    0 !important;
  display:          flex !important;
  flex-direction:   column !important;
}

/* ── Header ── */
.cart_drawer_header {
  background-color: var(--bl-cdr-bg) !important;
  background:       var(--bl-cdr-bg) !important;
  border-bottom:    1px solid var(--bl-cdr-border) !important;
  padding:          1.6rem 1.8rem !important;
  display:          flex !important;
  align-items:      center !important;
  justify-content:  space-between !important;
  flex-shrink:      0 !important;
}

.cart_drawer_header h4 {
  font-family:    'DM Sans', sans-serif !important;
  font-weight:    800 !important;
  font-size:      clamp(1.6rem, 2vw, 2rem) !important;
  letter-spacing: -0.01em !important;
  color:          var(--bl-cdr-text) !important;
  margin:         0 !important;
}

/* Close button — icon only, no circular background/border */
.cart_drawer_header .drawer-wrapper__close,
.cart_drawer_header .localization_drawer_close {
  width:       3.6rem !important;
  height:      3.6rem !important;
  display:     flex !important;
  align-items: center !important;
  justify-content: center !important;
  background:  transparent !important;
  border:      none !important;
  border-radius: 0 !important;
  color:       var(--bl-cdr-accent) !important;
  cursor:      pointer !important;
  transition:  color 0.22s ease, transform 0.25s ease !important;
  flex-shrink: 0 !important;
}

.cart_drawer_header .drawer-wrapper__close:hover,
.cart_drawer_header .localization_drawer_close:hover {
  color:      var(--bl-cdr-accent) !important;
  transform:  rotate(90deg) scale(1.1) !important;
}

.cart_drawer_header .icon_wrapper,
.cart_drawer_header .icon_wrapper svg {
  display:     flex !important;
  align-items: center !important;
  justify-content: center !important;
  color:  var(--bl-cdr-accent) !important;
  stroke: var(--bl-cdr-accent) !important;
  width:  1.6rem !important;
  height: 1.6rem !important;
}

/* ── Scroll content area ── */
.cart_drawer_content_wrapper {
  flex:       1 !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  background: var(--bl-cdr-bg) !important;
  scrollbar-width: thin !important;
  scrollbar-color: rgba(7,209,110,0.3) transparent !important;
}
.cart_drawer_content_wrapper::-webkit-scrollbar { width: 4px !important; }
.cart_drawer_content_wrapper::-webkit-scrollbar-thumb {
  background: rgba(7,209,110,0.3) !important;
  border-radius: 4px !important;
}

/* ── Item list ── */
.cart_drawer_content {
  padding:        1.2rem 1.4rem !important;
  display:        flex !important;
  flex-direction: column !important;
  gap:            1rem !important;
  background:     var(--bl-cdr-bg) !important;
}

/* ── Single cart item card ── */
.cart_drawer_item {
  display:     grid !important;
  grid-template-columns: 7rem 1fr !important;
  gap:         1.2rem !important;
  align-items: start !important;
  background:  var(--bl-cdr-item-bg) !important;
  border:      1px solid var(--bl-cdr-border) !important;
  border-radius: 10px !important;
  padding:     1.2rem !important;
  transition:  border-color 0.22s ease !important;
}
.cart_drawer_item:hover { border-color: rgba(7,209,110,0.28) !important; }
.cart_drawer_item.nested_cart_item {
  margin-left:  1rem !important;
  border-left:  2px solid rgba(7,209,110,0.22) !important;
}

/* Item image */
.cart_drawer__item_img {
  width:         7rem !important;
  height:        7rem !important;
  border-radius: 7px !important;
  overflow:      hidden !important;
  flex-shrink:   0 !important;
  background:    rgba(255,255,255,0.04) !important;
}
.cart_drawer__item_img a  { display: block !important; width: 100% !important; height: 100% !important; }
.cart_drawer__item_img img { width: 100% !important; height: 100% !important; object-fit: cover !important; display: block !important; transition: transform 0.35s ease !important; }
.cart_drawer__item_img:hover img { transform: scale(1.04) !important; }

/* Item info column */
.cart_drawer_item_info {
  display:        flex !important;
  flex-direction: column !important;
  gap:            0.5rem !important;
}

.cart_drawer_item_info .item_title,
.cart_drawer_item_info .item_title a {
  font-family:    'DM Sans', sans-serif !important;
  font-size:      clamp(1.2rem, 1.4vw, 1.4rem) !important;
  font-weight:    600 !important;
  color:          var(--bl-cdr-text) !important;
  text-decoration: none !important;
  line-height:    1.3 !important;
  overflow-wrap:  break-word !important;
  word-break:     break-word !important;
}
.cart_drawer_item_info .item_title a:hover { color: var(--bl-cdr-accent) !important; }

/* Price */
.cart_drawer_item_info .item_price_wrapper {
  font-family: 'DM Sans', sans-serif !important;
  font-weight: 700 !important;
  font-size:   clamp(1.2rem, 1.4vw, 1.5rem) !important;
  color:       var(--bl-cdr-text) !important;
  display:     flex !important;
  align-items: baseline !important;
  gap:         0.4rem !important;
  flex-wrap:   wrap !important;
}
.cart_drawer_item_info .item_price_wrapper s {
  font-size: 0.82em !important;
  color:     var(--bl-cdr-muted) !important;
  text-decoration: line-through !important;
}

/* Variant option tags */
.item_options_wrapper,
.item_product_options { display: flex !important; flex-wrap: wrap !important; gap: 0.3rem !important; }
.item_product_options span,
.item_options_wrapper span {
  font-family:   'DM Sans', sans-serif !important;
  font-size:     1.1rem !important;
  color:         var(--bl-cdr-muted) !important;
  background:    rgba(255,255,255,0.05) !important;
  border:        1px solid var(--bl-cdr-border) !important;
  border-radius: 3px !important;
  padding:       0.15rem 0.5rem !important;
}
[data-theme="light"] .item_product_options span,
[data-theme="light"] .item_options_wrapper span { background: rgba(0,26,46,0.05) !important; }

/* Properties */
.item_properties_wrapper { display: flex !important; gap: 0.3rem !important; font-size: 1.1rem !important; color: var(--bl-cdr-muted) !important; }
.item_property_name { font-weight: 600 !important; }
.item_selling_plan { font-size: 1.1rem !important; color: var(--bl-cdr-accent) !important; }
.item__unit_price { font-size: 1.1rem !important; color: var(--bl-cdr-muted) !important; }

/* ── Quantity + remove row ── */
.item_quantity_wrapper {
  display:         flex !important;
  align-items:     center !important;
  justify-content: space-between !important;
  gap:             0.8rem !important;
  margin-top:      0.3rem !important;
}

item-quantity {
  display:       inline-flex !important;
  align-items:   center !important;
  background:    var(--bl-cdr-inp-bg) !important;
  border:        1px solid var(--bl-cdr-border) !important;
  border-radius: 7px !important;
  overflow:      hidden !important;
}

/* +/- buttons */
.item_quantity_wrapper .btn_minus,
.item_quantity_wrapper .btn_plus {
  width:       3rem !important;
  height:      3rem !important;
  min-width:   3rem !important;
  min-height:  3rem !important;
  display:     flex !important;
  align-items: center !important;
  justify-content: center !important;
  background:  transparent !important;
  border:      none !important;
  color:       var(--bl-cdr-text) !important;
  cursor:      pointer !important;
  padding:     0 !important;
  transition:  color 0.2s ease, background 0.2s ease !important;
  flex-shrink: 0 !important;
}
.item_quantity_wrapper .btn_minus:hover:not([disabled]),
.item_quantity_wrapper .btn_plus:hover:not([disabled]) {
  color:      var(--bl-cdr-accent) !important;
  background: rgba(7,209,110,0.08) !important;
}
.item_quantity_wrapper .btn_minus[disabled],
.item_quantity_wrapper .btn_plus[disabled] { opacity: 0.3 !important; cursor: not-allowed !important; }

.item_quantity_wrapper .btn_minus svg,
.item_quantity_wrapper .btn_plus svg,
.item_quantity_wrapper .btn_minus .icon_wrapper,
.item_quantity_wrapper .btn_minus .icon_wrapper svg,
.item_quantity_wrapper .btn_plus .icon_wrapper,
.item_quantity_wrapper .btn_plus .icon_wrapper svg {
  display:       flex !important;
  width:         1.3rem !important;
  height:        1.3rem !important;
  min-width:     1.3rem !important;
  color:         inherit !important;
  stroke:        currentColor !important;
  fill:          currentColor !important;
  pointer-events: none !important;
}

.item_quantity_wrapper .icon_wrapper {
  display:         flex !important;
  align-items:     center !important;
  justify-content: center !important;
}

/* Quantity input */
.item_quantity_wrapper input[type="text"][name="quantity"],
.item_quantity_wrapper input[name="quantity"] {
  width:       3.4rem !important;
  height:      3rem !important;
  background:  transparent !important;
  border:      none !important;
  border-left: 1px solid var(--bl-cdr-border) !important;
  border-right: 1px solid var(--bl-cdr-border) !important;
  color:       var(--bl-cdr-text) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size:   1.3rem !important;
  font-weight: 600 !important;
  text-align:  center !important;
  outline:     none !important;
  -moz-appearance: textfield !important;
}
.item_quantity_wrapper input[name="quantity"]::-webkit-inner-spin-button,
.item_quantity_wrapper input[name="quantity"]::-webkit-outer-spin-button { -webkit-appearance: none !important; }
.item_quantity_wrapper input[name="quantity"]:focus { color: var(--bl-cdr-accent) !important; }

/* Remove (trash) button */
.item_remove_btn {
  display:         inline-flex !important;
  align-items:     center !important;
  justify-content: center !important;
  width:           3rem !important;
  height:          3rem !important;
  color:           var(--bl-cdr-muted) !important;
  text-decoration: none !important;
  border-radius:   6px !important;
  background:      transparent !important;
  transition:      color 0.2s ease, background 0.2s ease !important;
}
.item_remove_btn:hover { color: #ff5c5c !important; background: rgba(255,92,92,0.08) !important; }
.item_remove_btn .icon_wrapper,
.item_remove_btn svg,
.item_remove_btn .icon_wrapper svg {
  display:  flex !important;
  width:    1.5rem !important;
  height:   1.5rem !important;
  color:    inherit !important;
  stroke:   currentColor !important;
  pointer-events: none !important;
}
/* The raw icon-trash.svg ships with its own hardcoded fill (rendering
   purple regardless of theme) — stroke:currentColor above doesn't
   touch fill, so force it explicitly on every path/shape inside. */
.item_remove_btn svg path,
.item_remove_btn svg polyline,
.item_remove_btn svg line,
.item_remove_btn svg rect {
  fill:   currentColor !important;
  stroke: currentColor !important;
}

/* Cart error message */
.cart_error,
.cart_error[hidden] { display: none !important; }
.cart_error:not([hidden]) { display: block !important; font-size: 1.1rem !important; color: #ff6b6b !important; }

/* ── Upsell wrapper ── */
.cart_drawer_upsell_wrapper {
  padding:      1.2rem 1.4rem !important;
  border-top:   1px solid var(--bl-cdr-border) !important;
  background:   var(--bl-cdr-bg) !important;
}
.cart_drawer_upsell_head h2 {
  font-family:    'DM Sans', sans-serif !important;
  font-weight:    800 !important;
  font-size:      clamp(1.4rem, 1.8vw, 1.8rem) !important;
  letter-spacing: -0.01em !important;
  color:          var(--bl-cdr-text) !important;
  margin-bottom:  0.8rem !important;
}
.cart_drawer_upsell_head h2.h4::before {
  content:      '' !important;
  display:      inline-block !important;
  width:        0.3em !important; height: 0.3em !important;
  background:   var(--bl-cdr-accent) !important;
  border-radius: 50% !important;
  margin-right: 0.5em !important;
  vertical-align: 0.2em !important;
}

/* ── Upsell product cards ("You May Also Like") ──
   Rendered by snippets/product-card.liquid (via the recommendations
   API + Swiper — markup/logic untouched here, colors/sizing only).
   That snippet's own CSS (product-card.css) reads --color-text,
   --bg-color, --color-primary-button-* etc from Shopify's color-scheme
   system, which never follows the site's dark/light data-theme toggle,
   and some product cards render taller than others (a longer title
   wraps to 2 lines, pushing the price row down) with no shared height
   — the same fixes as elsewhere: recolor to our theme tokens, force
   equal card height, and swap the heading font to DM Sans. */
/* Each slide renders a bare title-only <a href> alongside the real
   visual card (image/title/price) for that same product — not a
   duplicate to dedupe, but the ONLY link for that product; the card
   itself isn't wrapped in an anchor at all. Every other anchor in
   this widget (real card links, swiper nav buttons) contains — or
   is — an image or icon; a plain-text-only link never legitimately
   appears here, so hiding by "no image inside" alone is reliable
   without assuming a specific sibling/parent structure (an earlier
   version assumed the stray link was always the image card's
   immediate previous sibling, which didn't hold for every render).
   Declarative :has() re-evaluates live as content streams in, so
   there's no unstyled flash to catch with JS timing. The matching
   JS below makes the now-unlinked card body clickable to that URL. */
.cart_drawer_upsell_products a:not(:has(img)) {
  display: none !important;
}

.cart_drawer_upsell_products .swiper-wrapper {
  display:     flex !important;
  align-items: stretch !important;
}
.cart_drawer_upsell_products .cart_upsell_item.swiper-slide {
  height:  auto !important;
  display: flex !important;
}
.cart_drawer_upsell_products .product_card_wrapper {
  width:          100% !important;
  height:         100% !important;
  display:        flex !important;
  flex-direction: column !important;
  font-family:    'DM Sans', sans-serif !important;
}
.cart_drawer_upsell_products .product_card_image {
  aspect-ratio: 1 / 1 !important;
  height:       auto !important;
  flex-shrink:  0 !important;
  background:   var(--bl-cdr-item-bg) !important;
}
/* Content flows normally (top-down) right after the image instead of
   being pinned to the card's bottom edge — bottom-pinning made the
   price sit at a different height on every card depending on how much
   blank space was left over, since titles clamp to a fixed 2-line slot
   regardless of their real length. Flowing normally means every card's
   title starts at the same point below the image, and every price
   starts at the same point below the title. */
.cart_drawer_upsell_products .product_card_content {
  margin-top: 0.6rem !important;
}
.cart_drawer_upsell_products .p_title {
  display:            -webkit-box !important;
  -webkit-line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;
  overflow:           hidden !important;
  min-height:         2.2em !important;
  color:              var(--bl-cdr-text) !important;
  font-family:        'DM Sans', sans-serif !important;
  font-size:          1.15rem !important;
  font-weight:        600 !important;
  text-align:         left !important;
}
.cart_drawer_upsell_products .p_description,
.cart_drawer_upsell_products .product_vendor {
  color:       var(--bl-cdr-muted) !important;
  font-family: 'DM Sans', sans-serif !important;
  text-align:  left !important;
}
.cart_drawer_upsell_products .product_card_price_inner {
  justify-content: flex-start !important;
}
/* Every price — single or range — now reads "Starts from ₹X" (wrapped
   by the script below), so both classes share the same muted
   regular-weight lead-in style; only the highlighted span is bold +
   accent colored. */
.cart_drawer_upsell_products .regular_price,
.cart_drawer_upsell_products .product_card_price_varies {
  color:       var(--bl-cdr-muted) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-weight: 500 !important;
  font-size:   1.1rem !important;
  text-align:  left !important;
}
.cart_drawer_upsell_products .bl-cdr-price-highlight {
  color:       var(--bl-cdr-accent) !important;
  font-weight: 800 !important;
  font-size:   1.4rem !important;
}
.cart_drawer_upsell_products .product_card_price_inner .cap {
  color:       var(--bl-cdr-muted) !important;
  font-family: 'DM Sans', sans-serif !important;
}
.cart_drawer_upsell_products .badge_inner {
  background: var(--bl-cdr-item-bg) !important;
}
.cart_drawer_upsell_products .badge_inner span {
  color:       var(--bl-cdr-text) !important;
  font-family: 'DM Sans', sans-serif !important;
}
.cart_drawer_upsell_products .quick_view_inner button {
  background:  var(--bl-cdr-accent) !important;
  border-color: var(--bl-cdr-accent) !important;
  box-shadow:  none !important;
}
.cart_drawer_upsell_products .quick_view_inner button svg path {
  fill: var(--bl-cdr-cta-text) !important;
}
.cart_drawer_upsell_products .cu.swiper-button-prev,
.cart_drawer_upsell_products .cu.swiper-button-next {
  color: var(--bl-cdr-text) !important;
}

/* ── Empty cart ── */
.empty_cart_drawer {
  display:         flex !important;
  flex-direction:  column !important;
  align-items:     center !important;
  justify-content: center !important;
  text-align:      center !important;
  gap:             1.4rem !important;
  padding:         4rem 2rem !important;
  background:      var(--bl-cdr-bg) !important;
}
.empty_cart_drawer h5 {
  font-family:    'DM Sans', sans-serif !important;
  font-weight:    800 !important;
  font-size:      clamp(1.8rem, 3vw, 2.4rem) !important;
  letter-spacing: -0.02em !important;
  color:          var(--bl-cdr-text) !important;
}
.empty_cart_drawer .btn,
.empty_cart_drawer .wave-btn {
  display:         inline-flex !important;
  align-items:     center !important;
  justify-content: center !important;
  padding:         1rem 2.4rem !important;
  background:      var(--bl-cdr-accent) !important;
  border:          none !important;
  border-radius:   9px !important;
  color:           var(--bl-cdr-cta-text) !important;
  font-family:     'DM Sans', sans-serif !important;
  font-weight:     700 !important;
  font-size:       clamp(1.3rem, 1.5vw, 1.5rem) !important;
  text-decoration: none !important;
  cursor:          pointer !important;
  transition:      opacity 0.22s ease, transform 0.22s ease !important;
}
.empty_cart_drawer .btn:hover { opacity: 0.88 !important; transform: translateY(-2px) !important; }
.empty_cart_drawer .wave-btn .wave { display: none !important; }

/* ── Footer — note, discount, subtotal, buttons ── */
.cart_drawer_items_footer {
  padding:        1.2rem 1.4rem 1.6rem !important;
  border-top:     1px solid var(--bl-cdr-border) !important;
  background:     var(--bl-cdr-bg) !important;
  display:        flex !important;
  flex-direction: column !important;
  gap:            0.8rem !important;
  flex-shrink:    0 !important;
}

/* Note + discount accordions */
.cart_drawer_cart_note_wrapper,
.cart_drawer_discount_wrapper,
.cart_drawer_discount_inner {
  background:    var(--bl-cdr-item-bg) !important;
  border:        1px solid var(--bl-cdr-border) !important;
  border-radius: 8px !important;
  overflow:      hidden !important;
}

/* Summary trigger row (inside <details>) */
.cart_drawer_note,
.cart_drawer_discount_trigger {
  display:         flex !important;
  align-items:     center !important;
  justify-content: space-between !important;
  padding:         1rem 1.2rem !important;
  cursor:          pointer !important;
  user-select:     none !important;
}
.cart_drawer_cart_note_wrapper details > summary,
.cart_drawer_discount_inner details > summary { list-style: none !important; }
.cart_drawer_cart_note_wrapper details > summary::-webkit-details-marker,
.cart_drawer_discount_inner details > summary::-webkit-details-marker { display: none !important; }

.cart_drawer_note .cart_note_trigger,
.cart_drawer_note .cart_add_note,
.cart_drawer_note .cart_edit_note,
.cart_drawer_discount_trigger p {
  font-family: 'DM Sans', sans-serif !important;
  font-size:   clamp(1.2rem, 1.4vw, 1.4rem) !important;
  font-weight: 600 !important;
  color:       var(--bl-cdr-text) !important;
  margin:      0 !important;
  transition:  color 0.2s ease !important;
}
.cart_drawer_cart_note_wrapper details > summary:hover .cart_note_trigger,
.cart_drawer_discount_inner details > summary:hover p { color: var(--bl-cdr-accent) !important; }

/* "add cart note" / "edit cart note" copy comes from the theme's
   locale file lowercase — capitalize each word purely for display. */
.cart_add_note,
.cart_edit_note {
  text-transform: capitalize !important;
}

/* + icon in accordion */
.cart_drawer_note > span svg,
.cart_drawer_note > span .icon_wrapper svg,
.cart_drawer_discount_trigger > span svg,
.cart_drawer_discount_trigger > span .icon_wrapper svg {
  width:      1.4rem !important;
  height:     1.4rem !important;
  color:      var(--bl-cdr-muted) !important;
  stroke:     currentColor !important;
  flex-shrink: 0 !important;
  transition: transform 0.3s ease, color 0.2s ease !important;
}
details[open] .cart_drawer_note > span svg,
details[open] .cart_drawer_discount_trigger > span svg {
  transform: rotate(45deg) !important;
  color:     var(--bl-cdr-accent) !important;
}

/* Note textarea */
.cart_note_wrapper { background: var(--bl-cdr-item-bg) !important; }
.cart_note_inner { padding: 0 1.2rem 1.2rem !important; }
.cart_note_inner textarea {
  width:       100% !important;
  min-height:  7rem !important;
  padding:     0.9rem 1rem !important;
  background:  var(--bl-cdr-inp-bg) !important;
  border:      1px solid var(--bl-cdr-border) !important;
  border-radius: 6px !important;
  color:       var(--bl-cdr-text) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size:   clamp(1.2rem, 1.4vw, 1.3rem) !important;
  resize:      vertical !important;
  outline:     none !important;
  transition:  border-color 0.22s ease !important;
}
.cart_note_inner textarea:focus { border-color: var(--bl-cdr-accent) !important; }
.cart_note_inner textarea::placeholder { color: var(--bl-cdr-muted) !important; }

/* Discount content
   Every selector here is prefixed with the #cart_drawer id to out-
   specificity Evolve's own cart-drawer.css — without it, some of these
   rules (input border-radius/border, button layout) were losing that
   fight, which is what produced the oversized pill radius, the stray
   double-border artifacts, and the input/button misalignment. */
#cart_drawer .cart_drawer_discount_content { padding: 0 1.2rem 1.2rem !important; background: var(--bl-cdr-item-bg) !important; }

/* Input + Apply button sit in one row, vertically centered. */
#cart_drawer #cart_discount_form {
  display:     flex !important;
  align-items: center !important;
  gap:         0.7rem !important;
}
#cart_drawer #cart_discount_form .input_wrapper {
  position: relative !important;
  flex:     1 1 auto !important;
  min-width: 0 !important;
  margin:   0 !important;
}
#cart_drawer .cart_drawer_discount_content input[name="discount"] {
  -webkit-appearance: none !important;
  appearance:  none !important;
  box-shadow:  none !important;
  width:       100% !important;
  height:      4.4rem !important;
  padding:     0 1rem !important;
  background:  var(--bl-cdr-inp-bg) !important;
  border:      1px solid var(--bl-cdr-border) !important;
  border-radius: 8px !important;
  color:       var(--bl-cdr-text) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size:   clamp(1.2rem, 1.4vw, 1.3rem) !important;
  outline:     none !important;
  transition:  border-color 0.22s ease !important;
}
#cart_drawer .cart_drawer_discount_content input[name="discount"]:focus { border-color: var(--bl-cdr-accent) !important; }
#cart_drawer .cart_drawer_discount_content input[name="discount"]::placeholder { color: var(--bl-cdr-muted) !important; }
/* This label duplicates the input's own placeholder text 1:1 and its
   floating-notch position was clashing with Evolve's base styling,
   overlapping the typed value instead of floating above the border.
   Visually hidden (kept in the DOM for screen readers) so the field
   looks like a normal input — same as the cart note textarea. */
.cart_drawer_discount_content label {
  position:  absolute !important;
  width:     1px !important;
  height:    1px !important;
  padding:   0 !important;
  margin:    -1px !important;
  overflow:  hidden !important;
  clip:      rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border:    0 !important;
  background: transparent !important;
  transform: none !important;
}
#cart_drawer .cart_drawer_discount_content_btn {
  flex:      0 0 auto !important;
  margin:    0 !important;
}
#cart_drawer .cart_drawer_discount_content_btn .btn {
  width:       auto !important;
  height:      4.4rem !important;
  padding:     0 1.4rem !important;
  background:  transparent !important;
  border:      1px solid var(--bl-cdr-accent) !important;
  border-radius: 8px !important;
  color:       var(--bl-cdr-accent) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size:   clamp(1.2rem, 1.4vw, 1.3rem) !important;
  font-weight: 600 !important;
  cursor:      pointer !important;
  text-align:  center !important;
  text-decoration: none !important;
  display:     inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  white-space: nowrap !important;
  transition:  background 0.22s ease !important;
}
#cart_drawer .cart_drawer_discount_content_btn .btn:hover { background: rgba(7,209,110,0.10) !important; }

/* Applied discount tags */
.cart_applied_discount {
  display:       inline-flex !important;
  align-items:   center !important;
  gap:           0.5rem !important;
  margin-top:    0.6rem !important;
  font-size:     1.2rem !important;
  font-weight:   600 !important;
  color:         var(--bl-cdr-accent) !important;
  background:    rgba(7,209,110,0.08) !important;
  border:        1px solid rgba(7,209,110,0.25) !important;
  border-radius: 6px !important;
  padding:       0.3rem 0.9rem !important;
}
.cart_applied_discount .discount_icon svg { color: var(--bl-cdr-accent) !important; fill: var(--bl-cdr-accent) !important; width: 1.2rem !important; height: 1.2rem !important; }
.cart_discount_remove_btn { background: transparent !important; border: none !important; color: inherit !important; cursor: pointer !important; display: inline-flex !important; align-items: center !important; }
.cart_discount_remove_btn svg,
.cart_discount_remove_btn .icon_wrapper svg { width: 1.1rem !important; height: 1.1rem !important; fill: currentColor !important; }
.cart_discount_error { font-size: 1.1rem !important; color: #ff6b6b !important; }

/* Cart-level discounts */
.drawer_cart_level_discount_wrapper { display: flex !important; flex-direction: column !important; gap: 0.4rem !important; }
.drawer_cart_level_discount { display: flex !important; align-items: center !important; gap: 0.5rem !important; font-size: 1.2rem !important; color: var(--bl-cdr-accent) !important; overflow-wrap: break-word !important; }
.drawer_cart_level_discount svg,
.drawer_cart_level_discount .icon_wrapper svg { width: 1.3rem !important; height: 1.3rem !important; fill: var(--bl-cdr-accent) !important; flex-shrink: 0 !important; }
.drawer_cart_level_discount p { margin: 0 !important; }

/* ── Subtotal row ── */
.cart_drawer_items_subtotals {
  display:         flex !important;
  align-items:     center !important;
  justify-content: space-between !important;
  gap:             1rem !important;
  padding:         0.8rem 0 !important;
  border-top:      1px solid var(--bl-cdr-border) !important;
}
.cart_drawer_items_subtotals p { font-family: 'DM Sans', sans-serif !important; margin: 0 !important; }
.cart_drawer_items_subtotals .item_subtotal { font-size: clamp(1.2rem,1.4vw,1.4rem) !important; color: var(--bl-cdr-muted) !important; font-weight: 500 !important; }
.cart_drawer_items_subtotals p:last-child {
  font-family: 'DM Sans', sans-serif !important;
  font-weight: 800 !important;
  font-size:   clamp(1.6rem, 2vw, 2rem) !important;
  color:       var(--bl-cdr-accent) !important;
  white-space: nowrap !important;
}

/* Tax info */
.cart_items_tax_info { font-size: clamp(1rem,1.1vw,1.2rem) !important; color: var(--bl-cdr-muted) !important; line-height: 1.5 !important; overflow-wrap: break-word !important; }
.cart_items_tax_info a { color: var(--bl-cdr-accent) !important; }

/* ── Checkout + View Cart buttons ── */
.cart_drawer_items_btns {
  display:        flex !important;
  flex-direction: column !important;
  gap:            0.7rem !important;
}

/* View cart — outline style (first link) */
.cart_drawer_items_btns > a:first-of-type,
.cart_drawer_items_btns magnetic-button:first-of-type a,
.cart_drawer_items_btns magnetic-button:first-of-type .btn {
  display:         flex !important;
  align-items:     center !important;
  justify-content: center !important;
  padding:         1rem 2rem !important;
  background:      transparent !important;
  border:          1px solid var(--bl-cdr-border) !important;
  border-radius:   9px !important;
  color:           var(--bl-cdr-text) !important;
  font-family:     'DM Sans', sans-serif !important;
  font-size:       clamp(1.2rem, 1.4vw, 1.4rem) !important;
  font-weight:     500 !important;
  text-decoration: none !important;
  cursor:          pointer !important;
  transition:      border-color 0.22s ease, color 0.22s ease !important;
}
.cart_drawer_items_btns > a:first-of-type:hover,
.cart_drawer_items_btns magnetic-button:first-of-type a:hover,
.cart_drawer_items_btns magnetic-button:first-of-type .btn:hover {
  border-color: var(--bl-cdr-accent) !important;
  color:        var(--bl-cdr-accent) !important;
}

/* Checkout — green filled (second link / btn-secondary) */
.cart_drawer_items_btns .btn-secondary,
.cart_drawer_items_btns > a:last-of-type,
.cart_drawer_items_btns magnetic-button:last-of-type a,
.cart_drawer_items_btns magnetic-button:last-of-type .btn {
  display:         flex !important;
  align-items:     center !important;
  justify-content: center !important;
  padding:         1.3rem 2rem !important;
  background:      var(--bl-cdr-accent) !important;
  border:          none !important;
  border-radius:   9px !important;
  color:           var(--bl-cdr-cta-text) !important;
  font-family:     'DM Sans', sans-serif !important;
  font-weight:     700 !important;
  font-size:       clamp(1.3rem, 1.5vw, 1.5rem) !important;
  letter-spacing:  0.01em !important;
  text-decoration: none !important;
  cursor:          pointer !important;
  position:        relative !important;
  overflow:        hidden !important;
  box-shadow:      none !important;
  transition:      opacity 0.22s ease, transform 0.22s ease, filter 0.22s ease !important;
}
.cart_drawer_items_btns .btn-secondary:hover,
.cart_drawer_items_btns > a:last-of-type:hover,
.cart_drawer_items_btns magnetic-button:last-of-type a:hover {
  opacity:    0.92 !important;
  transform:  translateY(-2px) !important;
  filter:     brightness(1.06) !important;
  box-shadow: none !important;
}

/* wave-btn: hide the wave decoration, show span text */
.cart_drawer_items_btns .wave-btn .wave { display: none !important; }
.cart_drawer_items_btns .wave-btn span  { display: block !important; }

/* ── Responsive ── */
@media (max-width: 480px) {
  .cart_drawer_inner { width: 100vw !important; }
  .cart_drawer_item  { grid-template-columns: 5.5rem 1fr !important; padding: 1rem !important; }
  .cart_drawer__item_img { width: 5.5rem !important; height: 5.5rem !important; }
}

@media (prefers-reduced-motion: reduce) {
  .cart_drawer__item_img img { transition: none !important; }
}
</style>

<cart-contents>
  <div
    class="drawer-wrapper cart_drawer_wrapper color_scheme color-{{ settings.color_scheme_drawer }}"
    id="cart_drawer"
    inert
    aria-hidden="true"
  >
    <div class="drawer-wrapper_inner cart_drawer_inner" tabindex="-1" data-lenis-prevent>
      <div class="cart_drawer_header">
        <h4>{{ 'drawers.cart_drawer.heading' | t }} ({{ cart.item_count }})</h4>

        <button
          class="drawer-wrapper__close localization_drawer_close drawer_close_btn"
          aria-label="{{ 'accessibility.close' | t }}"
          type="button"
        >
          <div class="icon_wrapper">
            {{ 'icon-close.svg' | inline_asset_content }}
          </div>
        </button>
      </div>

      <div class="cart_drawer_content_wrapper">
        {% if cart == empty %}
          <div class="empty_cart_drawer">
            <h5>{{ 'drawers.cart_drawer.empty_heading' | t }}</h5>
            <a
              class="btn {% if settings.button_style == 'wave' %}wave-btn{% endif %}"
              href="{{ routes.all_products_collection_url }}"
              aria-label="{{ 'general.continue_shopping' | t }}"
            >
              {% if settings.button_style == 'wave' %}
                <span>{{- 'general.continue_shopping' | t -}}</span>
                <div class="wave"></div>
              {% else %}
                {{- 'general.continue_shopping' | t -}}
              {% endif %}
            </a>
          </div>
        {% endif %}

        {% if cart != empty %}
          <div method="post" action="{{ routes.cart_url }}" id="cart_drawer_form">
            <div class="cart_drawer_content" tabindex="-1">
              {% for item in cart.items %}
                <div class="cart_drawer_item{% if item.parent_relationship.parent != null %} nested_cart_item{% endif %}"
                  data-parent-key="{{ item.parent_relationship.parent.key }}">

                  <div class="cart_drawer__item_img">
                    <a href="{{ item.url }}" aria-label="{{ item.title }}">
                      {% if item.image != blank %}
                        {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy' }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder_svg' }}
                      {% endif %}
                    </a>
                  </div>

                  <div class="cart_drawer_item_info">
                    <p class="item_title">
                      <a href="{{ item.url }}" aria-label="{{ item.title }}">{{ item.product.title }}</a>
                    </p>

                    <p class="item_price_wrapper">
                      {% if item.original_line_price != item.final_line_price %}
                        <span>{{ item.final_line_price | money }}</span>
                        <s>{{ item.original_line_price | money }}</s>
                        <span class="item_price_discount_list">
                          {%- for discount in item.line_level_discount_allocations -%}
                            <span class="item_price_discount">
                              {{ discount.discount_application.title }}
                              {{ 'icon-discount.svg' | inline_asset_content }}
                            </span>
                          {%- endfor -%}
                        </span>
                      {% else %}
                        {{ item.final_line_price | money }}
                        {% if item.variant.compare_at_price != blank
                          and item.variant.compare_at_price > 0
                          and item.variant.compare_at_price > item.variant.price %}
                          <s>{{ item.variant.compare_at_price | times: item.quantity | money }}</s>
                        {% endif %}
                      {% endif %}
                    </p>

                    {%- if item.variant.available and item.unit_price_measurement -%}
                      <p class="item__unit_price">
                        <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                        {{ item.unit_price | money }}
                        <span aria-hidden="true">/</span>
                        <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
                        {%- if item.unit_price_measurement.reference_value != 1 -%}
                          {{- item.unit_price_measurement.reference_value -}}
                        {%- endif -%}
                        {{ item.unit_price_measurement.reference_unit }}
                      </p>
                    {%- endif -%}

                    <div class="item_options_wrapper">
                      {% unless item.product.has_only_default_variant %}
                        <p class="item_product_options">
                          {% for option in item.options_with_values %}
                            <span>{{- option.name | append: ': ' -}}{{- option.value -}}</span>
                          {% endfor %}
                        </p>
                      {% endunless %}

                      {% if item.properties.size != 0 %}
                        {%- for property in item.properties -%}
                          {%- assign property_first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and property_first_char != '_' -%}
                            <div class="item_properties_wrapper">
                              <div class="item_property_name">{{ property.first }}:</div>
                              <div class="item_property_value">
                                {%- if property.last contains '/uploads/' -%}
                                  <a href="{{ property.last }}" class="link" target="_blank" aria-describedby="a11y-new-window-message">
                                    {{ property.last | split: '/' | last }}
                                  </a>
                                {%- else -%}
                                  {{ property.last }}
                                {%- endif -%}
                              </div>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                        {% if item.selling_plan_allocation != null %}
                          <p class="item_selling_plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                        {% endif %}
                      {% endif %}
                    </div>

                    <div class="item_quantity_wrapper">
                      <item-quantity data-line="{{ forloop.index }}">
                        <button
                          type="button"
                          class="btn_minus"
                          data-minus
                          aria-label="{{ 'Decrease button' }}"
                          data-quantity="{{ item.quantity | minus: 1 }}"
                          data-min="{{ item.quantity }} - {{ item.variant.quantity_rule.min }}"
                          {% if item.quantity == item.variant.quantity_rule.min %}disabled{% endif %}
                        >
                          {{ 'icon-minus.svg' | inline_asset_content }}
                        </button>

                        <input
                          type="text"
                          name="quantity"
                          min="{{ item.variant.quantity_rule.min }}"
                          data-min="{{ item.variant.quantity_rule.min }}"
                          {% if item.variant.quantity_rule.max %}
                            data-max="{{ item.variant.quantity_rule.max }}"
                            max="{{ item.variant.quantity_rule.max }}"
                          {% endif %}
                          step="{{ item.variant.quantity_rule.increment }}"
                          value="{{ item.quantity }}"
                          id="Item_quantity-{{ forloop.index }}"
                        >
                        <label class="visually-hidden" for="Item_quantity-{{ forloop.index }}">
                          {{- 'products.product.quantity' | t -}}
                        </label>

                        <button
                          type="button"
                          aria-label="{{ 'Increase button' }}"
                          class="btn_plus"
                          data-plus
                          data-quantity="{{ item.quantity | plus: 1 }}"
                          {% if item.quantity == item.variant.quantity_rule.max %}disabled{% endif %}
                        >
                          {{ 'icon-plus.svg' | inline_asset_content }}
                        </button>
                      </item-quantity>

                      <item-remove data-line="{{ forloop.index }}">
                        <a
                          aria-label="{{- 'drawers.cart_drawer.remove' | t -}}"
                          class="item_remove_btn"
                          href="{{ item.url_to_remove }}"
                          data-remove
                          data-quantity="0"
                        >
                          {{ 'icon-trash.svg' | inline_asset_content }}
                        </a>
                      </item-remove>
                    </div>

                    <div class="cart_error" data-line="{{ forloop.index }}" hidden></div>
                  </div>
                </div>
              {% endfor %}
            </div>

            {% if settings.show_cart_upsell %}
              {% if cart.item_count > 0 %}
                <div class="cart_drawer_upsell_wrapper">
                  {% if settings.cart_upsell_head != blank %}
                    <div class="cart_drawer_upsell_head">
                      <h2 class="h4">{{ settings.cart_upsell_head }}</h2>
                    </div>
                  {% endif %}
                  <div class="cart_drawer_upsell_products"></div>
                </div>
              {% endif %}
            {% endif %}

            <div class="cart_drawer_items_footer">
              {% if settings.show_cart_note %}
                <div class="cart_drawer_cart_note_wrapper">
                  <cart-note>
                    <details>
                      <summary>
                        <div class="cart_drawer_note">
                          <p class="cart_note_trigger">
                            <span class="cart_add_note">{{ 'sections.cart.cart_note_header' | t }}</span>
                            <span class="cart_edit_note">{{ 'sections.cart.cart_note_edit_header' | t }}</span>
                          </p>
                          <span>{{ 'icon-plus.svg' | inline_asset_content }}</span>
                        </div>
                      </summary>
                      <div class="cart_note_wrapper">
                        <div class="cart_note_inner">
                          <textarea
                            name="note"
                            form="cart"
                            id="cart_note-{{ section.id }}"
                            width="100%"
                            rows="6"
                            placeholder="{{ 'sections.cart.cart_note' | t }}"
                          >{{ cart.note }}</textarea>
                        </div>
                      </div>
                    </details>
                  </cart-note>
                </div>
              {% endif %}

              {% if settings.show_discount %}
                <div class="cart_drawer_discount_wrapper">
                  <div class="cart_drawer_discount_inner">
                    <cart-discount>
                      <details>
                        <summary>
                          <div class="cart_drawer_discount_trigger">
                            <p>{{ 'sections.cart.main_discount_label' | t }}</p>
                            <span>{{ 'icon-plus.svg' | inline_asset_content }}</span>
                          </div>
                        </summary>
                        <div class="cart_drawer_discount_content">
                          <form method="post" action="{{ routes.cart_update_url }}" id="cart_discount_form">
                            <div class="input_wrapper">
                              <input
                                id="cart_drawer_discount_content_input"
                                type="text"
                                name="discount"
                                placeholder="{{ 'sections.cart.discount_label' | t }}"
                              >
                              <label for="cart_drawer_discount_content_input">
                                {{- 'sections.cart.discount_label' | t | append: ' *' -}}
                              </label>
                            </div>
                            <div class="cart_drawer_discount_content_btn">
                              <button class="btn" type="submit" name="cart_discount_btn">
                                {{ 'sections.cart.apply_discount' | t }}
                              </button>
                            </div>
                          </form>
                        </div>
                      </details>

                      {%- liquid
                        assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
                        for item in cart.items
                          for allocation in item.line_level_discount_allocations
                            if allocation.discount_application.type == 'discount_code'
                              assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
                            endif
                          endfor
                        endfor
                        assign discount_codes = discount_codes | uniq
                      -%}

                      {% for discount_code in discount_codes %}
                        <div class="cart_applied_discount">
                          <span class="discount_icon icon_wrapper">{{- 'icon-discount.svg' | inline_asset_content -}}</span>
                          {{ discount_code }}
                          <button class="cart_discount_remove_btn" aria-label="{{ 'Cart discount remove' }}">
                            <span data-cart-discount-remove class="icon_wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
                          </button>
                        </div>
                      {% endfor %}

                      <div class="cart_discount_error hidden">
                        <p class="small-text">{{ 'sections.cart.cart_discount_error' | t }}</p>
                      </div>
                    </cart-discount>
                  </div>
                </div>
              {% endif %}

              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <div class="drawer_cart_level_discount_wrapper" aria-label="{{ 'customer.order.discount' | t }}">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <div class="drawer_cart_level_discount">
                      {{- 'icon-discount.svg' | inline_asset_content -}}
                      <p>{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</p>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="cart_drawer_items_subtotals">
                <p class="item_subtotal">{{ 'drawers.cart_drawer.subtotal' | t }}</p>
                <p>{{ cart.total_price | money }}</p>
              </div>

              {% if settings.show_tax_info %}
                <span class="cart_items_tax_info">
                  Taxes included, Free express Shipping calculated at Checkout.
                </span>
              {% endif %}

              <div class="cart_drawer_items_btns">
                {% if settings.enable_magnet %}<magnetic-button data-radius="200">{% endif %}
                <a href="{{ routes.cart_url }}" aria-label="{{ 'drawers.cart_drawer.view_cart' | t }}" class="btn {% if settings.button_style == 'wave' %}wave-btn{% endif %}">
                  {% if settings.button_style == 'wave' %}<span>{% endif %}
                  {{- 'drawers.cart_drawer.view_cart' | t -}}
                  {% if settings.button_style == 'wave' %}</span><div class="wave"></div>{% endif %}
                </a>
                {% if settings.enable_magnet %}</magnetic-button>{% endif %}

                <a href="{{ routes.root_url }}checkout" aria-label="{{ 'cart.checkout' | t }}" class="btn btn-secondary">
                  {{ 'cart.checkout' | t }}
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</cart-contents>

<script>
(function () {
  'use strict';

  /* ── "You May Also Like" price display cleanup ──
     Purely cosmetic text rewriting of the recommendation prices
     rendered by snippets/product-card.liquid (which we don't have
     access to edit) — swaps the shop's "INR." money-format prefix for
     a ₹ symbol, trims a trailing ".00", and reformats every price
     (single or range) as "Starts from ₹X" with the amount highlighted.
     No cart or pricing LOGIC is touched, only how the already-rendered
     text looks.

     IMPORTANT: adding an item's quantity triggers Shopify's cart AJAX
     update, which replaces the *entire* upsell block's markup with a
     fresh, unformatted copy from the server — including swapping out
     the .cart_drawer_upsell_products element itself for a brand new
     node. A MutationObserver attached directly to that node stops
     seeing anything once it's replaced. So instead we observe the
     drawer's stable outer wrapper (#cart_drawer, which persists across
     those updates) and re-query .cart_drawer_upsell_products fresh
     every time, rather than relying on a cached reference. */
  function formatSimplePrice(text) {
    return text
      .replace(/INR\.?\s*/gi, '₹')
      .replace(/\.00(?!\d)/g, '')
      .trim();
  }

  function formatPrices() {
    var container = document.querySelector('.cart_drawer_upsell_products');
    if (!container) return;

    container.querySelectorAll('.product_card_price_inner .cap').forEach(function (el) {
      if (el.dataset.blPriceFixed) return;
      el.textContent = formatSimplePrice(el.textContent);
      el.dataset.blPriceFixed = 'true';
    });

    container.querySelectorAll('.regular_price').forEach(function (el) {
      if (el.dataset.blPriceFixed) return;
      var cleaned = formatSimplePrice(el.textContent);
      el.innerHTML = 'Starts from <span class="bl-cdr-price-highlight">' + cleaned + '</span>';
      el.dataset.blPriceFixed = 'true';
    });

    container.querySelectorAll('.product_card_price_varies').forEach(function (el) {
      if (el.dataset.blPriceFixed) return;
      var cleaned = formatSimplePrice(el.textContent);
      var match = cleaned.match(/^(₹[\d,]+)\s*[-–—]\s*₹[\d,]+$/);
      var lower = match ? match[1] : cleaned;
      el.innerHTML = 'Starts from <span class="bl-cdr-price-highlight">' + lower + '</span>';
      el.dataset.blPriceFixed = 'true';
    });
  }

  /* ── "You May Also Like" card link fix ──
     Each slide renders a bare title-only <a href> alongside the real
     visual card (image/title/price) for that same product — the CSS
     above hides that stray link on sight. But the card body itself
     was never wrapped in a link at all, so without this it's dead
     space except for that one line of text. This takes the href off
     the (now-hidden) stray anchor and makes the nearby card body
     clickable to the same URL, so the whole card navigates like a
     normal product card.

     The stray link and its card aren't reliably direct siblings (an
     earlier version assumed that and silently did nothing whenever a
     render didn't match), so instead this walks up from the stray
     link through a few ancestor levels — the same levels Swiper uses
     for one "slide" — until it finds a scope containing an <img>,
     then targets that image's nearest reasonable card wrapper. */
  function fixUpsellCardLinks() {
    var container = document.querySelector('.cart_drawer_upsell_products');
    if (!container) return;

    container.querySelectorAll('a[href]').forEach(function (a) {
      if (a.querySelector('img') || a.dataset.blHandled) return;
      a.dataset.blHandled = 'true';

      var href = a.getAttribute('href');
      var scope = a.parentElement;
      var cardBody = null;

      for (var depth = 0; depth < 4 && scope && !cardBody; depth++) {
        var img = scope.querySelector('img');
        if (img) {
          cardBody = img.closest('.product_card_wrapper') || img.parentElement;
        }
        scope = scope.parentElement;
      }

      if (cardBody && !cardBody.dataset.blLinked) {
        cardBody.dataset.blLinked = 'true';
        cardBody.style.cursor = 'pointer';
        cardBody.addEventListener('click', function (e) {
          if (e.target.closest('a, button')) return;
          window.location.href = href;
        });
      }
    });
  }

  formatPrices();
  fixUpsellCardLinks();

  var observeRoot = document.getElementById('cart_drawer') || document.body;
  new MutationObserver(function () {
    formatPrices();
    fixUpsellCardLinks();
  }).observe(observeRoot, { childList: true, subtree: true });
})();
</script>
