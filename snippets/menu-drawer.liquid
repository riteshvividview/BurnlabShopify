<menudrawer-mobile class="color_scheme color-{{ settings.color_scheme_drawer }}">
  <div
    class="drawer-wrapper mobile_drawer_wrapper {% if section.settings.border_color != blank %}border-color{% endif %}"
    inert
    aria-hidden="true"
    id="mobile_menu_drawer"
    style="--border-color: {{ section.settings.border_color }};"
  >
    <div class="drawer-wrapper_inner mobile_drawer_inner" tabindex="-1" data-lenis-prevent>
      <div class="mobile_menu_drawer_main_content">
        <div class="drawer-wrapper_header">
          {%- if section.settings.logo != blank -%}
            <div class="header_name-logo-wrapper">
              {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = section.settings.logo_size | divided_by: settings.logo.aspect_ratio -%}
              {% capture sizes %}(max-width: {{ section.settings.logo_size | times: 2 }}px) 50vw, {{ settings.logo_size }}px{% endcapture %}
              {% capture widths %}{{ section.settings.logo_size }}, {{ section.settings.logo_size | times: 2.5 | round }}, {{ section.settings.logo_size | times: 3.5 }}{% endcapture %}
              {{
                section.settings.logo
                | image_url: width: 600
                | image_tag:
                  class: 'header_name-logo motion-reduce',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_size,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
              }}
            </div>
          {% else %}
            <span class="h2">{{ shop.name }}</span>
          {% endif %}
          <button
            id="mobile_drawer_close_btn"
            aria-label="Mobile drawer close button"
            class="drawer-wrapper__close mobile_drawer_close drawer_close_btn"
          >
            {{ 'icon-close.svg' | inline_asset_content }}
          </button>
        </div>

        <div class="mobile_menu_drawer_inner_content">
          {%- liquid
            assign categories_trigger = section.settings.categories_nav_label | downcase | strip
            assign cat_blocks = section.blocks | where: 'type', 'category_item'
            assign resources_trigger = section.settings.resources_nav_label | downcase | strip
            assign resources_menu_handle = section.settings.resources_menu
          -%}
          <ul class="mob_parent_wrapper">
            {% for link in menu.links %}
              {%- assign link_lower = link.title | downcase | strip -%}
              {% if link_lower == categories_trigger and cat_blocks.size > 0 %}
                {%- liquid
                  assign mobile_cat_visible_count = 0
                  for block in cat_blocks
                    if block.settings.show_on_mobile
                      assign mobile_cat_visible_count = mobile_cat_visible_count | plus: 1
                    endif
                  endfor
                -%}
                {%- if mobile_cat_visible_count > 0 -%}
                  <li class="mob_parent_li mob_cat_widget_li">
                    <div class="mob_cat_widget" data-cat-widget>

                      <div class="mob_cat_rail" role="tablist">
                        {%- assign cat_rail_rendered = false -%}
                        {%- for block in cat_blocks -%}
                          {%- unless block.settings.show_on_mobile -%}
                            {%- continue -%}
                          {%- endunless -%}
                          <button
                            type="button"
                            class="mob_cat_tab{% unless cat_rail_rendered %} is-active{% endunless %}"
                            data-cat-tab
                            data-cat-target="mob_cat_panel_{{ section.id }}_{{ forloop.index0 }}"
                            role="tab"
                            aria-selected="{% unless cat_rail_rendered %}true{% else %}false{% endunless %}"
                            {{ block.shopify_attributes }}
                          >
                            <span class="mob_cat_tab_thumb">
                              {%- if block.settings.category_image != blank -%}
                                <img
                                  src="{{ block.settings.category_image | image_url: width: 96 }}"
                                  alt="{{ block.settings.category_name | default: '' | escape }}"
                                  loading="lazy"
                                  width="44"
                                  height="44"
                                >
                              {%- else -%}
                                <span class="mob_cat_tab_thumb_placeholder">{{ block.settings.category_name | slice: 0, 1 }}</span>
                              {%- endif -%}
                            </span>
                            <span class="mob_cat_tab_label">{{ block.settings.category_name }}</span>
                          </button>
                          {%- assign cat_rail_rendered = true -%}
                        {%- endfor -%}
                      </div>

                      <div class="mob_cat_panel_wrap">
                        {%- assign cat_panel_rendered = false -%}
                        {%- for block in cat_blocks -%}
                          {%- unless block.settings.show_on_mobile -%}
                            {%- continue -%}
                          {%- endunless -%}
                          <div
                            class="mob_cat_panel{% unless cat_panel_rendered %} is-active{% endunless %}"
                            id="mob_cat_panel_{{ section.id }}_{{ forloop.index0 }}"
                            data-cat-panel
                            role="tabpanel"
                          >
                            {%- assign main_collection = block.settings.main_collection -%}
                            {%- if main_collection != blank -%}
                              {%- assign main_collection_count = block.settings.main_collection_count | default: 8 -%}
                              {%- assign main_collection_viewmore = block.settings.main_collection_view_more -%}
                              <ul class="mob_cat_sub_product_list mob_cat_main_collection_list">
                                {%- for product in main_collection.products limit: main_collection_count -%}
                                  <li class="mob_cat_sub_product_item">
                                    <a href="{{ product.url }}" class="mob_cat_sub_product_link">
                                      <span class="mob_cat_sub_product_img">
                                        {%- if product.featured_image != blank -%}
                                          <img
                                            src="{{ product.featured_image | image_url: width: 80 }}"
                                            alt="{{ product.title | default: '' | escape }}"
                                            loading="lazy"
                                            width="36"
                                            height="36"
                                          >
                                        {%- endif -%}
                                      </span>
                                      <span class="mob_cat_sub_product_title">{{ product.title }}</span>
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                              {%- if main_collection_viewmore and main_collection.url != blank -%}
                                <a href="{{ main_collection.url }}" class="mob_cat_sub_viewmore mob_cat_main_collection_viewmore">View More</a>
                              {%- endif -%}
                            {%- else -%}
                              <ul class="mob_cat_sub_list">
                                {%- assign cat_has_sub = false -%}
                                {%- for i in (1..5) -%}
                                  {%- assign sub_name_key = 'sub_category_name_' | append: i -%}
                                  {%- assign sub_coll_key = 'sub_category_collection_' | append: i -%}
                                  {%- assign sub_count_key = 'sub_category_count_' | append: i -%}
                                  {%- assign sub_viewmore_key = 'sub_category_view_more_' | append: i -%}
                                  {%- assign sub_name = block.settings[sub_name_key] -%}
                                  {%- if sub_name != blank -%}
                                    {%- assign cat_has_sub = true -%}
                                    {%- assign sub_collection = block.settings[sub_coll_key] -%}
                                    {%- assign sub_count = block.settings[sub_count_key] | default: 4 -%}
                                    {%- assign sub_viewmore = block.settings[sub_viewmore_key] -%}
                                    {%- assign sub_panel_id = 'mob_cat_sub_products_' | append: section.id | append: '_' | append: forloop.parentloop.index0 | append: '_' | append: forloop.index0 -%}
                                    <li class="mob_cat_sub_item">
                                      <button
                                        type="button"
                                        class="mob_cat_sub_toggle"
                                        data-sub-toggle
                                        aria-expanded="false"
                                        aria-controls="{{ sub_panel_id }}"
                                      >
                                        <span>{{- sub_name -}}</span>
                                        <span class="mob_cat_sub_icon" aria-hidden="true"></span>
                                      </button>
                                      <div class="mob_cat_sub_products" id="{{ sub_panel_id }}" data-sub-products>
                                        {%- if sub_collection != blank -%}
                                          <ul class="mob_cat_sub_product_list">
                                            {%- for product in sub_collection.products limit: sub_count -%}
                                              <li class="mob_cat_sub_product_item">
                                                <a href="{{ product.url }}" class="mob_cat_sub_product_link">
                                                  <span class="mob_cat_sub_product_img">
                                                    {%- if product.featured_image != blank -%}
                                                      <img
                                                        src="{{ product.featured_image | image_url: width: 80 }}"
                                                        alt="{{ product.title | default: '' | escape }}"
                                                        loading="lazy"
                                                        width="36"
                                                        height="36"
                                                      >
                                                    {%- endif -%}
                                                  </span>
                                                  <span class="mob_cat_sub_product_title">{{ product.title }}</span>
                                                </a>
                                              </li>
                                            {%- endfor -%}
                                          </ul>
                                          {%- if sub_viewmore and sub_collection.url != blank -%}
                                            <a href="{{ sub_collection.url }}" class="mob_cat_sub_viewmore">View More</a>
                                          {%- endif -%}
                                        {%- endif -%}
                                      </div>
                                    </li>
                                  {%- endif -%}
                                {%- endfor -%}
                                {%- unless cat_has_sub -%}
                                  <li class="mob_cat_sub_item">
                                    <a class="mob_cat_sub_toggle" href="{{ block.settings.category_link | default: '#' }}" style="text-decoration:none;">
                                      <span>{{- block.settings.category_name -}}</span>
                                    </a>
                                  </li>
                                {%- endunless -%}
                              </ul>
                            {%- endif -%}
                          </div>
                          {%- assign cat_panel_rendered = true -%}
                        {%- endfor -%}
                      </div>

                    </div>
                  </li>
                {%- endif -%}
              {% elsif link_lower == resources_trigger and resources_menu_handle != blank %}
                <li class="mob_has_dropdown mob_parent_li">
                  <details>
                    <summary>
                      <a class="mob_parent_a" aria-label="{{ link.title }}" href="{{ link.url }}">{{ link.title }}</a>
                      <span>{{ 'icon-caret-down.svg' | inline_asset_content }}</span>
                    </summary>

                    <ul class="mob_child_ul">
                      {% for childlink in linklists[resources_menu_handle].links %}
                        <li class="mob_child_li">
                          <a class="mob_child_a" aria-label="{{ childlink.title }}" href="{{ childlink.url }}">
                            {{- childlink.title -}}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </details>
                </li>
              {% elsif link.links != blank %}
                <li class="mob_has_dropdown mob_parent_li">
                  <details>
                    <summary>
                      <a class="mob_parent_a" aria-label="{{ link.title }}" href="{{ link.url }}">{{ link.title }}</a>
                      <span>{{ 'icon-caret-down.svg' | inline_asset_content }}</span>
                    </summary>

                    <ul class="mob_child_ul">
                      {% for childlink in link.links %}
                        {% if childlink.links != blank %}
                          <li class="mob_child_li mob_has_child_dropdown">
                            <details>
                              <summary>
                                <a class="mob_child_a" aria-label="{{ childlink.title }}" href="{{ childlink.url }}">
                                  {{- childlink.title -}}
                                </a>
                                <span>{{ 'icon-caret-down.svg' | inline_asset_content }}</span>
                              </summary>

                              <ul class="mob_grandchild_ul">
                                {% for grandchildlink in childlink.links %}
                                  <li class="mob_grandchild_li">
                                    <a
                                      class="mob_grandchild_a"
                                      aria-label="{{ grandchildlink.title }}"
                                      href="{{ grandchildlink.url }}"
                                    >
                                      {{- grandchildlink.title -}}
                                    </a>
                                  </li>
                                {% endfor %}
                              </ul>
                            </details>
                          </li>
                        {% else %}
                          <li class="mob_child_li">
                            <a class="mob_child_a" aria-label="{{ childlink.title }}" href="{{childlink.url }}">
                              {{- childlink.title -}}
                            </a>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </details>
                </li>
              {% else %}
                <li class="mob_parent_li">
                  <a class="mob_parent_a" aria-label="{{ link.title }}" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="mobile_menu_drawer_login_link">
        <div class="mobile_menu_drawer_login_localization_wrapper">
          {% comment %} {%- if shop.customer_accounts_enabled -%}
            <a
              title="Login"
              href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
              class="mob_header_account"
              rel="nofollow"
              aria-label="Account Icon"
            >
              {%- if section.settings.enable_customer_avatar -%}
                <account-icon>
                  {%- if customer and customer.has_avatar? -%}
                    {{ customer | avatar }}
                  {%- else -%}
                    <div class="icon_wrapper">
                      {{ 'icon-account.svg' | inline_asset_content }}
                    </div>
                  {%- endif -%}
                </account-icon>
              {%- else -%}
                <div class="icon_wrapper">
                  {{ 'icon-account.svg' | inline_asset_content }}
                </div>
              {%- endif -%}
              <span class="visually-hidden">
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </span>
            </a>
          {%- endif -%} {% endcomment %}
          {% if shop.customer_accounts_enabled %}
            <div class="header_accnt header_account header_account--icon">
              <shopify-account menu="{{ section.settings.customer_account_menu }}">
                <div class="icon_wrapper">
                  {% render 'icon-account' %}
                </div>
              </shopify-account>
            </div>
          {% endif %}
          {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
            <div class="mobile_menu_drawer--localization_wrapper">
              {% if localization.available_countries.size > 0 %}
                <button
                  title="Localization button"
                  id="mobile_menu_drawer_localization_btn"
                  class="drawer_open_btn"
                  aria-label="Localization Icon"
                  data-drawer="localization_drawer"
                >
                  {{ localization.language.endonym_name }}
                  {{- localization.country.currency.iso_code }} (
                  {{- localization.country.currency.symbol -}}
                  )
                </button>
              {% endif %}

              {% if localization.available_languages.size > 0 %}
                <button
                  title="Localization button"
                  id="mobile_menu_drawer_localization_btn"
                  class="drawer_open_btn"
                  aria-label="Localization Icon"
                  data-drawer="localization_drawer"
                >
                  {{ localization.language.endonym_name }}
                </button>
              {% endif %}
            </div>
          {% endif %}
        </div>
        <div class="drawer-social-media">
          {% render 'social-media' %}
        </div>
      </div>
    </div>
  </div>
</menudrawer-mobile>

<script>
(function () {
  var widget = document.querySelector('#mobile_menu_drawer .mob_cat_widget');
  if (!widget) return;

  var tabs   = widget.querySelectorAll('[data-cat-tab]');
  var panels = widget.querySelectorAll('[data-cat-panel]');

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var targetId = tab.getAttribute('data-cat-target');

      tabs.forEach(function (t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach(function (p) { p.classList.remove('is-active'); });

      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');

      var targetPanel = document.getElementById(targetId);
      if (targetPanel) targetPanel.classList.add('is-active');
    });
  });

  /* Subcategory accordion — clicking a subcategory row expands its
     product list (fetched from the chosen collection at render time,
     already in the DOM); opening one closes any other open row within
     the same category panel. */
  var subToggles = widget.querySelectorAll('[data-sub-toggle]');

  subToggles.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      if (!panel) return;

      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      var scope  = btn.closest('.mob_cat_panel') || widget;

      scope.querySelectorAll('[data-sub-toggle]').forEach(function (other) {
        if (other === btn) return;
        other.setAttribute('aria-expanded', 'false');
        var otherPanel = document.getElementById(other.getAttribute('aria-controls'));
        if (otherPanel) otherPanel.style.maxHeight = '';
      });

      btn.setAttribute('aria-expanded', String(!isOpen));
      panel.style.maxHeight = isOpen ? '' : panel.scrollHeight + 'px';
    });
  });
})();
</script>
