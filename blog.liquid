{% comment %}
  ============================================================
  BURNLAB — BLOG PRO V3
  - True dark/light theme toggle (data-theme on <html>, matches header.liquid)
  - Redesigned featured + grid layout
  - Fully responsive: desktop / tablet / mobile / small mobile
  - Backend logic (article loop, pagination, schema ids) unchanged
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id = 'burnlab-blog-pro-' | append: section.id

  assign bg_color           = section.settings.bg_color
  assign card_bg            = section.settings.card_bg
  assign text_color         = section.settings.text_color
  assign muted_text         = section.settings.muted_text
  assign accent_color       = section.settings.accent_color
  assign border_color       = section.settings.border_color

  assign bg_color_light     = section.settings.bg_color_light
  assign card_bg_light      = section.settings.card_bg_light
  assign text_color_light   = section.settings.text_color_light
  assign muted_text_light   = section.settings.muted_text_light
  assign accent_color_light = section.settings.accent_color_light
  assign border_color_light = section.settings.border_color_light
-%}

<style>

#{{ section_id }},
#{{ section_id }} *{
  box-sizing:border-box;
}

/* =========================================================
   ROOT
========================================================= */

#{{ section_id }}{
  --bl-radius: {{ section.settings.card_radius }}px;

  position:relative;
  overflow:hidden;

  padding-top:{{ section.settings.top_spacing }}px;
  padding-bottom:{{ section.settings.bottom_spacing }}px;

  background:var(--bl-mode-bg);
  color:var(--bl-mode-text);

  font-family:var(--bl-font-secondary, 'DM Sans', sans-serif);

  transition:background .35s ease, color .35s ease;
}

/* =========================================================
   THEME SUPPORT — mirrors header.liquid's data-theme pattern
========================================================= */

[data-theme="dark"] #{{ section_id }}{
  --bl-mode-bg:      {{ section.settings.bg_color }};
  --bl-mode-card:    {{ section.settings.card_bg }};
  --bl-mode-text:    {{ section.settings.text_color }};
  --bl-mode-muted:   {{ section.settings.muted_text }};
  --bl-mode-accent:  {{ section.settings.accent_color }};
  --bl-mode-border:  {{ section.settings.border_color }};
  --bl-mode-shadow:  0 10px 30px rgba(0,0,0,.28);
  --bl-mode-shadow-hover: 0 18px 50px rgba(0,0,0,.38);
  --bl-mode-grid-line: rgba(255,255,255,.025);
  --bl-mode-media-bg: #0d2032;
  --bl-mode-overlay: linear-gradient(to top, rgba(0,0,0,.6), rgba(0,0,0,.15), transparent);
}

[data-theme="light"] #{{ section_id }}{
  --bl-mode-bg:      {{ section.settings.bg_color_light }};
  --bl-mode-card:    {{ section.settings.card_bg_light }};
  --bl-mode-text:    {{ section.settings.text_color_light }};
  --bl-mode-muted:   {{ section.settings.muted_text_light }};
  --bl-mode-accent:  {{ section.settings.accent_color_light }};
  --bl-mode-border:  {{ section.settings.border_color_light }};
  --bl-mode-shadow:  0 6px 24px rgba(8,28,45,.08);
  --bl-mode-shadow-hover: 0 16px 42px rgba(8,28,45,.14);
  --bl-mode-grid-line: rgba(8,28,45,.035);
  --bl-mode-media-bg: #e9eef2;
  --bl-mode-overlay: linear-gradient(to top, rgba(8,28,45,.32), rgba(8,28,45,.05), transparent);
}

#{{ section_id }} *{
  transition:color .35s ease, background .35s ease, border-color .35s ease;
}

/* =========================================================
   BACKGROUND GRID
========================================================= */

#{{ section_id }}::before{
  content:'';
  position:absolute;
  inset:0;

  background:
    linear-gradient(var(--bl-mode-grid-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--bl-mode-grid-line) 1px, transparent 1px);

  background-size:44px 44px;

  mask-image:radial-gradient(circle at center, black 25%, transparent 85%);
  pointer-events:none;
}

/* =========================================================
   CONTAINER
========================================================= */

#{{ section_id }} .bl-blog-container{
  position:relative;
  z-index:2;

  width:100%;
  max-width:1400px;

  margin-inline:auto;

  padding-inline:clamp(1.6rem, 4vw, 4.8rem);
}

/* =========================================================
   HEADER
========================================================= */

#{{ section_id }} .bl-blog-header{
  margin-bottom:clamp(2.4rem, 5vw, 3.8rem);
}

#{{ section_id }} .bl-blog-heading-wrap{
  max-width:820px;
}

#{{ section_id }} .bl-blog-eyebrow{
  display:inline-flex;
  align-items:center;
  gap:.7rem;

  margin-bottom:1rem;

  font-size:.82rem;
  letter-spacing:.24em;
  text-transform:uppercase;
  font-weight:700;

  color:var(--bl-mode-accent);
}

#{{ section_id }} .bl-blog-eyebrow::before{
  content:'';
  width:28px;
  height:2px;
  border-radius:100px;
  background:var(--bl-mode-accent);
}

#{{ section_id }} .bl-blog-heading{
  font-family:var(--bl-font-primary, 'Archivo Black', sans-serif);
  font-weight:400;
  font-size:clamp(2.2rem, 4.8vw, 4.6rem);
  line-height:1.02;
  letter-spacing:-0.02em;

  margin:0;

  max-width:14ch;
}

#{{ section_id }} .bl-blog-subtext{
  margin-top:1.3rem;

  font-size:1rem;
  line-height:1.75;

  color:var(--bl-mode-muted);

  max-width:62ch;
}

/* =========================================================
   TOOLBAR — search + category filter
========================================================= */

#{{ section_id }} .bl-blog-toolbar{
  display:flex;
  flex-direction:column;
  gap:1.4rem;

  margin-bottom:clamp(1.8rem, 3vw, 2.6rem);
}

#{{ section_id }} .bl-blog-search{
  position:relative;

  max-width:480px;
}

#{{ section_id }} .bl-blog-search svg{
  position:absolute;
  top:50%;
  left:1.2rem;
  transform:translateY(-50%);

  width:1.6rem;
  height:1.6rem;

  color:var(--bl-mode-muted);

  pointer-events:none;
}

#{{ section_id }} .bl-blog-search input{
  width:100%;

  padding:1.1rem 1.4rem 1.1rem 3.8rem;

  border-radius:100px;
  border:1px solid var(--bl-mode-border);
  background:var(--bl-mode-card);
  color:var(--bl-mode-text);

  font-family:inherit;
  font-size:.94rem;

  transition:border-color .25s ease, background .35s ease, color .35s ease;
}

#{{ section_id }} .bl-blog-search input::placeholder{
  color:var(--bl-mode-muted);
}

#{{ section_id }} .bl-blog-search input:focus{
  outline:none;
  border-color:var(--bl-mode-accent);
}

#{{ section_id }} .bl-blog-tags{
  display:flex;
  flex-wrap:wrap;
  gap:.7rem;
}

#{{ section_id }} .bl-blog-tag-pill{
  display:inline-flex;
  align-items:center;

  padding:.65rem 1.4rem;

  border-radius:100px;
  border:1px solid var(--bl-mode-border);
  background:var(--bl-mode-card);
  color:var(--bl-mode-muted);

  font-size:.84rem;
  font-weight:600;
  text-decoration:none;
  white-space:nowrap;

  transition:border-color .25s ease, background .25s ease, color .25s ease;
}

#{{ section_id }} .bl-blog-tag-pill:hover{
  border-color:var(--bl-mode-accent);
  color:var(--bl-mode-text);
}

#{{ section_id }} .bl-blog-tag-pill.is-active{
  border-color:var(--bl-mode-accent);
  background:var(--bl-mode-accent);
  color:#001a2e;
}

#{{ section_id }} .bl-blog-results-count{
  margin-bottom:1.6rem;

  font-size:.88rem;
  font-weight:600;
  color:var(--bl-mode-muted);
}

#{{ section_id }} .bl-blog-results-count strong{
  color:var(--bl-mode-text);
}

/* =========================================================
   GRID
========================================================= */

#{{ section_id }} .bl-blog-grid{
  display:grid;

  grid-template-columns:
    repeat({{ section.settings.columns }}, minmax(0,1fr));

  gap:clamp(1.4rem, 2vw, 2rem);
}

/* =========================================================
   FEATURED CARD — side-by-side on desktop, stacked below
========================================================= */

#{{ section_id }} .bl-blog-card.featured{
  grid-column:1 / -1;

  flex-direction:row;
}

#{{ section_id }} .bl-blog-card.featured .bl-blog-media{
  width:52%;
  aspect-ratio:auto;
  flex-shrink:0;
}

#{{ section_id }} .bl-blog-card.featured .bl-blog-content{
  padding:clamp(1.6rem, 3vw, 3rem);
  justify-content:center;
}

#{{ section_id }} .bl-blog-card.featured .bl-blog-title{
  font-size:clamp(1.6rem, 2.6vw, 2.3rem);
}

#{{ section_id }} .bl-blog-card.featured .bl-blog-excerpt{
  -webkit-line-clamp:4;
  font-size:1rem;
}

/* =========================================================
   CARD
========================================================= */

#{{ section_id }} .bl-blog-card{
  position:relative;
  display:flex;
  flex-direction:column;

  overflow:hidden;

  border-radius:var(--bl-radius);

  background:var(--bl-mode-card);
  border:1px solid var(--bl-mode-border);

  box-shadow:var(--bl-mode-shadow);

  transition:
    transform .45s cubic-bezier(.16,1,.3,1),
    box-shadow .45s ease,
    border-color .35s ease,
    background .35s ease;
}

#{{ section_id }} .bl-blog-card:hover{
  transform:translateY(-6px);

  border-color:var(--bl-mode-accent);

  box-shadow:var(--bl-mode-shadow-hover);
}

/* =========================================================
   IMAGE
========================================================= */

#{{ section_id }} .bl-blog-media{
  position:relative;

  overflow:hidden;

  aspect-ratio:16/9;

  background:var(--bl-mode-media-bg);
}

#{{ section_id }} .bl-blog-media img{
  width:100%;
  height:100%;

  display:block;

  object-fit:cover;
  object-position:center;

  transition:transform 1s cubic-bezier(.16,1,.3,1);
}

#{{ section_id }} .bl-blog-card:hover .bl-blog-media img{
  transform:scale(1.05);
}

#{{ section_id }} .bl-blog-overlay{
  position:absolute;
  inset:0;

  background:var(--bl-mode-overlay);

  pointer-events:none;
}

#{{ section_id }} .bl-blog-card-badge{
  position:absolute;
  z-index:2;
  top:1.2rem;
  left:1.2rem;

  padding:.5rem 1.1rem;

  border-radius:100px;
  background:var(--bl-mode-accent);
  color:#001a2e;

  font-size:.72rem;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.06em;
}

/* =========================================================
   CONTENT
========================================================= */

#{{ section_id }} .bl-blog-content{
  padding:1.4rem 1.4rem 1.6rem;

  display:flex;
  flex-direction:column;
  flex:1;
}

#{{ section_id }} .bl-blog-meta{
  display:flex;
  flex-wrap:wrap;
  gap:.8rem;

  margin-bottom:.8rem;

  font-size:.72rem;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.08em;

  color:var(--bl-mode-accent);
}

#{{ section_id }} .bl-blog-title{
  margin:0 0 .7rem;

  font-size:1.38rem;
  line-height:1.35;
  font-weight:700;
}

#{{ section_id }} .bl-blog-title a{
  text-decoration:none;
  color:inherit;
}

/* Stretched link — makes the whole card clickable (image, meta,
   excerpt, empty space) while keeping a single real <a>, rather than
   nesting a <a> around block content, which would be invalid HTML. */
#{{ section_id }} .bl-blog-title a.bl-blog-stretched-link::after{
  content:'';
  position:absolute;
  inset:0;
  z-index:1;
}

#{{ section_id }} .bl-blog-excerpt{
  color:var(--bl-mode-muted);

  font-size:.92rem;
  line-height:1.7;

  display:-webkit-box;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;

  overflow:hidden;
}

/* =========================================================
   BUTTON
========================================================= */

#{{ section_id }} .bl-blog-btn{
  margin-top:auto;

  padding-top:1.1rem;

  display:inline-flex;
  align-items:center;
  gap:.6rem;

  text-decoration:none;

  font-size:.9rem;
  font-weight:700;

  color:var(--bl-mode-accent);
}

#{{ section_id }} .bl-blog-btn svg{
  transition:transform .35s ease;
}

#{{ section_id }} .bl-blog-card:hover .bl-blog-btn svg{
  transform:translateX(5px);
}

/* =========================================================
   REVEAL
========================================================= */

#{{ section_id }} .bl-reveal{
  opacity:0;
  transform:translateY(32px);

  transition:
    opacity .7s cubic-bezier(.16,1,.3,1),
    transform .7s cubic-bezier(.16,1,.3,1);
}

#{{ section_id }} .bl-reveal.is-visible{
  opacity:1;
  transform:none;
}

/* =========================================================
   PAGINATION
========================================================= */

#{{ section_id }} .pagination-wrapper{
  margin-top:clamp(2.4rem, 5vw, 4rem);
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width:1100px){

  #{{ section_id }} .bl-blog-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  #{{ section_id }} .bl-blog-card.featured{
    flex-direction:column;
  }

  #{{ section_id }} .bl-blog-card.featured .bl-blog-media{
    width:100%;
    aspect-ratio:16/9;
  }

}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width:768px){

  #{{ section_id }}{
    padding-top:{{ section.settings.mob_top_spacing }}px;
    padding-bottom:{{ section.settings.mob_bottom_spacing }}px;
  }

  #{{ section_id }} .bl-blog-grid{
    grid-template-columns:
      repeat({{ section.settings.mob_columns }}, minmax(0,1fr));

    gap:1.2rem;
  }

  #{{ section_id }} .bl-blog-card.featured{
    grid-column:1 / -1;
  }

  #{{ section_id }} .bl-blog-heading{
    max-width:100%;
  }

  #{{ section_id }} .bl-blog-search{
    max-width:100%;
  }

  #{{ section_id }} .bl-blog-tags{
    flex-wrap:nowrap;
    overflow-x:auto;
    scrollbar-width:none;
    padding-bottom:.2rem;
  }

  #{{ section_id }} .bl-blog-tags::-webkit-scrollbar{
    display:none;
  }

  #{{ section_id }} .bl-blog-content{
    padding:1.1rem 1.1rem 1.3rem;
  }

}

/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width:540px){

  #{{ section_id }} .bl-blog-grid{
    grid-template-columns:1fr;
  }

}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion:reduce){

  #{{ section_id }} .bl-blog-card,
  #{{ section_id }} .bl-blog-media img,
  #{{ section_id }} .bl-reveal{
    transition:none !important;
    animation:none !important;
    transform:none !important;
  }

}

</style>

<section id="{{ section_id }}">

  <div class="bl-blog-container">

    <div class="bl-blog-header bl-reveal">

      <div class="bl-blog-heading-wrap">

        {% if section.settings.eyebrow != blank %}
          <div class="bl-blog-eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        <h1 class="bl-blog-heading">
          {{ section.settings.heading | default: blog.title }}
        </h1>

        {% if section.settings.subtext != blank %}
          <div class="bl-blog-subtext">
            {{ section.settings.subtext }}
          </div>
        {% endif %}

      </div>

    </div>

    {% if section.settings.show_search or section.settings.show_category_filter %}
      <div class="bl-blog-toolbar bl-reveal">

        {% if section.settings.show_search %}
          <div class="bl-blog-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              type="text"
              id="bl-blog-search-{{ section.id }}"
              placeholder="{{ section.settings.search_placeholder }}"
              autocomplete="off"
              aria-label="Search articles"
            >
          </div>
        {% endif %}

        {% if section.settings.show_category_filter and blog.all_tags.size > 0 %}
          <div class="bl-blog-tags" role="list">
            <a href="{{ blog.url }}" class="bl-blog-tag-pill{% if current_tags.size == 0 %} is-active{% endif %}">All</a>
            {% for tag in blog.all_tags %}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="bl-blog-tag-pill{% if current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>
            {% endfor %}
          </div>
        {% endif %}

      </div>
    {% endif %}

    {% paginate blog.articles by section.settings.limit %}

      {% if section.settings.show_results_count %}
        <div class="bl-blog-results-count bl-reveal">
          Showing <strong>{{ paginate.items }}</strong> article{% unless paginate.items == 1 %}s{% endunless %}
        </div>
      {% endif %}

      <div class="bl-blog-grid" id="bl-blog-grid-{{ section.id }}">

        {% for article in blog.articles %}

          <article class="bl-blog-card {% if forloop.first and section.settings.enable_featured %}featured{% endif %} bl-reveal" data-search-title="{{ article.title | strip_html | escape }}">

            <div class="bl-blog-media">

              {% if article.tags.size > 0 %}
                <span class="bl-blog-card-badge">{{ article.tags.first }}</span>
              {% endif %}

              {% if article.image %}
                {{
                  article.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    alt: article.title
                }}
              {% endif %}

              <div class="bl-blog-overlay"></div>

            </div>

            <div class="bl-blog-content">

              <div class="bl-blog-meta">

                {% if section.settings.show_date %}
                  <span>
                    {{ article.published_at | time_tag: format: 'date' }}
                  </span>
                {% endif %}

                {% if section.settings.show_author %}
                  <span>
                    {{ article.author }}
                  </span>
                {% endif %}

              </div>

              <h2 class="bl-blog-title">
                <a href="{{ article.url }}" class="bl-blog-stretched-link">
                  {{ article.title }}
                </a>
              </h2>

              {% if section.settings.show_content %}
                <div class="bl-blog-excerpt">
                  {{ article.excerpt | strip_html | truncate: 110 }}
                </div>
              {% endif %}

              <a href="{{ article.url }}" class="bl-blog-btn" tabindex="-1">

                {{ section.settings.button_label }}

                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M2 7H12M12 7L7 2M12 7L7 12"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"/>
                </svg>

              </a>

            </div>

          </article>

        {% endfor %}

      </div>

      {% render 'pagination', paginate: paginate %}

    {% endpaginate %}

  </div>

</section>

{% if section.settings.enable_animations %}
<script>

document.addEventListener('DOMContentLoaded', function(){

  const root = document.getElementById('{{ section_id }}');

  if(!root) return;

  const revealItems = root.querySelectorAll('.bl-reveal');

  revealItems.forEach((item, index) => {
    item.style.transitionDelay = `${index * 0.07}s`;
  });

  const observer = new IntersectionObserver((entries) => {

    entries.forEach(entry => {

      if(entry.isIntersecting){
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }

    });

  }, {
    threshold:0.12
  });

  revealItems.forEach(el => observer.observe(el));

});

</script>
{% endif %}

{% if section.settings.show_search %}
<script>

document.addEventListener('DOMContentLoaded', function(){

  const searchInput = document.getElementById('bl-blog-search-{{ section.id }}');
  const grid = document.getElementById('bl-blog-grid-{{ section.id }}');

  if(!searchInput || !grid) return;

  searchInput.addEventListener('input', function(){

    const query = searchInput.value.trim().toLowerCase();

    grid.querySelectorAll('.bl-blog-card').forEach(function(card){
      const title = (card.getAttribute('data-search-title') || '').toLowerCase();
      card.style.display = (query === '' || title.indexOf(query) !== -1) ? '' : 'none';
    });

  });

});

</script>
{% endif %}

{% schema %}
{
  "name": "Burnlab Blog Pro",
  "tag": "section",
  "class": "burnlab-blog-pro",
  "settings": [

    {
      "type": "header",
      "content": "Header"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BURNLAB JOURNAL"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Training. Recovery. Performance."
    },

    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Explore expert insights, recovery strategies, fitness guides, and equipment tips designed to elevate your training experience."
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Article"
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "limit",
      "label": "Articles Per Page",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 9
    },

    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },

    {
      "type": "select",
      "id": "mob_columns",
      "label": "Mobile Columns",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "1"
    },

    {
      "type": "checkbox",
      "id": "enable_featured",
      "label": "Enable Featured First Article",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show Excerpt",
      "default": true
    },

    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 14,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Search & Filters"
    },

    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Bar",
      "default": true
    },

    {
