      "settings": [
        {
          "type": "header",
          "content": "Dark mode images"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image (dark mode)",
          "info": "Landscape image, shown on screens wider than 768px."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image (dark mode)",
          "info": "Portrait image, shown on screens 768px and narrower. Falls back to the desktop image if left blank."
        },
        {
          "type": "header",
          "content": "Light mode images"
