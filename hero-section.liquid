{% comment %}
  ============================================================
  BURNLAB — HERO SECTION (Image Tabs)
  Pure image carousel — each tab is a block with a desktop
  (landscape) image, a mobile (portrait) image, and an optional
  link. No text/heading/CTA fields: the images themselves carry
  all messaging. Height is section-wide (desktop + mobile), so
  every tab shares the same size.
  Min Width: 300px | Supports: OS 2.0
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id = 'burnlab-hero-' | append: section.id
  assign section_height        = section.settings.section_height        | default: 700
  assign section_height_mobile = section.settings.section_height_mobile | default: 500
  assign show_arrows           = section.settings.show_carousel_arrows
  assign enable_carousel       = section.settings.enable_carousel
  assign autoplay_duration     = section.settings.carousel_autoplay_duration | default: 4
  assign carousel_effect       = section.settings.carousel_effect | default: 'fade'
-%}

<style>
  #{{ section_id }} *, #{{ section_id }} *::before, #{{ section_id }} *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  /* ── SECTION SHELL ──────────────────────────────────────── */
  #{{ section_id }} {
    position: relative;
    width: 100%;
    height: {{ section_height }}px;
    overflow: hidden;
    background: #001a2e;
    isolation: isolate;
  }
  @media (max-width: 768px) {
    #{{ section_id }} {
      height: {{ section_height_mobile }}px;
    }
  }

  /* ── ANNOUNCEMENT BAR ───────────────────────────────────── */
  #{{ section_id }} .bl-announcement-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 50;
    overflow: hidden;
    background: {{ section.settings.announcement_bg | default: '#ff4d6d' }};
    height: {{ section.settings.announcement_height | default: 38 }}px;
    display: flex;
    align-items: center;
  }
  #{{ section_id }} .bl-announcement-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: bl-marquee {{ section.settings.announcement_speed | default: 20 }}s linear infinite;
    will-change: transform;
  }
  #{{ section_id }} .bl-ann-copy {
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
  }
  #{{ section_id }} .bl-ann-item {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: {{ section.settings.announcement_text_color | default: '#ffffff' }};
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0 28px;
    white-space: nowrap;
  }
  #{{ section_id }} .bl-ann-sep {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: {{ section.settings.announcement_text_color | default: '#ffffff' }};
    opacity: 0.75;
  }
  #{{ section_id }} .bl-ann-sep svg {
    width: {{ section.settings.announcement_icon_size | default: 14 }}px;
    height: {{ section.settings.announcement_icon_size | default: 14 }}px;
    display: block;
    fill: currentColor;
  }
  @keyframes bl-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .bl-announcement-track { animation-play-state: paused; }
  }

  /* ── TAB PANELS (image slides) ──────────────────────────── */
  #{{ section_id }} .bl-tab-panels {
    position: relative;
    width: 100%;
    height: 100%;
  }
  #{{ section_id }} .bl-tab-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #{{ section_id }} .bl-tab-panel.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  {%- if carousel_effect == 'slide' -%}
  #{{ section_id }} .bl-tab-panels {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  #{{ section_id }} .bl-tab-panel {
    position: relative;
    flex: 0 0 100%;
    max-width: 100%;
    opacity: 1;
    pointer-events: none;
  }
  #{{ section_id }} .bl-tab-panel.is-active {
    pointer-events: auto;
  }
  {%- endif -%}

  #{{ section_id }} .bl-tab-link {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .bl-tab-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #{{ section_id }} .bl-tab-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: var(--bl-tab-fit-desktop, contain);
  }
  /* Tablet: 769px–1024px */
  @media (max-width: 1024px) {
    #{{ section_id }} .bl-tab-media img {
      object-fit: var(--bl-tab-fit-tablet, contain);
    }
  }
  /* Mobile: ≤768px — wins over the tablet rule above via source order */
  @media (max-width: 768px) {
    #{{ section_id }} .bl-tab-media img {
      object-fit: var(--bl-tab-fit-mobile, contain);
    }
  }

  /* ── Viewport + theme swapping ──
     Each tab carries 4 image variants (desktop/mobile × dark/light).
     Default visible: desktop + dark. Light theme swaps dark→light;
     the max-width media query swaps desktop→mobile — both combine
     correctly for all four viewport/theme pairings. */
  #{{ section_id }} .bl-tab-media { display: none; }
  #{{ section_id }} .bl-tab-media--desktop.bl-tab-media--dark { display: block; }

  [data-theme="light"] #{{ section_id }} .bl-tab-media--desktop.bl-tab-media--dark  { display: none; }
  [data-theme="light"] #{{ section_id }} .bl-tab-media--desktop.bl-tab-media--light { display: block; }

  @media (max-width: 768px) {
    #{{ section_id }} .bl-tab-media--desktop { display: none !important; }
    #{{ section_id }} .bl-tab-media--mobile.bl-tab-media--dark { display: block; }

    [data-theme="light"] #{{ section_id }} .bl-tab-media--mobile.bl-tab-media--dark  { display: none; }
    [data-theme="light"] #{{ section_id }} .bl-tab-media--mobile.bl-tab-media--light { display: block; }
  }

  /* ── CAROUSEL ARROWS (centered, pinned to edges) ────────── */
  #{{ section_id }} .bl-carousel-arrows {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(12px, 2.5vw, 28px);
    pointer-events: none;
  }
  #{{ section_id }} .bl-carousel-arrow {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(40px, 5vw, 48px);
    height: clamp(40px, 5vw, 48px);
    flex-shrink: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(234, 244, 245, 0.3);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #eaf4f5;
    cursor: pointer;
    transition: border-color 0.3s ease, box-shadow 0.3s ease,
                transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.25s ease, color 0.25s ease;
    -webkit-tap-highlight-color: transparent;
  }
  #{{ section_id }} .bl-carousel-arrow svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    pointer-events: none;
  }
  #{{ section_id }} .bl-carousel-arrow:hover {
    border-color: #07d16e;
    color: #07d16e;
    box-shadow: 0 0 0 3px rgba(7, 209, 110, 0.18), 0 6px 20px rgba(7, 209, 110, 0.16);
    transform: translateY(-2px);
  }
  #{{ section_id }} .bl-carousel-arrow:active {
    transform: translateY(0) scale(0.96);
  }
  @media (max-width: 768px) {
    #{{ section_id }} .bl-carousel-arrows { padding: 0 10px; }
  }
  @media (max-width: 480px) {
    #{{ section_id }} .bl-carousel-arrow { width: 40px; height: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .bl-tab-panel,
    #{{ section_id }} .bl-tab-panels { transition: none !important; }
  }
</style>

<section
  id="{{ section_id }}"
  class="burnlab-hero"
  data-section-id="{{ section.id }}"
  aria-label="{{ 'sections.hero.title' | t | default: 'Hero section' }}"
>

  {%- if section.settings.announcement_enabled and section.settings.announcement_text != blank -%}
  <div class="bl-announcement-bar" role="marquee" aria-label="Announcement">
    <div class="bl-announcement-track">
      <div class="bl-ann-copy">
        {%- for i in (1..10) -%}
          <span class="bl-ann-item">{{ section.settings.announcement_text }}</span>
          <span class="bl-ann-sep" aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C11 5.5 8.5 8.5 0 12C8.5 15.5 11 18.5 12 24C13 18.5 15.5 15.5 24 12C15.5 8.5 13 5.5 12 0Z"/></svg></span>
        {%- endfor -%}
      </div>
      <div class="bl-ann-copy" aria-hidden="true">
        {%- for i in (1..10) -%}
          <span class="bl-ann-item">{{ section.settings.announcement_text }}</span>
          <span class="bl-ann-sep" aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C11 5.5 8.5 8.5 0 12C8.5 15.5 11 18.5 12 24C13 18.5 15.5 15.5 24 12C15.5 8.5 13 5.5 12 0Z"/></svg></span>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  <div class="bl-tab-panels" id="bl-tab-panels-{{ section.id }}">
    {%- assign block_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}
        {%- assign block_count = block_count | plus: 1 -%}
        {%- assign desktop_dark  = block.settings.desktop_image -%}
        {%- assign mobile_dark   = block.settings.mobile_image | default: desktop_dark -%}
        {%- assign desktop_light = block.settings.desktop_image_light | default: desktop_dark -%}
        {%- assign mobile_light  = block.settings.mobile_image_light | default: desktop_light -%}
        {%- assign tab_link         = block.settings.link -%}
        {%- assign tab_fit_desktop  = block.settings.object_fit_desktop | default: 'contain' -%}
        {%- assign tab_fit_tablet   = block.settings.object_fit_tablet  | default: 'contain' -%}
        {%- assign tab_fit_mobile   = block.settings.object_fit_mobile  | default: 'contain' -%}
        {%- assign img_alt       = desktop_dark.alt | default: mobile_dark.alt | default: '' -%}

        <div
          class="bl-tab-panel{% if forloop.first %} is-active{% endif %}"
          data-tab-index="{{ forloop.index0 }}"
          style="--bl-tab-fit-desktop: {{ tab_fit_desktop }}; --bl-tab-fit-tablet: {{ tab_fit_tablet }}; --bl-tab-fit-mobile: {{ tab_fit_mobile }};"
          {{ block.shopify_attributes }}
        >
          {%- if tab_link != blank -%}<a href="{{ tab_link }}" class="bl-tab-link" aria-label="{{ img_alt | default: 'Shop now' }}">{%- endif -%}

            {%- if desktop_dark != blank -%}
              <div class="bl-tab-media bl-tab-media--desktop bl-tab-media--dark">
                {%- if forloop.first -%}
                  {{ desktop_dark | image_url: width: 2000 | image_tag:
                    loading: 'eager', fetchpriority: 'high', alt: img_alt,
                    widths: '750, 1100, 1500, 2000'
                  }}
                {%- else -%}
                  {{ desktop_dark | image_url: width: 2000 | image_tag:
                    loading: 'lazy', alt: img_alt,
                    widths: '750, 1100, 1500, 2000'
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if desktop_light != blank -%}
              <div class="bl-tab-media bl-tab-media--desktop bl-tab-media--light">
                {%- if forloop.first -%}
                  {{ desktop_light | image_url: width: 2000 | image_tag:
                    loading: 'eager', fetchpriority: 'high', alt: img_alt,
                    widths: '750, 1100, 1500, 2000'
                  }}
                {%- else -%}
                  {{ desktop_light | image_url: width: 2000 | image_tag:
                    loading: 'lazy', alt: img_alt,
                    widths: '750, 1100, 1500, 2000'
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if mobile_dark != blank -%}
              <div class="bl-tab-media bl-tab-media--mobile bl-tab-media--dark">
                {%- if forloop.first -%}
                  {{ mobile_dark | image_url: width: 1000 | image_tag:
                    loading: 'eager', fetchpriority: 'high', alt: img_alt,
                    widths: '400, 600, 800, 1000'
                  }}
                {%- else -%}
                  {{ mobile_dark | image_url: width: 1000 | image_tag:
                    loading: 'lazy', alt: img_alt,
                    widths: '400, 600, 800, 1000'
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if mobile_light != blank -%}
              <div class="bl-tab-media bl-tab-media--mobile bl-tab-media--light">
                {%- if forloop.first -%}
                  {{ mobile_light | image_url: width: 1000 | image_tag:
                    loading: 'eager', fetchpriority: 'high', alt: img_alt,
                    widths: '400, 600, 800, 1000'
                  }}
                {%- else -%}
                  {{ mobile_light | image_url: width: 1000 | image_tag:
                    loading: 'lazy', alt: img_alt,
                    widths: '400, 600, 800, 1000'
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- if tab_link != blank -%}</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if show_arrows and block_count > 1 -%}
  <div class="bl-carousel-arrows" aria-label="Hero carousel controls">
    <button class="bl-carousel-arrow bl-carousel-arrow--prev" type="button" data-carousel-prev aria-label="Previous slide">
      <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M12 7H2M2 7L6.5 2.5M2 7L6.5 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="bl-carousel-arrow bl-carousel-arrow--next" type="button" data-carousel-next aria-label="Next slide">
      <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 7H12M12 7L7.5 2.5M12 7L7.5 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  {%- endif -%}

</section>

<script>
(function () {
  'use strict';

  var root = document.getElementById('{{ section_id }}');
  if (!root) return;

  var panelsWrap = root.querySelector('.bl-tab-panels');
  var panels     = Array.prototype.slice.call(root.querySelectorAll('.bl-tab-panel'));
  var prevBtn    = root.querySelector('[data-carousel-prev]');
  var nextBtn    = root.querySelector('[data-carousel-next]');
  var total      = panels.length;
  var current    = 0;

  if (total < 2) return; /* nothing to switch between */

  var EFFECT             = '{{ carousel_effect }}';
  var ENABLE_CAROUSEL    = {{ enable_carousel }};
  var AUTOPLAY_DURATION  = {{ autoplay_duration }} * 1000;
  var reducedMotion      = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var autoplayTimer      = null;

  function switchTo(n) {
    if (n === current) return;
    current = n;

    if (EFFECT === 'slide' && panelsWrap) {
      panelsWrap.style.transform = 'translateX(-' + (current * 100) + '%)';
    }

    panels.forEach(function (p, i) {
      p.classList.toggle('is-active', i === current);
    });
  }

  function getNext(n) { return (n + 1) % total; }
  function getPrev(n) { return (n - 1 + total) % total; }

  function startAutoplay() {
    if (!ENABLE_CAROUSEL || reducedMotion || AUTOPLAY_DURATION <= 0) return;
    stopAutoplay();
    autoplayTimer = setInterval(function () {
      switchTo(getNext(current));
    }, AUTOPLAY_DURATION);
  }
  function stopAutoplay() {
    if (autoplayTimer) { clearInterval(autoplayTimer); autoplayTimer = null; }
  }
  function restartAutoplay() {
    stopAutoplay();
    startAutoplay();
  }

  if (prevBtn) prevBtn.addEventListener('click', function () {
    switchTo(getPrev(current));
    restartAutoplay();
  });
  if (nextBtn) nextBtn.addEventListener('click', function () {
    switchTo(getNext(current));
    restartAutoplay();
  });

  root.addEventListener('mouseenter', stopAutoplay);
  root.addEventListener('mouseleave', startAutoplay);
  root.addEventListener('focusin', stopAutoplay);
  root.addEventListener('focusout', startAutoplay);

  startAutoplay();

  document.addEventListener('shopify:section:unload', function (e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      stopAutoplay();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Hero (Image Tabs)",
  "tag": "section",
  "class": "burnlab-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "announcement_enabled",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free shipping on orders above ₹999",
      "info": "This text repeats and scrolls across the top of the hero."
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Background color",
      "default": "#ff4d6d"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "announcement_speed",
      "label": "Scroll speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 20,
      "info": "Seconds per full scroll cycle. Lower = faster."
    },
    {
      "type": "range",
      "id": "announcement_height",
      "label": "Bar height",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "announcement_icon_size",
      "label": "Separator icon size",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14,
      "info": "Size of the sparkle icon between each announcement text."
    },
    {
      "type": "header",
      "content": "Section Size"
    },
    {
      "type": "number",
      "id": "section_height",
      "label": "Section height — Desktop (px)",
      "default": 700,
      "info": "Applies to every tab equally."
    },
    {
      "type": "number",
      "id": "section_height_mobile",
      "label": "Section height — Mobile (px)",
      "default": 500,
      "info": "Applies to every tab equally, on screens 768px and narrower."
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "show_carousel_arrows",
      "label": "Show prev / next arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable autoplay",
      "default": true,
      "info": "Automatically advances through the tabs on a loop. Pauses on hover/focus."
    },
    {
      "type": "range",
      "id": "carousel_autoplay_duration",
      "label": "Autoplay duration",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "default": 4
    },
    {
      "type": "select",
      "id": "carousel_effect",
      "label": "Transition effect",
      "options": [
        { "value": "fade",  "label": "Fade" },
        { "value": "slide", "label": "Slide (horizontal)" }
      ],
      "default": "fade"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "header",
          "content": "Dark mode images"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image (dark mode)",
          "info": "Landscape image, shown on screens wider than 768px."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image (dark mode)",
          "info": "Portrait image, shown on screens 768px and narrower. Falls back to the desktop image if left blank."
        },
        {
          "type": "header",
          "content": "Light mode images"
        },
        {
          "type": "image_picker",
          "id": "desktop_image_light",
          "label": "Desktop image (light mode)",
          "info": "Shown instead of the dark-mode desktop image when a visitor switches the site to light mode. Falls back to the dark-mode desktop image if left blank."
        },
        {
          "type": "image_picker",
          "id": "mobile_image_light",
          "label": "Mobile image (light mode)",
          "info": "Shown instead of the dark-mode mobile image when a visitor switches the site to light mode. Falls back to the light-mode desktop image (or dark-mode mobile image) if left blank."
        },
        {
          "type": "header",
          "content": "Image Fit"
        },
        {
          "type": "select",
          "id": "object_fit_desktop",
          "label": "Image fit — Desktop",
          "options": [
            { "value": "cover",   "label": "Cover (fill, crop to edges)" },
            { "value": "contain", "label": "Contain (fit fully, no cropping)" }
          ],
          "default": "contain",
          "info": "Screens wider than 1024px."
        },
        {
          "type": "select",
          "id": "object_fit_tablet",
          "label": "Image fit — Tablet",
          "options": [
            { "value": "cover",   "label": "Cover (fill, crop to edges)" },
            { "value": "contain", "label": "Contain (fit fully, no cropping)" }
          ],
          "default": "contain",
          "info": "Screens from 769px to 1024px."
        },
        {
          "type": "select",
          "id": "object_fit_mobile",
          "label": "Image fit — Mobile",
          "options": [
            { "value": "cover",   "label": "Cover (fill, crop to edges)" },
            { "value": "contain", "label": "Contain (fit fully, no cropping)" }
          ],
          "default": "contain",
          "info": "Screens 768px and narrower."
        },
        {
          "type": "header",
          "content": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Where this tab goes when clicked — used for every image variant above. Leave blank for no link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (Image Tabs)",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
