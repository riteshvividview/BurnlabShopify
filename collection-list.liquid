{% comment %}
  ============================================================
  BURNLAB — COLLECTION LIST
  Supports: Shopify OS 2.0 | Min Width: 300px
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id      = 'burnlab-clist-' | append: section.id
  assign eyebrow         = section.settings.eyebrow       
  assign heading         = section.settings.heading        
  assign subtitle        = section.settings.subtitle       
  assign show_hdr        = section.settings.show_header
  assign hdr_align       = section.settings.header_align    | default: 'center'
  assign bg_type         = section.settings.bg_type         | default: 'pale'
  assign bg_custom       = section.settings.bg_custom       | default: '#001a2e'
  assign text_color      = section.settings.text_color      | default: '#001a2e'
  assign accent_color    = section.settings.accent_color    | default: '#07d16e'
  assign card_width_desktop = section.settings.card_width_desktop | default: 260
  assign card_width_mobile  = section.settings.card_width_mobile  | default: 160
  assign card_gap           = section.settings.card_gap           | default: 20
  assign card_radius     = section.settings.card_radius     | default: 16
  assign card_style      = section.settings.card_style      | default: 'overlay'
  assign aspect_ratio    = section.settings.aspect_ratio    | default: '3/4'
  assign overlay_opacity = section.settings.overlay_opacity | default: 75 | divided_by: 100.0
  assign overlay_color   = section.settings.overlay_color   | default: '#001a2e'
  assign img_hover       = section.settings.img_hover       | default: 'zoom'
  assign show_shop_cta   = section.settings.show_shop_cta
  assign shop_cta_label  = section.settings.shop_cta_label 
  assign enable_bg_text  = section.settings.enable_bg_text
  assign bg_text_val     = section.settings.bg_text_val  
  assign enable_grain    = section.settings.enable_grain
  assign enable_glows    = section.settings.enable_glows
  assign enable_anim     = section.settings.enable_animations
  assign heading_size    = section.settings.heading_size    | default: 48
  assign subtitle_size   = section.settings.subtitle_size   | default: 16
  assign card_title_size = section.settings.card_title_size | default: 18
  assign below_bg        = section.settings.below_bg_color  | default: '#001a2e'

  if bg_type == 'navy'
    assign resolved_bg = '#001a2e'
  elsif bg_type == 'teal'
    assign resolved_bg = '#336870'
  elsif bg_type == 'custom'
    assign resolved_bg = bg_custom
  else
    assign resolved_bg = '#eaf4f5'
  endif

  comment
    Theme-toggle colours — dark set mirrors the section's existing
    settings above (unchanged appearance in dark mode); light set is
    new and swaps in automatically via data-theme, same pattern as
    scroll-testimonial-image.liquid.
  endcomment
  assign bg_dark      = resolved_bg
  assign text_dark    = text_color
  assign accent_dark  = accent_color
  assign bg_light     = section.settings.bg_color_light     | default: '#eaf4f5'
  assign text_light   = section.settings.text_color_light   | default: '#001a2e'
  assign accent_light = section.settings.accent_color_light | default: '#07d16e'
-%}

<style>
  /* ── CSS VARIABLES ─────────────────────────────────────── */
  #{{ section_id }} {
    --bl-green:         {{ accent_color }};
    --bl-navy:          #001a2e;
    --bl-pale:          #eaf4f5;
    --bl-teal:          #336870;
    --font-primary:     'Archivo Black', sans-serif;
    --font-secondary:   'DM Sans', sans-serif;
    --ease-expo:        cubic-bezier(0.16, 1, 0.3, 1);
    --ease-back:        cubic-bezier(0.34, 1.56, 0.64, 1);
    --section-bg:       {{ bg_dark }};
    --section-text:     {{ text_dark }};
    --section-accent:   {{ accent_dark }};
    --card-min-w:       {{ card_width_desktop }}px;
    --card-gap:         {{ card_gap }}px;
    --card-radius:      {{ card_radius }}px;
    --overlay-color:    {{ overlay_color }};
    --overlay-opacity:  {{ overlay_opacity }};
    --below-bg:         {{ below_bg }};
  }

  /* ── Light theme override (CSS layer — JS inline wins) ── */
  [data-theme="light"] #{{ section_id }} {
    --section-bg:       {{ bg_light }};
    --section-text:     {{ text_light }};
    --section-accent:   {{ accent_light }};
  }

  /* ── RESET ─────────────────────────────────────────────── */
  #{{ section_id }} *, #{{ section_id }} *::before, #{{ section_id }} *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  /* ── SECTION SHELL ──────────────────────────────────────── */
  #{{ section_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--section-bg);
    color: var(--section-text);
    isolation: isolate;
  }

  /* ── GRAIN ──────────────────────────────────────────────── */
  #{{ section_id }} .clist-grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-size: 220px;
    opacity: 0.35;
    pointer-events: none;
    z-index: 2;
  }

  /* ── AMBIENT GLOWS ──────────────────────────────────────── */
  #{{ section_id }} .clist-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
    z-index: 1;
    will-change: transform;
  }
  #{{ section_id }} .clist-glow--a {
    width: clamp(180px, 35vw, 440px);
    height: clamp(180px, 35vw, 440px);
    background: var(--section-accent);
    opacity: 0.07;
    top: -8%;
    left: -4%;
    animation: clistGlowA 14s ease-in-out infinite alternate;
  }
  #{{ section_id }} .clist-glow--b {
    width: clamp(140px, 28vw, 360px);
    height: clamp(140px, 28vw, 360px);
    background: var(--bl-teal);
    opacity: 0.08;
    bottom: -4%;
    right: -2%;
    animation: clistGlowB 17s ease-in-out infinite alternate;
  }
  @keyframes clistGlowA {
    from { transform: translate(0,0) scale(1); }
    to   { transform: translate(35px,-25px) scale(1.12); }
  }
  @keyframes clistGlowB {
    from { transform: translate(0,0) scale(1); }
    to   { transform: translate(-28px,20px) scale(1.1); }
  }

  /* ── BACKGROUND WATERMARK TEXT ──────────────────────────── */
  #{{ section_id }} .clist-bg-text {
    position: absolute;
    top: 50%;
    left: 0;
    white-space: nowrap;
    font-family: var(--font-primary);
    font-weight: 400;
    font-size: clamp(6rem, 18vw, 26rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(7,209,110,0.07);
    pointer-events: none;
    user-select: none;
    z-index: 2;
    transform: translateY(-50%);
    animation: clistBgDrift 30s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes clistBgDrift {
    from { transform: translateY(-50%) translateX(0); }
    to   { transform: translateY(-50%) translateX(-8%); }
  }
  @media (max-width: 768px) {
    #{{ section_id }} .clist-bg-text { display: none; }
  }

  /* ── CONTAINER ──────────────────────────────────────────── */
  #{{ section_id }} .clist-container {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.6rem, 5vw, 8rem);
  }

  /* ── SECTION HEADER ─────────────────────────────────────── */
  #{{ section_id }} .clist-header {
    margin-bottom: clamp(2.4rem, 5vw, 4.8rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  #{{ section_id }} .clist-header[data-align="center"] {
    align-items: center;
    text-align: center;
  }
  #{{ section_id }} .clist-header[data-align="right"] {
    align-items: flex-end;
    text-align: right;
  }

  #{{ section_id }} .clist-eyebrow {
    font-family: var(--font-secondary);
    font-size: clamp(0.9rem, 1.1vw, 1.2rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--section-accent);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(0.8rem, 1.5vw, 1.2rem);
  }
  #{{ section_id }} .clist-header[data-align="center"] .clist-eyebrow { justify-content: center; }
  #{{ section_id }} .clist-header[data-align="right"]  .clist-eyebrow { justify-content: flex-end; }
  #{{ section_id }} .clist-eyebrow::before {
    content: '';
    display: inline-block;
    width: 32px;
    height: 2px;
    background: var(--section-accent);
    flex-shrink: 0;
    border-radius: 2px;
  }

  #{{ section_id }} .clist-heading {
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, {{ heading_size }}px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--section-text);
    overflow-wrap: break-word;
    word-break: break-word;
    margin-bottom: clamp(0.8rem, 1.5vw, 1.2rem);
  }

  #{{ section_id }} .clist-subtitle {
    font-family: var(--font-secondary);
    font-size: clamp(1.3rem, 1.5vw, {{ subtitle_size }}px);
    font-weight: 400;
    line-height: 1.65;
    color: var(--section-text);
    opacity: 0.68;
    max-width: 60ch;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* ── GRID ───────────────────────────────────────────────── */
  #{{ section_id }} .clist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--card-min-w), 1fr));
    gap: var(--card-gap);
    align-items: start;
  }

  /* ── CARD BASE ──────────────────────────────────────────── */
  #{{ section_id }} .clist-card {
    display: block;
    text-decoration: none;
    border-radius: var(--card-radius);
    overflow: hidden;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  /* ── IMAGE WRAPPER — in-flow, drives card height, containing block for all overlays ── */
  #{{ section_id }} .clist-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: {{ aspect_ratio }};
    overflow: hidden;
  }

  /* img fills wrapper absolutely */
  #{{ section_id }} .clist-img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.75s var(--ease-expo);
    will-change: transform;
  }

  #{{ section_id }} .clist-card:hover .clist-img,
  #{{ section_id }} .clist-card.is-active .clist-img {
    transform: scale(1.06);
  }

  /* Placeholder when no image */
  #{{ section_id }} .clist-img-placeholder {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(7,209,110,0.06);
    color: var(--section-accent);
    opacity: 0.4;
  }
  #{{ section_id }} .clist-img-placeholder svg {
    width: clamp(40px, 8vw, 64px);
    height: clamp(40px, 8vw, 64px);
  }

  /* Per-card colour tint */
  #{{ section_id }} .clist-img-tint {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    background: var(--card-tint, #001a2e);
    opacity: var(--card-tint-opacity, 0.2);
    pointer-events: none;
    z-index: 1;
  }

  /* Bottom gradient — always on so default title stays readable */
  #{{ section_id }} .clist-card-grad {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 65%;
    background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.80) 100%);
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  #{{ section_id }} .clist-card:hover .clist-card-grad,
  #{{ section_id }} .clist-card.is-active .clist-card-grad { opacity: 0; }

  /* ── BADGE ──────────────────────────────────────────────── */
  #{{ section_id }} .clist-badge {
    position: absolute;
    top: clamp(10px, 1.5vw, 16px);
    right: clamp(10px, 1.5vw, 16px);
    z-index: 10;
    padding: 5px 12px;
    border-radius: 100px;
    background: var(--section-accent);
    color: var(--bl-navy);
    font-family: var(--font-secondary);
    font-size: clamp(0.8rem, 0.9vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  #{{ section_id }} .clist-card:hover .clist-badge,
  #{{ section_id }} .clist-card.is-active .clist-badge { opacity: 0; }

  /* ── DEFAULT STATE — title pinned to bottom ───────────────── */
  #{{ section_id }} .clist-card-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 5;
    padding: clamp(1.2rem, 2vw, 2rem);
    transition: opacity 0.3s ease, transform 0.35s var(--ease-expo);
  }
  #{{ section_id }} .clist-card:hover .clist-card-bottom,
  #{{ section_id }} .clist-card.is-active .clist-card-bottom {
    opacity: 0;
    pointer-events: none;
  }
  #{{ section_id }} .clist-card-bottom-title {
    font-family: var(--font-secondary);
    font-weight: 700;
    font-size: clamp(1.3rem, 1.5vw, {{ card_title_size }}px);
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  /* ── HOVER PANEL — slides up from bottom ─────────────────── */
  #{{ section_id }} .clist-card-hover {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.2rem, 2vw, 1.8rem);
    transform: translateY(100%);
    transition: transform 0.45s var(--ease-expo);
    will-change: transform;
    overflow: hidden;
  }
  /* Panel background via ::before so content opacity is unaffected */
  #{{ section_id }} .clist-card-hover::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--hover-panel-color, #001a2e);
    opacity: var(--hover-panel-opacity, 0.92);
    z-index: -1;
  }
  #{{ section_id }} .clist-card:hover .clist-card-hover,
  #{{ section_id }} .clist-card.is-active .clist-card-hover {
    transform: translateY(0);
  }

  /* Title at top of hover panel */
  #{{ section_id }} .clist-hover-title {
    font-family: var(--font-secondary);
    font-weight: 700;
    font-size: clamp(1.3rem, 1.5vw, {{ card_title_size }}px);
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
    margin-bottom: clamp(0.5rem, 0.8vw, 0.85rem);
    flex-shrink: 0;
  }

  /* Description */
  #{{ section_id }} .clist-hover-desc {
    font-family: var(--font-secondary);
    font-size: clamp(1.1rem, 1.15vw, 1.35rem);
    font-weight: 400;
    color: rgba(234,244,245,0.72);
    line-height: 1.6;
    margin-bottom: clamp(0.8rem, 1.2vw, 1.1rem);
    flex-shrink: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA button */
  #{{ section_id }} .clist-hover-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    background: var(--section-accent);
    color: var(--bl-navy);
    border-radius: 100px;
    font-family: var(--font-secondary);
    font-size: clamp(1rem, 1.05vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    align-self: flex-start;
    margin-bottom: clamp(0.8rem, 1.2vw, 1.1rem);
    flex-shrink: 0;
    transition: transform 0.25s var(--ease-back), box-shadow 0.25s ease;
  }
  #{{ section_id }} .clist-card:hover .clist-hover-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(7,209,110,0.35);
  }
  #{{ section_id }} .clist-hover-cta svg {
    width: 11px; height: 11px; flex-shrink: 0;
  }

  /* CTA — outlined style */
  #{{ section_id }} .clist-hover-cta--outlined {
    background: transparent;
    color: #ffffff;
    border: 2px solid rgba(255,255,255,0.65);
  }
  #{{ section_id }} .clist-card:hover .clist-hover-cta--outlined:hover {
    background: rgba(255,255,255,0.1);
    border-color: #ffffff;
    box-shadow: none;
    transform: translateY(-2px);
  }

  /* CTA — underline style (like reference image) */
  #{{ section_id }} .clist-hover-cta--underline {
    background: transparent;
    color: #ffffff;
    border-radius: 0;
    padding: 3px 0;
    border-bottom: 2px solid #ffffff;
    letter-spacing: 0.08em;
    gap: 6px;
  }
  #{{ section_id }} .clist-card:hover .clist-hover-cta--underline:hover {
    transform: none;
    opacity: 0.75;
    box-shadow: none;
  }

  /* Text alignment — bottom title */
  #{{ section_id }} .clist-card-bottom--center { text-align: center; }
  #{{ section_id }} .clist-card-bottom--right  { text-align: right; }

  /* Text alignment — hover panel */
  #{{ section_id }} .clist-card-hover--center .clist-hover-title,
  #{{ section_id }} .clist-card-hover--center .clist-hover-desc {
    text-align: center;
  }
  #{{ section_id }} .clist-card-hover--center .clist-hover-cta {
    align-self: center;
  }
  #{{ section_id }} .clist-card-hover--right .clist-hover-title,
  #{{ section_id }} .clist-card-hover--right .clist-hover-desc {
    text-align: right;
  }
  #{{ section_id }} .clist-card-hover--right .clist-hover-cta {
    align-self: flex-end;
  }


  /* ── REVEAL ANIMATION (page-flip catalog feel) ──────────── */
  #{{ section_id }} .clist-reveal {
    opacity: 0;
    transform: perspective(1000px) rotateY(-15deg) translateX(-20px) scale(0.96);
    will-change: transform;
    transition: opacity 0.8s var(--ease-expo), transform 0.8s var(--ease-expo);
  }
  #{{ section_id }} .clist-reveal.is-visible {
    opacity: 1;
    transform: perspective(1000px) rotateY(0deg) translateX(0) scale(1);
  }

  /* Header elements: simple fade-up */
  #{{ section_id }} .clist-hdr-reveal {
    opacity: 0;
    transform: translateY(24px);
    will-change: transform;
    transition: opacity 0.7s var(--ease-expo), transform 0.7s var(--ease-expo);
  }
  #{{ section_id }} .clist-hdr-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Shopify editor — always visible */
  #{{ section_id }}.is-visible .clist-reveal,
  .shopify-design-mode #{{ section_id }} .clist-reveal,
  #{{ section_id }}.is-visible .clist-hdr-reveal,
  .shopify-design-mode #{{ section_id }} .clist-hdr-reveal {
    opacity: 1;
    transform: none;
  }
  /* ── REDUCED MOTION ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .clist-reveal,
    #{{ section_id }} .clist-hdr-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    #{{ section_id }} .clist-glow--a,
    #{{ section_id }} .clist-glow--b   { animation: none; }
    #{{ section_id }} .clist-bg-text   { animation: none; }
    #{{ section_id }} .clist-card      { transition: none; }
    #{{ section_id }} .clist-img       { transition: none; }
    #{{ section_id }} .clist-card--overlay .clist-cta-row {
      opacity: 1;
      transform: none;
    }
  }

  /* ── RESPONSIVE ─────────────────────────────────────────── */
  @media (max-width: 768px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
    }
    #{{ section_id }} .clist-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    #{{ section_id }} .clist-heading {
      font-size: clamp(2rem, 8vw, 3rem);
    }
    #{{ section_id }} .clist-header {
      text-align: left !important;
      align-items: flex-start !important;
    }
    #{{ section_id }} .clist-eyebrow { justify-content: flex-start !important; }
    #{{ section_id }} .clist-subtitle { text-align: left !important; }
    #{{ section_id }} .clist-card-hover {
      padding: clamp(0.85rem, 3vw, 1.2rem);
    }
    #{{ section_id }} .clist-hover-title {
      font-size: clamp(1rem, 4vw, 1.3rem);
      margin-bottom: 0.4rem;
    }
    #{{ section_id }} .clist-hover-desc {
      font-size: clamp(0.85rem, 3vw, 1rem);
      margin-bottom: 0.6rem;
      -webkit-line-clamp: 3;
    }
    #{{ section_id }} .clist-hover-cta {
      padding: 7px 14px;
      font-size: clamp(0.8rem, 3vw, 0.95rem);
      margin-bottom: 0.4rem;
    }
  }

  @media (max-width: 767px) {
    #{{ section_id }} {
      --card-min-w: {{ card_width_mobile }}px;
    }
  }

  @media (max-width: 480px) {
    #{{ section_id }} .clist-grid {
      grid-template-columns: repeat(auto-fill, minmax(var(--card-min-w), 1fr));
    }
    #{{ section_id }} .clist-heading {
      font-size: clamp(2rem, 8vw, 3rem);
    }
  }
</style>

<section
  id="{{ section_id }}"
  class="burnlab-clist"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>

  {%- if enable_grain -%}
  <div class="clist-grain" aria-hidden="true"></div>
  {%- endif -%}

  {%- if enable_glows -%}
  <div class="clist-glow clist-glow--a" aria-hidden="true"></div>
  <div class="clist-glow clist-glow--b" aria-hidden="true"></div>
  {%- endif -%}

  {%- if enable_bg_text and bg_text_val != blank -%}
  <div class="clist-bg-text" aria-hidden="true">{{ bg_text_val }}</div>
  {%- endif -%}

  <div class="clist-container">

    {%- if show_hdr -%}
    <div class="clist-header" data-align="{{ hdr_align }}">
      {%- if eyebrow != blank -%}
      <p class="clist-eyebrow clist-hdr-reveal">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
      <h2 class="clist-heading clist-hdr-reveal">{{ heading }}</h2>
      {%- endif -%}
      {%- if subtitle != blank -%}
      <p class="clist-subtitle clist-hdr-reveal">{{ subtitle }}</p>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="clist-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bk_collection = collections[block.settings.collection]

          if block.settings.custom_image != blank
            assign bk_img = block.settings.custom_image
          elsif bk_collection != blank and bk_collection.image != blank
            assign bk_img = bk_collection.image
          else
            assign bk_img = blank
          endif

          if block.settings.custom_title != blank
            assign bk_title = block.settings.custom_title
          elsif bk_collection != blank
            assign bk_title = bk_collection.title
          else
            assign bk_title = 'Collection'
          endif

          if block.settings.custom_url != blank
            assign bk_url = block.settings.custom_url
          elsif bk_collection != blank
            assign bk_url = bk_collection.url
          else
            assign bk_url = '#'
          endif

          assign bk_count = ''
          if block.settings.show_product_count and bk_collection != blank
            assign bk_count = bk_collection.all_products_count
          endif

          assign bk_badge      = block.settings.badge_text
          assign bk_desc       = block.settings.description
          assign bk_cta_label  = block.settings.cta_label
          assign bk_text_align = block.settings.hover_text_align | default: 'center'
          assign bk_cta_style  = block.settings.cta_style | default: 'filled'

          assign hp_color_raw    = block.settings.hover_panel_color | default: '#001a2e'
          assign hp_opacity_pct  = block.settings.hover_panel_opacity | default: 90
          assign hp_opacity      = hp_opacity_pct | times: 1.0 | divided_by: 100
          assign tint_pct        = block.settings.overlay_opacity | default: 20
          assign card_tint       = tint_pct | times: 1.0 | divided_by: 100
        -%}
        <a
          href="{{ bk_url }}"
          class="clist-card clist-reveal"
          data-card-index="{{ forloop.index0 }}"
          aria-label="{{ bk_title }}"
          style="--hover-panel-color: {{ hp_color_raw }}; --hover-panel-opacity: {{ hp_opacity }}; --card-tint: {{ hp_color_raw }}; --card-tint-opacity: {{ card_tint }};"
          {{ block.shopify_attributes }}
        >
          <!-- img-wrap is in-flow and sets card height via aspect-ratio.
               Everything else is absolute inside it. -->
          <div class="clist-img-wrap">
            {%- if bk_img != blank -%}
              {{ bk_img | image_url: width: 900 | image_tag:
                loading: 'lazy',
                alt: bk_img.alt | default: bk_title,
                class: 'clist-img',
                widths: '400, 600, 900',
                sizes: '(max-width: 480px) 100vw, (max-width: 1024px) 50vw, 25vw'
              }}
            {%- else -%}
              <div class="clist-img-placeholder">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect x="8" y="8" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
                  <rect x="36" y="8" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
                  <rect x="8" y="36" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
                  <rect x="36" y="36" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2"/>
                </svg>
              </div>
            {%- endif -%}
            <div class="clist-img-tint" aria-hidden="true"></div>
            <div class="clist-card-grad" aria-hidden="true"></div>
            {%- if bk_badge != blank -%}
              <span class="clist-badge">{{ bk_badge }}</span>
            {%- endif -%}

            <!-- Default state: title pinned to bottom of wrapper -->
            <div class="clist-card-bottom clist-card-bottom--{{ bk_text_align }}">
              <h3 class="clist-card-bottom-title">{{ bk_title }}</h3>
            </div>

            <!-- Hover panel: slides up from bottom inside wrapper -->
            <div class="clist-card-hover clist-card-hover--{{ bk_text_align }}" aria-hidden="true">
              <h3 class="clist-hover-title">{{ bk_title }}</h3>
              {%- if bk_desc != blank -%}
                <p class="clist-hover-desc">{{ bk_desc }}</p>
              {%- endif -%}
              {%- if bk_cta_label != blank -%}
                <span class="clist-hover-cta clist-hover-cta--{{ bk_cta_style }}">
                  {{ bk_cta_label }}
                  <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M1 6H11M11 6L6.5 1.5M11 6L6.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              {%- endif -%}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
(function () {
  var SECTION = document.getElementById('{{ section_id }}');
  if (!SECTION) return;

  /* ── Theme color maps — mirrors scroll-testimonial-image.liquid ── */
  var CLIST_DARK = {
    bg:     '{{ bg_dark }}',
    text:   '{{ text_dark }}',
    accent: '{{ accent_dark }}'
  };
  var CLIST_LIGHT = {
    bg:     '{{ bg_light }}',
    text:   '{{ text_light }}',
    accent: '{{ accent_light }}'
  };

  function applyClistTheme() {
    var isLight = document.documentElement.getAttribute('data-theme') === 'light';
    var c = isLight ? CLIST_LIGHT : CLIST_DARK;
    SECTION.style.setProperty('--section-bg', c.bg);
    SECTION.style.setProperty('--section-text', c.text);
    SECTION.style.setProperty('--section-accent', c.accent);
    SECTION.style.backgroundColor = c.bg;
    SECTION.style.color = c.text;
  }

  applyClistTheme();
  var clistThemeObs = new MutationObserver(applyClistTheme);
  clistThemeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  document.addEventListener('shopify:section:unload', function (e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      clistThemeObs.disconnect();
    }
  });
})();
</script>

<script>
(function () {
  var root = document.getElementById('{{ section_id }}');
  if (!root) return;

  var cards = root.querySelectorAll('.clist-card');

  function isMobileView() {
    return window.innerWidth <= 768 || window.matchMedia('(hover: none)').matches;
  }

  cards.forEach(function (card) {
    card.addEventListener('click', function (e) {
      if (!isMobileView()) return;

      var cta = card.querySelector('.clist-hover-cta');
      var isCtaClick = cta ? (cta === e.target || cta.contains(e.target)) : false;
      var isActive = card.classList.contains('is-active');

      if (isActive && isCtaClick) {
        return;
      }

      e.preventDefault();

      if (isActive && !isCtaClick) {
        card.classList.remove('is-active');
      } else {
        cards.forEach(function (c) {
          if (c !== card) c.classList.remove('is-active');
        });
        card.classList.add('is-active');
      }
    });
  });

  document.addEventListener('click', function (e) {
    if (!isMobileView()) return;
    if (!root.contains(e.target)) {
      cards.forEach(function (card) {
        card.classList.remove('is-active');
      });
    }
  });
})();
</script>

{% if section.settings.enable_animations %}
<script>
(function () {
  'use strict';

  var root = document.getElementById('{{ section_id }}');
  if (!root) return;

  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── 1. HEADER ELEMENTS — simple stagger fade-up ──────── */
  var hdrEls = root.querySelectorAll('.clist-hdr-reveal');
  hdrEls.forEach(function (el, i) {
    if (!reducedMotion) {
      el.style.transitionDelay = (i * 0.10) + 's';
    }
  });

  var hdrObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        hdrObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  hdrEls.forEach(function (el) { hdrObserver.observe(el); });

  /* ── 2. CARD REVEAL — page-flip catalog cascade ─────── */
  var cardEls = root.querySelectorAll('.clist-card.clist-reveal');

  if (!reducedMotion) {
    /* Apply stagger delays (per card, left-to-right in grid) */
    cardEls.forEach(function (card) {
      var idx = parseInt(card.getAttribute('data-card-index') || '0', 10);
      card.style.transitionDelay = (idx * 0.10) + 's';
    });
  }

  var cardObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        /* Remove stagger delay after reveal so hover is instant */
        entry.target.addEventListener('transitionend', function cleanup() {
          entry.target.style.transitionDelay = '';
          entry.target.removeEventListener('transitionend', cleanup);
        });
        cardObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  cardEls.forEach(function (card) { cardObserver.observe(card); });

  /* ── 4. CLEANUP on section unmount ──────────────────── */
  document.addEventListener('shopify:section:unload', function (e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      hdrObserver.disconnect();
      cardObserver.disconnect();
    }
  });

})();
</script>
{% endif %}

