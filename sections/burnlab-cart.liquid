{% style %}
  .main_cart_wrapper {
    padding-top: {{ section.settings.top_spacing }}px;
    padding-bottom: {{ section.settings.bottom_spacing }}px;
  }

  @media screen and (max-width: 640px) {
    .main_cart_wrapper {
      padding-top: {{ section.settings.mob_top_spacing }}px;
      padding-bottom: {{ section.settings.mob_bottom_spacing }}px;
    }
  }
{% endstyle %}

{{ 'cart.css' | asset_url | stylesheet_tag }}
{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}

{% style %}

  /* ═══════════════════════════════════════════════════════════════
     BURNLAB — Cart page reskin (colors / fonts / theme toggle only)
     Structure, markup and cart logic are untouched. Everything here
     overrides the theme's default color-scheme with BurnLab's own
     dark/light tokens, switched by [data-theme] on <html> — same
     mechanism used in header.liquid.

     Every override below is prefixed with `html[data-theme]` (not just
     `.main_cart_wrapper`) purely to win specificity ties against the
     theme's own cart.css selectors — without this prefix several rules
     were losing the cascade to equally-specific theme rules depending
     on stylesheet order.
     ═══════════════════════════════════════════════════════════════ */

  html[data-theme="dark"] .main_cart_wrapper {
    --bl-cart-bg:            #001a2e;
    --bl-cart-surface:       #08253f;
    --bl-cart-surface-soft:  rgba(255, 255, 255, 0.04);
    --bl-cart-text:          #eaf4f5;
    --bl-cart-muted:         rgba(234, 244, 245, 0.58);
    --bl-cart-border:        rgba(255, 255, 255, 0.10);
    --bl-cart-input-bg:      rgba(255, 255, 255, 0.05);
    --bl-cart-accent:        #07d16e;
    --bl-cart-accent-contrast: #001a2e;
    --bl-cart-danger:        #ff4d6d;
    --bl-cart-placeholder:   rgba(255, 255, 255, 0.06);
  }

  html[data-theme="light"] .main_cart_wrapper {
    --bl-cart-bg:            #f5f7fa;
    --bl-cart-surface:       #ffffff;
    --bl-cart-surface-soft:  rgba(8, 28, 45, 0.03);
    --bl-cart-text:          #081c2d;
    --bl-cart-muted:         rgba(8, 28, 45, 0.55);
    --bl-cart-border:        rgba(8, 28, 45, 0.10);
    --bl-cart-input-bg:      rgba(8, 28, 45, 0.04);
    --bl-cart-accent:        #04914f;
    --bl-cart-accent-contrast: #ffffff;
    --bl-cart-danger:        #ff4d6d;
    --bl-cart-placeholder:   rgba(8, 28, 45, 0.05);
  }

  html[data-theme] .main_cart_wrapper,
  html[data-theme] .main_cart_wrapper *:not(svg):not(path) {
    font-family: 'DM Sans', sans-serif;
    transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
  }

  html[data-theme] .main_cart_wrapper {
    background: var(--bl-cart-bg) !important;
    color: var(--bl-cart-text) !important;
  }

  /* ── Force every injected SVG icon (trash, plus, minus, close, discount,
       caret) to inherit color from its wrapping element instead of
       whatever fill/stroke shipped in the raw icon asset ── */
  html[data-theme] .main_cart_wrapper svg {
    color: inherit;
  }

  html[data-theme] .main_cart_wrapper svg path:not([fill="none"]),
  html[data-theme] .main_cart_wrapper svg circle:not([fill="none"]),
  html[data-theme] .main_cart_wrapper svg rect:not([fill="none"]),
  html[data-theme] .main_cart_wrapper svg polygon:not([fill="none"]) {
    fill: currentColor !important;
  }

  html[data-theme] .main_cart_wrapper svg path[stroke],
  html[data-theme] .main_cart_wrapper svg circle[stroke],
  html[data-theme] .main_cart_wrapper svg line[stroke],
  html[data-theme] .main_cart_wrapper svg polyline[stroke] {
    stroke: currentColor !important;
  }

  /* ── Headings / empty state ── */
  html[data-theme] .main_cart_wrapper h1,
  html[data-theme] .main_cart_wrapper h4,
  html[data-theme] .main_cart_wrapper .h6 {
    color: var(--bl-cart-text) !important;
  }

  /* Empty-cart card had the same hardcoded dark background bug as the
     header row / item rows found earlier — it never toggled with the
     theme since we'd only themed its text, not its own background. */
  html[data-theme] .main_empty_cart_wrapper {
    background: var(--bl-cart-surface-soft) !important;
  }

  html[data-theme] .main_empty_cart_wrapper p {
    color: var(--bl-cart-muted) !important;
  }

  /* ── Buttons (Continue shopping / Checkout / Calculate shipping) ── */
  html[data-theme] .main_cart_wrapper .btn {
    background: var(--bl-cart-accent) !important;
    color: var(--bl-cart-accent-contrast) !important;
    border-color: var(--bl-cart-accent) !important;
  }

  /* "Continue shopping" (wave-btn) always keeps black text regardless
     of theme — it's a fixed brand choice, not tied to the accent
     contrast variable used by Checkout/Calculate Shipping. */
  html[data-theme] .main_cart_wrapper .btn.wave-btn,
  html[data-theme] .main_cart_wrapper .btn.wave-btn span {
    color: #000000 !important;
  }

  html[data-theme] .main_cart_wrapper .btn:hover {
    filter: brightness(1.08);
  }

  /* ── Catch-all: strip any leftover hardcoded backgrounds from cart.css
       on plain structural wrappers so only our themed surfaces show ── */
  html[data-theme] .main_cart_content,
  html[data-theme] .main_cart__items_wrapper,
  html[data-theme] .main_cart__items_footer,
  html[data-theme] #cart_drawer_form {
    background: transparent !important;
  }

  /* ── Cart item rows ── */
  html[data-theme] .main_cart__item_img {
    background: var(--bl-cart-placeholder) !important;
  }

  html[data-theme] .main_cart__item_title a {
    color: var(--bl-cart-accent) !important;
  }

  html[data-theme] .main_cart__item_price_wrapper,
  html[data-theme] .main_cart__item_unit_price,
  html[data-theme] .main_cart__item_product_options,
  html[data-theme] .main_cart__item_property_name,
  html[data-theme] .main_cart__item_property_value,
  html[data-theme] .main_cart__item_selling_plan {
    color: var(--bl-cart-muted) !important;
  }

  html[data-theme] .main_cart__item_price_wrapper span:first-child {
    color: var(--bl-cart-text) !important;
  }

  html[data-theme] .main_cart__item_price_wrapper s {
    color: var(--bl-cart-muted) !important;
  }

  html[data-theme] .main_cart__item_price_discount {
    color: var(--bl-cart-accent) !important;
  }

  html[data-theme] .main_cart_item,
  html[data-theme] .nested_cart_item {
    background: var(--bl-cart-surface-soft) !important;
    border-color: var(--bl-cart-border) !important;
  }

  /* Header row ("Cart (N)" + Continue shopping) — same hardcoded dark
     card background bug as the item rows above. */
  html[data-theme] .main_cart_header {
    background: var(--bl-cart-surface-soft) !important;
    border-color: var(--bl-cart-border) !important;
  }

  /* ── Quantity stepper ── */
  html[data-theme] item-quantity,
  html[data-theme] .main_cart__item_quantity_wrapper {
    background: var(--bl-cart-surface-soft) !important;
    border-color: var(--bl-cart-border) !important;
  }

  html[data-theme] .btn_minus,
  html[data-theme] .btn_plus {
    background: transparent !important;
    color: var(--bl-cart-text) !important;
    border-color: var(--bl-cart-border) !important;
  }

  html[data-theme] .main_cart__item_quantity_wrapper input {
    background: transparent !important;
    color: var(--bl-cart-text) !important;
  }

  /* ── Remove item ── */
  html[data-theme] .item_remove_btn {
    color: var(--bl-cart-muted) !important;
  }

  html[data-theme] .item_remove_btn:hover {
    color: var(--bl-cart-danger) !important;
  }

  /* ── Cart note (closed summary bar — note the DOUBLE underscore
       `main_cart__note_wrapper` / `main_cart__note`, which is a
       different element than the single-underscore
       `main_cart_note_wrapper` used for the expanded textarea area
       below; both need covering) ── */
  html[data-theme] .main_cart__note_wrapper,
  html[data-theme] .main_cart__note {
    background: var(--bl-cart-surface-soft) !important;
    border-color: var(--bl-cart-border) !important;
  }

  html[data-theme] .main_cart_note_trigger,
  html[data-theme] .cart_add_note,
  html[data-theme] .cart_edit_note,
  html[data-theme] .cart_drawer_discount_trigger p {
    color: var(--bl-cart-text) !important;
  }

  html[data-theme] .main_cart__note,
  html[data-theme] .cart_drawer_discount_trigger,
  html[data-theme] .main_cart_note_wrapper,
  html[data-theme] .cart_drawer_discount_content {
    border-color: var(--bl-cart-border) !important;
  }

  html[data-theme] .main_cart_note_wrapper,
  html[data-theme] .main_cart_note_wrapper .main_cart_note_inner {
    background: var(--bl-cart-surface-soft) !important;
  }

  /* Only ONE of the three nested discount containers (wrapper > inner >
     content) should carry a visible background — giving all three the
     same color previously stacked 2-3 slightly-offset rounded rects on
     top of each other (since each has its own margin/padding from
     cart.css), producing a "blob peeking out" look. `.inner` is the
     actual visible card; the other two are purely structural. */
  html[data-theme] .cart_drawer_discount_wrapper,
  html[data-theme] .cart_drawer_discount_content {
    background: transparent !important;
  }

  /* The discount block has one extra nesting level compared to the note
     block (`.wrapper` > `.inner` vs. just `.wrapper`), and cart.css's
     own margin/padding on that extra level was insetting it slightly
     narrower than the note box above it. Force both to fill the full
     width of their shared parent so the two cards line up exactly. */
  html[data-theme] .main_cart__note_wrapper,
  html[data-theme] .cart_drawer_discount_wrapper {
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    box-sizing: border-box !important;
  }

  html[data-theme] .cart_drawer_discount_inner {
    background: var(--bl-cart-surface-soft) !important;
    border-radius: var(--border-radius, 10px);
    overflow: hidden;
    width: 100% !important;
    margin: 0 !important;
    box-sizing: border-box !important;
  }

  html[data-theme] .cart_drawer_discount_trigger {
    padding: 1.2rem !important;
  }

  html[data-theme] .main_cart_note_inner textarea,
  html[data-theme] #cart_drawer_discount_content_input,
  html[data-theme] #shipping-zip,
  html[data-theme] .main_cart_wrapper select {
    background: var(--bl-cart-input-bg) !important;
    color: var(--bl-cart-text) !important;
    border-color: var(--bl-cart-border) !important;
  }

  /* ── Note / discount input polish — give the fields a defined,
       consistent shape instead of blending flat into their container ── */
  html[data-theme] .main_cart_note_wrapper,
  html[data-theme] .cart_drawer_discount_content {
    padding: 1.2rem !important;
  }

  html[data-theme] .main_cart_note_inner textarea {
    display: block;
    width: 100%;
    border-width: 1px !important;
    border-style: solid !important;
    border-radius: 10px !important;
    padding: 1rem 1.2rem !important;
    resize: vertical;
  }

  html[data-theme] #cart_discount_form {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  html[data-theme] #cart_discount_form .input_wrapper {
    flex: 1 1 220px;
  }

  html[data-theme] #cart_drawer_discount_content_input {
    width: 100%;
    border-width: 1px !important;
    border-style: solid !important;
    border-radius: 999px !important;
    padding: 0.9rem 1.4rem !important;
  }

  html[data-theme] .cart_drawer_discount_content_btn .btn {
    border-radius: 999px !important;
    padding: 0.9rem 1.6rem !important;
    white-space: nowrap;
  }

  /* ── Animated open/close for the note + discount <details> accordions ──
     Native <details> snaps open/closed with no transition support, and
     its UA stylesheet hard-sets `display:none` on the content when
     closed, which can't be animated directly. This keeps the content
     always in the layout (overriding that display:none) and instead
     animates its height via a CSS grid-rows trick, so opening/closing
     is smooth without any JS or markup changes. */
  cart-note details:not([open]) > *:not(summary),
  cart-discount details:not([open]) > *:not(summary) {
    display: grid !important;
  }

  cart-note details > *:not(summary),
  cart-discount details > *:not(summary) {
    grid-template-rows: 0fr;
    overflow: hidden;
    opacity: 0;
    transition:
      grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s ease;
  }

  cart-note details[open] > *:not(summary),
  cart-discount details[open] > *:not(summary) {
    grid-template-rows: 1fr;
    opacity: 1;
    transition:
      grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s ease 0.05s;
  }

  cart-note details > *:not(summary) > *,
  cart-discount details > *:not(summary) > * {
    min-height: 0;
  }

  cart-note summary,
  cart-discount summary {
    cursor: pointer;
  }

  html[data-theme] .main_cart_note_inner textarea::placeholder,
  html[data-theme] #cart_drawer_discount_content_input::placeholder,
  html[data-theme] #shipping-zip::placeholder {
    color: var(--bl-cart-muted) !important;
  }

  html[data-theme] .cart_applied_discount {
    background: var(--bl-cart-surface-soft) !important;
    color: var(--bl-cart-text) !important;
    border-color: var(--bl-cart-border) !important;
  }

  html[data-theme] .discount_icon,
  html[data-theme] .cart_applied_discount .icon_wrapper {
    color: var(--bl-cart-accent) !important;
  }

  html[data-theme] .cart_discount_remove_btn {
    color: var(--bl-cart-muted) !important;
  }

  html[data-theme] .cart_discount_remove_btn:hover {
    color: var(--bl-cart-danger) !important;
  }

  html[data-theme] .cart_discount_error,
  html[data-theme] .main_cart_level_discount {
    color: var(--bl-cart-danger) !important;
  }

  html[data-theme] .main_cart_level_discount_wrapper {
    color: var(--bl-cart-accent) !important;
  }

  /* ── Subtotal / tax info ── */
  html[data-theme] .main_cart__items_subtotals,
  html[data-theme] .main_cart__items_subtotals p {
    color: var(--bl-cart-text) !important;
  }

  html[data-theme] .cart_items_tax_info,
  html[data-theme] .cart_items_tax_info a {
    color: var(--bl-cart-muted) !important;
  }

  /* ── Shipping calculator card ── */
  html[data-theme] .main_cart_shipping_calculator_wrapper {
    background: var(--bl-cart-surface-soft) !important;
    border: 1px solid var(--bl-cart-border) !important;
    border-radius: var(--border-radius, 10px);
    padding: clamp(1.4rem, 3vw, 2.4rem);
  }

  html[data-theme] .main_cart_shipping_calculator_wrapper .c_wrapper,
  html[data-theme] .main_cart_shipping_calculator_wrapper .c_wrapper_inner {
    background: var(--bl-cart-surface) !important;
    color: var(--bl-cart-text) !important;
  }

  html[data-theme] .main_cart_shipping_calculator_wrapper .c_wrapper {
    border-radius: var(--border-radius, 10px);
    padding: clamp(1.2rem, 2.5vw, 2rem);
    margin-top: 1.4rem;
  }

  html[data-theme] .main_cart_shipping_calculator_wrapper .c_wrapper_inner {
    gap: 1rem;
  }

  /* Country / province / zip fields — targeted individually as well as
     generically, since `.countryContainer .select` in the theme's own
     cart.css was winning the cascade over a generic `.select` rule for
     the country field specifically. */
  html[data-theme] .main_cart_shipping_calculator_wrapper .select,
  html[data-theme] .main_cart_shipping_calculator_wrapper select,
  html[data-theme] .main_cart_shipping_calculator_wrapper input,
  html[data-theme] .countryContainer,
  html[data-theme] .countryContainer .select,
  html[data-theme] #countrySelector,
  html[data-theme] #provinceContainer,
  html[data-theme] #provinceContainer .select,
  html[data-theme] #provinceSelector,
  html[data-theme] #shipping-zip {
    background: var(--bl-cart-input-bg) !important;
    border-color: var(--bl-cart-border) !important;
    color: var(--bl-cart-text) !important;
  }

  /* Best-effort styling of the native <option> list — the OS-native
     hover/selected highlight color itself cannot be overridden with
     CSS in any browser, only the base background/text can. */
  html[data-theme] .main_cart_shipping_calculator_wrapper select option {
    background: var(--bl-cart-surface) !important;
    color: var(--bl-cart-text) !important;
  }

  html[data-theme] .main_cart_shipping_calculator_wrapper input::placeholder {
    color: var(--bl-cart-muted) !important;
  }

  html[data-theme] #shipping-results .err {
    color: var(--bl-cart-danger) !important;
  }

  html[data-theme] #shipping-results .calculating,
  html[data-theme] .es_inner {
    color: var(--bl-cart-muted) !important;
  }

  html[data-theme] .es_inner span:last-child {
    color: var(--bl-cart-accent) !important;
  }

  /* ── Responsive safeguards ── */
  @media screen and (max-width: 640px) {
    html[data-theme] .main_cart_wrapper .container {
      padding-inline: clamp(1rem, 4vw, 1.6rem);
    }

    html[data-theme] .main_cart_header {
      flex-wrap: wrap;
      row-gap: 1rem;
    }

    html[data-theme] .main_cart_header h1 {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }

    html[data-theme] .main_cart_item {
      flex-wrap: wrap;
    }

    html[data-theme] .main_cart_shipping_calculator_wrapper .c_wrapper_inner {
      flex-wrap: wrap;
    }

    html[data-theme] .main_cart_shipping_calculator_wrapper .input_wrapper_select,
    html[data-theme] .main_cart_shipping_calculator_wrapper .input_wrapper {
      flex: 1 1 100%;
      min-width: 0;
    }

    html[data-theme] .main_cart_shipping_calculator_wrapper select,
    html[data-theme] .main_cart_shipping_calculator_wrapper input {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html[data-theme] .main_cart_wrapper,
    html[data-theme] .main_cart_wrapper * {
      transition: none !important;
    }
  }

{% endstyle %}

<div
  class="main_cart_wrapper color_scheme color-{{section.settings.color_scheme }}"
  style="--border-radius: {{section.settings.border_radius }}px;"
>
  <div class="container">
    <cart-contents>
      {% if cart == empty %}
        <div class="main_empty_cart_wrapper">
          <h1>{{ 'cart.title' | t }}</h1>
          <p>{{ 'sections.cart.empty_cart_heading' | t }}</p>

          {% if settings.enable_magnet %}<magnetic-button data-radius="200">{% endif %}
          <a
            class="btn {% if settings.button_style == 'wave' %}wave-btn{% endif %}"
            aria-label="{{ 'general.continue_shopping' | t }}"
            href="{{ routes.all_products_collection_url }}"
          >
            {% if settings.button_style == 'wave' %}
                <span>{{- 'general.continue_shopping' | t -}}</span>
            {% else %}
              {{- 'general.continue_shopping' | t -}}
            {% endif %}

            {% if settings.button_style == 'wave' %}
                <div class="wave"></div>
            {% endif %}
          </a>
          {% if settings.enable_magnet %}</magnetic-button>{% endif %}
        </div>
      {% endif %}

      {% if cart != empty %}
        <div class="main_cart_header">
          <h1>{{ 'cart.title' | t }} ({{ cart.item_count }})</h1>

          {% if settings.enable_magnet %}<magnetic-button data-radius="200">{% endif %}
          <a
            class="btn {% if settings.button_style == 'wave' %}wave-btn{% endif %}"
            aria-label="{{ 'general.continue_shopping' | t }}"
            href="{{ routes.all_products_collection_url }}"
          >
            {% if settings.button_style == 'wave' %}
                <span>{{- 'general.continue_shopping' | t -}}</span>
            {% else %}
              {{- 'general.continue_shopping' | t -}}
            {% endif %}

            {% if settings.button_style == 'wave' %}
                <div class="wave"></div>
            {% endif %}
          </a>
          {% if settings.enable_magnet %}</magnetic-button>{% endif %}
        </div>

        <div class="main_cart_content">
          <div id="cart_drawer_form">
            <div class="main_cart__items_wrapper">
              {% for item in cart.items %}
                <div class="main_cart_item{% if item.parent_relationship.parent != null %} nested_cart_item{% endif %}"
                  data-parent-key="{{ item.parent_relationship.parent.key }}"
                >
                  <div class="main_cart__item_img">
                    <a href="{{ item.url }}" aria-label="{{ item.title }}">
                      {% if item.image != blank %}
                        {{ item.image | image_url: width: 500 | image_tag }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder_svg' }}
                      {% endif %}
                    </a>
                  </div>

                  <div class="main_cart__item_info">
                    <div class="main_cart__item_info_title_wrapper">
                      <p class="main_cart__item_title">
                        <a href="{{ item.url }}" aria-label="{{ item.title }}">{{ item.product.title }}</a>
                      </p>

                      <p class="main_cart__item_price_wrapper">
                        {% if item.original_line_price != item.final_line_price %}
                          <span>{{ item.final_line_price | money }}</span>
                          <s>{{ item.original_line_price | money }}</s>
                          <span class="main_cart__item_price_discount_list">
                            {%- for discount in item.line_level_discount_allocations -%}
                              <span class="main_cart__item_price_discount">
                                {{ discount.discount_application.title }}
                                {{ 'icon-discount.svg' | inline_asset_content }}
                              </span>
                            {% endfor %}
                          </span>
                        {% else %}
                          {{ item.final_line_price | money }}
                          {% if item.variant.compare_at_price != blank
                            and item.variant.compare_at_price > 0
                            and item.variant.compare_at_price > item.variant.price
                          %}
                            <s>{{ item.variant.compare_at_price | times: item.quantity | money }}</s>
                          {% endif %}
                        {% endif %}
                      </p>

                      {%- if item.variant.available and item.unit_price_measurement -%}
                        <p class="main_cart__item_unit_price">
                          <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                          {{ item.unit_price | money }}
                          <span aria-hidden="true">/</span>
                          <span class="visually-hidden"
                            >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
                          >
                          {%- if item.unit_price_measurement.reference_value != 1 -%}
                            {{- item.unit_price_measurement.reference_value -}}
                          {%- endif -%}
                          {{ item.unit_price_measurement.reference_unit }}
                        </p>
                      {%- endif -%}

                      <div class="main_cart__item_options_wrapper">
                        {% unless item.product.has_only_default_variant %}
                          <p class="main_cart__item_product_options">
                            {% for option in item.options_with_values %}
                              <span>
                                {{- option.name | append: ': ' -}}
                                {{- option.value -}}
                              </span>
                            {% endfor %}
                          </p>
                        {% endunless %}

                        {% if item.properties.size != 0 %}
                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="main_cart__item_properties_wrapper">
                                <div class="main_cart__item_property_name">{{ property.first }}:</div>
                                <div class="main_cart__item_property_value">
                                  {%- if property.last contains '/uploads/' -%}
                                    <a
                                      href="{{ property.last }}"
                                      class="link"
                                      target="_blank"
                                      aria-describedby="a11y-new-window-message"
                                    >
                                      {{ property.last | split: '/' | last }}
                                    </a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </div>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}

                          {% if item.selling_plan_allocation != null %}
                            <p class="main_cart__item_selling_plan">
                              {{ item.selling_plan_allocation.selling_plan.name }}
                            </p>
                          {% endif %}
                        {% endif %}
                      </div>
                    </div>

                    <div class="main_cart__item_info_quantity_wrapper">
                      <div class="main_cart__item_quantity_wrapper">
                        <item-quantity data-line="{{ forloop.index }}">
                          <button
                            type="button"
                            class="btn_minus"
                            data-minus
                            aria-label="{{ 'Decrease button' }}"
                            data-quantity="{{ item.quantity | minus: 1 }}"
                            data-min="{{ item.quantity }} - {{ item.variant.quantity_rule.min }}"
                            {% if item.quantity == item.variant.quantity_rule.min %}
                              disabled
                            {% endif %}
                          >
                            {{ 'icon-minus.svg' | inline_asset_content }}
                          </button>

                          <input
                            type="text"
                            name="quantity"
                            min="{{ item.variant.quantity_rule.min }}"
                            data-min="{{ item.variant.quantity_rule.min }}"
                            {% if item.variant.quantity_rule.max %}
                              data-max="{{item.variant.quantity_rule.max }}"
                              max="{{ item.variant.quantity_rule.max }}"
                            {% endif %}
                            step="{{item.variant.quantity_rule.increment }}"
                            value="{{ item.quantity }}"
                            id="Item_quantity-{{ forloop.index }}"
                          >
                          <label class="visually-hidden" for="Item_quantity-{{ forloop.index }}">
                            {{- 'products.product.quantity' | t -}}
                          </label>

                          <button
                            type="button"
                            aria-label="{{ 'Increase button' }}"
                            class="btn_plus"
                            data-plus
                            data-quantity="{{ item.quantity | plus: 1 }}"
                            {% if item.quantity == item.variant.quantity_rule.max %}
                              disabled
                            {% endif %}
                          >
                            {{ 'icon-plus.svg' | inline_asset_content }}
                          </button>
                        </item-quantity>
                      </div>
                      <div class="cart_error" data-line="{{ forloop.index }}" hidden></div>
                    </div>

                    <div class="main_cart__item_info_action_wrapper">
                      <item-remove data-line="{{ forloop.index }}">
                        <a
                          aria-label="{{- 'drawers.cart_drawer.remove' | t -}}"
                          class="item_remove_btn"
                          href="{{ item.url_to_remove }}"
                          data-remove
                          data-quantity="0"
                        >
                          {{ 'icon-trash.svg' | inline_asset_content }}
                        </a>
                      </item-remove>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>

            <div class="main_cart__items_footer">
              {% if settings.show_cart_note %}
                <div class="main_cart__note_wrapper">
                  <cart-note>
                    <details>
                      <summary>
                        <div class="main_cart__note">
                          <p class="main_cart_note_trigger">
                            <span class="cart_add_note">{{ 'sections.cart.cart_note_header' | t }}</span>
                            <span class="cart_edit_note">{{ 'sections.cart.cart_note_edit_header' | t }}</span>
                          </p>

                          <span>{{ 'icon-plus.svg' | inline_asset_content }}</span>
                        </div>
                      </summary>

                      <div class="main_cart_note_wrapper">
                        <div class="main_cart_note_inner">
                          <textarea
                            name="note"
                            form="cart"
                            id="cart_note-{{ section.id }}"
                            width="100%"
                            rows="6"
                            placeholder="{{ 'sections.cart.cart_note' | t }}"
                          >{{ cart.note }}</textarea>
                        </div>
                      </div>
                    </details>
                  </cart-note>
                </div>
              {% endif %}

              {% if settings.show_discount %}
                <div class="cart_drawer_discount_wrapper">
                  <div class="cart_drawer_discount_inner">
                    <cart-discount>
                      <details>
                        <summary>
                          <div class="cart_drawer_discount_trigger">
                            <p>{{ 'sections.cart.main_discount_label' | t }}</p>
                            <span>{{ 'icon-plus.svg' | inline_asset_content }}</span>
                          </div>
                        </summary>

                        <div class="cart_drawer_discount_content">
                          <form method="post" action="{{ routes.cart_update_url }}" id="cart_discount_form">
                            <div class="input_wrapper">
                              <input
                                id="cart_drawer_discount_content_input"
                                type="text"
                                name="discount"
                                placeholder="{{ 'sections.cart.discount_label' | t }}"
                              >
                              <label for="cart_drawer_discount_content_input">
                                {{- 'sections.cart.discount_label' | t | append: ' *' -}}
                              </label>
                            </div>

                            <div class="cart_drawer_discount_content_btn">
                              <button class="btn" type="submit" name="cart_discount_btn">
                                {{ 'sections.cart.apply_discount' | t }}
                              </button>
                            </div>
                          </form>
                        </div>
                      </details>

                      {% liquid
                        assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
                        for item in cart.items
                          for allocation in item.line_level_discount_allocations
                            if allocation.discount_application.type == 'discount_code'
                              assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
                            endif
                          endfor
                        endfor

                        assign discount_codes = discount_codes | uniq
                      %}

                      {% for discount_code in discount_codes %}
                        <div class="cart_applied_discount">
                          <span class="discount_icon icon_wrapper">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                          </span>
                          {{ discount_code }}
                          <button class="cart_discount_remove_btn" aria-label="{{ 'Cart discount remove' }}">
                            <span data-cart-discount-remove class="icon_wrapper">
                              {{- 'icon-close.svg' | inline_asset_content -}}
                            </span>
                          </button>
                        </div>
                      {% endfor %}

                      <div class="cart_discount_error hidden">
                        <p class="small-text">{{ 'sections.cart.cart_discount_error' | t }}</p>
                      </div>
                    </cart-discount>
                  </div>
                </div>
              {% endif %}

              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <div class="main_cart_level_discount_wrapper" aria-label="{{ 'customer.order.discount' | t }}">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <div class="main_cart_level_discount">
                      {{- 'icon-discount.svg' | inline_asset_content -}}
                      <p>
                        {{ discount.title | escape }}
                        (-{{ discount.total_allocated_amount | money }})
                      </p>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="main_cart__items_subtotals">
                <p class="item_subtotal">{{ 'drawers.cart_drawer.subtotal' | t }}</p>
                <p>{{ cart.total_price | money }}</p>
              </div>

              {% if settings.show_tax_info %}
                <span class="cart_items_tax_info">
                  {%- if cart.duties_included and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- endif -%}
                </span>
              {% endif %}

              <div class="main_cart__items_btns">
                {% if settings.enable_magnet %}<magnetic-button data-radius="200">{% endif %}
                <a href="{{ routes.root_url }}checkout" aria-label="{{ 'cart.checkout' | t }}" class="btn">
                  {{ 'cart.checkout' | t }}
                </a>
                {% if settings.enable_magnet %}</magnetic-button>{% endif %}

                {%- if additional_checkout_buttons -%}
                  <div class="cart_additional_checkout_btns">
                    {{ content_for_additional_checkout_buttons }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>

          {% if section.settings.enable_shipping_calculator %}
            <div class="main_cart_shipping_calculator_wrapper">
              <h4 class="h6" style="text-align: {{section.settings.shipping_head_align }};">
                {{ 'templates.cart.shipping_estimate_heading' | t }}
              </h4>

              <div class="c_wrapper">
                <div class="c_wrapper_inner">
                  <div class="input_wrapper_select countryContainer">
                    <div class="select">
                      <select
                        id="countrySelector"
                        name="country"
                        autocomplete="country"
                        data-default="{{ localization.country.iso_code }}"
                      >
                        {{ all_country_option_tags }}
                      </select>
                      {{ 'icon-caret-down.svg' | inline_asset_content }}
                    </div>
                  </div>

                  <div class="input_wrapper_select" id="provinceContainer">
                    <div class="select">
                      <select id="provinceSelector" name="province" autocomplete="address-level1"></select>
                      {{ 'icon-caret-down.svg' | inline_asset_content }}
                    </div>
                  </div>

                  <div class="input_wrapper">
                    <input
                      type="text"
                      id="shipping-zip"
                      placeholder="{{ 'templates.cart.zip' | t }}"
                      required
                    >
                    <label for="shipping-zip">{{ 'templates.cart.zip' | t }}</label>
                  </div>
                </div>

                <button class="btn" id="shipping-calc-btn" type="button">Calculate Shipping <span></span></button>

                <div id="shipping-results"></div>

              </div>

            </div>
          {% endif %}
        </div>
      {% endif %}
    </cart-contents>
  </div>
</div>

{% if section.settings.enable_shipping_calculator %}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const countryEl = document.getElementById('countrySelector');
      const provinceEl = document.getElementById('provinceSelector');
      const provinceContainer = document.getElementById('provinceContainer');

      function updateProvinces() {
        const selectedOption = countryEl.options[countryEl.selectedIndex];
        const provinces = JSON.parse(selectedOption.getAttribute('data-provinces') || '[]');

        provinceEl.innerHTML = '';

        if (provinces.length === 0) {
          provinceContainer.style.display = 'none';
          provinceEl.required = false;
        } else {
          provinceContainer.style.display = 'block';
          provinceEl.required = true;

          provinces.forEach(([code, name]) => {
            const opt = document.createElement('option');
            opt.value = name;
            opt.textContent = name;
            provinceEl.appendChild(opt);
          });
        }
      }

      document.querySelectorAll('#countrySelector option').forEach((option) => {
        const country = option.value;
        const data = Shopify.countryProvinceSelector?.countries?.[country];
        if (data?.provinces) {
          option.setAttribute('data-provinces', JSON.stringify(data.provinces));
        }
      });

      countryEl.addEventListener('change', updateProvinces);
      updateProvinces(); // initialize
    });

    document.addEventListener('DOMContentLoaded', function () {
      const btn = document.querySelector('#shipping-calc-btn');
      const zipInput = document.querySelector('#shipping-zip');
      const resultsBox = document.querySelector('#shipping-results');

      if (!btn) return;

      btn.addEventListener('click', function () {
        const zip = zipInput.value.trim();
        if (!zip) {
          resultsBox.innerHTML = '<p class="err">Please enter a postal code.</p>';
          return;
        }

        resultsBox.innerHTML = '<p class="calculating">Calculating...</p>';

        // Set country (default India)
        const country = document.getElementById('countrySelector').value;
        const province = document.getElementById('provinceSelector').value;
        console.log(country, province);
        // Shopify API: get shipping rates
        fetch(
          `/cart/shipping_rates.json?shipping_address[zip]=${zip}&shipping_address[country]=${country}&shipping_address[province]=${province}`
        )
          .then((res) => res.json())
          .then((data) => {
            if (data.shipping_rates) {
              if (data.shipping_rates.length) {
                let html = '<div class="es_wrapper">';

                data.shipping_rates.forEach((rate) => {
                  let price = rate.price;
                  console.log(typeof rate.price);
                  if (rate.price == '0.00' || rate.price == '0') {
                    price = 'FREE';
                  }
                  html += `
              <div class="es_inner">
              <span>
                ${rate.name}
                </span>
                <span>${Shopify.formatMoney(price)}</span>
                ${rate.delivery_range ? `(${rate.delivery_range.join(' to ')})` : ''}
              </div>
            `;
                });

                html += '</div>';
                resultsBox.innerHTML = html;
              } else {
                resultsBox.innerHTML = '<p class="err">Sorry, we do not ship to your address</p>';
              }
            } else if (data.zip) {
              resultsBox.innerHTML = `<p class="err">${data.zip}</p>`;
            } else {
              resultsBox.innerHTML = '<p class="err">Shipping rates not available.</p>';
            }
          })
          .catch((err) => {
            resultsBox.innerHTML = `<p class="err">${err}</p>`;
          });
      });
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Section border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable_shipping_calculator",
      "label": "Enable shipping calculator",
      "default": true,
      "info": "Show info based on the shipping details set in the admin."
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mob_top_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mob_bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px"
    }
  ]
}
{% endschema %}