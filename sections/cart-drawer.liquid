{% comment %}
  ============================================================
  BURNLAB — Cart Drawer Theming Override
  Targets Evolve's snippets/cart-drawer.liquid HTML structure.
  Does NOT replace Evolve's JS — only adds BurnLab CSS on top.
  ============================================================
{% endcomment %}

{%- liquid
  assign accent_color     = section.settings.accent_color     | default: '#07d16e'
  assign bg_dark          = section.settings.bg_dark          | default: '#001828'
  assign bg_light         = section.settings.bg_light         | default: '#f0f5f8'
  assign text_dark        = section.settings.text_dark        | default: '#eaf4f5'
  assign text_light       = section.settings.text_light       | default: '#001a2e'
  assign item_bg_dark     = section.settings.item_bg_dark     | default: '#001a2e'
  assign item_bg_light    = section.settings.item_bg_light    | default: '#ffffff'
  assign btn_bg_dark      = section.settings.btn_bg_dark      | default: '#001a2e'
  assign btn_bg_light     = section.settings.btn_bg_light     | default: '#e8f0f4'
  assign drawer_width     = section.settings.drawer_width     | default: 440
-%}

{% style %}

/* ══════════════════════════════════════════════════════════════════
   BURNLAB CART DRAWER — CSS override for Evolve's snippet
   All selectors target Evolve's existing HTML class names.
   Dark/light switching via [data-theme] on <html>.
   ══════════════════════════════════════════════════════════════════ */

/* ── CSS variables — dark mode default ── */
:root,
[data-theme="dark"] {
  --bl-cdr-bg:        {{ bg_dark }};
  --bl-cdr-text:      {{ text_dark }};
  --bl-cdr-accent:    {{ accent_color }};
  --bl-cdr-item-bg:   {{ item_bg_dark }};
  --bl-cdr-btn-bg:    {{ btn_bg_dark }};
  --bl-cdr-border:    rgba(51,104,112,0.22);
  --bl-cdr-muted:     rgba(234,244,245,0.50);
  --bl-cdr-overlay:   rgba(0,10,20,0.75);
  --bl-cdr-shadow:    -8px 0 48px rgba(0,0,0,0.5);
  --bl-cdr-input-bg:  rgba(255,255,255,0.05);
}

[data-theme="light"] {
  --bl-cdr-bg:       {{ bg_light }};
  --bl-cdr-text:     {{ text_light }};
  --bl-cdr-item-bg:  {{ item_bg_light }};
  --bl-cdr-btn-bg:   {{ btn_bg_light }};
  --bl-cdr-border:   rgba(0,26,46,0.12);
  --bl-cdr-muted:    rgba(0,26,46,0.50);
  --bl-cdr-overlay:  rgba(0,26,46,0.55);
  --bl-cdr-shadow:   -8px 0 48px rgba(0,26,46,0.22);
  --bl-cdr-input-bg: rgba(0,26,46,0.04);
}

/* ══════════════════════════════════════════════════════════════════
   DRAWER WRAPPER — the full-screen overlay + slide-in panel
   ══════════════════════════════════════════════════════════════════ */

.cart_drawer_wrapper {
  background: var(--bl-cdr-overlay) !important;
  transition: background 0.35s ease !important;
}

.cart_drawer_inner {
  width: min({{ drawer_width }}px, 100vw) !important;
  background: var(--bl-cdr-bg) !important;
  border-left: 1px solid var(--bl-cdr-border) !important;
  box-shadow: var(--bl-cdr-shadow) !important;
  display: flex !important;
  flex-direction: column !important;
  font-family: 'DM Sans', sans-serif !important;
  color: var(--bl-cdr-text) !important;
  transition: background 0.35s ease, color 0.35s ease !important;
}

/* ══════════════════════════════════════════════════════════════════
   HEADER
   ══════════════════════════════════════════════════════════════════ */

.cart_drawer_header {
  background: var(--bl-cdr-bg) !important;
  border-bottom: 1px solid var(--bl-cdr-border) !important;
  padding: 1.6rem 1.8rem !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  flex-shrink: 0 !important;
}

.cart_drawer_header h4 {
  font-family: 'Archivo Black', sans-serif !important;
  font-weight: 400 !important;
  font-size: clamp(1.6rem, 2vw, 2rem) !important;
  letter-spacing: -0.01em !important;
  color: var(--bl-cdr-text) !important;
  margin: 0 !important;
}

/* Close button — green circular */
.cart_drawer_header .drawer-wrapper__close,
.cart_drawer_header button[class*="close"] {
  width: 3.6rem !important;
  height: 3.6rem !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: rgba(7,209,110,0.08) !important;
  border: 1px solid rgba(7,209,110,0.22) !important;
  border-radius: 50% !important;
  color: var(--bl-cdr-accent) !important;
  cursor: pointer !important;
  transition: background 0.22s ease, transform 0.25s ease !important;
  flex-shrink: 0 !important;
}

.cart_drawer_header .drawer-wrapper__close:hover,
.cart_drawer_header button[class*="close"]:hover {
  background: rgba(7,209,110,0.16) !important;
  transform: rotate(90deg) scale(1.05) !important;
}

.cart_drawer_header .drawer-wrapper__close svg,
.cart_drawer_header button[class*="close"] svg,
.cart_drawer_header .icon_wrapper svg {
  color: var(--bl-cdr-accent) !important;
  stroke: var(--bl-cdr-accent) !important;
  width: 1.6rem !important;
  height: 1.6rem !important;
}

.cart_drawer_header .icon_wrapper {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

/* ══════════════════════════════════════════════════════════════════
   CONTENT SCROLL AREA
   ══════════════════════════════════════════════════════════════════ */

.cart_drawer_content_wrapper {
  flex: 1 !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  background: var(--bl-cdr-bg) !important;
  scrollbar-width: thin !important;
  scrollbar-color: rgba(7,209,110,0.3) transparent !important;
}

.cart_drawer_content_wrapper::-webkit-scrollbar { width: 4px !important; }
.cart_drawer_content_wrapper::-webkit-scrollbar-thumb {
  background: rgba(7,209,110,0.3) !important; border-radius: 4px !important;
}

.cart_drawer_content {
  padding: 1.2rem 1.4rem !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 1rem !important;
  background: var(--bl-cdr-bg) !important;
}

/* ══════════════════════════════════════════════════════════════════
   CART ITEMS
   ══════════════════════════════════════════════════════════════════ */

.cart_drawer_item {
  display: grid !important;
  grid-template-columns: 7rem 1fr !important;
  gap: 1.2rem !important;
  align-items: start !important;
  background: var(--bl-cdr-item-bg) !important;
  border: 1px solid var(--bl-cdr-border) !important;
  border-radius: 10px !important;
  padding: 1.2rem !important;
  transition: border-color 0.22s ease !important;
}

.cart_drawer_item:hover {
  border-color: rgba(7,209,110,0.28) !important;
}

.cart_drawer_item.nested_cart_item {
  margin-left: 1rem !important;
  border-left: 2px solid rgba(7,209,110,0.22) !important;
}

/* ── Item image ── */
.cart_drawer__item_img {
  width: 7rem !important;
  height: 7rem !important;
  border-radius: 7px !important;
  overflow: hidden !important;
  flex-shrink: 0 !important;
  background: rgba(255,255,255,0.04) !important;
}

.cart_drawer__item_img a {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

.cart_drawer__item_img img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
  transition: transform 0.35s ease !important;
}

.cart_drawer__item_img:hover img { transform: scale(1.04) !important; }

/* ── Item info ── */
.cart_drawer_item_info {
  display: flex !important;
  flex-direction: column !important;
  gap: 0.5rem !important;
}

.cart_drawer_item_info .item_title,
.cart_drawer_item_info .item_title a {
  font-family: 'DM Sans', sans-serif !important;
  font-size: clamp(1.2rem, 1.4vw, 1.4rem) !important;
  font-weight: 600 !important;
  color: var(--bl-cdr-text) !important;
  text-decoration: none !important;
  line-height: 1.35 !important;
  overflow-wrap: break-word !important;
  word-break: break-word !important;
}

.cart_drawer_item_info .item_title a:hover { color: var(--bl-cdr-accent) !important; }

/* Prices */
.cart_drawer_item_info .item_price_wrapper {
  font-family: 'Archivo Black', sans-serif !important;
  font-weight: 400 !important;
  font-size: clamp(1.2rem, 1.4vw, 1.5rem) !important;
  color: var(--bl-cdr-text) !important;
  display: flex !important;
  align-items: baseline !important;
  gap: 0.4rem !important;
  flex-wrap: wrap !important;
}

.cart_drawer_item_info .item_price_wrapper s {
  font-size: 0.82em !important;
  color: var(--bl-cdr-muted) !important;
  text-decoration: line-through !important;
}

/* Variant options */
.item_options_wrapper,
.item_product_options {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 0.3rem !important;
}

.item_product_options span,
.item_options_wrapper span {
  font-family: 'DM Sans', sans-serif !important;
  font-size: 1.1rem !important;
  color: var(--bl-cdr-muted) !important;
  background: rgba(255,255,255,0.05) !important;
  border: 1px solid var(--bl-cdr-border) !important;
  border-radius: 3px !important;
  padding: 0.15rem 0.5rem !important;
}

[data-theme="light"] .item_product_options span,
[data-theme="light"] .item_options_wrapper span {
  background: rgba(0,26,46,0.05) !important;
}

/* ── Quantity + remove row ── */
.item_quantity_wrapper {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 0.8rem !important;
  margin-top: 0.2rem !important;
}

item-quantity {
  display: inline-flex !important;
  align-items: center !important;
  background: var(--bl-cdr-input-bg) !important;
  border: 1px solid var(--bl-cdr-border) !important;
  border-radius: 7px !important;
  overflow: hidden !important;
}

.item_quantity_wrapper .btn_minus,
.item_quantity_wrapper .btn_plus {
  width: 3rem !important;
  height: 3rem !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: transparent !important;
  border: none !important;
  color: var(--bl-cdr-text) !important;
  cursor: pointer !important;
  padding: 0 !important;
  font-size: 1.6rem !important;
  line-height: 1 !important;
  transition: color 0.2s ease, background 0.2s ease !important;
}

.item_quantity_wrapper .btn_minus:hover:not([disabled]),
.item_quantity_wrapper .btn_plus:hover:not([disabled]) {
  color: var(--bl-cdr-accent) !important;
  background: rgba(7,209,110,0.08) !important;
}

.item_quantity_wrapper .btn_minus[disabled],
.item_quantity_wrapper .btn_plus[disabled] { opacity: 0.3 !important; cursor: not-allowed !important; }

/* Evolve uses SVG icons inside the buttons */
.item_quantity_wrapper .btn_minus svg,
.item_quantity_wrapper .btn_plus svg,
.item_quantity_wrapper .btn_minus .icon_wrapper svg,
.item_quantity_wrapper .btn_plus .icon_wrapper svg {
  width: 1.2rem !important;
  height: 1.2rem !important;
  color: inherit !important;
  stroke: currentColor !important;
  pointer-events: none !important;
}

.item_quantity_wrapper .icon_wrapper {
  display: flex !important; align-items: center !important; justify-content: center !important;
}

.item_quantity_wrapper input[name="quantity"] {
  width: 3.4rem !important;
  height: 3rem !important;
  background: transparent !important;
  border: none !important;
  border-left: 1px solid var(--bl-cdr-border) !important;
  border-right: 1px solid var(--bl-cdr-border) !important;
  color: var(--bl-cdr-text) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size: 1.3rem !important;
  font-weight: 600 !important;
  text-align: center !important;
  outline: none !important;
}

.item_quantity_wrapper input[name="quantity"]:focus { color: var(--bl-cdr-accent) !important; }

/* Remove (trash) button */
.item_remove_btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 3rem !important;
  height: 3rem !important;
  color: var(--bl-cdr-muted) !important;
  text-decoration: none !important;
  transition: color 0.2s ease, background 0.2s ease !important;
  border-radius: 6px !important;
  background: transparent !important;
}

.item_remove_btn:hover { color: #ff5c5c !important; background: rgba(255,92,92,0.08) !important; }

.item_remove_btn svg,
.item_remove_btn .icon_wrapper svg {
  width: 1.5rem !important;
  height: 1.5rem !important;
  color: inherit !important;
  stroke: currentColor !important;
  pointer-events: none !important;
}

/* Cart error */
.cart_error {
  font-size: 1.1rem !important;
  color: #ff6b6b !important;
  padding: 0.2rem 0 !important;
}

/* ══════════════════════════════════════════════════════════════════
   UPSELL SECTION
   ══════════════════════════════════════════════════════════════════ */

.cart_drawer_upsell_wrapper {
  padding: 1.2rem 1.4rem !important;
  border-top: 1px solid var(--bl-cdr-border) !important;
  background: var(--bl-cdr-bg) !important;
}

.cart_drawer_upsell_head {
  margin-bottom: 1rem !important;
}

.cart_drawer_upsell_head h2 {
  font-family: 'Archivo Black', sans-serif !important;
  font-weight: 400 !important;
  font-size: clamp(1.4rem, 1.8vw, 1.8rem) !important;
  letter-spacing: -0.01em !important;
  color: var(--bl-cdr-text) !important;
}

.cart_drawer_upsell_head h2::before {
  content: '' !important;
  display: inline-block !important;
  width: 0.3em !important; height: 0.3em !important;
  background: var(--bl-cdr-accent) !important;
  border-radius: 50% !important;
  margin-right: 0.5em !important;
  vertical-align: 0.2em !important;
}

/* ══════════════════════════════════════════════════════════════════
   EMPTY CART
   ══════════════════════════════════════════════════════════════════ */

.empty_cart_drawer {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  gap: 1.4rem !important;
  padding: 4rem 2rem !important;
  background: var(--bl-cdr-bg) !important;
}

.empty_cart_drawer h5 {
  font-family: 'Archivo Black', sans-serif !important;
  font-weight: 400 !important;
  font-size: clamp(1.8rem, 3vw, 2.4rem) !important;
  letter-spacing: -0.02em !important;
  color: var(--bl-cdr-text) !important;
}

/* ══════════════════════════════════════════════════════════════════
   FOOTER — note, discount, subtotal, buttons
   ══════════════════════════════════════════════════════════════════ */

.cart_drawer_items_footer {
  padding: 1.2rem 1.4rem 1.6rem !important;
  border-top: 1px solid var(--bl-cdr-border) !important;
  background: var(--bl-cdr-bg) !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 0.8rem !important;
}

/* Cart note accordion */
.cart_drawer_cart_note_wrapper,
.cart_drawer_discount_wrapper {
  background: var(--bl-cdr-item-bg) !important;
  border: 1px solid var(--bl-cdr-border) !important;
  border-radius: 8px !important;
  overflow: hidden !important;
}

.cart_drawer_note summary,
.cart_drawer_discount_trigger {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 1rem 1.2rem !important;
  cursor: pointer !important;
  user-select: none !important;
  list-style: none !important;
}

.cart_drawer_note summary::-webkit-details-marker,
.cart_drawer_cart_note_wrapper details > summary::-webkit-details-marker { display: none !important; }

.cart_drawer_note summary p,
.cart_drawer_discount_trigger p {
  font-family: 'DM Sans', sans-serif !important;
  font-size: clamp(1.2rem, 1.4vw, 1.4rem) !important;
  font-weight: 600 !important;
  color: var(--bl-cdr-text) !important;
  margin: 0 !important;
  transition: color 0.2s ease !important;
}

.cart_drawer_note summary:hover p,
.cart_drawer_discount_trigger:hover p { color: var(--bl-cdr-accent) !important; }

.cart_drawer_note summary svg,
.cart_drawer_discount_trigger svg,
.cart_drawer_note summary .icon_wrapper,
.cart_drawer_discount_trigger .icon_wrapper svg {
  width: 1.5rem !important; height: 1.5rem !important;
  color: var(--bl-cdr-muted) !important; flex-shrink: 0 !important;
  transition: transform 0.3s ease, color 0.2s ease !important;
}

details[open] .cart_drawer_note summary svg,
details[open] .cart_drawer_discount_trigger svg,
details[open] .cart_drawer_note summary .icon_wrapper svg,
details[open] .cart_drawer_discount_trigger .icon_wrapper svg {
  transform: rotate(45deg) !important;
  color: var(--bl-cdr-accent) !important;
}

/* Note textarea */
.cart_note_wrapper, .cart_note_inner { padding: 0 1.2rem 1.2rem !important; }

.cart_note_inner textarea {
  width: 100% !important;
  min-height: 7rem !important;
  padding: 0.9rem 1rem !important;
  background: var(--bl-cdr-input-bg) !important;
  border: 1px solid var(--bl-cdr-border) !important;
  border-radius: 6px !important;
  color: var(--bl-cdr-text) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size: clamp(1.2rem, 1.4vw, 1.3rem) !important;
  resize: vertical !important;
  outline: none !important;
  transition: border-color 0.22s ease !important;
}

.cart_note_inner textarea:focus { border-color: var(--bl-cdr-accent) !important; }
.cart_note_inner textarea::placeholder { color: var(--bl-cdr-muted) !important; }

/* Discount content */
.cart_drawer_discount_content { padding: 0 1.2rem 1.2rem !important; }

.cart_drawer_discount_content .input_wrapper {
  position: relative !important;
  margin-bottom: 0.8rem !important;
}

.cart_drawer_discount_content input[name="discount"] {
  width: 100% !important;
  padding: 0.9rem 1rem !important;
  background: var(--bl-cdr-input-bg) !important;
  border: 1px solid var(--bl-cdr-border) !important;
  border-radius: 6px !important;
  color: var(--bl-cdr-text) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size: clamp(1.2rem, 1.4vw, 1.3rem) !important;
  outline: none !important;
  transition: border-color 0.22s ease !important;
}

.cart_drawer_discount_content input[name="discount"]:focus { border-color: var(--bl-cdr-accent) !important; }
.cart_drawer_discount_content input[name="discount"]::placeholder { color: var(--bl-cdr-muted) !important; }

.cart_drawer_discount_content label {
  position: absolute !important;
  top: -0.6rem !important; left: 0.8rem !important;
  font-size: 1rem !important; font-weight: 600 !important;
  color: var(--bl-cdr-accent) !important;
  background: var(--bl-cdr-item-bg) !important;
  padding: 0 0.3rem !important;
  pointer-events: none !important;
}

.cart_drawer_discount_content_btn .btn {
  width: 100% !important;
  padding: 0.85rem !important;
  background: transparent !important;
  border: 1px solid var(--bl-cdr-accent) !important;
  border-radius: 6px !important;
  color: var(--bl-cdr-accent) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size: clamp(1.2rem, 1.4vw, 1.3rem) !important;
  font-weight: 600 !important;
  cursor: pointer !important;
  text-align: center !important;
  text-decoration: none !important;
  transition: background 0.22s ease !important;
}

.cart_drawer_discount_content_btn .btn:hover { background: rgba(7,209,110,0.10) !important; }

/* Applied discount tags */
.cart_applied_discount {
  display: inline-flex !important;
  align-items: center !important;
  gap: 0.5rem !important;
  margin-top: 0.6rem !important;
  font-size: 1.2rem !important;
  font-weight: 600 !important;
  color: var(--bl-cdr-accent) !important;
  background: rgba(7,209,110,0.08) !important;
  border: 1px solid rgba(7,209,110,0.25) !important;
  border-radius: 6px !important;
  padding: 0.3rem 0.9rem !important;
}

.cart_applied_discount .discount_icon svg { color: var(--bl-cdr-accent) !important; width: 1.2rem !important; height: 1.2rem !important; }
.cart_discount_remove_btn { background: transparent !important; border: none !important; color: inherit !important; cursor: pointer !important; }
.cart_discount_remove_btn svg { width: 1.1rem !important; height: 1.1rem !important; }

/* Cart-level discounts */
.drawer_cart_level_discount_wrapper { display: flex !important; flex-direction: column !important; gap: 0.4rem !important; }
.drawer_cart_level_discount {
  display: flex !important; align-items: center !important; gap: 0.5rem !important;
  font-size: 1.2rem !important; color: var(--bl-cdr-accent) !important;
  overflow-wrap: break-word !important;
}
.drawer_cart_level_discount svg { width: 1.3rem !important; height: 1.3rem !important; flex-shrink: 0 !important; }

/* Subtotal row */
.cart_drawer_items_subtotals {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 1rem !important;
  padding: 0.6rem 0 !important;
  border-top: 1px solid var(--bl-cdr-border) !important;
}

.cart_drawer_items_subtotals p {
  font-family: 'DM Sans', sans-serif !important;
  font-size: clamp(1.2rem, 1.4vw, 1.4rem) !important;
  margin: 0 !important;
}

.cart_drawer_items_subtotals p:first-child { color: var(--bl-cdr-muted) !important; font-weight: 500 !important; }
.cart_drawer_items_subtotals p:last-child {
  font-family: 'Archivo Black', sans-serif !important;
  font-weight: 400 !important;
  font-size: clamp(1.6rem, 2vw, 2rem) !important;
  color: var(--bl-cdr-accent) !important;
  white-space: nowrap !important;
}

/* Tax info */
.cart_items_tax_info {
  font-size: clamp(1rem, 1.1vw, 1.2rem) !important;
  color: var(--bl-cdr-muted) !important;
  line-height: 1.5 !important;
  overflow-wrap: break-word !important;
}

.cart_items_tax_info a { color: var(--bl-cdr-accent) !important; }

/* ── Buttons — Checkout + View Cart ── */
.cart_drawer_items_btns {
  display: flex !important;
  flex-direction: column !important;
  gap: 0.7rem !important;
}

/* Checkout (primary) button */
.cart_drawer_items_btns .btn-secondary,
.cart_drawer_items_btns a[href*="checkout"],
.cart_drawer_items_btns .btn:last-child {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 1.3rem 2rem !important;
  background: var(--bl-cdr-accent) !important;
  border: none !important;
  border-radius: 9px !important;
  color: #001a2e !important;
  font-family: 'Archivo Black', sans-serif !important;
  font-weight: 400 !important;
  font-size: clamp(1.3rem, 1.5vw, 1.5rem) !important;
  letter-spacing: 0.01em !important;
  text-decoration: none !important;
  cursor: pointer !important;
  position: relative !important;
  overflow: hidden !important;
  transition: opacity 0.22s ease, transform 0.22s ease, box-shadow 0.22s ease !important;
  will-change: transform !important;
}

.cart_drawer_items_btns .btn-secondary::before,
.cart_drawer_items_btns a[href*="checkout"]::before {
  content: '' !important;
  position: absolute !important; inset: 0 !important;
  background: linear-gradient(135deg, rgba(255,255,255,0.13) 0%, transparent 55%) !important;
  pointer-events: none !important;
}

.cart_drawer_items_btns .btn-secondary:hover,
.cart_drawer_items_btns a[href*="checkout"]:hover {
  opacity: 0.9 !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 8px 28px rgba(7,209,110,0.38) !important;
}

/* View cart (secondary) button */
.cart_drawer_items_btns .btn:first-child {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 1rem 2rem !important;
  background: transparent !important;
  border: 1px solid var(--bl-cdr-border) !important;
  border-radius: 9px !important;
  color: var(--bl-cdr-text) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size: clamp(1.2rem, 1.4vw, 1.4rem) !important;
  font-weight: 500 !important;
  text-decoration: none !important;
  cursor: pointer !important;
  transition: border-color 0.22s ease, color 0.22s ease !important;
}

.cart_drawer_items_btns .btn:first-child:hover {
  border-color: var(--bl-cdr-accent) !important;
  color: var(--bl-cdr-accent) !important;
}

/* Wave buttons (Evolve's wave-btn style — override with flat BurnLab style) */
.cart_drawer_items_btns .wave-btn span { display: block !important; }
.cart_drawer_items_btns .wave-btn .wave { display: none !important; }

/* ══════════════════════════════════════════════════════════════════
   EMPTY CART CONTINUE SHOPPING BUTTON
   ══════════════════════════════════════════════════════════════════ */

.empty_cart_drawer .btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 1rem 2.4rem !important;
  background: var(--bl-cdr-accent) !important;
  border: none !important;
  border-radius: 9px !important;
  color: #001a2e !important;
  font-family: 'Archivo Black', sans-serif !important;
  font-weight: 400 !important;
  font-size: clamp(1.3rem, 1.5vw, 1.5rem) !important;
  text-decoration: none !important;
  cursor: pointer !important;
  transition: opacity 0.22s ease, transform 0.22s ease !important;
}

.empty_cart_drawer .btn:hover { opacity: 0.88 !important; transform: translateY(-2px) !important; }

/* ══════════════════════════════════════════════════════════════════
   RESPONSIVE ADJUSTMENTS
   ══════════════════════════════════════════════════════════════════ */

@media (max-width: 480px) {
  .cart_drawer_inner { width: 100vw !important; }
  .cart_drawer_item { grid-template-columns: 6rem 1fr !important; padding: 1rem !important; }
  .cart_drawer__item_img { width: 6rem !important; height: 6rem !important; }
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  .cart_drawer_inner,
  .cart_drawer__item_img img { transition: none !important; }
}

{% endstyle %}

