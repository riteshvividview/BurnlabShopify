{% if section.settings.enable_animations %}
<script>
(function () {
  var SECTION = document.getElementById('{{ section_id }}');
  if (!SECTION) return;

  /* ── Theme color maps ─────────────────────────────────── */
  var STI_DARK = {
    bg:          '{{ bg_dark }}',
    text:        '{{ text_dark }}',
    accent:      '{{ accent_dark }}',
    muted:       '{{ muted_dark }}',
    cardBg:      '{{ card_bg_dark }}',
    cardBorder:  '{{ card_border_dark }}'
  };
  var STI_LIGHT = {
    bg:          '{{ bg_light }}',
    text:        '{{ text_light }}',
    accent:      '{{ accent_light }}',
    muted:       '{{ muted_light }}',
    cardBg:      '{{ card_bg_light }}',
    cardBorder:  '{{ card_border_light }}'
  };

  function applyTheme() {
    var isLight = document.documentElement.getAttribute('data-theme') === 'light';
    var c = isLight ? STI_LIGHT : STI_DARK;
    SECTION.style.setProperty('--sti-bg',          c.bg);
    SECTION.style.setProperty('--sti-text',        c.text);
    SECTION.style.setProperty('--sti-accent',      c.accent);
    SECTION.style.setProperty('--sti-muted',       c.muted);
    SECTION.style.setProperty('--sti-card-bg',     c.cardBg);
    SECTION.style.setProperty('--sti-card-border', c.cardBorder);
    SECTION.style.backgroundColor = c.bg;
    SECTION.style.color = c.text;
  }

  applyTheme();
  var themeObs = new MutationObserver(applyTheme);
  themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  /* ── Scroll-reveal IntersectionObserver ───────────────── */
  var revealObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  SECTION.querySelectorAll('.sti-reveal, .sti-reveal--left, .sti-reveal--right').forEach(function(el) {
    revealObs.observe(el);
  });

  /* ── Parallax — left col drifts up, right col drifts down */
  {% if section.settings.enable_parallax %}
  var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    var colLeft  = document.getElementById('{{ section_id }}-col-left');
    var colRight = document.getElementById('{{ section_id }}-col-right');
    var layout   = document.getElementById('{{ section_id }}-layout');
    var ticking  = false;
    var STRENGTH = 0.12;

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(function() {
          if (!layout) { ticking = false; return; }
          var rect   = layout.getBoundingClientRect();
          var vH     = window.innerHeight;
          var center = rect.top + rect.height / 2;
          var progress = (vH / 2 - center) / (vH / 2 + rect.height / 2);
          var shift  = progress * rect.height * STRENGTH;
          if (colLeft)  colLeft.style.transform  = 'translateY(' + (-shift) + 'px)';
          if (colRight) colRight.style.transform = 'translateY(' + ( shift) + 'px)';
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
  {% endif %}

  /* ── Badge pulse on center image hover ───────────────── */
  var badge = SECTION.querySelector('.sti-badge-circle');
  var centerWrap = SECTION.querySelector('.sti-center-img-wrap');
  if (badge && centerWrap) {
    centerWrap.addEventListener('mouseenter', function() {
      badge.style.boxShadow = '0 0 0 10px rgba(7,209,110,0.18), 0 0 32px rgba(7,209,110,0.25)';
    });
    centerWrap.addEventListener('mouseleave', function() {
      badge.style.boxShadow = '0 0 0 6px rgba(7,209,110,0.12)';
    });
  }

})();
</script>
{% endif %}

<!-- ── Fade carousel autoplay (independent of enable_animations) ── -->
<script>
(function () {
  var SECTION = document.getElementById('{{ section_id }}');
  if (!SECTION) return;

  var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  SECTION.querySelectorAll('.sti-carousel-card').forEach(function (card) {
    var slides = card.querySelectorAll('.sti-carousel-slide');
    if (slides.length < 2) return;

    var seconds  = parseFloat(card.getAttribute('data-carousel-interval')) || 4;
    var current  = 0;
    slides.forEach(function (s, i) { if (s.classList.contains('is-active')) current = i; });

    if (prefersReducedMotion) return;

    setInterval(function () {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, Math.max(seconds, 1) * 1000);
  });
})();
</script>

{% if section.settings.mobile_viewmore_enable %}
<script>
(function () {
  var SECTION = document.getElementById('{{ section_id }}');
  if (!SECTION) return;

  var LIMIT = {{ section.settings.mobile_viewmore_limit | default: 4 }};
  var wrap  = document.getElementById('{{ section_id }}-viewmore-wrap');
  var btn   = document.getElementById('{{ section_id }}-viewmore-btn');
  if (!wrap || !btn) return;

  function isMobile() { return window.innerWidth <= 768; }

  /* Collect cards in mobile visual order: center col → left col → right col */
  function getCards() {
    var c = Array.from(SECTION.querySelectorAll('.sti-col--center .sti-img-card, .sti-col--center .sti-card'));
    var l = Array.from(SECTION.querySelectorAll('.sti-col--left .sti-img-card,   .sti-col--left .sti-card'));
    var r = Array.from(SECTION.querySelectorAll('.sti-col--right .sti-img-card,  .sti-col--right .sti-card'));
    return c.concat(l).concat(r);
  }

  function applyMobileLimit() {
    var cards = getCards();
    /* Reset first */
    cards.forEach(function(el) { el.classList.remove('sti-mobile-hidden'); });

    if (cards.length <= LIMIT) {
      wrap.style.display = 'none';
      return;
    }

    cards.slice(LIMIT).forEach(function(el) {
      el.classList.add('sti-mobile-hidden');
    });
    wrap.style.display = 'flex';
    btn.setAttribute('aria-expanded', 'false');
  }

  function resetToDesktop() {
    getCards().forEach(function(el) { el.classList.remove('sti-mobile-hidden'); });
    wrap.style.display = 'none';
  }

  btn.addEventListener('click', function () {
    var hidden = Array.from(SECTION.querySelectorAll('.sti-mobile-hidden'));
    if (!hidden.length) return;

    /* Remember the first card to reveal so we can scroll to it */
    var firstCard = hidden[0];

    hidden.forEach(function(el) {
      el.classList.remove('sti-mobile-hidden');
      /* Trigger reveal animation after display change settles */
      setTimeout(function() { el.classList.add('is-visible'); }, 40);
    });
    btn.setAttribute('aria-expanded', 'true');
    wrap.style.display = 'none';

    /* Scroll to the first newly revealed card so the user sees
       new content from the point where they clicked, not from the top */
    setTimeout(function() {
      var hdr = document.querySelector('.bl-hdr-outer') || document.querySelector('header');
      var hdrH = hdr ? hdr.offsetHeight + 12 : 72;
      var top = firstCard.getBoundingClientRect().top + window.scrollY - hdrH;
      window.scrollTo({ top: top, behavior: 'smooth' });
    }, 60);
  });

  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      if (isMobile()) { applyMobileLimit(); } else { resetToDesktop(); }
    }, 200);
  }, { passive: true });

  /* Boot */
  function boot() { if (isMobile()) applyMobileLimit(); }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
{% endif %}

