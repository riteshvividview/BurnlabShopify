  50% { box-shadow: 0 0 0 8px rgba(7,209,110,0.18); }
}
#{{ section_id }} .bl-pd-atc [type="submit"]:not(:disabled),
#{{ section_id }} .bl-pd-atc [name="add"]:not(:disabled) {
  animation: bl-atc-glow 3s ease-in-out infinite;
}
#{{ section_id }} .bl-pd-atc [type="submit"]:hover,
#{{ section_id }} .bl-pd-atc [name="add"]:hover { animation: none; }

/* Stagger entrance on info blocks */
#{{ section_id }} .bl-pd-info-col.is-visible .bl-pd-block {
  animation: bl-block-in 0.5s cubic-bezier(0.16,1,0.3,1) both;
}
#{{ section_id }} .bl-pd-info-col.is-visible .bl-pd-block:nth-child(1)  { animation-delay: 0.08s; }
#{{ section_id }} .bl-pd-info-col.is-visible .bl-pd-block:nth-child(2)  { animation-delay: 0.15s; }
#{{ section_id }} .bl-pd-info-col.is-visible .bl-pd-block:nth-child(3)  { animation-delay: 0.22s; }
#{{ section_id }} .bl-pd-info-col.is-visible .bl-pd-block:nth-child(4)  { animation-delay: 0.28s; }
#{{ section_id }} .bl-pd-info-col.is-visible .bl-pd-block:nth-child(5)  { animation-delay: 0.34s; }
#{{ section_id }} .bl-pd-info-col.is-visible .bl-pd-block:nth-child(6)  { animation-delay: 0.40s; }
#{{ section_id }} .bl-pd-info-col.is-visible .bl-pd-block:nth-child(n+7) { animation-delay: 0.46s; }
@keyframes bl-block-in {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: none; }
}
{% endif %}

/* ── Icon Trio block ─── */
#{{ section_id }} .bl-pd-icon-trio {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--bl-pd-divider);
  /* background set per-block via inline style; falls back to section surface */
  background: var(--bl-pd-surface);
  width: 100%;
  text-align: center; /* ensure all text centres */
}
#{{ section_id }} .bl-pd-icon-trio-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: clamp(1.2rem, 2vw, 1.6rem) clamp(0.6rem, 1.5vw, 1rem);
  gap: 0.4rem;
  position: relative;
}
#{{ section_id }} .bl-pd-icon-trio-item + .bl-pd-icon-trio-item::before {
  content: '';
  position: absolute;
  left: 0; top: 18%; bottom: 18%;
  width: 1px;
  background: var(--bl-pd-divider);
}
#{{ section_id }} .bl-pd-icon-trio-icon {
  width: clamp(26px, 5vw, 34px);
  height: clamp(26px, 5vw, 34px);
  object-fit: contain;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--bl-pd-accent);
}
#{{ section_id }} .bl-pd-icon-trio-icon img {
  width: 100%; height: 100%; object-fit: contain; display: block;
}
#{{ section_id }} .bl-pd-icon-trio-icon svg {
  width: 100%; height: 100%;
}
#{{ section_id }} .bl-pd-icon-trio-title {
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(1rem, 1.8vw, 1.2rem);
  font-weight: 700;
  line-height: 1.2;
  color: var(--bl-pd-text);
  overflow-wrap: break-word;
  word-break: break-word;
}
#{{ section_id }} .bl-pd-icon-trio-sub {
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(0.85rem, 1.4vw, 1rem);
  line-height: 1.3;
  /* slightly lighter than full muted — more readable */
  color: var(--bl-pd-text);
  opacity: 0.62;
  overflow-wrap: break-word;
  word-break: break-word;
}
/* Mobile: true full-viewport width + horizontal centering.
   margin-left: calc(50% - 50vw) shifts the element left to the
   viewport edge regardless of any container padding or grid offset. */
@media (max-width: 768px) {
  #{{ section_id }} .bl-pd-icon-trio {
    width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    border-radius: 0;
    border-left: none;
    border-right: none;
  }
  #{{ section_id }} .bl-pd-icon-trio-item {
    padding-inline: clamp(0.5rem, 2vw, 0.9rem);
  }
}
@media (max-width: 480px) {
  #{{ section_id }} .bl-pd-icon-trio-title { font-size: 0.95rem; }
  #{{ section_id }} .bl-pd-icon-trio-sub   { font-size: 0.78rem; }
}

/* ── Vendor hover glow ─── */
#{{ section_id }} .bl-pd-vendor {
  transition: letter-spacing 0.3s ease, opacity 0.2s ease;
}
#{{ section_id }} .bl-pd-vendor:hover { letter-spacing: 0.18em; }

/* ── Title smooth color shift ─── */
#{{ section_id }} .bl-pd-title {
  transition: color 0.3s ease;
}

/* ── Feature badge hover lift ─── */
#{{ section_id }} .bl-pd-badge {
  transition: border-color 0.25s ease, transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.25s ease;
  will-change: transform;
}
#{{ section_id }} .bl-pd-badge:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(7,209,110,0.15);
}

/* ── Thumb hover effect ─── */
#{{ section_id }} .bl-pd-thumb { transition: border-color 0.22s ease, transform 0.22s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.22s ease; }
#{{ section_id }} .bl-pd-thumb:hover { transform: scale(1.1) translateY(-2px); box-shadow: 0 4px 16px rgba(7,209,110,0.2); }
#{{ section_id }} .bl-pd-thumb.is-active { box-shadow: 0 0 0 2px var(--bl-pd-accent), 0 4px 16px rgba(7,209,110,0.22); }

/* ── Gallery main wrap — smooth border glow on hover ─── */
#{{ section_id }} .bl-pd-main-wrap {
  transition: transform 0.45s cubic-bezier(0.16,1,0.3,1), box-shadow 0.4s ease;
}
#{{ section_id }} .bl-pd-main-wrap:hover {
  box-shadow: 0 0 0 1.5px rgba(7,209,110,0.3), 0 24px 80px rgba(0,0,0,0.28);
}

/* ── Auto color swatches (applied by JS to Color/Colour options) ── */
#{{ section_id }} .bl-pd-vars .bl-color-swatch {
  width: 3.2rem !important;
  height: 3.2rem !important;
  min-height: 3.2rem !important;
  padding: 0 !important;
  border-radius: 50% !important;
  font-size: 0 !important;       /* hide text */
  color: transparent !important;
  letter-spacing: -99em !important;
  overflow: hidden !important;
  flex-shrink: 0 !important;
  border: 2.5px solid rgba(128,128,128,0.3) !important;
  box-shadow: none !important;
  transition: box-shadow 0.22s ease, transform 0.22s ease, border-color 0.22s ease !important;
}
#{{ section_id }} .bl-pd-vars .bl-color-swatch.active,
#{{ section_id }} .bl-pd-vars .bl-color-swatch.is-active,
#{{ section_id }} .bl-pd-vars input[type="radio"]:checked + .bl-color-swatch {
  box-shadow: 0 0 0 2.5px var(--bl-pd-surface), 0 0 0 4.5px var(--bl-pd-accent) !important;
  border-color: transparent !important;
  transform: scale(1.12) !important;
}
#{{ section_id }} .bl-pd-vars .bl-color-swatch:hover:not(.active):not(.is-active) {
  transform: scale(1.1) !important;
  box-shadow: 0 0 0 2px var(--bl-pd-surface), 0 0 0 3.5px rgba(255,255,255,0.45) !important;
  border-color: transparent !important;
}

/* ── Reduced motion ─── */
@media (prefers-reduced-motion: reduce) {
  #{{ section_id }} .bl-pd-slide,
  #{{ section_id }} .bl-pd-main-wrap,
  #{{ section_id }} .bl-pd-thumb,
  #{{ section_id }} .bl-pd-glow,
  #{{ section_id }} .bl-pd-media-col,
  #{{ section_id }} .bl-pd-info-col { transition: none !important; animation: none !important; }
}

/* ── Reveal animations ─── */
{% if enable_anim %}
#{{ section_id }} .bl-pd-media-col {
  opacity: 0; transform: translateX(-28px);
  transition: opacity 0.65s cubic-bezier(0.16,1,0.3,1),
              transform 0.65s cubic-bezier(0.16,1,0.3,1);
  will-change: opacity, transform;
}
#{{ section_id }} .bl-pd-info-col {
  opacity: 0; transform: translateX(28px);
  transition: opacity 0.65s 0.12s cubic-bezier(0.16,1,0.3,1),
              transform 0.65s 0.12s cubic-bezier(0.16,1,0.3,1);
  will-change: opacity, transform;
}
#{{ section_id }} .bl-pd-media-col.is-visible,
#{{ section_id }} .bl-pd-info-col.is-visible { opacity: 1; transform: none; }
{% endif %}

/* ── Shopify editor overrides ─── */
.shopify-design-mode #{{ section_id }} .bl-pd-media-col,
.shopify-design-mode #{{ section_id }} .bl-pd-info-col { opacity: 1 !important; transform: none !important; }

/* ── Lightbox ─── */
#bl-lb-{{ section.id }} {
  position: fixed; inset: 0; z-index: 9999;
  background: rgba(0,8,18,0.95); backdrop-filter: blur(14px);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
#bl-lb-{{ section.id }}.is-open { opacity: 1; visibility: visible; }
#bl-lb-{{ section.id }} .bl-lb-img-wrap {
  max-width: min(90vw, 1200px); max-height: 90vh; position: relative;
}
#bl-lb-{{ section.id }} .bl-lb-img {
  max-width: 100%; max-height: 90vh; object-fit: contain;
  border-radius: 12px; display: block; transition: opacity 0.3s ease;
}
#bl-lb-{{ section.id }} .bl-lb-close,
#bl-lb-{{ section.id }} .bl-lb-prev,
#bl-lb-{{ section.id }} .bl-lb-next {
  position: fixed; width: 4.8rem; height: 4.8rem; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.18); background: rgba(0,26,46,0.7);
  color: #fff; cursor: pointer; display: flex; align-items: center;
  justify-content: center; transition: background 0.2s ease; z-index: 10000;
}
#bl-lb-{{ section.id }} .bl-lb-close { top: 1.8rem; right: 1.8rem; }
#bl-lb-{{ section.id }} .bl-lb-prev { left: 1.8rem; top: 50%; transform: translateY(-50%); }
#bl-lb-{{ section.id }} .bl-lb-next { right: 1.8rem; top: 50%; transform: translateY(-50%); }
#bl-lb-{{ section.id }} .bl-lb-close:hover,
#bl-lb-{{ section.id }} .bl-lb-prev:hover,
#bl-lb-{{ section.id }} .bl-lb-next:hover { background: rgba(7,209,110,0.3); }
#bl-lb-{{ section.id }} .bl-lb-close svg,
#bl-lb-{{ section.id }} .bl-lb-prev svg,
#bl-lb-{{ section.id }} .bl-lb-next svg { width: 2rem; height: 2rem; pointer-events: none; }
#bl-lb-{{ section.id }} .bl-lb-count {
  position: fixed; bottom: 1.8rem; left: 50%; transform: translateX(-50%);
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif);
  font-size: 1.3rem; color: rgba(255,255,255,0.5);
}
@media (max-width: 480px) {
  #bl-lb-{{ section.id }} .bl-lb-prev { left: 0.5rem; }
  #bl-lb-{{ section.id }} .bl-lb-next { right: 0.5rem; }
}

/* ── Sticky ATC ─── */
/* No backdrop-filter here — it creates a stacking context that fights the header dropdown */
#bl-satc-{{ section.id }} {
  position: fixed; top: 0; left: 0; right: 0; z-index: 2;
  background: #000e1c;
  border-bottom: 1px solid rgba(7,209,110,0.2);
  box-shadow: 0 4px 32px rgba(0,0,0,0.42);
  transform: translateY(-110%);
  transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
  will-change: transform;
}
#bl-satc-{{ section.id }}.is-visible { transform: translateY(0); }
#bl-satc-{{ section.id }} .bl-satc-inner {
  max-width: 1400px; margin-inline: auto;
  padding: 0.9rem clamp(1.6rem, 4vw, 4.8rem);
  display: flex; align-items: center; gap: 1.4rem;
}
#bl-satc-{{ section.id }} .bl-satc-img {
  width: 4.8rem; height: 4.8rem; border-radius: 8px;
  object-fit: cover; flex-shrink: 0;
}
#bl-satc-{{ section.id }} .bl-satc-meta { flex: 1; min-width: 0; }
#bl-satc-{{ section.id }} .bl-satc-title {
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif);
  font-size: clamp(1.2rem, 1.4vw, 1.5rem); font-weight: 600;
  color: #eaf4f5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
#bl-satc-{{ section.id }} .bl-satc-price {
  font-family: var(--bl-font-primary, 'Archivo Black', sans-serif);
  font-weight: 400; font-size: clamp(1.4rem, 1.8vw, 2rem); color: #07d16e;
}
#bl-satc-{{ section.id }} .bl-satc-btn {
  padding: 0.9rem 2.4rem; background: #07d16e; color: #001a2e;
  font-family: var(--bl-font-primary, 'Archivo Black', sans-serif);
  font-weight: 400; font-size: clamp(1.2rem, 1.4vw, 1.5rem);
  letter-spacing: 0.05em; text-transform: uppercase;
  border: none; border-radius: 50px; cursor: pointer; flex-shrink: 0;
  white-space: nowrap; transition: background 0.25s ease, transform 0.2s ease;
  will-change: transform;
}
#bl-satc-{{ section.id }} .bl-satc-btn:hover { background: #05b85e; transform: scale(1.04); }
#bl-satc-{{ section.id }} .bl-satc-btn:disabled {
  background: rgba(51,104,112,0.35); color: rgba(234,244,245,0.4);
  cursor: not-allowed; transform: none;
}
@media (max-width: 480px) {
  #bl-satc-{{ section.id }} .bl-satc-img { display: none; }
  #bl-satc-{{ section.id }} .bl-satc-inner { gap: 0.9rem; }
}

/* ── Description — full-width below grid ─── */
#{{ section_id }} .bl-pd-desc-below-wrap {
  margin-top: clamp(3.5rem, 5vw, 6rem);
  padding-top: clamp(3rem, 4.5vw, 5rem);
  border-top: 1px solid rgba(7,209,110,0.18);
  position: relative; z-index: 10;
}
#{{ section_id }} .bl-pd-desc-below-inner {
  max-width: 900px; margin-inline: auto;
}

/* ── Description — paginated layout ─── */
#{{ section_id }} .bl-pd-desc-paged-wrap {
  margin-top: clamp(3.5rem, 5vw, 6rem);
  padding-top: clamp(3rem, 4.5vw, 5rem);
  border-top: 1px solid rgba(7,209,110,0.18);
  position: relative; z-index: 10;
}
#{{ section_id }} .bl-pd-desc-paged-header {
  margin-bottom: 2.4rem;
}
#{{ section_id }} .bl-pd-desc-paged-eyebrow {
  display: inline-flex; align-items: center; gap: 0.8rem;
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif);
  font-size: clamp(0.95rem, 1vw, 1.1rem); font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--bl-pd-accent); margin-bottom: 0.8rem;
}
#{{ section_id }} .bl-pd-desc-paged-eyebrow::before {
  content: ''; width: 2.4rem; height: 2px;
  background: var(--bl-pd-accent); display: block;
}
#{{ section_id }} .bl-pd-desc-paged-title {
  font-family: var(--bl-font-primary, 'Archivo Black', sans-serif);
  font-weight: 400; font-size: clamp(1.8rem, 3vw, 3rem);
  color: var(--bl-pd-text); line-height: 1.08; letter-spacing: -0.02em;
  overflow-wrap: break-word; word-break: break-word;
}
#{{ section_id }} .bl-pd-desc-paged-body {
  max-width: 900px; margin-inline: auto;
}
/* Individual pages */
#{{ section_id }} .bl-pd-desc-page {
  display: none;
}
#{{ section_id }} .bl-pd-desc-page.is-active {
  display: block;
  animation: bl-page-in 0.4s cubic-bezier(0.16,1,0.3,1) both;
}
#{{ section_id }} .bl-pd-desc-page.is-exit {
  animation: bl-page-out 0.25s ease forwards;
}
@keyframes bl-page-in {
  from { opacity: 0; transform: translateX(20px); }
  to   { opacity: 1; transform: none; }
}
@keyframes bl-page-out {
  from { opacity: 1; transform: none; }
  to   { opacity: 0; transform: translateX(-20px); }
}
/* Pager controls */
#{{ section_id }} .bl-pd-desc-pager {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1.6rem; margin-top: 3rem;
  padding-top: 2rem; border-top: 1px solid rgba(7,209,110,0.12);
  flex-wrap: wrap;
}
#{{ section_id }} .bl-pd-desc-pager-btn {
  display: inline-flex; align-items: center; gap: 0.6rem;
  background: var(--bl-pd-surface) !important;
  color: var(--bl-pd-text) !important;
  border: 1.5px solid rgba(51,104,112,0.38) !important;
  border-radius: 50px !important;
  padding: 0.8rem 1.8rem !important;
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif) !important;
  font-size: clamp(1.2rem, 1.3vw, 1.4rem) !important; font-weight: 600 !important;
  cursor: pointer; transition: border-color 0.22s ease, color 0.22s ease, background 0.22s ease, transform 0.2s ease !important;
  will-change: transform;
}
#{{ section_id }} .bl-pd-desc-pager-btn:hover:not(:disabled) {
  border-color: var(--bl-pd-accent) !important; color: var(--bl-pd-accent) !important;
  background: rgba(7,209,110,0.08) !important; transform: translateY(-2px) !important;
}
#{{ section_id }} .bl-pd-desc-pager-btn:disabled {
  opacity: 0.3; cursor: not-allowed; transform: none !important;
}
#{{ section_id }} .bl-pd-desc-pager-dots {
  display: flex; gap: 0.55rem; align-items: center;
}
#{{ section_id }} .bl-pd-desc-pager-dot {
  width: 0.72rem; height: 0.72rem; border-radius: 50%;
  background: rgba(51,104,112,0.45); border: none; cursor: pointer;
  transition: background 0.22s ease, transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
  padding: 0;
}
#{{ section_id }} .bl-pd-desc-pager-dot.is-active {
  background: var(--bl-pd-accent); transform: scale(1.35);
}
#{{ section_id }} .bl-pd-desc-pager-count {
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif);
  font-size: 1.2rem; color: var(--bl-pd-muted); letter-spacing: 0.06em;
}
@media (max-width: 480px) {
  #{{ section_id }} .bl-pd-desc-pager { flex-direction: column; align-items: center; gap: 1.2rem; }
  #{{ section_id }} .bl-pd-desc-pager-btn { width: 100%; justify-content: center; }
}
@media (prefers-reduced-motion: reduce) {
  #{{ section_id }} .bl-pd-desc-page.is-active { animation: none; }
  #{{ section_id }} .bl-pd-desc-page.is-exit { animation: none; }
}

/* ── Inventory — custom badge (replaces Evolve snippet) ── */
#{{ section_id }} .bl-inv-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.1rem 0.5rem 0.8rem;
  border-radius: 50px;
  border: 1px solid var(--_inv-border, rgba(7,209,110,0.35));
  background: var(--_inv-bg, rgba(7,209,110,0.08));
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif);
  font-size: clamp(1.15rem, 1.3vw, 1.35rem);
  font-weight: 600;
  color: var(--_inv-clr, #07d16e);
}
#{{ section_id }} .bl-inv-dot {
  display: block; /* block inside flex = no baseline drama */
  width: 0.6rem; height: 0.6rem;
  border-radius: 50%;
  background: var(--_inv-clr, #07d16e);
  flex-shrink: 0;
}

/* ══════════════════════════════════════════════════════
   TABBED DESCRIPTION — below the product grid
══════════════════════════════════════════════════════ */
#{{ section_id }} .bl-pd-tabbed-wrap {
  margin-top: clamp(3.5rem, 5vw, 6rem);
  padding-top: clamp(3rem, 4.5vw, 5rem);
  border-top: 1px solid rgba(7,209,110,0.18);
  position: relative; z-index: 10;
}

/* Tab nav */
#{{ section_id }} .bl-pd-tabs-nav {
  display: flex; gap: 0;
  border-bottom: 1px solid rgba(51,104,112,0.25);
  margin-bottom: clamp(2.4rem, 4vw, 4rem);
  overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
}
#{{ section_id }} .bl-pd-tabs-nav::-webkit-scrollbar { display: none; }

#{{ section_id }} .bl-pd-tab-btn {
  position: relative;
  display: inline-flex; align-items: center;
  padding: 1.2rem 2.6rem;
  background: transparent; border: none;
  border-bottom: 2px solid transparent;
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif);
  font-size: clamp(1.1rem, 1.2vw, 1.35rem); font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: rgba(234,244,245,0.42);
  cursor: pointer; white-space: nowrap; flex-shrink: 0;
  transition: color 0.25s ease, border-color 0.25s ease;
  margin-bottom: -1px;
}
#{{ section_id }} .bl-pd-tab-btn:hover { color: rgba(234,244,245,0.75); }
#{{ section_id }} .bl-pd-tab-btn.is-active {
  color: var(--bl-pd-accent);
  border-bottom-color: var(--bl-pd-accent);
}

/* Tab panels */
#{{ section_id }} .bl-pd-tab-panel { display: none; }
#{{ section_id }} .bl-pd-tab-panel.is-active {
  display: block;
  animation: bl-tab-in 0.35s cubic-bezier(0.16,1,0.3,1) both;
}
@keyframes bl-tab-in {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: none; }
}
@media (prefers-reduced-motion: reduce) {
  #{{ section_id }} .bl-pd-tab-panel.is-active { animation: none; }
}

/* Description two-column — with images: text LEFT sticky, images RIGHT scroll */
#{{ section_id }} .bl-pd-desc-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2.4rem, 4vw, 5rem);
  align-items: start;
}
#{{ section_id }} .bl-pd-desc-split-text {
  min-width: 0;
  position: sticky;
  /* var(--header-height) covers the main navbar;
     extra 6.5rem covers the sticky ATC bar that appears on scroll */
  top: calc(var(--header-height, 6.4rem) + 6.5rem);
  align-self: start;
}
#{{ section_id }} .bl-pd-desc-split-imgs {
  min-width: 0; display: flex; flex-direction: column; gap: 1.4rem;
}
#{{ section_id }} .bl-pd-desc-split-imgs img {
  width: 100% !important; height: auto !important;
  border-radius: var(--bl-pd-radius) !important; display: block !important;
  box-shadow: 0 8px 32px rgba(0,0,0,0.32) !important;
  margin-block: 0 !important;
}

/* Description two-column — no images: CSS columns */
#{{ section_id }} .bl-pd-desc-cols {
  column-count: 2;
  column-gap: clamp(2.4rem, 4vw, 5rem);
  column-rule: 1px solid rgba(51,104,112,0.18);
}
#{{ section_id }} .bl-pd-desc-cols p:first-child { margin-top: 0 !important; }

/* Additional info specs table */
#{{ section_id }} .bl-pd-specs-table {
  width: 100%; border-collapse: collapse;
}
#{{ section_id }} .bl-pd-specs-table tr {
  border-bottom: 1px solid rgba(51,104,112,0.15);
}
#{{ section_id }} .bl-pd-specs-table tr:last-child { border-bottom: none; }
#{{ section_id }} .bl-pd-specs-table th {
  width: 35%; padding: 1rem 1.2rem 1rem 0;
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif);
  font-size: clamp(1.2rem, 1.3vw, 1.4rem); font-weight: 700;
  letter-spacing: 0.04em; color: var(--bl-pd-accent);
  text-align: left; vertical-align: top;
}
#{{ section_id }} .bl-pd-specs-table td {
  padding: 1rem 0;
  font-family: var(--bl-font-secondary, 'DM Sans', sans-serif);
  font-size: clamp(1.2rem, 1.3vw, 1.4rem); font-weight: 400;
  color: var(--bl-pd-text); line-height: 1.6; vertical-align: top;
}
/* ── Tabbed section: mobile responsive ── */
@media (max-width: 768px) {
  /* Single column for both split and CSS-columns layouts */
  #{{ section_id }} .bl-pd-desc-split {
    grid-template-columns: 1fr !important;
  }
  /* Disable sticky on mobile — just stacks naturally */
  #{{ section_id }} .bl-pd-desc-split-text {
    position: static !important;
    top: auto !important;
  }
  /* Images go below text on mobile */
  #{{ section_id }} .bl-pd-desc-split-imgs {
    width: 100%;
  }
  /* Collapse two CSS columns to one */
  #{{ section_id }} .bl-pd-desc-cols {
    column-count: 1 !important;
    column-rule: none !important;
  }
  /* Tab buttons: smaller, still scrollable row */
  #{{ section_id }} .bl-pd-tab-btn {
    padding: 1rem 1.8rem;
    font-size: clamp(1rem, 3.2vw, 1.2rem);
    letter-spacing: 0.08em;
  }
  /* Tabbed wrap: tighter top spacing */
  #{{ section_id }} .bl-pd-tabbed-wrap {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  /* Give tab panels comfortable reading padding */
  #{{ section_id }} .bl-pd-tab-panel {
    padding-inline: 0;
  }
  /* Specs table: stack label above value */
  #{{ section_id }} .bl-pd-specs-table th,
  #{{ section_id }} .bl-pd-specs-table td { display: block; width: 100%; }
  #{{ section_id }} .bl-pd-specs-table th { padding-bottom: 0.2rem; }
  #{{ section_id }} .bl-pd-specs-table td { padding-top: 0; padding-bottom: 1.2rem; }
}
@media (max-width: 480px) {
  #{{ section_id }} .bl-pd-tab-btn {
    padding: 0.9rem 1.4rem;
    font-size: 1rem;
  }
}

/* ══════════════════════════════════════════════════════
   VISUAL CANVAS MODE — parallax image panel + full text
══════════════════════════════════════════════════════ */
#{{ section_id }} .bl-pd-story-wrap {
  margin-top: clamp(3.5rem, 5vw, 6rem);
  padding-top: clamp(3rem, 4.5vw, 5rem);
  border-top: 1px solid rgba(7,209,110,0.18);
  position: relative; z-index: 10;
}

/* ── Canvas: progress bar ── */
#{{ section_id }} .bl-pd-story-progress {
  width: 100%; height: 3px;
  background: rgba(51,104,112,0.2);
  border-radius: 3px; overflow: hidden;
  margin-bottom: clamp(3rem, 5vw, 5rem);
}
#{{ section_id }} .bl-pd-story-progress-fill {
  height: 100%; width: 0%;
  background: linear-gradient(90deg, var(--bl-pd-accent), rgba(51,104,112,0.8));
  border-radius: 3px; transition: width 0.1s linear; will-change: width;
}

/* ── Canvas: text section — two-column grid ── */
#{{ section_id }} .bl-canvas-text-section {
  margin-bottom: clamp(3rem, 5vw, 5rem);
}
#{{ section_id }} .bl-canvas-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2.4rem, 5vw, 5.5rem);
  align-items: start;
}

/* Description column */
#{{ section_id }} .bl-canvas-text {
  font-family: 'DM Sans', sans-serif;
  font-size: var(--bl-pd-b-size); line-height: 1.75;
  color: var(--bl-pd-text);
  min-width: 0;
}
#{{ section_id }} .bl-canvas-text * { color: var(--bl-pd-text) !important; }
#{{ section_id }} .bl-canvas-text strong,
#{{ section_id }} .bl-canvas-text b    { color: var(--bl-pd-accent) !important; }
#{{ section_id }} .bl-canvas-text a    { color: var(--bl-pd-accent) !important; }
#{{ section_id }} .bl-canvas-text h1,
#{{ section_id }} .bl-canvas-text h2,
#{{ section_id }} .bl-canvas-text h3,
#{{ section_id }} .bl-canvas-text h4 {
  font-family: 'DM Sans', sans-serif !important; font-weight: 700 !important;
  color: var(--bl-pd-text) !important; line-height: 1.2 !important;
  margin: 1.2em 0 0.6em !important;
  padding-bottom: 0.65rem !important;
  border-bottom: 2px solid var(--bl-pd-accent) !important;
}
#{{ section_id }} .bl-canvas-text h1:first-child,
#{{ section_id }} .bl-canvas-text h2:first-child,
#{{ section_id }} .bl-canvas-text h3:first-child { margin-top: 0 !important; }
#{{ section_id }} .bl-canvas-text h2 { font-size: clamp(1.45rem,1.9vw,1.8rem) !important; }
#{{ section_id }} .bl-canvas-text h3 { font-size: clamp(1.3rem,1.6vw,1.6rem) !important; }
#{{ section_id }} .bl-canvas-text ul,
#{{ section_id }} .bl-canvas-text ol  { padding-left: 2em !important; }
#{{ section_id }} .bl-canvas-text ul  { list-style-type: disc !important; }
#{{ section_id }} .bl-canvas-text li  { display: list-item !important; margin-bottom: 0.4em !important; }
#{{ section_id }} .bl-canvas-text li > p { display: inline !important; margin: 0 !important; }
#{{ section_id }} .bl-canvas-text p   { margin-bottom: 0.9em !important; }

/* Additional info column — sticky */
#{{ section_id }} .bl-canvas-info {
  min-width: 0;
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(51,104,112,0.2);
  border-radius: 14px;
  padding: clamp(1.6rem, 2.5vw, 2.4rem);
  position: sticky;
  top: calc(var(--header-height, 6.4rem) + 8.5rem);
  align-self: start;
}
#{{ section_id }} .bl-canvas-info-heading {
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(0.85rem, 0.95vw, 1rem); font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--bl-pd-accent);
  display: flex; align-items: center; gap: 0.6rem;
  margin-bottom: 1.4rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(51,104,112,0.2);
}
#{{ section_id }} .bl-canvas-info-heading::before {
  content: ''; width: 1.8rem; height: 2px;
  background: var(--bl-pd-accent); border-radius: 2px; flex-shrink: 0;
}
#{{ section_id }} .bl-canvas-info-row {
  display: flex; gap: 0.8rem; padding: 0.75rem 0;
  border-bottom: 1px solid rgba(51,104,112,0.1);
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(1.15rem, 1.25vw, 1.3rem); line-height: 1.5;
}
#{{ section_id }} .bl-canvas-info-row:last-child { border-bottom: none; padding-bottom: 0; }
#{{ section_id }} .bl-canvas-info-key {
  flex: 0 0 42%; color: rgba(234,244,245,0.5); font-weight: 600;
}
#{{ section_id }} .bl-canvas-info-val {
  flex: 1; color: var(--bl-pd-text); font-weight: 400; min-width: 0;
  overflow-wrap: break-word; word-break: break-word;
}

/* Mobile: stack columns */
@media (max-width: 768px) {
  #{{ section_id }} .bl-canvas-2col { grid-template-columns: 1fr; gap: 2rem; }
}

/* ── Canvas: gallery section (below text) ── */
#{{ section_id }} .bl-canvas-gallery-section {
  border-top: 1px solid rgba(7,209,110,0.15);
  padding-top: clamp(2.4rem, 4vw, 4rem);
}
#{{ section_id }} .bl-canvas-gallery-label {
  display: inline-flex; align-items: center; gap: 0.8rem;
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(0.9rem, 1vw, 1.1rem); font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--bl-pd-accent); margin-bottom: clamp(1.4rem, 2.5vw, 2.4rem);
  position: relative; z-index: 5; /* always above parallax items */
  background: var(--bl-pd-bg); /* opaque bg so images can't bleed through */
  padding-right: 1rem;
}
#{{ section_id }} .bl-canvas-gallery-label::before {
  content: ''; display: block; width: 2.2rem; height: 2px;
  background: var(--bl-pd-accent); border-radius: 2px; flex-shrink: 0;
}

/* Masonry-style auto grid */
#{{ section_id }} .bl-canvas-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.2rem;
  padding-top: 0.5rem; /* buffer so parallax upward shift doesn't hit label */
}
#{{ section_id }} .bl-canvas-gallery-item {
  border-radius: var(--bl-pd-radius);
  overflow: hidden;
  cursor: zoom-in;
  will-change: transform;
  box-shadow: 0 6px 24px rgba(0,0,0,0.28);
  transition: box-shadow 0.35s ease, transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
  position: relative; z-index: 1; /* below the label's z-index: 5 */
}
#{{ section_id }} .bl-canvas-gallery-item:hover {
  box-shadow: 0 14px 44px rgba(7,209,110,0.2), 0 6px 18px rgba(0,0,0,0.32);
  transform: translateY(-4px) scale(1.015);
}
#{{ section_id }} .bl-canvas-gallery-item img {
  width: 100% !important; height: 200px !important;
  object-fit: cover !important; display: block !important;
  transition: transform 0.5s ease;
}
#{{ section_id }} .bl-canvas-gallery-item:hover img { transform: scale(1.06); }

/* Zoom icon on hover */
#{{ section_id }} .bl-canvas-gallery-item::after {
  content: '';
  position: absolute; inset: 0;
  background: rgba(7,209,110,0); border-radius: inherit;
  transition: background 0.3s ease;
  pointer-events: none;
}
#{{ section_id }} .bl-canvas-gallery-item:hover::after {
  background: rgba(7,209,110,0.08);
}

/* ── Canvas lightbox ── */
.bl-canvas-lb {
  position: fixed; inset: 0; z-index: 9998;
  background: rgba(0,8,18,0.96); backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.bl-canvas-lb.is-open { opacity: 1; visibility: visible; }
.bl-canvas-lb-img-wrap {
  max-width: min(88vw, 1100px); max-height: 85vh; position: relative;
}
.bl-canvas-lb-img {
  max-width: 100%; max-height: 85vh; object-fit: contain;
  border-radius: 12px; display: block;
  box-shadow: 0 24px 80px rgba(0,0,0,0.65);
  transition: opacity 0.2s ease;
}
.bl-canvas-lb-close,
.bl-canvas-lb-prev,
.bl-canvas-lb-next {
  position: fixed; width: 4.4rem; height: 4.4rem; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.15);
  background: rgba(0,26,46,0.7); color: #fff;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease, transform 0.2s ease; z-index: 9999;
}
.bl-canvas-lb-close:hover,
.bl-canvas-lb-prev:hover,
.bl-canvas-lb-next:hover { background: rgba(7,209,110,0.3); }
.bl-canvas-lb-close { top: 1.6rem; right: 1.6rem; }
.bl-canvas-lb-prev  { left: 1.6rem; top: 50%; transform: translateY(-50%); }
.bl-canvas-lb-next  { right: 1.6rem; top: 50%; transform: translateY(-50%); }
.bl-canvas-lb-prev:hover { transform: translateY(-50%) scale(1.1); }
.bl-canvas-lb-next:hover { transform: translateY(-50%) scale(1.1); }
.bl-canvas-lb-count {
  position: fixed; bottom: 1.6rem; left: 50%; transform: translateX(-50%);
  font-family: 'DM Sans', sans-serif; font-size: 1.2rem;
  color: rgba(255,255,255,0.45); letter-spacing: 0.06em; z-index: 9999;
}
@media (max-width: 480px) {
  .bl-canvas-lb-prev { left: 0.6rem; }
  .bl-canvas-lb-next { right: 0.6rem; }
  .bl-canvas-lb-close { top: 0.8rem; right: 0.8rem; }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  #{{ section_id }} .bl-canvas-gallery-item { transform: none !important; transition: box-shadow 0.3s ease !important; }
  #{{ section_id }} .bl-canvas-gallery-item img { transition: none !important; }
}
/* ── Mobile ── */
@media (max-width: 768px) {
  #{{ section_id }} .bl-canvas-text { column-count: 1 !important; column-rule: none; }
  #{{ section_id }} .bl-canvas-gallery { grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }
  #{{ section_id }} .bl-canvas-gallery-item img { height: 150px !important; }
}
@media (max-width: 480px) {
  #{{ section_id }} .bl-canvas-gallery { grid-template-columns: 1fr; }
  #{{ section_id }} .bl-canvas-gallery-item img { height: 220px !important; }
}


/* ── Image hover magnifier (lens) ─── */
{% if enable_zoom %}
#{{ section_id }} .bl-zoom-lens {
  position: absolute;
  width: 130px; height: 130px;
  border: 2px solid rgba(7,209,110,0.75);
  box-shadow: 0 0 0 1px rgba(7,209,110,0.25), inset 0 0 20px rgba(7,209,110,0.06);
  border-radius: 6px;
  cursor: crosshair;
  pointer-events: none;
  display: none;
  z-index: 25;
  will-change: transform;
}
/* Zoom result lives outside section (appended to body), so scoped only by JS-set id */
.bl-zoom-result-{{ section.id }} {
  position: fixed;
  width: 380px; height: 380px;
  border: 1px solid rgba(7,209,110,0.35);
  border-radius: {{ img_radius }}px;
  background-color: {{ bg_color }};
  background-repeat: no-repeat;
  display: none;
  z-index: 9000;
  pointer-events: none;
  box-shadow: 0 28px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(7,209,110,0.18);
  overflow: hidden;
}
.bl-zoom-result-{{ section.id }}::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(7,209,110,0.04) 0%, transparent 60%);
  pointer-events: none;
}
@media (max-width: 1280px) {
  .bl-zoom-result-{{ section.id }} { width: 300px; height: 300px; }
}
{% endif %}

{% endstyle %}

<div
  id="{{ section_id }}"
  style="padding-top: {{ pad_top }}px; padding-bottom: {{ pad_bot }}px;"
>

  {%- if enable_glow -%}
    <div class="bl-pd-glow bl-pd-glow--1" aria-hidden="true"></div>
    <div class="bl-pd-glow bl-pd-glow--2" aria-hidden="true"></div>
  {%- endif -%}

  <div class="bl-pd-bg-text" aria-hidden="true">{{ product.title | upcase | truncate: 20, '' }}</div>

  <div class="bl-pd-wrap">

    {%- if show_crumbs -%}
      <nav class="bl-pd-crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="bl-pd-crumbs-sep" aria-hidden="true">›</span>
        {%- if product.collections.first -%}
          <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
          <span class="bl-pd-crumbs-sep" aria-hidden="true">›</span>
        {%- endif -%}
        <span aria-current="page">{{ product.title | escape | truncate: 60 }}</span>
      </nav>
    {%- endif -%}

    <main-product
      data-main-product="true"
      data-product-url="{{ product.url }}"
      data-section-id="{{ section.id }}"
      data-original-section-id="{{ section.id }}"
      data-update-url="true"
      data-base-url="{{ routes.root_url }}"
    >
      <div class="bl-pd-grid">

        {%- comment -%}── Media Column ──{%- endcomment -%}
        <div class="bl-pd-media-col">
          <div class="bl-pd-gallery">

            <div class="bl-pd-main-wrap" id="bl-pd-main-{{ section.id }}">

              {%- for media in product.media -%}
                <div
                  class="bl-pd-slide{% if media.id == featured_media.id or forloop.first and featured_media == blank %} is-active{% endif %}"
                  data-media-id="{{ media.id }}"
                >
                  {%- if media.media_type == 'image' -%}
                    <img
                      src="{{ media | image_url: width: 1000 }}"
                      srcset="{{ media | image_url: width: 500 }} 500w, {{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1000 }} 1000w"
                      alt="{{ media.alt | default: product.title | escape }}"
                      loading="{%- if forloop.first -%}eager{%- else -%}lazy{%- endif -%}"
                      fetchpriority="{%- if forloop.first -%}high{%- else -%}auto{%- endif -%}"
                    >
                  {%- elsif media.media_type == 'video' -%}
                    <video autoplay muted loop playsinline>
                      {%- for source in media.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endfor -%}
                    </video>
                  {%- elsif media.media_type == 'external_video' -%}
                    <img src="{{ media | image_url: width: 1000 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy">
                  {%- endif -%}
                </div>
              {%- endfor -%}

              {%- for block in section.blocks -%}
                {%- if block.type == 'extra-photos' -%}
                  {%- for i in (1..6) -%}
                    {%- assign img_key = 'photo_' | append: i -%}
                    {%- assign extra_img = block.settings[img_key] -%}
                    {%- if extra_img != blank -%}
                      <div class="bl-pd-slide" data-media-id="x-{{ block.id }}-{{ i }}">
                        <img
                          src="{{ extra_img | image_url: width: 1000 }}"
                          srcset="{{ extra_img | image_url: width: 500 }} 500w, {{ extra_img | image_url: width: 1000 }} 1000w"
                          alt="{{ extra_img.alt | default: product.title | escape }}"
                          loading="lazy"
                        >
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if enable_zoom -%}
                <button class="bl-pd-zoom" id="bl-pd-zoom-{{ section.id }}" aria-label="Zoom image" type="button">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
                    <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
                  </svg>
                </button>
              {%- endif -%}

              <button class="bl-pd-arr bl-pd-arr--p" aria-label="Previous image" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>
              </button>
              <button class="bl-pd-arr bl-pd-arr--n" aria-label="Next image" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>
              </button>

            </div>

            {%- assign total_slides = product.media.size -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'extra-photos' -%}
                {%- for i in (1..6) -%}
                  {%- assign img_key = 'photo_' | append: i -%}
                  {%- if block.settings[img_key] != blank -%}
                    {%- assign total_slides = total_slides | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if total_slides > 1 -%}
              <div class="bl-pd-thumbs" id="bl-pd-thumbs-{{ section.id }}" role="list">

                {%- for media in product.media -%}
                  <button
                    class="bl-pd-thumb{% if media.id == featured_media.id or forloop.first and featured_media == blank %} is-active{% endif %}"
                    data-media-id="{{ media.id }}"
                    type="button"
                    role="listitem"
                    aria-label="View image {{ forloop.index }}"
                  >
                    <img src="{{ media | image_url: width: 150 }}" alt="" loading="lazy">
                    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <span class="bl-pd-thumb-play">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5,3 19,12 5,21"/></svg>
                      </span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}

                {%- for block in section.blocks -%}
                  {%- if block.type == 'extra-photos' -%}
                    {%- for i in (1..6) -%}
                      {%- assign img_key = 'photo_' | append: i -%}
                      {%- assign extra_img = block.settings[img_key] -%}
                      {%- if extra_img != blank -%}
                        <button class="bl-pd-thumb" data-media-id="x-{{ block.id }}-{{ i }}" type="button" role="listitem" aria-label="View extra image {{ i }}">
                          <img src="{{ extra_img | image_url: width: 150 }}" alt="" loading="lazy">
                        </button>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}

              </div>
            {%- endif -%}

          </div>
        </div>

        {%- comment -%}── Info Column ──{%- endcomment -%}
        <div class="bl-pd-info-col">
          <div class="bl-pd-info-inner">

            {%- comment -%}Pre-compute description layout so collapsible-tab can check it{%- endcomment -%}
            {%- assign _desc_layout_mode = 'column' -%}
            {%- for _b in section.blocks -%}
              {%- if _b.type == 'description' -%}
                {%- assign _desc_layout_mode = _b.settings.desc_layout | default: 'column' -%}
              {%- endif -%}
            {%- endfor -%}

            {%- for block in section.blocks -%}
              {%- case block.type -%}

                {%- when '@app' -%}
                  {%- render block -%}

                {%- when 'extra-photos' -%}
                  {%- comment -%}Rendered in gallery — no info column output{%- endcomment -%}

                {%- when 'vendor' -%}
                  {%- if product.vendor != blank -%}
                    <div class="bl-pd-block bl-pd-vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</div>
                  {%- endif -%}

                {%- when 'title' -%}
                  <div class="bl-pd-block" {{ block.shopify_attributes }}>
                    <h1 class="bl-pd-title">{{ product.title }}</h1>
                  </div>

                {%- when 'price' -%}
                  {%- assign _p_clr = block.settings.price_color -%}
                  {%- assign _cp_clr = block.settings.compare_price_color -%}
                  {%- if _p_clr == blank -%}{%- assign _p_clr = accent_color -%}{%- endif -%}
                  {%- if _cp_clr == blank -%}{%- assign _cp_clr = muted_color -%}{%- endif -%}
                  <div class="bl-pd-block bl-pd-price" id="Price-{{ section.id }}"
                    style="--price-clr: {{ _p_clr }}; --compare-clr: {{ _cp_clr }};"
                    {{ block.shopify_attributes }}>
                    {%- render 'product-price', product: product, is_product_section: true, show_badges: true -%}
                    {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                      <div class="product_tax" style="margin-top:0.5rem; font-family:'DM Sans',sans-serif; font-size:1.2rem; color:{{ muted_color }};">
                        {%- if cart.duties_included and cart.taxes_included -%}{{ 'products.product.duties_and_taxes_included' | t }}
                        {%- elsif cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}
                        {%- elsif cart.duties_included -%}{{ 'products.product.duties_included' | t }}
                        {%- endif -%}
                        {%- if shop.shipping_policy.body != blank -%}
                          &nbsp;·&nbsp;{{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- assign form_id = 'product-form-installment-' | append: section.id -%}
                    {%- form 'product', product, id: form_id, class: 'installment' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      {{ form | payment_terms }}
                    {%- endform -%}
                  </div>

                {%- when 'feature-badges' -%}
                  <div class="bl-pd-block bl-pd-badges" {{ block.shopify_attributes }}>
                    {%- for i in (1..4) -%}
                      {%- assign text_key = 'badge_text_' | append: i -%}
                      {%- assign icon_key = 'badge_icon_' | append: i -%}
                      {%- assign badge_text = block.settings[text_key] -%}
                      {%- assign badge_icon = block.settings[icon_key] -%}
                      {%- if badge_text != blank -%}
                        <div class="bl-pd-badge">
                          {%- if badge_icon == 'shield' -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                          {%- elsif badge_icon == 'truck' -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                          {%- elsif badge_icon == 'refresh' -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
                          {%- elsif badge_icon == 'star' -%}
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          {%- elsif badge_icon == 'check' -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                          {%- else -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                          {%- endif -%}
                          {{ badge_text | escape }}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>

                {%- when 'sku' -%}
                  <div class="bl-pd-block bl-pd-sku" id="SKU-{{ section.id }}" {{ block.shopify_attributes }}>
                    {%- if product.selected_or_first_available_variant.sku != blank -%}
                      SKU: <strong>{{ product.selected_or_first_available_variant.sku }}</strong>
                    {%- endif -%}
                  </div>

                {%- when 'separator' -%}
                  <div class="bl-pd-block bl-pd-sep" style="opacity: {{ block.settings.opacity | default: 60 }}%;" {{ block.shopify_attributes }}></div>

                {%- when 'description' -%}
                  {%- assign desc_layout = block.settings.desc_layout | default: 'column' -%}
                  {%- if product.description != blank and desc_layout == 'column' -%}
                    <div class="bl-pd-block bl-pd-desc rte" {{ block.shopify_attributes }}>
                      {{ product.description }}
                    </div>
                  {%- elsif desc_layout != 'column' -%}
                    {%- comment -%}Placeholder keeps block clickable in editor; content renders below grid{%- endcomment -%}
                    <div class="bl-pd-block bl-pd-desc-placeholder" {{ block.shopify_attributes }}
                      style="display:none;" aria-hidden="true"></div>
                  {%- endif -%}

                {%- when 'product-siblings' -%}
                  {%- if product.metafields.custom.product_siblings != blank -%}
                    <div class="bl-pd-block bl-pd-sib" {{ block.shopify_attributes }}>
                      {%- assign sibling_products = product.metafields.custom.product_siblings.value -%}
                      {%- assign active_color = '' -%}
                      {%- for sib in sibling_products -%}
                        {%- if sib.product.value.title == product.title -%}
                          {%- assign active_color = sib.color_name.value -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <div class="main_product_options_header" style="margin-bottom:0.8rem;">
                        <h4 style="font-family:'DM Sans',sans-serif;font-weight:600;font-size:1.3rem;color:{{ text_color }};">
                          {{ block.settings.label | default: 'Color' }}: <span style="color:{{ accent_color }};">{{ active_color }}</span>
                        </h4>
                      </div>
                      <div class="product_siblings_products" style="display:flex;flex-wrap:wrap;gap:0.6rem;">
                        {%- for sib in sibling_products -%}
                          {%- assign p = sib.product.value -%}
                          {%- assign color_val = sib.color_value.value -%}
                          <a href="{{ p.url }}" title="{{ p.title | escape }}"
                            class="swatch_label swatch_circle{% if product.title == p.title %} active{% endif %}"
                            aria-label="{{ p.title | escape }}"
                          >
                            {%- if block.settings.use_image -%}
                              <span>{{ p.featured_image | image_url: width: 150 | image_tag }}</span>
                            {%- else -%}
                              <span style="--background: {{ color_val }};"></span>
                            {%- endif -%}
                          </a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}

                {%- when 'variant-picker' -%}
                  {%- assign _opt_lbl_clr = block.settings.option_label_color -%}
                  {%- if _opt_lbl_clr == blank -%}{%- assign _opt_lbl_clr = '#eaf4f5' -%}{%- endif -%}
                  <div class="bl-pd-block bl-pd-vars" id="Variant_picker-{{ section.id }}" data-label-color="{{ _opt_lbl_clr }}" {{ block.shopify_attributes }}>
                    {%- render 'variant-picker', product: product, picker_type: block.settings.options_type, swatch_shape: settings.swatch_shape -%}
                  </div>

                {%- when 'quantity' -%}
                  <div class="bl-pd-block bl-pd-qty" id="Quantity-{{ section.id }}" {{ block.shopify_attributes }}>
                    {%- render 'quantity-input', product: product, block: block -%}
                  </div>

                {%- when 'add-to-cart' -%}
                  <div class="bl-pd-block bl-pd-atc" id="Action_buttons-{{ section.id }}" {{ block.shopify_attributes }}>
                    {%- assign gift_card_feature = false -%}
                    {%- if block.settings.show_gift_card_feature and product.gift_card? -%}
                      {%- assign gift_card_feature = true -%}
                    {%- endif -%}
                    {%- render 'action-buttons', product: product, show_dynamic_button: block.settings.show_dynamic_button, gift_card_feature: gift_card_feature -%}
                  </div>

                {%- when 'inventory' -%}
                  <div class="bl-pd-block" id="Inventory-{{ section.id }}" {{ block.shopify_attributes }}>
                    {%- liquid
                      assign _cv       = product.selected_or_first_available_variant
                      assign _thresh   = block.settings.threshold | default: 10
                      assign _in_clr   = block.settings.in_stock_color     | default: '#07d16e'
                      assign _out_clr  = block.settings.out_of_stock_color | default: '#ff4444'
                      assign _low_clr  = block.settings.threshold_color    | default: '#e8a000'
                      if _cv.available
                        if _cv.inventory_management != blank and _cv.inventory_quantity <= _thresh
                          assign _inv_label = 'Only ' | append: _cv.inventory_quantity | append: ' left'
                          assign _inv_state = 'low'
                          assign _inv_clr   = _low_clr
                          assign _inv_bg    = 'rgba(232,160,0,0.08)'
                          assign _inv_bdr   = 'rgba(232,160,0,0.35)'
                        else
                          assign _inv_label = 'In Stock'
                          assign _inv_state = 'in'
                          assign _inv_clr   = _in_clr
                          assign _inv_bg    = 'rgba(7,209,110,0.08)'
                          assign _inv_bdr   = 'rgba(7,209,110,0.35)'
                        endif
                      else
                        assign _inv_label = 'Out of Stock'
                        assign _inv_state = 'out'
                        assign _inv_clr   = _out_clr
                        assign _inv_bg    = 'rgba(255,68,68,0.08)'
                        assign _inv_bdr   = 'rgba(255,68,68,0.35)'
                      endif
                    -%}
                    <div class="bl-inv-badge bl-inv-badge--{{ _inv_state }}"
                      id="bl-inv-custom-{{ section.id }}"
                      data-threshold="{{ _thresh }}"
                      data-in-clr="{{ _in_clr }}"
                      data-out-clr="{{ _out_clr }}"
                      data-low-clr="{{ _low_clr }}"
                      style="--_inv-clr:{{ _inv_clr }};--_inv-bg:{{ _inv_bg }};--_inv-border:{{ _inv_bdr }};"
                    >
                      <span class="bl-inv-dot"></span>
                      <span class="bl-inv-text">{{ _inv_label }}</span>
                    </div>
                  </div>

                {%- when 'collapsible-tab' -%}
                  {%- comment -%}Skip if this tab shows the description and tabbed layout already handles it below{%- endcomment -%}
                  {%- unless block.settings.show_description and _desc_layout_mode == 'tabbed' -%}
                  <div class="bl-pd-block bl-pd-tab" {{ block.shopify_attributes }}>
                    <details{% if block.settings.open_by_default %} open{% endif %}>
                      <summary>
                        <span style="overflow-wrap:break-word;word-break:break-word;">{{ block.settings.title | escape }}</span>
                        <div class="square" aria-hidden="true"><div class="hori"></div><div class="vert"></div></div>
                      </summary>
                      <div class="main_product_content_wrapper{% if block.settings.show_background %} has_bg{% endif %}">
                        <div class="main_product_content_inner rte">
                          {%- if block.settings.show_description -%}{{ product.description }}{%- else -%}{{ block.settings.content }}{%- endif -%}
                        </div>
                      </div>
                    </details>
                  </div>
                  {%- endunless -%}

                {%- when 'icon-trio' -%}
                  {%- comment -%}Three-column icon + text strip — full-width on mobile{%- endcomment -%}
                  <div class="bl-pd-block bl-pd-icon-trio" {{ block.shopify_attributes }}>
                    {%- for i in (1..3) -%}
                      {%- assign icon_key  = 'icon_'     | append: i -%}
                      {%- assign title_key = 'title_'    | append: i -%}
                      {%- assign sub_key   = 'subtitle_' | append: i -%}
                      {%- assign icon_img  = block.settings[icon_key] -%}
                      {%- assign title_txt = block.settings[title_key] -%}
                      {%- assign sub_txt   = block.settings[sub_key] -%}
                      <div class="bl-pd-icon-trio-item">
                        <span class="bl-pd-icon-trio-icon" aria-hidden="true"
                          style="color: {{ block.settings.accent_color | default: accent_color }};">
                          {%- if icon_img != blank -%}
                            <img src="{{ icon_img | image_url: width: 72 }}" alt="" loading="lazy" width="36" height="36">
                          {%- else -%}
                            {%- comment -%}
                              Slot 1 = 100% Moneyback Guarantee → shield with checkmark
                              Slot 2 = Cash on Delivery → banknote
                              Slot 3 = FREE Express Shipping → truck
                            {%- endcomment -%}
                            {%- if i == 1 -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                            {%- elsif i == 2 -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/><circle cx="8" cy="15" r="1.5" fill="currentColor" stroke="none"/></svg>
                            {%- else -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                            {%- endif -%}
                          {%- endif -%}
                        </span>
                        {%- if title_txt != blank -%}
                          <p class="bl-pd-icon-trio-title">{{ title_txt | escape }}</p>
                        {%- endif -%}
                        {%- if sub_txt != blank -%}
                          <p class="bl-pd-icon-trio-sub">{{ sub_txt | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>

                {%- when 'social-share' -%}
                  <div class="bl-pd-block bl-pd-share" {{ block.shopify_attributes }}>
                    {%- render 'social-share', share_title: product.title, share_permalink: product.url, share_image: product.featured_image -%}
                  </div>

                {%- when 'trust-badges' -%}
                  <div class="bl-pd-block bl-pd-trust" {{ block.shopify_attributes }}>
                    {%- if block.settings.head != blank -%}
                      <div class="trust_badges_head thead--{{ block.settings.head_align }}">
                        <h4 class="h6">{{ block.settings.head }}</h4>
                      </div>
                    {%- endif -%}
                    <div class="trust_badges_inner">
                      <ul style="display:flex;flex-wrap:wrap;gap:0.6rem;list-style:none;">
                        {%- for type in shop.enabled_payment_types -%}
                          <li class="trust_badge_item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>

                {%- when 'gift-wrap' -%}
                  {%- if block.settings.gift_wrap_product != blank -%}
                    <div class="bl-pd-block" {{ block.shopify_attributes }}
                      style="display:flex;align-items:center;gap:0.8rem;padding:1rem 1.4rem;background:{{ surface_color }};border:1px solid rgba(51,104,112,0.22);border-radius:10px;">
                      <input type="checkbox" id="gift_wrap_{{ section.id }}"
                        name="gift_wrap" value="{{ block.settings.gift_wrap_product.selected_or_first_available_variant.id }}"
                        style="accent-color:{{ accent_color }};width:1.6rem;height:1.6rem;cursor:pointer;">
                      <label for="gift_wrap_{{ section.id }}"
                        style="font-family:'DM Sans',sans-serif;font-size:1.4rem;cursor:pointer;color:{{ text_color }};">
                        {{ 'products.product.gift_wrap' | t }}
                      </label>
                    </div>
                  {%- endif -%}

                {%- when 'pickup-availability' -%}
                  <div class="bl-pd-block bl-pd-pickup" id="Pickup-{{ section.id }}"
                    data-store-availability-container
                    data-product-title="{{ product.title | escape }}"
                    data-has-only-default-variant="{{ product.has_only_default_variant }}"
                    data-base-url="{{ shop.url }}{{ routes.root_url }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- assign pickup_avail = product.selected_or_first_available_variant.store_availabilities | where: 'pick_up_enabled', true -%}
                    {%- if pickup_avail.size > 0 -%}
                      {%- render 'pickup-availability', product: product, product_variant: product.selected_or_first_available_variant -%}
                    {%- endif -%}
                  </div>

                {%- when 'complementary-products' -%}
                  <div class="bl-pd-block" {{ block.shopify_attributes }}>
                    <related-products
                      data-type="complementary" data-section-id="{{ section.id }}"
                      data-product-id="{{ product.id }}" data-columns="1.5"
                      data-mobile-columns="1" data-spacing="{{ settings.horizontal_spacing }}"
                      data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.limit }}&intent=complementary"
                    >
                      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
                        {%- if block.settings.head != blank -%}
                          <div style="margin-bottom:1rem;">
                            <h2 style="font-family:'Archivo Black',sans-serif;font-weight:400;font-size:clamp(1.6rem,2vw,2rem);color:{{ text_color }};">{{ block.settings.head }}</h2>
                          </div>
                        {%- endif -%}
                        <div class="complementary_products_inner swiper">
                          <div class="swiper-wrapper">
                            {%- for recommendation in recommendations.products -%}
                              <div class="swiper-slide">
                                {%- render 'product-card-horizontal', product: recommendation, index: forloop.index -%}
                              </div>
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endif -%}
                    </related-products>
                  </div>

                {%- when 'size-chart' -%}
                  {%- assign show_sc = true -%}
                  {%- if block.settings.link_checkbox and block.settings.link_option != blank -%}
                    {%- assign show_sc = false -%}
                    {%- for option in product.options_with_values -%}
                      {%- if option.name == block.settings.link_option -%}{%- assign show_sc = true -%}{%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- if show_sc -%}
                    <div class="bl-pd-block" {{ block.shopify_attributes }}>
                      <button type="button" class="bl-pd-sc-trigger"
                        style="display:inline-flex;align-items:center;gap:0.5rem;background:transparent;border:1px solid rgba(51,104,112,0.3);border-radius:50px;padding:0.5rem 1.2rem;color:{{ text_color }};font-family:'DM Sans',sans-serif;font-size:1.3rem;cursor:pointer;transition:border-color 0.2s ease;"
                        onclick="document.getElementById('bl-sc-{{ section.id }}').style.display='flex';"
                      >
                        {%- if block.settings.size_chart_icon != blank -%}
                          {{ block.settings.size_chart_icon | image_url: width: 40 | image_tag: style: 'height:2rem;width:auto;' }}
                        {%- endif -%}
                        {{ block.settings.size_title | default: 'Size chart' | escape }}
                      </button>
                    </div>
                  {%- endif -%}

              {%- endcase -%}
            {%- endfor -%}

          </div>
        </div>

      </div>
    </main-product>

    {%- comment -%}── Description — below / paginated layout ──{%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'description' -%}
        {%- assign desc_layout = block.settings.desc_layout | default: 'column' -%}
        {%- if product.description != blank and desc_layout != 'column' -%}

          {%- if desc_layout == 'tabbed' or desc_layout == 'story' -%}
            {%- comment -%}These layouts are rendered in their own loops below{%- endcomment -%}
          {%- elsif desc_layout == 'paginated' -%}

            <div class="bl-pd-desc-paged-wrap bl-reveal">
              <div class="bl-pd-desc-paged-header">
                <span class="bl-pd-desc-paged-eyebrow">Product Details</span>
                <h2 class="bl-pd-desc-paged-title">{{ product.title | truncate: 50, '' }}</h2>
              </div>
              <div class="bl-pd-desc-paged-body">
                <div class="bl-pd-desc-paged-content bl-pd-desc rte" id="bl-desc-paged-{{ section.id }}">
                  {{ product.description }}
                </div>
                <div class="bl-pd-desc-pager" id="bl-desc-pager-{{ section.id }}" style="display:none;">
                  <button class="bl-pd-desc-pager-btn bl-pd-desc-pager-btn--prev" type="button" disabled aria-label="Previous page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>
                    Previous
                  </button>
                  <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;">
                    <div class="bl-pd-desc-pager-dots" id="bl-desc-dots-{{ section.id }}"></div>
                    <span class="bl-pd-desc-pager-count" id="bl-desc-count-{{ section.id }}">1 / 1</span>
                  </div>
                  <button class="bl-pd-desc-pager-btn bl-pd-desc-pager-btn--next" type="button" aria-label="Next page">
                    Next
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>
                  </button>
                </div>
              </div>
            </div>

          {%- else -%}
            {%- comment -%}below layout (desc_layout == 'below'){%- endcomment -%}

            <div class="bl-pd-desc-below-wrap bl-reveal">
              <div class="bl-pd-desc-below-inner">
                <span class="bl-pd-desc-paged-eyebrow">Product Details</span>
                <div class="bl-pd-desc rte" style="margin-top: 2rem;">
                  {{ product.description }}
                </div>
              </div>
            </div>

          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%}── Description — tabbed layout ──{%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'description' -%}
        {%- assign desc_layout = block.settings.desc_layout | default: 'column' -%}
        {%- if desc_layout == 'tabbed' and product.description != blank -%}

          {%- comment -%}── Custom second tab from schema ──{%- endcomment -%}
          {%- assign tab2_title   = block.settings.tab2_title   | default: 'Additional Info' -%}
          {%- assign tab2_content = block.settings.tab2_content -%}

          {%- comment -%}── Metafield-based additional info ──{%- endcomment -%}
          {%- assign has_addl_mf = false -%}
          {%- if product.metafields.custom.material != blank
            or product.metafields.custom.dimensions != blank
            or product.metafields.custom.weight != blank
            or product.metafields.custom.care_instructions != blank
            or product.metafields.custom.warranty != blank
            or product.metafields.custom.country_of_origin != blank
            or product.metafields.custom.assembly_required != blank
            or product.metafields.custom.color != blank
            or product.metafields.custom.frame_material != blank
            or product.metafields.custom.max_load != blank
          -%}
            {%- assign has_addl_mf = true -%}
          {%- endif -%}

          {%- comment -%}── Fallback product data tab ──{%- endcomment -%}
          {%- assign has_addl_fallback = false -%}
          {%- if product.type != blank or product.vendor != blank or product.tags.size > 0 -%}
            {%- assign has_addl_fallback = true -%}
          {%- endif -%}

          {%- comment -%}Second tab shows if: custom content set OR metafields exist OR product has type/vendor/tags{%- endcomment -%}
          {%- assign show_tab2 = false -%}
          {%- if tab2_content != blank or has_addl_mf or has_addl_fallback -%}
            {%- assign show_tab2 = true -%}
          {%- endif -%}

          <div class="bl-pd-tabbed-wrap" id="bl-pd-tabs-{{ section.id }}">

            <!-- Tab navigation -->
            <div class="bl-pd-tabs-nav" role="tablist" aria-label="Product information">
              <button class="bl-pd-tab-btn is-active"
                role="tab" aria-selected="true"
                aria-controls="bl-tab-panel-desc-{{ section.id }}"
                id="bl-tab-btn-desc-{{ section.id }}"
                data-bl-tab="desc" type="button">Description</button>

              {%- if show_tab2 -%}
              <button class="bl-pd-tab-btn"
                role="tab" aria-selected="false"
                aria-controls="bl-tab-panel-tab2-{{ section.id }}"
                id="bl-tab-btn-tab2-{{ section.id }}"
                data-bl-tab="tab2" type="button">{{ tab2_title }}</button>
              {%- endif -%}
            </div>

            <!-- Description panel -->
            <div class="bl-pd-tab-panel is-active"
              role="tabpanel"
              id="bl-tab-panel-desc-{{ section.id }}"
              aria-labelledby="bl-tab-btn-desc-{{ section.id }}"
            >
              {%- assign desc_has_img = false -%}
              {%- if product.description contains '<img' -%}
                {%- assign desc_has_img = true -%}
              {%- endif -%}
              {%- if desc_has_img -%}
                <div class="bl-pd-desc-split" id="bl-desc-split-{{ section.id }}">
                  <div class="bl-pd-desc-split-text bl-pd-desc rte" id="bl-desc-text-{{ section.id }}">
                    {{ product.description }}
                  </div>
                  <div class="bl-pd-desc-split-imgs" id="bl-desc-imgs-{{ section.id }}"></div>
                </div>
              {%- else -%}
                <div class="bl-pd-desc-cols bl-pd-desc rte">
                  {{ product.description }}
                </div>
              {%- endif -%}
            </div>

            {%- if show_tab2 -%}
            <!-- Second tab panel: custom content → metafields → product data fallback -->
            <div class="bl-pd-tab-panel"
              role="tabpanel"
              id="bl-tab-panel-tab2-{{ section.id }}"
              aria-labelledby="bl-tab-btn-tab2-{{ section.id }}"
            >
              {%- if tab2_content != blank -%}
                <div class="bl-pd-desc rte">{{ tab2_content }}</div>
              {%- else -%}
                <table class="bl-pd-specs-table">
                  <tbody>
                    {%- if product.metafields.custom.material != blank -%}
                      <tr><th scope="row">Material</th><td>{{ product.metafields.custom.material }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.dimensions != blank -%}
                      <tr><th scope="row">Dimensions</th><td>{{ product.metafields.custom.dimensions }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.weight != blank -%}
                      <tr><th scope="row">Weight</th><td>{{ product.metafields.custom.weight }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.max_load != blank -%}
                      <tr><th scope="row">Max Load</th><td>{{ product.metafields.custom.max_load }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.frame_material != blank -%}
                      <tr><th scope="row">Frame Material</th><td>{{ product.metafields.custom.frame_material }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.color != blank -%}
                      <tr><th scope="row">Color</th><td>{{ product.metafields.custom.color }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.care_instructions != blank -%}
                      <tr><th scope="row">Care Instructions</th><td>{{ product.metafields.custom.care_instructions }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.warranty != blank -%}
                      <tr><th scope="row">Warranty</th><td>{{ product.metafields.custom.warranty }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.country_of_origin != blank -%}
                      <tr><th scope="row">Country of Origin</th><td>{{ product.metafields.custom.country_of_origin }}</td></tr>
                    {%- endif -%}
                    {%- if product.metafields.custom.assembly_required != blank -%}
                      <tr><th scope="row">Assembly Required</th><td>{{ product.metafields.custom.assembly_required }}</td></tr>
                    {%- endif -%}
                    {%- comment -%}── Weights / sizes available from product options ──{%- endcomment -%}
                    {%- for opt in product.options_with_values -%}
                      {%- assign _opt_lc = opt.name | downcase -%}
                      {%- if _opt_lc == 'weight' or _opt_lc contains 'weight' or _opt_lc contains 'kg' or _opt_lc == 'size' or _opt_lc contains 'capacity' -%}
                        <tr><th scope="row">{{ opt.name }} Available</th><td>{{ opt.values | join: ' / ' }}</td></tr>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- comment -%}── Stock count (total across all available variants) ──{%- endcomment -%}
                    {%- assign _total_stock = 0 -%}
                    {%- for _v in product.variants -%}
                      {%- if _v.available and _v.inventory_quantity > 0 -%}
                        {%- assign _total_stock = _total_stock | plus: _v.inventory_quantity -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if _total_stock > 0 -%}
                      <tr><th scope="row">Stock Available</th><td>{{ _total_stock }} units</td></tr>
                    {%- endif -%}

                    {%- comment -%}── SKU ──{%- endcomment -%}
                    {%- assign _sku = product.selected_or_first_available_variant.sku -%}
                    {%- if _sku != blank -%}
                      <tr><th scope="row">SKU</th><td>{{ _sku }}</td></tr>
                    {%- endif -%}

                    {%- comment -%}── Barcode ──{%- endcomment -%}
                    {%- assign _bc = product.selected_or_first_available_variant.barcode -%}
                    {%- if _bc != blank -%}
                      <tr><th scope="row">Barcode</th><td>{{ _bc }}</td></tr>
                    {%- endif -%}

                    {%- comment -%}── Package weight ──{%- endcomment -%}
                    {%- assign _pw = product.selected_or_first_available_variant.weight -%}
                    {%- if _pw > 0 -%}
                      <tr><th scope="row">Package Weight</th><td>{{ _pw | weight_with_unit }}</td></tr>
                    {%- endif -%}

                    {%- comment -%}Fallback: always-available Shopify product fields{%- endcomment -%}
                    {%- unless has_addl_mf -%}
                      {%- if product.type != blank -%}
                        <tr><th scope="row">Product Type</th><td>{{ product.type }}</td></tr>
                      {%- endif -%}
                      {%- if product.vendor != blank -%}
                        <tr><th scope="row">Brand</th><td>{{ product.vendor }}</td></tr>
                      {%- endif -%}
                    {%- endunless -%}
                  </tbody>
                </table>
              {%- endif -%}
            </div>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%}── Description — Scroll Story layout ──{%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'description' -%}
        {%- assign desc_layout = block.settings.desc_layout | default: 'column' -%}
        {%- if desc_layout == 'story' and product.description != blank -%}
          <div class="bl-pd-story-wrap" id="bl-pd-story-{{ section.id }}">
            <div class="bl-pd-story-progress">
              <div class="bl-pd-story-progress-fill" id="bl-story-fill-{{ section.id }}"></div>
            </div>
            <div id="bl-story-src-{{ section.id }}" style="display:none;" aria-hidden="true">
              {{ product.description }}
            </div>
            {%- comment -%}Pre-rendered additional info for the canvas right column{%- endcomment -%}
            <div id="bl-canvas-addl-{{ section.id }}" style="display:none;" aria-hidden="true">

              {%- comment -%}── Basic product identity ──{%- endcomment -%}
              {%- if product.vendor != blank -%}
                <div data-key="Brand" data-val="{{ product.vendor | escape }}"></div>
              {%- endif -%}
              {%- if product.type != blank -%}
                <div data-key="Product Type" data-val="{{ product.type | escape }}"></div>
              {%- endif -%}
              {%- if product.collections.size > 0 -%}
                <div data-key="Category" data-val="{{ product.collections.first.title | escape }}"></div>
              {%- endif -%}

              {%- comment -%}── ALL variant options (Color, Size, Weight, etc.) ──{%- endcomment -%}
              {%- for opt in product.options_with_values -%}
                <div data-key="{{ opt.name | escape }}" data-val="{{ opt.values | join: ' · ' | escape }}"></div>
              {%- endfor -%}

              {%- comment -%}── Availability & pricing ──{%- endcomment -%}
              {%- assign _ts = 0 -%}
              {%- for _v in product.variants -%}
                {%- if _v.available and _v.inventory_quantity > 0 -%}
                  {%- assign _ts = _ts | plus: _v.inventory_quantity -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if _ts > 0 -%}
                <div data-key="In Stock" data-val="{{ _ts }} units"></div>
              {%- else -%}
                <div data-key="Availability" data-val="Out of Stock"></div>
              {%- endif -%}
              {%- if product.variants.size > 1 -%}
                <div data-key="Variants" data-val="{{ product.variants.size }} options available"></div>
              {%- endif -%}
              {%- assign _min = product.price_min -%}
              {%- assign _max = product.price_max -%}
              {%- if _min != _max -%}
                <div data-key="Price Range" data-val="{{ _min | money }} – {{ _max | money }}"></div>
              {%- endif -%}

              {%- comment -%}── SKU & barcode ──{%- endcomment -%}
              {%- assign _cv = product.selected_or_first_available_variant -%}
              {%- if _cv.sku != blank -%}
                <div data-key="SKU" data-val="{{ _cv.sku | escape }}"></div>
              {%- endif -%}
              {%- if _cv.barcode != blank -%}
                <div data-key="Barcode" data-val="{{ _cv.barcode | escape }}"></div>
              {%- endif -%}
              {%- if _cv.weight > 0 -%}
                <div data-key="Package Weight" data-val="{{ _cv.weight | weight_with_unit | escape }}"></div>
              {%- endif -%}

              {%- comment -%}── Metafields (fill in as needed in Shopify Admin) ──{%- endcomment -%}
              {%- if product.metafields.custom.material != blank -%}
                <div data-key="Material" data-val="{{ product.metafields.custom.material | escape }}"></div>
              {%- endif -%}
              {%- if product.metafields.custom.dimensions != blank -%}
                <div data-key="Dimensions" data-val="{{ product.metafields.custom.dimensions | escape }}"></div>
              {%- endif -%}
              {%- if product.metafields.custom.max_load != blank -%}
                <div data-key="Max Load" data-val="{{ product.metafields.custom.max_load | escape }}"></div>
              {%- endif -%}
              {%- if product.metafields.custom.frame_material != blank -%}
                <div data-key="Frame Material" data-val="{{ product.metafields.custom.frame_material | escape }}"></div>
              {%- endif -%}
              {%- if product.metafields.custom.warranty != blank -%}
                <div data-key="Warranty" data-val="{{ product.metafields.custom.warranty | escape }}"></div>
              {%- endif -%}
              {%- if product.metafields.custom.care_instructions != blank -%}
                <div data-key="Care Instructions" data-val="{{ product.metafields.custom.care_instructions | escape }}"></div>
              {%- endif -%}
              {%- if product.metafields.custom.country_of_origin != blank -%}
                <div data-key="Country of Origin" data-val="{{ product.metafields.custom.country_of_origin | escape }}"></div>
              {%- endif -%}
              {%- if product.metafields.custom.assembly_required != blank -%}
                <div data-key="Assembly Required" data-val="{{ product.metafields.custom.assembly_required | escape }}"></div>
              {%- endif -%}

              {%- comment -%}── Tags (skip internal/app tags starting with underscore) ──{%- endcomment -%}
              {%- assign _visible_tags = '' -%}
              {%- for tag in product.tags -%}
                {%- unless tag contains '_' or tag contains ':' -%}
                  {%- if _visible_tags == '' -%}
                    {%- assign _visible_tags = tag -%}
                  {%- else -%}
                    {%- assign _visible_tags = _visible_tags | append: ', ' | append: tag -%}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
              {%- if _visible_tags != '' -%}
                <div data-key="Tags" data-val="{{ _visible_tags | escape }}"></div>
              {%- endif -%}

            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

{%- comment -%}── Size chart popup ──{%- endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'size-chart' -%}
    {%- if block.settings.size_img != blank or block.settings.size_pg != blank -%}
      <div id="bl-sc-{{ section.id }}" style="display:none;position:fixed;inset:0;z-index:8000;background:rgba(0,10,20,0.9);backdrop-filter:blur(12px);align-items:center;justify-content:center;">
        <div style="position:relative;max-width:90vw;max-height:90vh;overflow:auto;background:{{ surface_color }};border-radius:16px;padding:2rem;">
          <button onclick="document.getElementById('bl-sc-{{ section.id }}').style.display='none';"
            style="position:absolute;top:1rem;right:1rem;background:transparent;border:none;color:{{ text_color }};cursor:pointer;font-size:2rem;line-height:1;" aria-label="Close">
            &times;
          </button>
          {%- if block.settings.size_img != blank -%}
            {{ block.settings.size_img | image_url: width: 1200 | image_tag: loading: 'lazy', style: 'max-width:100%;height:auto;display:block;' }}
          {%- elsif block.settings.size_pg != blank -%}
            <h2 style="font-family:'Archivo Black',sans-serif;font-weight:400;color:{{ text_color }};margin-bottom:1rem;">{{ block.settings.size_pg.title }}</h2>
            <div style="font-family:'DM Sans',sans-serif;color:{{ text_color }};line-height:1.7;">{{ block.settings.size_pg.content }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}── Lightbox ──{%- endcomment -%}
{%- if enable_zoom -%}
<div id="bl-lb-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Image zoom">
  <button class="bl-lb-close" aria-label="Close" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <button class="bl-lb-prev" aria-label="Previous" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>
  </button>
  <button class="bl-lb-next" aria-label="Next" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>
  </button>
  <div class="bl-lb-img-wrap">
    <img class="bl-lb-img" src="" alt="" id="bl-lb-img-{{ section.id }}">
  </div>
  <div class="bl-lb-count" id="bl-lb-count-{{ section.id }}">1 / 1</div>
</div>
{%- endif -%}

{%- comment -%}── Sticky ATC ──{%- endcomment -%}
{%- if enable_sticky -%}
<div id="bl-satc-{{ section.id }}" aria-hidden="true">
  <div class="bl-satc-inner">
    {%- if product.featured_image -%}
      <img
        class="bl-satc-img"
        src="{{ product.featured_image | image_url: width: 120 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
      >
    {%- endif -%}
    <div class="bl-satc-meta">
      <div class="bl-satc-title">{{ product.title }}</div>
      <div class="bl-satc-price" data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</div>
    </div>
    <button
      type="button"
      class="bl-satc-btn"
      id="bl-satc-btn-{{ section.id }}"
      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
    >
      {%- if product.selected_or_first_available_variant.available -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>
</div>
{%- endif -%}

<script type="application/ld+json">{{ product | structured_data }}</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var sec    = document.getElementById('{{ section_id }}');
  if (!sec) return;

  var slides = Array.from(sec.querySelectorAll('.bl-pd-slide'));
  var thumbs = Array.from(sec.querySelectorAll('.bl-pd-thumb'));
  var wrap   = sec.querySelector('#bl-pd-main-{{ section.id }}');
  var cur    = 0;
  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Init: find active index matching featured_media ──
  var featuredId = '{{ featured_media.id }}';
  slides.forEach(function (s, i) {
    if (s.dataset.mediaId == featuredId) cur = i;
  });

  function goTo(idx) {
    if (idx === cur && slides[idx].classList.contains('is-active')) return;
    slides[cur].classList.remove('is-active');
    thumbs[cur] && thumbs[cur].classList.remove('is-active');
    cur = (idx + slides.length) % slides.length;
    slides[cur].classList.add('is-active');
    if (thumbs[cur]) {
      thumbs[cur].classList.add('is-active');
      thumbs[cur].scrollIntoView({ inline: 'nearest', behavior: 'smooth', block: 'nearest' });
    }
    {% if enable_zoom %}updateLbSrc();{% endif %}
  }

  thumbs.forEach(function (t, i) { t.addEventListener('click', function () { goTo(i); }); });

  var arrP = sec.querySelector('.bl-pd-arr--p');
  var arrN = sec.querySelector('.bl-pd-arr--n');
  if (arrP) arrP.addEventListener('click', function () { goTo(cur - 1); });
  if (arrN) arrN.addEventListener('click', function () { goTo(cur + 1); });

  // touch swipe
  var tx = 0;
  if (wrap) {
    wrap.addEventListener('touchstart', function (e) { tx = e.touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend', function (e) {
      var d = tx - e.changedTouches[0].clientX;
      if (Math.abs(d) > 48) goTo(d > 0 ? cur + 1 : cur - 1);
    });
  }

  // variant media
  sec.addEventListener('variant:changed', function (e) {
    if (e.detail && e.detail.variant && e.detail.variant.featured_media) {
      var mid = String(e.detail.variant.featured_media.id);
      var idx = slides.findIndex(function (s) { return s.dataset.mediaId === mid; });
      if (idx >= 0) goTo(idx);
    }

    // Update custom inventory badge
    var invEl = document.getElementById('bl-inv-custom-{{ section.id }}');
    if (invEl && e.detail && e.detail.variant) {
      var v         = e.detail.variant;
      var thresh    = parseInt(invEl.dataset.threshold || '10', 10);
      var inClr     = invEl.dataset.inClr   || '#07d16e';
      var outClr    = invEl.dataset.outClr  || '#ff4444';
      var lowClr    = invEl.dataset.lowClr  || '#e8a000';
      var label, clr, bg, bdr, state;
      if (v.available) {
        if (v.inventory_management && v.inventory_quantity <= thresh) {
          label = 'Only ' + v.inventory_quantity + ' left';
          clr = lowClr; bg = 'rgba(232,160,0,0.08)'; bdr = 'rgba(232,160,0,0.35)'; state = 'low';
        } else {
          label = 'In Stock';
          clr = inClr; bg = 'rgba(7,209,110,0.08)'; bdr = 'rgba(7,209,110,0.35)'; state = 'in';
        }
      } else {
        label = 'Out of Stock';
        clr = outClr; bg = 'rgba(255,68,68,0.08)'; bdr = 'rgba(255,68,68,0.35)'; state = 'out';
      }
      invEl.className = 'bl-inv-badge bl-inv-badge--' + state;
      invEl.style.cssText = '--_inv-clr:' + clr + ';--_inv-bg:' + bg + ';--_inv-border:' + bdr + ';';
      var dot  = invEl.querySelector('.bl-inv-dot');
      var text = invEl.querySelector('.bl-inv-text');
      if (dot)  dot.style.background  = clr;
      if (text) text.textContent = label;
    }
  });

  {% if enable_zoom %}
  // ── Lightbox ──
  var lb       = document.getElementById('bl-lb-{{ section.id }}');
  var lbImg    = document.getElementById('bl-lb-img-{{ section.id }}');
  var lbCount  = document.getElementById('bl-lb-count-{{ section.id }}');

  function updateLbSrc() {
    if (!lb || !lb.classList.contains('is-open')) return;
    var img = slides[cur].querySelector('img');
    if (img) {
      lbImg.src = img.src.replace(/width=\d+/, 'width=2000');
      lbImg.alt = img.alt;
    }
    if (lbCount) lbCount.textContent = (cur + 1) + ' / ' + slides.length;
  }

  function openLb() {
    if (!lb) return;
    updateLbSrc();
    lb.classList.add('is-open');
    lb.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeLb() {
    if (!lb) return;
    lb.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  if (wrap) wrap.addEventListener('click', function (e) {
    // Only open lightbox if current slide is an image (not video)
    var active = wrap.querySelector('.bl-pd-slide.is-active');
    if (active && active.querySelector('img') && !active.querySelector('video')) openLb();
  });
  var zBtn = sec.querySelector('#bl-pd-zoom-{{ section.id }}');
  if (zBtn) { zBtn.addEventListener('click', function (e) { e.stopPropagation(); openLb(); }); }

  if (lb) {
    lb.querySelector('.bl-lb-close').addEventListener('click', closeLb);
    lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
    lb.querySelector('.bl-lb-prev').addEventListener('click', function () { goTo(cur - 1); updateLbSrc(); });
    lb.querySelector('.bl-lb-next').addEventListener('click', function () { goTo(cur + 1); updateLbSrc(); });
  }
  document.addEventListener('keydown', function (e) {
    if (!lb || !lb.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowLeft')  { goTo(cur - 1); updateLbSrc(); }
    if (e.key === 'ArrowRight') { goTo(cur + 1); updateLbSrc(); }
  });
  {% endif %}

  {% if enable_zoom %}
  // ── Hover magnifier lens (desktop-only, images only, Flipkart/Amazon style) ──
  (function () {
    if (reducedMotion || window.innerWidth <= 1024) return;

    var mainWrap = sec.querySelector('#bl-pd-main-{{ section.id }}');
    if (!mainWrap) return;

    // Create lens element inside the main wrap
    var lens = document.createElement('div');
    lens.className = 'bl-zoom-lens';
    mainWrap.appendChild(lens);

    // Create result element appended to body (escapes overflow:hidden)
    var result = document.createElement('div');
    result.className = 'bl-zoom-result-{{ section.id }}';
    document.body.appendChild(result);

    var ZOOM = 3;
    var rafId = null;
    var pendingX = 0, pendingY = 0, pendingRect = null, pendingSrc = '';

    function isImgSlide(slide) {
      return slide && slide.querySelector('img') && !slide.querySelector('video');
    }

    function positionResult(rect) {
      var rw = result.offsetWidth;
      var rh = result.offsetHeight;
      var gap = 20;
      var left = rect.right + gap;
      var top  = rect.top;
      // If result goes off right edge, put it left of media
      if (left + rw > window.innerWidth - 10) {
        left = rect.left - rw - gap;
      }
      // Clamp top so it doesn't go off bottom
      if (top + rh > window.innerHeight - 10) {
        top = window.innerHeight - rh - 10;
      }
      if (top < 10) top = 10;
      result.style.left = left + 'px';
      result.style.top  = top + 'px';
    }

    function applyMagnifier(x, y, rect, src) {
      var lw = lens.offsetWidth, lh = lens.offsetHeight;
      var rw = result.offsetWidth, rh = result.offsetHeight;

      // Clamp lens within image bounds
      var lx = Math.max(0, Math.min(x - lw / 2, rect.width - lw));
      var ly = Math.max(0, Math.min(y - lh / 2, rect.height - lh));
      lens.style.left = lx + 'px';
      lens.style.top  = ly + 'px';

      // Compute background size = image displayed size × ZOOM
      var bgW = rect.width * ZOOM;
      var bgH = rect.height * ZOOM;

      // The centre of the lens maps to the centre of the result
      var cx = lx + lw / 2;
      var cy = ly + lh / 2;
      var bpX = -(cx * ZOOM - rw / 2);
      var bpY = -(cy * ZOOM - rh / 2);

      result.style.backgroundImage    = 'url(' + src + ')';
      result.style.backgroundSize     = bgW + 'px ' + bgH + 'px';
      result.style.backgroundPosition = bpX + 'px ' + bpY + 'px';
      positionResult(rect);
    }

    mainWrap.addEventListener('mousemove', function (e) {
      var active = mainWrap.querySelector('.bl-pd-slide.is-active');
      if (!isImgSlide(active)) { hideMag(); return; }
      var img = active.querySelector('img');
      if (!img) { hideMag(); return; }

      var rect = mainWrap.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;

      // High-res src
      var src = img.src.replace(/width=\d+/, 'width=2000');

      pendingX = x; pendingY = y; pendingRect = rect; pendingSrc = src;

      if (!rafId) {
        rafId = requestAnimationFrame(function () {
          rafId = null;
          lens.style.display   = 'block';
          result.style.display = 'block';
          applyMagnifier(pendingX, pendingY, pendingRect, pendingSrc);
        });
      }
    });

    function hideMag() {
      lens.style.display   = 'none';
      result.style.display = 'none';
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    }

    mainWrap.addEventListener('mouseleave', hideMag);

    // Hide magnifier when lightbox opens
    if (wrap) wrap.addEventListener('click', hideMag);
    window.addEventListener('resize', function () {
      if (window.innerWidth <= 1024) hideMag();
    });

    // Re-check on variant change (video slides have no lens)
    sec.addEventListener('variant:changed', hideMag);
  })();
  {% endif %}

  {% if enable_para %}
  // ── Parallax glow + image tilt ──
  if (!reducedMotion) {
    var g1 = sec.querySelector('.bl-pd-glow--1');
    var g2 = sec.querySelector('.bl-pd-glow--2');
    var rafPara = null;
    var mx = 0, my = 0;

    document.addEventListener('mousemove', function (e) {
      mx = e.clientX; my = e.clientY;
      if (!rafPara) rafPara = requestAnimationFrame(function () {
        rafPara = null;
        var cx = window.innerWidth / 2, cy = window.innerHeight / 2;
        var dx = (mx - cx) / cx, dy = (my - cy) / cy;
        if (g1) g1.style.transform = 'translate(' + (dx * 22) + 'px,' + (dy * 18) + 'px)';
        if (g2) g2.style.transform = 'translate(' + (dx * -16) + 'px,' + (dy * -12) + 'px)';
        if (wrap) {
          var rx = dy * 3.5, ry = dx * -3.5;
          wrap.style.transform = 'perspective(1200px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg)';
        }
      });
    });
    sec.addEventListener('mouseleave', function () {
      if (wrap) wrap.style.transform = 'perspective(1200px) rotateX(0) rotateY(0)';
      if (g1) g1.style.transform = '';
      if (g2) g2.style.transform = '';
    });
  }
  {% endif %}

  {% if enable_anim %}
  // ── Reveal animations ──
  var revObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  var mc = sec.querySelector('.bl-pd-media-col');
  var ic = sec.querySelector('.bl-pd-info-col');
  if (mc) revObs.observe(mc);
  if (ic) revObs.observe(ic);
  {% endif %}

  {% if enable_sticky %}
  // ── Sticky ATC ──
  var satcBar = document.getElementById('bl-satc-{{ section.id }}');
  var atcEl   = sec.querySelector('#Action_buttons-{{ section.id }}');

  function blSetAtcTop() {
    var hdr = document.querySelector('.bl-hdr-outer') || document.querySelector('header[role="banner"]') || document.querySelector('header');
    if (hdr && satcBar) satcBar.style.top = hdr.offsetHeight + 'px';
  }
  blSetAtcTop();
  window.addEventListener('resize', blSetAtcTop);

  if (satcBar && atcEl) {
    var satcObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          satcBar.classList.remove('is-visible');
          satcBar.setAttribute('aria-hidden', 'true');
        } else {
          satcBar.classList.add('is-visible');
          satcBar.removeAttribute('aria-hidden');
        }
      });
    }, { threshold: 0 });
    satcObs.observe(atcEl);

    // Clicking sticky ATC submits the main product form
    var satcBtn = document.getElementById('bl-satc-btn-{{ section.id }}');
    if (satcBtn) {
      satcBtn.addEventListener('click', function () {
        var form = sec.querySelector('form[action*="/cart/add"]') || sec.querySelector('[data-type="add-to-cart-form"]');
        if (form) { if (form.requestSubmit) form.requestSubmit(); else form.submit(); }
      });
    }

    // Update sticky price + availability on variant change
    sec.addEventListener('variant:changed', function (e) {
      if (!e.detail || !e.detail.variant) return;
      var v = e.detail.variant;
      var priceEl = satcBar.querySelector('.bl-satc-price');
      if (priceEl && v.price !== undefined) {
        priceEl.textContent = '{{ product.selected_or_first_available_variant.price | money }}'.replace(
          /[\d,]+(\.\d+)?/, (v.price / 100).toFixed(2)
        );
      }
      if (satcBtn) satcBtn.disabled = !v.available;
    });

    // Hide sticky ATC bar when mobile drawer is open so it doesn't overlap
    if (satcBar) {
      var blSatcDrawerObs = new MutationObserver(function () {
        var drawerEl = document.querySelector(
          '#mobile_menu_drawer, .menu-drawer, [class*="mobile_menu"], [class*="menu-drawer"]'
        );
        var isOpen = drawerEl && (
          drawerEl.hasAttribute('open') ||
          drawerEl.classList.contains('is-active') ||
          drawerEl.getAttribute('aria-hidden') === 'false' ||
          (drawerEl.style && drawerEl.style.display === 'block')
        );
        satcBar.style.display = isOpen ? 'none' : '';
      });
      blSatcDrawerObs.observe(document.body, {
        subtree: true, attributes: true,
        attributeFilter: ['open', 'class', 'aria-hidden', 'style']
      });
    }
  }
  {% endif %}

  // ── Description paginator ──
  (function () {
    var pagedContent = document.getElementById('bl-desc-paged-{{ section.id }}');
    var pager        = document.getElementById('bl-desc-pager-{{ section.id }}');
    var dotsWrap     = document.getElementById('bl-desc-dots-{{ section.id }}');
    var countEl      = document.getElementById('bl-desc-count-{{ section.id }}');
    if (!pagedContent || !pager) return;

    // Split into pages at every H2 heading
    var children = Array.from(pagedContent.childNodes);
    var pages    = [];
    var current  = [];

    children.forEach(function (node) {
      var isH2 = node.nodeType === 1 && node.tagName === 'H2';
      if (isH2 && current.length > 0) {
        pages.push(current);
        current = [];
      }
      current.push(node);
    });
    if (current.length > 0) pages.push(current);

    // Fallback: split by every 3 block-level elements if no H2s found
    if (pages.length <= 1) {
      var blockEls = children.filter(function (n) {
        return n.nodeType === 1 && ['P','H2','H3','H4','UL','OL','FIGURE','TABLE','DIV'].indexOf(n.tagName) > -1;
      });
      if (blockEls.length > 5) {
        var chunkSize = Math.ceil(blockEls.length / Math.ceil(blockEls.length / 4));
        pages = [];
        current = [];
        blockEls.forEach(function (el, i) {
          current.push(el);
          if (current.length >= chunkSize && i < blockEls.length - 1) {
            pages.push(current.slice()); current = [];
          }
        });
        if (current.length) pages.push(current);
      }
    }

    if (pages.length <= 1) return; // No need to paginate

    // Build page wrappers
    pagedContent.innerHTML = '';
    pages.forEach(function (nodeArr, i) {
      var wrap = document.createElement('div');
      wrap.className = 'bl-pd-desc-page' + (i === 0 ? ' is-active' : '');
      nodeArr.forEach(function (n) { wrap.appendChild(n.cloneNode ? n.cloneNode(true) : n); });
      pagedContent.appendChild(wrap);
    });

    // Build dot indicators
    var dots = [];
    if (dotsWrap) {
      pages.forEach(function (_, i) {
        var dot = document.createElement('button');
        dot.className = 'bl-pd-desc-pager-dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Section ' + (i + 1));
        dot.addEventListener('click', function () { goPage(i); });
        dotsWrap.appendChild(dot);
        dots.push(dot);
      });
    }

    var prevBtn = pager.querySelector('.bl-pd-desc-pager-btn--prev');
    var nextBtn = pager.querySelector('.bl-pd-desc-pager-btn--next');
    var curIdx  = 0;

    function updateCount() {
      if (countEl) countEl.textContent = (curIdx + 1) + ' / ' + pages.length;
    }

    function goPage(idx) {
      var pageDivs = pagedContent.querySelectorAll('.bl-pd-desc-page');
      pageDivs[curIdx].classList.remove('is-active');
      if (dots[curIdx]) dots[curIdx].classList.remove('is-active');
      curIdx = Math.max(0, Math.min(idx, pages.length - 1));
      pageDivs[curIdx].classList.add('is-active');
      if (dots[curIdx]) dots[curIdx].classList.add('is-active');
      if (prevBtn) prevBtn.disabled = curIdx === 0;
      if (nextBtn) nextBtn.disabled = curIdx === pages.length - 1;
      updateCount();
      // Smooth scroll to paged section top
      var topEl = pagedContent.closest('.bl-pd-desc-paged-wrap') || pagedContent;
      var hdrH = 80;
      var hdr = document.querySelector('.bl-hdr-outer') || document.querySelector('header');
      if (hdr) hdrH = hdr.offsetHeight + 16;
      window.scrollTo({ top: topEl.getBoundingClientRect().top + window.scrollY - hdrH, behavior: 'smooth' });
    }

    if (prevBtn) { prevBtn.disabled = true; prevBtn.addEventListener('click', function () { goPage(curIdx - 1); }); }
    if (nextBtn) { nextBtn.disabled = pages.length <= 1; nextBtn.addEventListener('click', function () { goPage(curIdx + 1); }); }
    updateCount();
    pager.style.display = 'flex';
  })();

  // ── Sticky description column: keep top offset updated as sticky ATC bar appears/disappears ──
  (function () {
    var stickyText = sec.querySelector('.bl-pd-desc-split-text');
    var satcBar    = document.getElementById('bl-satc-{{ section.id }}');
    if (!stickyText) return;
    function syncTop() {
      // Disable on mobile — CSS sets position:static there
      if (window.innerWidth <= 768) { stickyText.style.top = ''; return; }
      var hdr   = document.querySelector('.bl-hdr-outer') || document.querySelector('header');
      var hdrH  = hdr ? hdr.offsetHeight : 64;
      var satcH = (satcBar && satcBar.classList.contains('is-visible')) ? satcBar.offsetHeight : 0;
      stickyText.style.top = (hdrH + satcH + 12) + 'px';
    }
    syncTop();
    window.addEventListener('scroll', syncTop, { passive: true });
    window.addEventListener('resize', syncTop, { passive: true });
  })();

  // ── Tabbed description: tab switching + image extraction ──
  (function () {
    var tabbedWrap = document.getElementById('bl-pd-tabs-{{ section.id }}');
    if (!tabbedWrap) return;

    var tabBtns   = Array.from(tabbedWrap.querySelectorAll('.bl-pd-tab-btn'));
    var tabPanels = Array.from(tabbedWrap.querySelectorAll('.bl-pd-tab-panel'));

    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = btn.getAttribute('data-bl-tab');
        tabBtns.forEach(function (b) { b.classList.remove('is-active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('is-active'); btn.setAttribute('aria-selected', 'true');
        tabPanels.forEach(function (p) { p.classList.remove('is-active'); });
        var panel = tabbedWrap.querySelector('#bl-tab-panel-' + target + '-{{ section.id }}');
        if (panel) panel.classList.add('is-active');
      });
    });

    // Move <img> elements from the text column into the images column
    var textCol = document.getElementById('bl-desc-text-{{ section.id }}');
    var imgsCol = document.getElementById('bl-desc-imgs-{{ section.id }}');
    if (textCol && imgsCol) {
      var imgs = Array.from(textCol.querySelectorAll('img'));
      imgs.forEach(function (img) {
        var wrapper = img.closest('figure') || img.parentNode;
        var clone   = img.cloneNode(true);
        imgsCol.appendChild(clone);
        // Remove the original; if its wrapper is now empty, remove that too
        img.remove();
        if (wrapper && wrapper !== textCol && wrapper.textContent.trim() === '' && !wrapper.querySelector('img, video, svg')) {
          wrapper.remove();
        }
      });
      // If no images ended up in the right column (e.g. all were lazy-src only), hide the split
      if (imgsCol.children.length === 0) {
        var split = document.getElementById('bl-desc-split-{{ section.id }}');
        if (split) { split.style.gridTemplateColumns = '1fr'; imgsCol.style.display = 'none'; }
      }
    }
  })();

  // ── Visual Canvas mode ─────────────────────────────────────────────
  (function () {
    var storyWrap = document.getElementById('bl-pd-story-{{ section.id }}');
    if (!storyWrap) return;

    var srcEl   = document.getElementById('bl-story-src-{{ section.id }}');
    var barFill = document.getElementById('bl-story-fill-{{ section.id }}');
    if (!srcEl) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isMobile = window.innerWidth <= 768;

    // ── Parse the description HTML ──
    var parser = new DOMParser();
    var doc    = parser.parseFromString(srcEl.innerHTML, 'text/html');
    var nodes  = Array.from(doc.body.childNodes);

    // ── Extract images from description ──
    var tempDiv = document.createElement('div');
    nodes.forEach(function(n) { if (n.cloneNode) tempDiv.appendChild(n.cloneNode(true)); });
    var allImgs = Array.from(tempDiv.querySelectorAll('img'));
    var imgSrcs = [];
    allImgs.forEach(function(img) {
      imgSrcs.push(img.src);
      var w = img.closest('figure') || img.parentNode;
      img.remove();
      if (w && w !== tempDiv && !w.textContent.trim() && !w.querySelector('img,video,svg')) w.remove();
    });

    // ── 1. Text section: description LEFT + additional info RIGHT ──
    var addlEl   = document.getElementById('bl-canvas-addl-{{ section.id }}');
    var addlRows = addlEl ? Array.from(addlEl.querySelectorAll('[data-key]')) : [];

    var textSection = document.createElement('div');
    textSection.className = 'bl-canvas-text-section';

    var twoCol = document.createElement('div');
    twoCol.className = 'bl-canvas-2col';

    // Left: description
    var textDiv = document.createElement('div');
    textDiv.className = 'bl-canvas-text';
    textDiv.innerHTML = tempDiv.innerHTML;

    // Right: additional info panel
    var infoDiv = document.createElement('div');
    infoDiv.className = 'bl-canvas-info';

    var infoHeading = document.createElement('div');
    infoHeading.className = 'bl-canvas-info-heading';
    infoHeading.textContent = 'Product Information';
    infoDiv.appendChild(infoHeading);

    if (addlRows.length > 0) {
      addlRows.forEach(function(row) {
        var r = document.createElement('div');
        r.className = 'bl-canvas-info-row';
        r.innerHTML = '<span class="bl-canvas-info-key">' + row.dataset.key + '</span>'
                    + '<span class="bl-canvas-info-val">'  + row.dataset.val  + '</span>';
        infoDiv.appendChild(r);
      });
    } else {
      var empty = document.createElement('p');
      empty.style.cssText = 'font-family:"DM Sans",sans-serif;font-size:1.3rem;opacity:0.4;';
      empty.textContent = 'No additional specifications available.';
      infoDiv.appendChild(empty);
    }

    twoCol.appendChild(textDiv);
    twoCol.appendChild(infoDiv);
    textSection.appendChild(twoCol);
    storyWrap.appendChild(textSection);

    // ── 2. Gallery section (if images exist) ──
    if (allImgs.length > 0) {
      var gallerySection = document.createElement('div');
      gallerySection.className = 'bl-canvas-gallery-section';

      var label = document.createElement('div');
      label.className = 'bl-canvas-gallery-label';
      label.textContent = 'Product Gallery';
      gallerySection.appendChild(label);

      var gallery = document.createElement('div');
      gallery.className = 'bl-canvas-gallery';

      var speeds = [0.12, -0.08, 0.16, -0.1, 0.13, -0.07, 0.09];

      allImgs.forEach(function(img, i) {
        var item = document.createElement('div');
        item.className = 'bl-canvas-gallery-item';
        item.dataset.speed = speeds[i % speeds.length];
        item.dataset.idx   = i;
        item.setAttribute('role', 'button');
        item.setAttribute('aria-label', 'View image ' + (i + 1));
        img.style.width = '100%'; img.style.height = '200px'; img.style.objectFit = 'cover';
        item.appendChild(img);
        gallery.appendChild(item);
      });

      gallerySection.appendChild(gallery);
      storyWrap.appendChild(gallerySection);

      // ── Parallax on gallery items ──
      if (!reduced && !isMobile) {
        var galleryItems = Array.from(gallery.querySelectorAll('.bl-canvas-gallery-item'));
        var rafPara = null;
        window.addEventListener('scroll', function() {
          if (rafPara) return;
          rafPara = requestAnimationFrame(function() {
            rafPara = null;
            galleryItems.forEach(function(item) {
              var rect = item.getBoundingClientRect();
              var offset = (rect.top + rect.height / 2) - window.innerHeight / 2;
              var s = parseFloat(item.dataset.speed || '0.1');
              item.style.transform = 'translateY(' + (offset * s * -1) + 'px)';
            });
          });
        }, { passive: true });
      }

      // ── Lightbox ──
      var lb = document.createElement('div');
      lb.className = 'bl-canvas-lb';
      lb.setAttribute('role', 'dialog');
      lb.setAttribute('aria-modal', 'true');
      lb.innerHTML = [
        '<div class="bl-canvas-lb-img-wrap"><img class="bl-canvas-lb-img" src="" alt="Product image"></div>',
        '<button class="bl-canvas-lb-close" type="button" aria-label="Close">',
        '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
        '</button>',
        allImgs.length > 1 ? [
          '<button class="bl-canvas-lb-prev" type="button" aria-label="Previous image">',
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>',
          '</button>',
          '<button class="bl-canvas-lb-next" type="button" aria-label="Next image">',
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>',
          '</button>',
          '<div class="bl-canvas-lb-count"></div>'
        ].join('') : ''
      ].join('');
      document.body.appendChild(lb);

      var lbImg   = lb.querySelector('.bl-canvas-lb-img');
      var lbCount = lb.querySelector('.bl-canvas-lb-count');
      var curLb   = 0;

      function setLbImg(idx) {
        curLb = (idx + imgSrcs.length) % imgSrcs.length;
        lbImg.style.opacity = '0';
        setTimeout(function() {
          lbImg.src = imgSrcs[curLb].replace(/width=\d+/, 'width=1400');
          lbImg.style.opacity = '1';
        }, 150);
        if (lbCount) lbCount.textContent = (curLb + 1) + ' / ' + imgSrcs.length;
      }
      function openLb(idx) {
        setLbImg(idx); lb.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
      function closeLb() {
        lb.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      Array.from(gallery.querySelectorAll('.bl-canvas-gallery-item')).forEach(function(item) {
        item.addEventListener('click', function() { openLb(parseInt(item.dataset.idx, 10)); });
      });
      lb.querySelector('.bl-canvas-lb-close').addEventListener('click', closeLb);
      lb.addEventListener('click', function(e) { if (e.target === lb) closeLb(); });
      var prevBtn = lb.querySelector('.bl-canvas-lb-prev');
      var nextBtn = lb.querySelector('.bl-canvas-lb-next');
      if (prevBtn) prevBtn.addEventListener('click', function() { setLbImg(curLb - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function() { setLbImg(curLb + 1); });
      document.addEventListener('keydown', function(e) {
        if (!lb.classList.contains('is-open')) return;
        if (e.key === 'Escape')      closeLb();
        if (e.key === 'ArrowLeft')   setLbImg(curLb - 1);
        if (e.key === 'ArrowRight')  setLbImg(curLb + 1);
      });
    }

    // ── Progress bar ──
    if (barFill) {
      window.addEventListener('scroll', function() {
        var rect  = storyWrap.getBoundingClientRect();
        var done  = Math.max(0, -rect.top);
        var total = Math.max(1, storyWrap.offsetHeight - window.innerHeight);
        barFill.style.width = Math.min(100, (done / total) * 100) + '%';
      }, { passive: true });
    }

    window.addEventListener('resize', function() {
      isMobile = window.innerWidth <= 768;
    }, { passive: true });
  })();

  // ── Reveal: below/paginated description sections ──
  {% if enable_anim %}
  var descRevObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        descRevObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });
  sec.querySelectorAll('.bl-pd-desc-paged-wrap.bl-reveal, .bl-pd-desc-below-wrap.bl-reveal').forEach(function (el) {
    descRevObs.observe(el);
  });
  {% endif %}

  // ── Variant option label colorizer ──────────────────────────────
  // Uses MutationObserver so color stays white even after Evolve's JS
  // re-applies its own inline styles on variant selection.
  (function () {
    var vpWrap = sec.querySelector('.bl-pd-vars');
    if (!vpWrap) return;
    var labelColor = vpWrap.getAttribute('data-label-color') || '#eaf4f5';
    var busy = false;

    function paint() {
      if (busy) return;
      busy = true;
      obs.disconnect();

      vpWrap.querySelectorAll('*').forEach(function (el) {
        var tag = el.tagName;
        var cls = typeof el.className === 'string' ? el.className : '';
        if (tag === 'INPUT' || tag === 'BUTTON' || tag === 'SELECT') return;
        if (cls.indexOf('swatch_label') !== -1 || cls.indexOf('swatch_circle') !== -1 ||
            cls.indexOf('swatch_image') !== -1 || cls.indexOf('btn--') !== -1) return;
        if (tag === 'LABEL') {
          var prev = el.previousElementSibling;
          if (prev && prev.tagName === 'INPUT') return;
          var forId = el.getAttribute('for');
          if (forId) { var inp = document.getElementById(forId); if (inp && inp.type === 'radio') return; }
        }
        var directText = '';
        el.childNodes.forEach(function (n) { if (n.nodeType === 3) directText += n.textContent; });
        if (tag === 'LEGEND' || tag === 'LABEL' || /\S[^:]*:/.test(directText.trim().slice(0, 40))) {
          el.style.setProperty('color', labelColor, 'important');
        }
      });

      obs.observe(vpWrap, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'class'] });
      busy = false;
    }

    var obs = new MutationObserver(paint);
    paint();
  })();

  // ── Dark / light theme toggle ────────────────────────────────────
  (function () {
    var BL_PD_DARK = {
      bg:      '{{ bg_color }}',
      text:    '{{ text_color }}',
      accent:  '{{ accent_color }}',
      muted:   '{{ muted_color }}',
      surface: '{{ surface_color }}',
      divider: 'rgba(51,104,112,0.22)'
    };
    var BL_PD_LIGHT = {
      bg:      '{{ bg_light }}',
      text:    '{{ text_light }}',
      accent:  '{{ accent_light }}',
      muted:   '{{ muted_light }}',
      surface: '{{ surface_light }}',
      divider: 'rgba(0,26,46,0.12)'
    };

    function applyPdTheme() {
      var isLight = document.documentElement.getAttribute('data-theme') === 'light';
      var c = isLight ? BL_PD_LIGHT : BL_PD_DARK;
      sec.style.setProperty('--bl-pd-bg',      c.bg);
      sec.style.setProperty('--bl-pd-text',    c.text);
      sec.style.setProperty('--bl-pd-accent',  c.accent);
      sec.style.setProperty('--bl-pd-muted',   c.muted);
      sec.style.setProperty('--bl-pd-surface', c.surface);
      sec.style.setProperty('--bl-pd-divider', c.divider);
      sec.style.backgroundColor = c.bg;
      sec.style.color           = c.text;

      /* Variant picker option labels — static Liquid colour doesn't
         auto-respond; re-apply using the current theme text colour */
      sec.querySelectorAll('.bl-pd-vars').forEach(function(vpWrap) {
        var labelClr = isLight
          ? c.text
          : (vpWrap.getAttribute('data-label-color') || c.text);
        vpWrap.querySelectorAll(
          'legend, [class*="option_name"], [class*="option_title"],' +
          '[class*="variant_label"], [class*="form_label"],' +
          '[class*="selected_option"], [class*="variant_name"]'
        ).forEach(function(el) {
          el.style.setProperty('color', labelClr, 'important');
        });
      });
    }

    applyPdTheme();
    new MutationObserver(applyPdTheme).observe(
      document.documentElement,
      { attributes: true, attributeFilter: ['data-theme'] }
    );
  })();

});
</script>

<script>
/* ── Auto color swatch conversion ──────────────────────────────────
   Detects any variant option whose name is "Color" / "Colour" and
   converts its rendered buttons to circular CSS-named-color swatches.
   All other options (Size, Weight, etc.) remain as regular buttons.
   ───────────────────────────────────────────────────────────────── */
(function () {
  var SECTION = document.getElementById('{{ section_id }}');
  if (!SECTION) return;

  /* Product options injected from Liquid so we know the real option names */
  var PRODUCT_OPTS = {{ product.options_with_values | json }};

  function convertColorSwatches() {
    var vp = document.getElementById('Variant_picker-{{ section.id }}');
    if (!vp) return;

    var fieldsets = Array.from(vp.querySelectorAll('fieldset'));

    PRODUCT_OPTS.forEach(function (opt, idx) {
      /* Only process options whose name is Color / Colour (case-insensitive) */
      if (!/^colou?rs?$/i.test(opt.name.trim())) return;

      /* Find the matching fieldset by position */
      var fs = fieldsets[idx];
      if (!fs) return;

      /* Convert each label/button in this fieldset to a color circle */
      fs.querySelectorAll(
        'label, .swatch_label, .btn, .btn--secondary, input[type="radio"] + label'
      ).forEach(function (el) {
        /* Skip if already converted */
        if (el.classList.contains('bl-color-swatch')) return;

        /* Derive color name from data-value, value attr, or visible text */
        var colorName = (
          el.getAttribute('data-value') ||
          el.getAttribute('value') ||
          el.textContent ||
          ''
        ).trim();

        el.classList.add('bl-color-swatch');
        /* CSS named colors work directly: "pink" → pink, "orange" → orange */
        el.style.setProperty('background', colorName, 'important');
        el.setAttribute('title', colorName); /* tooltip on hover */
        el.setAttribute('aria-label', colorName);
      });
    });
  }

  /* Run after Evolve's custom elements have initialised */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { setTimeout(convertColorSwatches, 150); });
  } else {
    setTimeout(convertColorSwatches, 150);
  }

  /* Re-run when Shopify editor reloads the section */
  document.addEventListener('shopify:section:load',   convertColorSwatches);
  document.addEventListener('shopify:section:select', convertColorSwatches);

  /* Re-run when variant changes (Evolve may re-render the picker) */
  SECTION.addEventListener('variant:changed', function () { setTimeout(convertColorSwatches, 80); });
})();
</script>

