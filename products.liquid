<script>
(function () {
  /* ── Measure real header height (nav + announcement bar, if any) so the
     sticky ATC bar — and anything else on the page using var(--header-height)
     — never overlaps a fixed/sticky header, at any announcement bar height.

     Reading header-element's own box height isn't reliable: its announcement
     bar and nav can each independently be position:fixed/sticky (pulled out
     of normal flow), so the wrapper's height doesn't always reflect what's
     actually pinned on screen. Instead, measure the real viewport-space
     bottom edge of every fixed/sticky element anchored near the top —
     covering both the header's built-in announcement bar and the standalone
     Announcement Bar section — and use whichever one extends lowest. */
  var headerEl = document.querySelector('header-element');
  if (!headerEl) return;

  function setHeaderHeightVar() {
    var maxBottom = 0;
    var candidates = document.querySelectorAll(
      '.bl-hdr-outer, .bl-hdr-announcement-bar, .bl-announcement-bar'
    );
    candidates.forEach(function (el) {
      var cs = window.getComputedStyle(el);
      if (cs.position !== 'fixed' && cs.position !== 'sticky') return;
      if (cs.display === 'none' || cs.visibility === 'hidden') return;
      var rect = el.getBoundingClientRect();
      /* A sticky element not yet "stuck" still sits at its natural in-flow
         position near the top (e.g. right below the announcement bar) —
         filtering by rect.top would wrongly exclude it before the user
         scrolls. Fixed/sticky headers are always near the top of the
         document, so just take the lowest bottom edge among them. */
      if (rect.height > 0 && rect.bottom > maxBottom) maxBottom = rect.bottom;
    });
    if (maxBottom <= 0) {
      maxBottom = headerEl.getBoundingClientRect().height;
    }
    if (maxBottom > 0) {
      document.documentElement.style.setProperty('--header-height', maxBottom + 'px');
    }
  }

  /* Deliberately NOT recalculated on scroll. Once a sticky/fixed header
     is "stuck", its rendered height is constant — scrolling doesn't
     change it. Recomputing via getBoundingClientRect() on every scroll
     frame was not just wasted work: on iOS Safari, the address bar
     collapsing/expanding mid-scroll makes viewport geometry briefly
     unstable, so this was occasionally writing a transient wrong value
     to --header-height. Since the sticky ATC bar's `top` reads that var
     directly with no transition, any bad value showed up as an instant,
     visible jump/glitch in the bar's position while scrolling on iPhone.
     resize / load / ResizeObserver already cover every legitimate case
     the header's height can actually change (viewport resize, orientation
     change, announcement bar toggling). */
  setHeaderHeightVar();
  window.addEventListener('resize', setHeaderHeightVar, { passive: true });
  window.addEventListener('load', setHeaderHeightVar);

  if (window.ResizeObserver) {
    var ro = new ResizeObserver(setHeaderHeightVar);
    ro.observe(headerEl);
    document.querySelectorAll('.bl-hdr-outer, .bl-hdr-announcement-bar, .bl-announcement-bar')
      .forEach(function (el) { ro.observe(el); });
  }
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var sec    = document.getElementById('{{ section_id }}');
  if (!sec) return;

  // Declared unconditionally (not gated by "enable sticky ATC") — if that
  // markup doesn't exist on the page, these just resolve to null and every
  // consumer below already checks for that before touching them.
  var satcBar    = document.getElementById('bl-satc-{{ section.id }}');
  var satcSelect = document.getElementById('bl-satc-select-{{ section.id }}');
  var satcBtn    = document.getElementById('bl-satc-btn-{{ section.id }}');

  var slides = Array.from(sec.querySelectorAll('.bl-pd-slide'));
  var thumbs = Array.from(sec.querySelectorAll('.bl-pd-thumb'));
  var wrap   = sec.querySelector('#bl-pd-main-{{ section.id }}');
  var cur    = 0;
  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Init: find active index matching featured_media ──
  var featuredId = '{{ featured_media.id }}';
  slides.forEach(function (s, i) {
    if (s.dataset.mediaId == featuredId) cur = i;
  });

  // Thumbs are a filtered subset of slides (videos have no thumb), so the
  // two arrays don't share index positions — always resolve the matching
  // thumb by data-media-id rather than by the slide's index.
  function findThumbForSlide(slide) {
    if (!slide) return null;
    var mediaId = slide.dataset.mediaId;
    return thumbs.find(function (t) { return t.dataset.mediaId === mediaId; }) || null;
  }

  // ── Video mute/unmute ──
  // Videos ship muted in the HTML (audio off by default) so the
  // browser's native autoplay is never blocked. Switching away from a
  // video re-mutes it, so it never keeps playing audio in the
  // background once it's no longer on screen — only the manual mute
  // button ever turns audio on.
  var muteBtn = sec.querySelector('#bl-pd-mute-{{ section.id }}');
  var zoomBtn = sec.querySelector('#bl-pd-zoom-{{ section.id }}');

  function updateZoomButton() {
    if (!zoomBtn) return;
    var activeSlide = slides[cur];
    zoomBtn.hidden = !!(activeSlide && activeSlide.querySelector('video'));
  }

  function updateMuteButton() {
    if (!muteBtn) return;
    var activeVideo = slides[cur] && slides[cur].querySelector('video');
    if (!activeVideo) {
      muteBtn.hidden = true;
      return;
    }
    muteBtn.hidden = false;
    muteBtn.classList.toggle('is-unmuted', !activeVideo.muted);
    muteBtn.setAttribute('aria-label', activeVideo.muted ? 'Unmute video' : 'Mute video');
  }
  if (muteBtn) {
    muteBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var activeVideo = slides[cur] && slides[cur].querySelector('video');
      if (!activeVideo) return;
      activeVideo.muted = !activeVideo.muted;
      updateMuteButton();
    });
  }

  updateMuteButton();
  updateZoomButton();

  function goTo(idx) {
    var newIdx = (idx + slides.length) % slides.length;
    var outgoingVideo = slides[cur] && slides[cur].querySelector('video');
    if (outgoingVideo) outgoingVideo.muted = true;
    if (slides[cur]) slides[cur].classList.remove('is-active');
    var prevThumb = findThumbForSlide(slides[cur]);
    if (prevThumb) prevThumb.classList.remove('is-active');
    cur = newIdx;
    if (slides[cur]) slides[cur].classList.add('is-active');
    var incomingVideo = slides[cur] && slides[cur].querySelector('video');
    if (incomingVideo) incomingVideo.muted = true;
    var nextThumb = findThumbForSlide(slides[cur]);
    if (nextThumb) {
      nextThumb.classList.add('is-active');
      nextThumb.scrollIntoView({ inline: 'nearest', behavior: 'smooth', block: 'nearest' });
    }
    updateMuteButton();
    updateZoomButton();
    {% if enable_zoom %}if (typeof updateLbSrc === 'function') updateLbSrc();{% endif %}
  }

  thumbs.forEach(function (t, i) { t.addEventListener('click', function (e) {
    e.preventDefault();
    if (thumbsDragged) { thumbsDragged = false; return; }
    var mediaId = t.dataset.mediaId;
    var targetIdx = -1;
    if (mediaId) {
      targetIdx = slides.findIndex(function (s) { return s.dataset.mediaId === mediaId; });
    }
    if (targetIdx === -1) targetIdx = i;
    goTo(targetIdx);
  }); });

  // ── Thumbnail strip — click-and-drag to scroll (desktop mouse users) ──
  var thumbsWrap    = sec.querySelector('.bl-pd-thumbs');
  var thumbsDragging = false;
  var thumbsDragged  = false;
  var thumbsStartX   = 0;
  var thumbsStartScroll = 0;

  if (thumbsWrap) {
    thumbsWrap.addEventListener('mousedown', function (e) {
      thumbsDragging = true;
      thumbsDragged  = false;
      thumbsWrap.classList.add('is-dragging');
      thumbsStartX = e.pageX - thumbsWrap.offsetLeft;
      thumbsStartScroll = thumbsWrap.scrollLeft;
    });
    ['mouseleave', 'mouseup'].forEach(function (evt) {
      thumbsWrap.addEventListener(evt, function () {
        thumbsDragging = false;
        thumbsWrap.classList.remove('is-dragging');
      });
    });
    thumbsWrap.addEventListener('mousemove', function (e) {
      if (!thumbsDragging) return;
      e.preventDefault();
      var x = e.pageX - thumbsWrap.offsetLeft;
      var walk = x - thumbsStartX;
      if (Math.abs(walk) > 5) thumbsDragged = true;
      thumbsWrap.scrollLeft = thumbsStartScroll - walk;
    });
  }

  var arrP = sec.querySelector('.bl-pd-arr--p');
  var arrN = sec.querySelector('.bl-pd-arr--n');
  if (arrP) arrP.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); goTo(cur - 1); });
  if (arrN) arrN.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); goTo(cur + 1); });

  // touch swipe
  var tx = 0, ty = 0, touchMoved = false;
  if (wrap) {
    wrap.addEventListener('touchstart', function (e) {
      tx = e.touches[0].clientX;
      ty = e.touches[0].clientY;
      touchMoved = false;
    }, { passive: true });
    wrap.addEventListener('touchmove', function (e) {
      var dx = Math.abs(tx - e.touches[0].clientX);
      var dy = Math.abs(ty - e.touches[0].clientY);
      if (dx > 10 || dy > 10) touchMoved = true;
    }, { passive: true });
    wrap.addEventListener('touchend', function (e) {
      var dx = tx - e.changedTouches[0].clientX;
      var dy = ty - e.changedTouches[0].clientY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        goTo(dx > 0 ? cur + 1 : cur - 1);
      }
    });
  }

  // ── Color swatch fallback ──────────────────────────────────────────
  // Shopify only renders an actual color for a swatch when the merchant
  // has configured that specific option value under Settings → Product
  // options in Admin. Any value without one falls back to a flat gray
  // circle (variant-picker.liquid marks it with .bl-swatch-fallback +
  // data-swatch-name). Rather than leave it gray, try to resolve the
  // option value's own text as real CSS color(s) — the browser's CSS
  // parser already recognizes ~140 named colors (e.g. "Black", "Navy",
  // "Maroon"), so a value like "Black Blue" becomes a genuine two-tone
  // split swatch instead of solid gray, with zero admin config needed.
  (function () {
    var fallbackEls = sec.querySelectorAll('.bl-swatch-fallback[data-swatch-name]');
    if (!fallbackEls.length) return;

    function resolveCssColor(word) {
      var probe = document.createElement('div');
      probe.style.color = '';
      probe.style.color = word;
      return probe.style.color !== '' ? word : null;
    }

    fallbackEls.forEach(function (el) {
      var raw = el.getAttribute('data-swatch-name') || '';
      var words = raw.trim().split(/\s+/);
      var colors = [];
      words.forEach(function (w) {
        var c = resolveCssColor(w);
        if (c) colors.push(c);
      });
      if (colors.length === 1) {
        el.style.background = colors[0];
        el.style.opacity = '';
      } else if (colors.length >= 2) {
        el.style.background = 'linear-gradient(135deg, ' + colors[0] + ' 50%, ' + colors[1] + ' 50%)';
        el.style.opacity = '';
      }
      // No recognizable color word at all — leave the neutral gray placeholder.
    });
  })();

  // ── Variant change — single source of truth ──
  // Nothing in this theme ever actually dispatches a "variant:changed" DOM
  // event (checked — there's no dispatchEvent call for it anywhere), so
  // every listener that depended on it was dead code. Instead: read the
  // product's full variant list once, and whenever any radio in the main
  // picker changes, work out which variant that combination resolves to
  // and drive every dependent UI piece (media, inventory, price block,
  // sticky bar, hidden id fields) from that one place. The sticky bar's own
  // select reuses the exact same function, so both controls always agree.

  // Built via direct Liquid property access (not `product.variants | json`)
  // because Shopify's `| json` filter on a variant object silently strips
  // inventory_quantity/inventory_policy — confirmed on this store's own
  // data-selected-variant script tag, which has no inventory_quantity key
  // at all. That's what caused the inventory badge to read "undefined
  // Units" until something else re-rendered it with real server data.
  var PRODUCT_VARIANTS_ALL = [
    {%- for v in product.variants -%}
    {
      id: {{ v.id | json }},
      title: {{ v.title | json }},
      available: {{ v.available | json }},
      options: {{ v.options | json }},
      price: {{ v.price | json }},
      compare_at_price: {{ v.compare_at_price | json }},
      inventory_management: {{ v.inventory_management | json }},
      inventory_quantity: {{ v.inventory_quantity | json }},
      inventory_policy: {{ v.inventory_policy | json }},
      featured_media: {% if v.featured_media %}{ id: {{ v.featured_media.id | json }} }{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  // Always renders a comma-grouped whole-number amount (no decimals), to
  // match the SSR price block below (which uses money_without_trailing_zeros
  // unconditionally) — avoids the old bug where the client update briefly
  // showed a raw "11999.00" before a later re-render fixed the formatting.
  function formatMoneyNoDecimals(cents) {
    var num = Math.round(cents / 100);
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function findVariantByOptions(values) {
    return PRODUCT_VARIANTS_ALL.find(function (v) {
      if (!v.options || v.options.length !== values.length) return false;
      return v.options.every(function (val) { return values.indexOf(val) !== -1; });
    });
  }
  function findVariantById(id) {
    id = String(id);
    return PRODUCT_VARIANTS_ALL.find(function (v) { return String(v.id) === id; });
  }
  // Every "id" field on the page tied to this product — the real
  // add-to-cart form (drives Add to Cart + the dynamic "Buy it now" /
  // Shop Pay button) AND the separate installment-message form (drives the
  // "or 4 payments of ₹X" text). Both need to stay in sync, not just the
  // cart form, or the checkout button / installment text goes stale after
  // switching variants.
  function getAllIdFields() {
    return Array.from(sec.querySelectorAll('form [name="id"]'));
  }
  // Sets both the live property AND the DOM attribute (some Shopify-hosted
  // widgets, like the dynamic checkout button, watch the attribute via
  // MutationObserver rather than re-reading .value), then dispatches
  // input/change so anything listening for user-driven edits picks it up.
  function setVariantIdField(field, id, available) {
    if (!field) return;
    field.value = id;
    field.setAttribute('value', id);
    field.disabled = available === false;
    field.dispatchEvent(new Event('input', { bubbles: true }));
    field.dispatchEvent(new Event('change', { bubbles: true }));
  }
  // Clicks the matching option(s) in the real on-page variant picker so its
  // own visual state (active class) stays correct too, not just the data.
  function syncMainPicker(optionValues) {
    if (!optionValues || !optionValues.length) return;
    optionValues.forEach(function (val) {
      var radio = sec.querySelector('.bl-pd-vars input[type="radio"][value="' + CSS.escape(String(val)) + '"]');
      if (radio && !radio.checked) radio.checked = true;
    });
  }

  function applyVariantUpdate(v) {
    if (!v) return;

    // Media
    if (v.featured_media) {
      var mid = String(v.featured_media.id);
      var idx = slides.findIndex(function (s) { return s.dataset.mediaId === mid; });
      if (idx >= 0) goTo(idx);
    }

    // Custom inventory badge
    var invEl = document.getElementById('bl-inv-custom-{{ section.id }}');
    if (invEl) {
      var thresh = parseInt(invEl.dataset.threshold || '10', 10);
      var inClr  = invEl.dataset.inClr  || '#07d16e';
      var outClr = invEl.dataset.outClr || '#ff4444';
      var lowClr = invEl.dataset.lowClr || '#e8a000';
      var label, clr, bg, bdr, state;
      if (v.available) {
        if (v.inventory_management && v.inventory_quantity <= thresh) {
          label = 'Only ' + v.inventory_quantity + ' left';
          clr = lowClr; bg = 'rgba(232,160,0,0.08)'; bdr = 'rgba(232,160,0,0.35)'; state = 'low';
        } else if (v.inventory_management) {
          label = 'Stock : ' + v.inventory_quantity + ' Units';
          clr = inClr; bg = 'rgba(7,209,110,0.08)'; bdr = 'rgba(7,209,110,0.35)'; state = 'in';
        } else {
          label = 'In Stock';
          clr = inClr; bg = 'rgba(7,209,110,0.08)'; bdr = 'rgba(7,209,110,0.35)'; state = 'in';
        }
      } else {
        label = 'Out of Stock';
        clr = outClr; bg = 'rgba(255,68,68,0.08)'; bdr = 'rgba(255,68,68,0.35)'; state = 'out';
      }
      invEl.className = 'bl-inv-badge bl-inv-badge--' + state;
      invEl.style.cssText = '--_inv-clr:' + clr + ';--_inv-bg:' + bg + ';--_inv-border:' + bdr + ';';
      var dot  = invEl.querySelector('.bl-inv-dot');
      var text = invEl.querySelector('.bl-inv-text');
      if (dot)  dot.style.background = clr;
      if (text) text.textContent = label;
    }

    // Variant picker's own "Size: 24KG (Single)" header text — Shopify's
    // native variant-picker component re-renders this itself, but only
    // after a delayed section re-fetch triggered by the main picker (the
    // 1-2s lag), and it never reacts to the sticky bar's select at all
    // (that control is outside its own custom element). Set it directly,
    // instantly, from both change sources instead of relying on that.
    if (v.options) {
      var optHeaderSpans = sec.querySelectorAll('.bl-pd-vars .main_product_options_header h4 span');
      optHeaderSpans.forEach(function (span, i) {
        if (v.options[i] !== undefined) span.textContent = v.options[i];
      });
    }

    // Price block — fully custom, not Shopify's native price snippet, so
    // nothing updates it unless we do it here explicitly.
    var priceWrap = document.getElementById('Price-{{ section.id }}');
    if (priceWrap && v.price !== undefined) {
      var pCurEl   = priceWrap.querySelector('.bl-pd-price-current');
      var pCmpEl   = priceWrap.querySelector('.bl-pd-price-compare');
      var pBadgeEl = priceWrap.querySelector('.bl-pd-price-badge');
      var pRow     = priceWrap.querySelector('.bl-pd-price-row');

      if (pCurEl) {
        pCurEl.textContent = '{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}'.replace(
          /[\d,]+(\.\d+)?/, formatMoneyNoDecimals(v.price)
        );
      }

      var hasCompare = v.compare_at_price && v.compare_at_price > v.price;
      if (hasCompare) {
        var cmpText = '{{ product.selected_or_first_available_variant.compare_at_price | default: 100 | money_without_trailing_zeros }}'.replace(
          /[\d,]+(\.\d+)?/, formatMoneyNoDecimals(v.compare_at_price)
        );
        if (!pCmpEl && pRow) {
          pCmpEl = document.createElement('span');
          pCmpEl.className = 'bl-pd-price-compare';
          pRow.appendChild(pCmpEl);
        }
        if (pCmpEl) { pCmpEl.textContent = cmpText; pCmpEl.style.display = ''; }

        var pct = Math.round(((v.compare_at_price - v.price) / v.compare_at_price) * 100);
        if (!pBadgeEl && pRow) {
          pBadgeEl = document.createElement('span');
          pBadgeEl.className = 'bl-pd-price-badge';
          pRow.appendChild(pBadgeEl);
        }
        if (pBadgeEl) { pBadgeEl.textContent = '-' + pct + '% OFF'; pBadgeEl.style.display = ''; }
      } else {
        if (pCmpEl)   pCmpEl.style.display = 'none';
        if (pBadgeEl) pBadgeEl.style.display = 'none';
      }
    }

    // Main Add to Cart button — Shopify's own action-buttons snippet only
    // renders this once server-side, so it never updates on variant change
    // unless we drive it from here too.
    var atcBtn = sec.querySelector('#Action_buttons-{{ section.id }} .product_form_submit_button');
    if (atcBtn) {
      atcBtn.disabled = !v.available;
      atcBtn.setAttribute('data-available', v.available);
      var atcBtnText = atcBtn.querySelector('.btn_text');
      if (atcBtnText) atcBtnText.textContent = v.available ? '{{ "products.product.add_to_cart" | t }}' : 'Out of Stock';
    }

    // Sticky ATC bar
    if (satcBar) {
      var satcPriceEl = satcBar.querySelector('.bl-satc-price');
      if (satcPriceEl && v.price !== undefined) {
        satcPriceEl.textContent = '{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}'.replace(
          /[\d,]+(\.\d+)?/, formatMoneyNoDecimals(v.price)
        );
      }
      if (satcBtn) {
        satcBtn.disabled = !v.available;
        satcBtn.textContent = v.available ? '{{ "products.product.add_to_cart" | t }}' : 'Out of Stock';
      }
      if (satcSelect && v.id != null) satcSelect.value = String(v.id);
    }

    // Hidden variant-id field(s) — cart-add form AND the installment form
    // both get updated, so the dynamic checkout ("Buy it now") button and
    // the Shop Pay installment message ("or 4 payments of...") both refresh
    // for the newly selected variant, not just the visible price block.
    if (v.id != null) {
      getAllIdFields().forEach(function (field) { setVariantIdField(field, v.id, v.available); });
    }

    try {
      sec.dispatchEvent(new CustomEvent('variant:changed', { detail: { variant: v } }));
    } catch (e) {}
  }

  // Main picker → resolve the full selected combination to a variant.
  sec.addEventListener('change', function (e) {
    if (!e.target || !e.target.matches || !e.target.matches('.bl-pd-vars input[type="radio"]')) return;
    var selected = Array.from(sec.querySelectorAll('.bl-pd-vars input[type="radio"]:checked'))
      .map(function (el) { return el.value; });
    var variant = findVariantByOptions(selected);
    if (variant) applyVariantUpdate(variant);
  });

  {% if enable_zoom %}
  // ── Lightbox ──
  var lb       = document.getElementById('bl-lb-{{ section.id }}');
  var lbImg    = document.getElementById('bl-lb-img-{{ section.id }}');
  var lbCount  = document.getElementById('bl-lb-count-{{ section.id }}');

  function updateLbSrc() {
    if (!lb) return;
    var activeSlide = slides[cur];
    if (!activeSlide) return;
    var img = activeSlide.querySelector('img');
    if (img && lbImg) {
      var src = img.currentSrc || img.src || img.getAttribute('src');
      if (src) {
        lbImg.src = src.replace(/width=\d+/, 'width=2000').replace(/&\d+x\d+/, '');
        lbImg.alt = img.alt || '';
      }
    }
    if (lbCount) lbCount.textContent = (cur + 1) + ' / ' + slides.length;
  }

  function openLb() {
    if (!lb) return;
    lb.classList.add('is-open');
    lb.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    updateLbSrc();
  }
  function closeLb() {
    if (!lb) return;
    lb.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  if (wrap) wrap.addEventListener('click', function (e) {
    if (e.target.closest('.bl-pd-arr') || e.target.closest('.bl-pd-zoom') || e.target.closest('.bl-pd-mute')) return;
    if (touchMoved) { touchMoved = false; return; }
    var active = wrap.querySelector('.bl-pd-slide.is-active');
    if (active && active.querySelector('img') && !active.querySelector('video')) openLb();
  });
  var zBtn = sec.querySelector('#bl-pd-zoom-{{ section.id }}');
  if (zBtn) { zBtn.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); openLb(); }); }

  if (lb) {
    var lbClose = lb.querySelector('.bl-lb-close');
    var lbPrev  = lb.querySelector('.bl-lb-prev');
    var lbNext  = lb.querySelector('.bl-lb-next');
    if (lbClose) lbClose.addEventListener('click', function (e) { e.stopPropagation(); closeLb(); });
    lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
    if (lbPrev)  lbPrev.addEventListener('click', function (e) { e.stopPropagation(); goTo(cur - 1); });
    if (lbNext)  lbNext.addEventListener('click', function (e) { e.stopPropagation(); goTo(cur + 1); });
  }
  document.addEventListener('keydown', function (e) {
    if (!lb || !lb.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowLeft')  { goTo(cur - 1); }
    if (e.key === 'ArrowRight') { goTo(cur + 1); }
  });
  {% endif %}

  {% if enable_zoom %}
  // ── Hover magnifier lens (desktop-only, images only, Flipkart/Amazon style) ──
  (function () {
    if (reducedMotion || window.innerWidth <= 1024) return;

    var mainWrap = sec.querySelector('#bl-pd-main-{{ section.id }}');
    if (!mainWrap) return;

    // Create lens element inside the main wrap
    var lens = document.createElement('div');
    lens.className = 'bl-zoom-lens';
    mainWrap.appendChild(lens);

    // Create result element appended to body (escapes overflow:hidden)
    var result = document.createElement('div');
    result.className = 'bl-zoom-result-{{ section.id }}';
    document.body.appendChild(result);

    var ZOOM = 3;
    var rafId = null;
    var pendingX = 0, pendingY = 0, pendingRect = null, pendingSrc = '';

    function isImgSlide(slide) {
      return slide && slide.querySelector('img') && !slide.querySelector('video');
    }

    function positionResult(rect) {
      var rw = result.offsetWidth;
      var rh = result.offsetHeight;
      var gap = 20;
      var left = rect.right + gap;
      var top  = rect.top;
      // If result goes off right edge, put it left of media
      if (left + rw > window.innerWidth - 10) {
        left = rect.left - rw - gap;
      }
      // Clamp top so it doesn't go off bottom
      if (top + rh > window.innerHeight - 10) {
        top = window.innerHeight - rh - 10;
      }
      if (top < 10) top = 10;
      result.style.left = left + 'px';
      result.style.top  = top + 'px';
    }

    function applyMagnifier(x, y, rect, src) {
      var lw = lens.offsetWidth, lh = lens.offsetHeight;
      var rw = result.offsetWidth, rh = result.offsetHeight;

      // Clamp lens within image bounds
      var lx = Math.max(0, Math.min(x - lw / 2, rect.width - lw));
      var ly = Math.max(0, Math.min(y - lh / 2, rect.height - lh));
      lens.style.left = lx + 'px';
      lens.style.top  = ly + 'px';

      // Compute background size = image displayed size × ZOOM
      var bgW = rect.width * ZOOM;
      var bgH = rect.height * ZOOM;

      // The centre of the lens maps to the centre of the result
      var cx = lx + lw / 2;
      var cy = ly + lh / 2;
      var bpX = -(cx * ZOOM - rw / 2);
      var bpY = -(cy * ZOOM - rh / 2);

      result.style.backgroundImage    = 'url(' + src + ')';
      result.style.backgroundSize     = bgW + 'px ' + bgH + 'px';
      result.style.backgroundPosition = bpX + 'px ' + bpY + 'px';
      positionResult(rect);
    }

    mainWrap.addEventListener('mousemove', function (e) {
      var active = mainWrap.querySelector('.bl-pd-slide.is-active');
      if (!isImgSlide(active)) { hideMag(); return; }
      var img = active.querySelector('img');
      if (!img) { hideMag(); return; }

      var rect = mainWrap.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;

      // High-res src
      var src = img.src.replace(/width=\d+/, 'width=2000');

      pendingX = x; pendingY = y; pendingRect = rect; pendingSrc = src;

      if (!rafId) {
        rafId = requestAnimationFrame(function () {
          rafId = null;
          lens.style.display   = 'block';
          result.style.display = 'block';
          applyMagnifier(pendingX, pendingY, pendingRect, pendingSrc);
        });
      }
    });

    function hideMag() {
      lens.style.display   = 'none';
      result.style.display = 'none';
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    }

    mainWrap.addEventListener('mouseleave', hideMag);

    // Hide magnifier when lightbox opens
    if (wrap) wrap.addEventListener('click', hideMag);
    window.addEventListener('resize', function () {
      if (window.innerWidth <= 1024) hideMag();
    });

    // Re-check on variant change (video slides have no lens)
    sec.addEventListener('variant:changed', hideMag);
  })();
  {% endif %}

  {% if enable_para %}
  // ── Parallax glow (image tilt/"float" removed — image stays static) ──
  if (!reducedMotion) {
    var g1 = sec.querySelector('.bl-pd-glow--1');
    var g2 = sec.querySelector('.bl-pd-glow--2');
    var rafPara = null;
    var mx = 0, my = 0;

    document.addEventListener('mousemove', function (e) {
      mx = e.clientX; my = e.clientY;
      if (!rafPara) rafPara = requestAnimationFrame(function () {
        rafPara = null;
        var cx = window.innerWidth / 2, cy = window.innerHeight / 2;
        var dx = (mx - cx) / cx, dy = (my - cy) / cy;
        if (g1) g1.style.transform = 'translate(' + (dx * 22) + 'px,' + (dy * 18) + 'px)';
        if (g2) g2.style.transform = 'translate(' + (dx * -16) + 'px,' + (dy * -12) + 'px)';
      });
    });
    sec.addEventListener('mouseleave', function () {
      if (g1) g1.style.transform = '';
      if (g2) g2.style.transform = '';
    });
  }
  {% endif %}

  {% if enable_anim %}
  // ── Reveal animations ──
  var revObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  var mc = sec.querySelector('.bl-pd-media-col');
  var ic = sec.querySelector('.bl-pd-info-col');
  if (mc) revObs.observe(mc);
  if (ic) revObs.observe(ic);
  {% endif %}

  {% if enable_sticky %}
  // ── Sticky ATC ──
  // Positioning (top offset below the header, or pinned to the bottom) is
  // handled entirely by CSS via var(--header-height) / data-position — no
  // inline "top" override here, since that used to win over the CSS calc()
  // with an incomplete header-only measurement and cause the overlap.
  // satcBar / satcSelect / satcBtn are declared near the top of this script;
  // getIdField / syncMainPicker / applyVariantUpdate are the shared
  // variant-change functions defined above, also used by the main picker.
  var atcEl = sec.querySelector('#Action_buttons-{{ section.id }}');

  if (satcBar && atcEl) {
    var satcObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          satcBar.classList.remove('is-visible');
          satcBar.setAttribute('aria-hidden', 'true');
        } else {
          satcBar.classList.add('is-visible');
          satcBar.removeAttribute('aria-hidden');
        }
      });
    }, { threshold: 0 });
    satcObs.observe(atcEl);

    if (satcSelect) {
      satcSelect.addEventListener('change', function () {
        var variant = findVariantById(satcSelect.value);
        if (!variant) return;
        applyVariantUpdate(variant);
        syncMainPicker(variant.options);
      });
    }

    // Clicking sticky ATC submits the REAL add-to-cart form via
    // requestSubmit() (not .submit(), which would skip the theme's own
    // "submit" listener and its AJAX cart / drawer handling entirely).
    // Submitting the actual form — rather than a hand-rolled fetch —
    // keeps quantity, gift-wrap, and any other fields in the form intact,
    // and reuses whatever cart-drawer/notification behavior the main Add
    // to Cart button already triggers, instead of reinventing it.
    if (satcBtn) {
      satcBtn.addEventListener('click', function () {
        var form = sec.querySelector('form[action*="/cart/add"]') || sec.querySelector('[data-type="add-to-cart-form"]');
        if (form) {
          if (satcSelect) {
            getAllIdFields().forEach(function (field) { setVariantIdField(field, satcSelect.value); });
          }
          if (form.requestSubmit) form.requestSubmit(); else form.submit();
        }
      });
    }

    // Hide sticky ATC bar when mobile drawer is open so it doesn't overlap
    if (satcBar) {
      var blSatcDrawerObs = new MutationObserver(function () {
        var drawerEl = document.querySelector(
          '#mobile_menu_drawer, .menu-drawer, [class*="mobile_menu"], [class*="menu-drawer"]'
        );
        var isOpen = drawerEl && (
          drawerEl.hasAttribute('open') ||
          drawerEl.classList.contains('is-active') ||
          drawerEl.getAttribute('aria-hidden') === 'false' ||
          (drawerEl.style && drawerEl.style.display === 'block')
        );
        satcBar.style.display = isOpen ? 'none' : '';
      });
      blSatcDrawerObs.observe(document.body, {
        subtree: true, attributes: true,
        attributeFilter: ['open', 'class', 'aria-hidden', 'style']
      });
    }
  }
  {% endif %}

  // ── Description paginator ──
  (function () {
    var pagedContent = document.getElementById('bl-desc-paged-{{ section.id }}');
    var pager        = document.getElementById('bl-desc-pager-{{ section.id }}');
    var dotsWrap     = document.getElementById('bl-desc-dots-{{ section.id }}');
    var countEl      = document.getElementById('bl-desc-count-{{ section.id }}');
    if (!pagedContent || !pager) return;

    // Split into pages at every H2 heading
    var children = Array.from(pagedContent.childNodes);
    var pages    = [];
    var current  = [];

    children.forEach(function (node) {
      var isH2 = node.nodeType === 1 && node.tagName === 'H2';
      if (isH2 && current.length > 0) {
        pages.push(current);
        current = [];
      }
      current.push(node);
    });
    if (current.length > 0) pages.push(current);

    // Fallback: split by every 3 block-level elements if no H2s found
    if (pages.length <= 1) {
      var blockEls = children.filter(function (n) {
        return n.nodeType === 1 && ['P','H2','H3','H4','UL','OL','FIGURE','TABLE','DIV'].indexOf(n.tagName) > -1;
      });
      if (blockEls.length > 5) {
        var chunkSize = Math.ceil(blockEls.length / Math.ceil(blockEls.length / 4));
        pages = [];
        current = [];
        blockEls.forEach(function (el, i) {
          current.push(el);
          if (current.length >= chunkSize && i < blockEls.length - 1) {
            pages.push(current.slice()); current = [];
          }
        });
        if (current.length) pages.push(current);
      }
    }

    if (pages.length <= 1) return; // No need to paginate

    // Build page wrappers
    pagedContent.innerHTML = '';
    pages.forEach(function (nodeArr, i) {
      var wrap = document.createElement('div');
      wrap.className = 'bl-pd-desc-page' + (i === 0 ? ' is-active' : '');
      nodeArr.forEach(function (n) { wrap.appendChild(n.cloneNode ? n.cloneNode(true) : n); });
      pagedContent.appendChild(wrap);
    });

    // Build dot indicators
    var dots = [];
    if (dotsWrap) {
      pages.forEach(function (_, i) {
        var dot = document.createElement('button');
        dot.className = 'bl-pd-desc-pager-dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Section ' + (i + 1));
        dot.addEventListener('click', function () { goPage(i); });
        dotsWrap.appendChild(dot);
        dots.push(dot);
      });
    }

    var prevBtn = pager.querySelector('.bl-pd-desc-pager-btn--prev');
    var nextBtn = pager.querySelector('.bl-pd-desc-pager-btn--next');
    var curIdx  = 0;

    function updateCount() {
      if (countEl) countEl.textContent = (curIdx + 1) + ' / ' + pages.length;
    }

    function goPage(idx) {
      var pageDivs = pagedContent.querySelectorAll('.bl-pd-desc-page');
      pageDivs[curIdx].classList.remove('is-active');
      if (dots[curIdx]) dots[curIdx].classList.remove('is-active');
      curIdx = Math.max(0, Math.min(idx, pages.length - 1));
      pageDivs[curIdx].classList.add('is-active');
      if (dots[curIdx]) dots[curIdx].classList.add('is-active');
      if (prevBtn) prevBtn.disabled = curIdx === 0;
      if (nextBtn) nextBtn.disabled = curIdx === pages.length - 1;
      updateCount();
      // Smooth scroll to paged section top
      var topEl = pagedContent.closest('.bl-pd-desc-paged-wrap') || pagedContent;
      var hdrH = 80;
      var hdr = document.querySelector('.bl-hdr-outer') || document.querySelector('header');
      if (hdr) hdrH = hdr.offsetHeight + 16;
      window.scrollTo({ top: topEl.getBoundingClientRect().top + window.scrollY - hdrH, behavior: 'smooth' });
    }

    if (prevBtn) { prevBtn.disabled = true; prevBtn.addEventListener('click', function () { goPage(curIdx - 1); }); }
    if (nextBtn) { nextBtn.disabled = pages.length <= 1; nextBtn.addEventListener('click', function () { goPage(curIdx + 1); }); }
    updateCount();
    pager.style.display = 'flex';
  })();

  // ── Sticky description column: keep top offset updated as sticky ATC bar appears/disappears ──
  (function () {
    var stickyText = sec.querySelector('.bl-pd-desc-split-text');
    var satcBar    = document.getElementById('bl-satc-{{ section.id }}');
    if (!stickyText) return;
    function syncTop() {
      // Disable on mobile — CSS sets position:static there
      if (window.innerWidth <= 768) { stickyText.style.top = ''; return; }
      var hdr   = document.querySelector('.bl-hdr-outer') || document.querySelector('header');
      var hdrH  = hdr ? hdr.offsetHeight : 64;
      var satcH = (satcBar && satcBar.classList.contains('is-visible')) ? satcBar.offsetHeight : 0;
      stickyText.style.top = (hdrH + satcH + 12) + 'px';
    }
    syncTop();
    window.addEventListener('scroll', syncTop, { passive: true });
    window.addEventListener('resize', syncTop, { passive: true });
  })();

  // ── Tabbed description: tab switching + image extraction ──
  (function () {
    var tabbedWrap = document.getElementById('bl-pd-tabs-{{ section.id }}');
    if (!tabbedWrap) return;

    var tabBtns   = Array.from(tabbedWrap.querySelectorAll('.bl-pd-tab-btn'));
    var tabPanels = Array.from(tabbedWrap.querySelectorAll('.bl-pd-tab-panel'));

    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = btn.getAttribute('data-bl-tab');
        tabBtns.forEach(function (b) { b.classList.remove('is-active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('is-active'); btn.setAttribute('aria-selected', 'true');
        tabPanels.forEach(function (p) { p.classList.remove('is-active'); });
        var panel = tabbedWrap.querySelector('#bl-tab-panel-' + target + '-{{ section.id }}');
        if (panel) panel.classList.add('is-active');
      });
    });

    // Move <img> elements from the text column into the images column
    var textCol = document.getElementById('bl-desc-text-{{ section.id }}');
    var imgsCol = document.getElementById('bl-desc-imgs-{{ section.id }}');
    if (textCol && imgsCol) {
      var imgs = Array.from(textCol.querySelectorAll('img'));
      imgs.forEach(function (img) {
        var wrapper = img.closest('figure') || img.parentNode;
        var clone   = img.cloneNode(true);
        imgsCol.appendChild(clone);
        // Remove the original; if its wrapper is now empty, remove that too
        img.remove();
        if (wrapper && wrapper !== textCol && wrapper.textContent.trim() === '' && !wrapper.querySelector('img, video, svg')) {
          wrapper.remove();
        }
      });
      // If no images ended up in the right column (e.g. all were lazy-src only), hide the split
      if (imgsCol.children.length === 0) {
        var split = document.getElementById('bl-desc-split-{{ section.id }}');
        if (split) { split.style.gridTemplateColumns = '1fr'; imgsCol.style.display = 'none'; }
      }
    }
  })();

  // ── Accordion description mode: unwrap stray <details> from every auto-generated panel ──
  // (Images are kept — see #{{ section_id }} .bl-pd-acc-wrap .bl-pd-desc img
  // in the <style> block for their equal, clamp()-sized styling.)
  (function () {
    var accWrap = document.getElementById('bl-pd-acc-{{ section.id }}');
    if (!accWrap) return;
    Array.from(accWrap.querySelectorAll('.bl-pd-desc.rte')).forEach(function (panel) {
      /* Any <details> pasted straight into the product description (common
         in copy-pasted spec sheets) is unwrapped into plain flowing text.
         CSS alone can't reliably hide these — some browsers render a
         built-in "Details" label with a native triangle when a <details>
         has no <summary>, and that fallback isn't a real, selectable DOM
         node — so we remove the tags outright instead of hiding them. */
      Array.from(panel.querySelectorAll('details')).forEach(function (det) {
        var summary = det.querySelector(':scope > summary');
        if (summary) summary.remove();
        while (det.firstChild) {
          det.parentNode.insertBefore(det.firstChild, det);
        }
        det.remove();
      });
    });
  })();

  // ── Accordion description mode: smooth open/close (instead of the browser's instant show/hide) ──
  (function () {
    var accWrap = document.getElementById('bl-pd-acc-{{ section.id }}');
    if (!accWrap) return;

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    Array.from(accWrap.children).forEach(function (item) {
      var summary = item.querySelector(':scope > summary');
      var panel   = item.querySelector(':scope > .bl-pd-acc-panel');
      if (!summary || !panel) return;

      summary.addEventListener('click', function (e) {
        e.preventDefault();

        if (reducedMotion) {
          item.open = !item.open;
          panel.style.height = item.open ? 'auto' : '0px';
          return;
        }

        if (item.open) {
          // Closing: fix current height, then collapse to 0 on the next frame.
          panel.style.height = panel.scrollHeight + 'px';
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              panel.style.height = '0px';
            });
          });
          panel.addEventListener('transitionend', function onEnd(ev) {
            if (ev.propertyName !== 'height') return;
            panel.removeEventListener('transitionend', onEnd);
            item.open = false;
          });
        } else {
          // Opening: reveal content first so scrollHeight is measurable, then animate 0 → height.
          item.open = true;
          var target = panel.scrollHeight;
          panel.style.height = '0px';
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              panel.style.height = target + 'px';
            });
          });
          panel.addEventListener('transitionend', function onEnd(ev) {
            if (ev.propertyName !== 'height') return;
            panel.removeEventListener('transitionend', onEnd);
            panel.style.height = 'auto';
          });
        }
      });
    });
  })();

  // ── Visual Canvas mode ─────────────────────────────────────────────
  (function () {
    var storyWrap = document.getElementById('bl-pd-story-{{ section.id }}');
    if (!storyWrap) return;

    var srcEl   = document.getElementById('bl-story-src-{{ section.id }}');
    var barFill = document.getElementById('bl-story-fill-{{ section.id }}');
    if (!srcEl) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var isMobile = window.innerWidth <= 768;

    // ── Parse the description HTML ──
    var parser = new DOMParser();
    var doc    = parser.parseFromString(srcEl.innerHTML, 'text/html');
    var nodes  = Array.from(doc.body.childNodes);

    // ── Extract images from description ──
    var tempDiv = document.createElement('div');
    nodes.forEach(function(n) { if (n.cloneNode) tempDiv.appendChild(n.cloneNode(true)); });
    var allImgs = Array.from(tempDiv.querySelectorAll('img'));
    var imgSrcs = [];
    allImgs.forEach(function(img) {
      imgSrcs.push(img.src);
      var w = img.closest('figure') || img.parentNode;
      img.remove();
      if (w && w !== tempDiv && !w.textContent.trim() && !w.querySelector('img,video,svg')) w.remove();
    });

    // ── 1. Text section: description LEFT + additional info RIGHT ──
    var addlEl   = document.getElementById('bl-canvas-addl-{{ section.id }}');
    var addlRows = addlEl ? Array.from(addlEl.querySelectorAll('[data-key]')) : [];

    var textSection = document.createElement('div');
    textSection.className = 'bl-canvas-text-section';

    var twoCol = document.createElement('div');
    twoCol.className = 'bl-canvas-2col';

    // Left: description
    var textDiv = document.createElement('div');
    textDiv.className = 'bl-canvas-text';
    textDiv.innerHTML = tempDiv.innerHTML;

    // Right: additional info panel
    var infoDiv = document.createElement('div');
    infoDiv.className = 'bl-canvas-info';

    var infoHeading = document.createElement('div');
    infoHeading.className = 'bl-canvas-info-heading';
    infoHeading.textContent = 'Product Information';
    infoDiv.appendChild(infoHeading);

    if (addlRows.length > 0) {
      addlRows.forEach(function(row) {
        var r = document.createElement('div');
        r.className = 'bl-canvas-info-row';
        r.innerHTML = '<span class="bl-canvas-info-key">' + row.dataset.key + '</span>'
                    + '<span class="bl-canvas-info-val">'  + row.dataset.val  + '</span>';
        infoDiv.appendChild(r);
      });
    } else {
      var empty = document.createElement('p');
      empty.style.cssText = 'font-family:"DM Sans",sans-serif;font-size:1.3rem;opacity:0.4;';
      empty.textContent = 'No additional specifications available.';
      infoDiv.appendChild(empty);
    }

    twoCol.appendChild(textDiv);
    twoCol.appendChild(infoDiv);
    textSection.appendChild(twoCol);
    storyWrap.appendChild(textSection);

    // ── 2. Gallery section (if images exist) ──
    if (allImgs.length > 0) {
      var gallerySection = document.createElement('div');
      gallerySection.className = 'bl-canvas-gallery-section';

      var label = document.createElement('div');
      label.className = 'bl-canvas-gallery-label';
      label.textContent = 'Product Gallery';
      gallerySection.appendChild(label);

      var gallery = document.createElement('div');
      gallery.className = 'bl-canvas-gallery';

      var speeds = [0.12, -0.08, 0.16, -0.1, 0.13, -0.07, 0.09];

      allImgs.forEach(function(img, i) {
        var item = document.createElement('div');
        item.className = 'bl-canvas-gallery-item';
        item.dataset.speed = speeds[i % speeds.length];
        item.dataset.idx   = i;
        item.setAttribute('role', 'button');
        item.setAttribute('aria-label', 'View image ' + (i + 1));
        img.style.width = '100%'; img.style.height = '200px'; img.style.objectFit = 'cover';
        item.appendChild(img);
        gallery.appendChild(item);
      });

      gallerySection.appendChild(gallery);
      storyWrap.appendChild(gallerySection);

      // ── Parallax on gallery items ──
      if (!reduced && !isMobile) {
        var galleryItems = Array.from(gallery.querySelectorAll('.bl-canvas-gallery-item'));
        var rafPara = null;
        window.addEventListener('scroll', function() {
          if (rafPara) return;
          rafPara = requestAnimationFrame(function() {
            rafPara = null;
            galleryItems.forEach(function(item) {
              var rect = item.getBoundingClientRect();
              var offset = (rect.top + rect.height / 2) - window.innerHeight / 2;
              var s = parseFloat(item.dataset.speed || '0.1');
              item.style.transform = 'translateY(' + (offset * s * -1) + 'px)';
            });
          });
        }, { passive: true });
      }

      // ── Lightbox ──
      var lb = document.createElement('div');
      lb.className = 'bl-canvas-lb';
      lb.setAttribute('role', 'dialog');
      lb.setAttribute('aria-modal', 'true');
      lb.innerHTML = [
        '<div class="bl-canvas-lb-img-wrap"><img class="bl-canvas-lb-img" src="" alt="Product image"></div>',
        '<button class="bl-canvas-lb-close" type="button" aria-label="Close">',
        '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
        '</button>',
        allImgs.length > 1 ? [
          '<button class="bl-canvas-lb-prev" type="button" aria-label="Previous image">',
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>',
          '</button>',
          '<button class="bl-canvas-lb-next" type="button" aria-label="Next image">',
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>',
          '</button>',
          '<div class="bl-canvas-lb-count"></div>'
        ].join('') : ''
      ].join('');
      document.body.appendChild(lb);

      var lbImg   = lb.querySelector('.bl-canvas-lb-img');
      var lbCount = lb.querySelector('.bl-canvas-lb-count');
      var curLb   = 0;

      function setLbImg(idx) {
        curLb = (idx + imgSrcs.length) % imgSrcs.length;
        lbImg.style.opacity = '0';
        setTimeout(function() {
          lbImg.src = imgSrcs[curLb].replace(/width=\d+/, 'width=1400');
          lbImg.style.opacity = '1';
        }, 150);
        if (lbCount) lbCount.textContent = (curLb + 1) + ' / ' + imgSrcs.length;
      }
      function openLb(idx) {
        setLbImg(idx); lb.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
      function closeLb() {
        lb.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      Array.from(gallery.querySelectorAll('.bl-canvas-gallery-item')).forEach(function(item) {
        item.addEventListener('click', function() { openLb(parseInt(item.dataset.idx, 10)); });
      });
      lb.querySelector('.bl-canvas-lb-close').addEventListener('click', closeLb);
      lb.addEventListener('click', function(e) { if (e.target === lb) closeLb(); });
      var prevBtn = lb.querySelector('.bl-canvas-lb-prev');
      var nextBtn = lb.querySelector('.bl-canvas-lb-next');
      if (prevBtn) prevBtn.addEventListener('click', function() { setLbImg(curLb - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function() { setLbImg(curLb + 1); });
      document.addEventListener('keydown', function(e) {
        if (!lb.classList.contains('is-open')) return;
        if (e.key === 'Escape')      closeLb();
        if (e.key === 'ArrowLeft')   setLbImg(curLb - 1);
        if (e.key === 'ArrowRight')  setLbImg(curLb + 1);
      });
    }

    // ── Progress bar ──
    if (barFill) {
      window.addEventListener('scroll', function() {
        var rect  = storyWrap.getBoundingClientRect();
        var done  = Math.max(0, -rect.top);
        var total = Math.max(1, storyWrap.offsetHeight - window.innerHeight);
        barFill.style.width = Math.min(100, (done / total) * 100) + '%';
      }, { passive: true });
    }

    window.addEventListener('resize', function() {
      isMobile = window.innerWidth <= 768;
    }, { passive: true });
  })();

  // ── Reveal: below/paginated description sections ──
  {% if enable_anim %}
  var descRevObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        descRevObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });
  sec.querySelectorAll('.bl-pd-desc-paged-wrap.bl-reveal, .bl-pd-desc-below-wrap.bl-reveal').forEach(function (el) {
    descRevObs.observe(el);
  });
  {% endif %}

  // ── Variant option label colorizer + dark/light theme toggle ─────
  // A single system now, keyed off the current theme's own text colour
  // (not a fixed light-mode-only hex), so "Size:" etc. stays legible in
  // both modes. Repaints on variant-picker DOM mutations (Evolve's JS
  // re-applies its own inline styles on selection) and on theme toggles.
  (function () {
    var BL_PD_DARK = {
      bg:      '{{ bg_color }}',
      text:    '{{ text_color }}',
      accent:  '{{ accent_color }}',
      descAccent: '{{ desc_accent }}',
      muted:   '{{ muted_color }}',
      surface: '{{ surface_color }}',
      divider: 'rgba(51,104,112,0.22)'
    };
    var BL_PD_LIGHT = {
      bg:      '{{ bg_light }}',
      text:    '{{ text_light }}',
      accent:  '{{ accent_light }}',
      descAccent: '{{ desc_accent_light }}',
      muted:   '{{ muted_light }}',
      surface: '{{ surface_light }}',
      divider: 'rgba(0,26,46,0.12)'
    };

    var vpWrap = sec.querySelector('.bl-pd-vars');
    var busy = false;

    function currentLabelColor() {
      var isLight = document.documentElement.getAttribute('data-theme') === 'light';
      return isLight ? BL_PD_LIGHT.text : BL_PD_DARK.text;
    }

    function paintLabels(labelColor) {
      if (!vpWrap || busy) return;
      busy = true;
      labelObs.disconnect();

      vpWrap.querySelectorAll('*').forEach(function (el) {
        var tag = el.tagName;
        var cls = typeof el.className === 'string' ? el.className : '';
        if (tag === 'INPUT' || tag === 'BUTTON' || tag === 'SELECT') return;
        if (cls.indexOf('swatch_label') !== -1 || cls.indexOf('swatch_circle') !== -1 ||
            cls.indexOf('swatch_image') !== -1 || cls.indexOf('btn--') !== -1) return;
        if (tag === 'LABEL') {
          var prev = el.previousElementSibling;
          if (prev && prev.tagName === 'INPUT') return;
          var forId = el.getAttribute('for');
          if (forId) { var inp = document.getElementById(forId); if (inp && inp.type === 'radio') return; }
        }
        var directText = '';
        el.childNodes.forEach(function (n) { if (n.nodeType === 3) directText += n.textContent; });
        if (tag === 'LEGEND' || tag === 'LABEL' || /\S[^:]*:/.test(directText.trim().slice(0, 40))) {
          el.style.setProperty('color', labelColor, 'important');
        }
      });

      labelObs.observe(vpWrap, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'class'] });
      busy = false;
    }

    var labelObs = new MutationObserver(function () { paintLabels(currentLabelColor()); });

    function applyPdTheme() {
      var isLight = document.documentElement.getAttribute('data-theme') === 'light';
      var c = isLight ? BL_PD_LIGHT : BL_PD_DARK;
      sec.style.setProperty('--bl-pd-bg',      c.bg);
      sec.style.setProperty('--bl-pd-text',    c.text);
      sec.style.setProperty('--bl-pd-accent',  c.accent);
      sec.style.setProperty('--bl-pd-desc-accent', c.descAccent);
      sec.style.setProperty('--bl-pd-muted',   c.muted);
      sec.style.setProperty('--bl-pd-surface', c.surface);
      sec.style.setProperty('--bl-pd-divider', c.divider);
      sec.style.backgroundColor = c.bg;
      sec.style.color           = c.text;
      paintLabels(c.text);
    }

    applyPdTheme();
    new MutationObserver(applyPdTheme).observe(
      document.documentElement,
      { attributes: true, attributeFilter: ['data-theme'] }
    );
  })();

});
</script>

