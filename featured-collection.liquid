{% style %}
#shopify-section-{{ section.id }} .section_padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  position: relative;
  z-index: 1;
}
@media screen and (max-width: 640px) {
  #shopify-section-{{ section.id }} .section_padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
}
{% endstyle %}

{{ 'featured-collection.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}

<style>
/* ─── BurnLab featured-collection: precise overrides using exact theme class names ─── */

/* 1. Grid: override align-items:end so all cards stretch to equal height */
#shopify-section-{{ section.id }} .feat_section_container.has_collection {
  align-items: stretch !important;
}

/* 2. Ensure the full height chain is unbroken: grid cell → intermediate divs → card wrapper */
#shopify-section-{{ section.id }} .featured_coll_inner,
#shopify-section-{{ section.id }} .featured_coll_inner > * {
  height: 100%;
}
#shopify-section-{{ section.id }} .product_card_wrapper {
  height: 100%;
}

/* 3. Push .product_card_content (price area) to the bottom of each card */
#shopify-section-{{ section.id }} .product_card_content {
  margin-top: auto !important;
}

/* 4. Price: left-align regardless of product_content_align setting */
#shopify-section-{{ section.id }} .product_card_price_inner {
  justify-content: flex-start !important;
}
#shopify-section-{{ section.id }} .product_card_price_wrapper .unit-price {
  justify-content: flex-start !important;
}

/* 5. Slider dots */
/* Override --color-highlight at section scope so the critical.css ::after rule picks up green */
#shopify-section-{{ section.id }} {
  --color-highlight: #07C469;
  --arrows-text: #07C469;
  --swiper-theme-color: #07C469;
  --swiper-pagination-color: #07C469;
}

/* Show pagination on desktop (theme hides it globally, only shows on mobile) */
#shopify-section-{{ section.id }} .featured_col_inner_wrapper .swiper-pagination {
  display: block !important;
  margin: 1.2rem 0 0 !important;
}

/* Inactive dot: the ::after pseudo creates the visual circle — override to muted green */
#shopify-section-{{ section.id }} span.swiper-pagination-bullet::after {
  background: rgba(7, 196, 105, 0.4) !important;
}

/* Active dot: critical.css uses ::after { background: var(--color-highlight) !important }
   Override both the variable AND the ::after directly to guarantee green */
#shopify-section-{{ section.id }} span.swiper-pagination-bullet.swiper-pagination-bullet-active::after {
  background: #07C469 !important;
}

/* Also reset the bullet element itself — no extra scale/border/shadow */
#shopify-section-{{ section.id }} .swiper-pagination-bullet,
#shopify-section-{{ section.id }} .swiper-pagination-bullet-active {
  transform: none !important;
  border: none !important;
  outline: none !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

/* 6a. Desktop title clamp (schema-controlled) */
{% if section.settings.enable_title_clamp_desktop %}
#shopify-section-{{ section.id }} .product_card_image p.p_title {
  display: -webkit-box !important;
  -webkit-line-clamp: {{ section.settings.title_clamp_lines | default: 3 }} !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
}
{% endif %}

/* 6b. Mobile: clamp (schema-controlled) + responsive font sizes */
@media screen and (max-width: 640px) {
  {% if section.settings.enable_title_clamp_mobile %}
  #shopify-section-{{ section.id }} .product_card_image p.p_title {
    display: -webkit-box !important;
    -webkit-line-clamp: {{ section.settings.title_clamp_lines | default: 3 }} !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }
  {% endif %}

  /* Title font: mobile */
  #shopify-section-{{ section.id }} .product_card_image p.p_title {
    font-size: clamp(1.1rem, 3.2vw, 1.3rem) !important;
    line-height: 1.4 !important;
  }

  /* Price: bigger than title */
  #shopify-section-{{ section.id }} .product_card_price_inner span.regular_price,
  #shopify-section-{{ section.id }} .product_card_price_inner span.product_card_price_varies {
    font-size: clamp(1.3rem, 3.8vw, 1.5rem) !important;
    line-height: 1.3 !important;
    font-weight: 600 !important;
  }
  #shopify-section-{{ section.id }} .product_card_price_inner .cap {
    font-size: clamp(1.1rem, 3.2vw, 1.3rem) !important;
  }

  /* Vendor */
  #shopify-section-{{ section.id }} span.product_vendor {
    font-size: clamp(0.9rem, 2.4vw, 1rem) !important;
  }
}
</style>

<div
  class="color_scheme color-{{ section.settings.color_scheme }}{% unless section.settings.enable_slider %} no_slider{% endunless %} section_padding"
  style="
    --columns: {{ section.settings.columns }};
     {% if section.settings.columns_mobile == '1' %}
      --mobile-columns: 1;
    {% else %}
      --mobile-columns: 2;
    {% endif %}
    --border-radius: {{ section.settings.border-radius }}px;
  "
>
  <div class="container">
    <featured-collection>
      <swiper-section
        data-slides-desktop="{{section.settings.columns }}"
        data-slides-tablet="{{section.settings.columns }}"
        data-slides-mobile="{{ section.settings.columns_mobile }}"
        data-gap="{{ settings.horizontal_spacing }}"
        data-speed="800"
      >
        <div class="section_header fc_head {% if section.settings.show_viewall == 'heading_right' %} section_header-flex{% endif %}">
          <div class="fc_head_head fc_head--{{ section.settings.head_align }}">
            {% if section.settings.head != blank %}
              <h2 class="section_heading {{ section.settings.font-size }} {% if section.settings.font_style == 'body' %}body_style{% endif %}">
                {{ section.settings.head }}
              </h2>
            {% endif %}

            {% if section.settings.text != blank %}
              <div class="section_rteText " style="--text-max-width:{{ section.settings.max-width }}%;">
                {{ section.settings.text }}
              </div>
            {% endif %}
          </div>

          {% if section.settings.enable_slider %}
            <div class="fc_arrows">
              <button aria-label="Previous button" class="swiper-button-prev">
                {% render 'icon-left' %}
              </button>
              <button aria-label="Next button" class="swiper-button-next">
                {% render 'icon-right' %}
              </button>
            </div>
          {% else %}
            {% if section.settings.show_btn %}
              {% assign collection = section.settings.collection %}
              {% if section.settings.show_viewall == 'heading_right' %}
                <div
                  class="button__wrapper{% if section.settings.wide_button %} button__wide{% endif %}"
                >
                  {% render 'section-button',
                    button_label: 'View All Products',
                    btn_link: collection.url,
                    new_tab: false,
                    style: section.settings.style
                  %}
                </div>
              {% endif %}
            {% endif %}
          {% endif %}
        </div>

        <div class="featured_collection_inner {% if section.settings.collection == blank %} empty_collection{% endif %} card_block_{{ section.settings.back_block }}">
          {% assign collection = section.settings.collection %}
          {% if collection != blank %}
            <div class="featured_col_inner_wrapper">
              <div class="feat_section_container{% unless section.settings.enable_slider %} has_collection{% endunless %}">
                {% if section.settings.enable_slider %}
                  <div class="swiper"><div class="swiper-wrapper main-swiper-wrapper">
                {% endif %}
                {% for product in collection.products limit: section.settings.limit %}
                  <div class="featured_coll_inner{% if section.settings.enable_slider %} swiper-slide{% endif %} {% if section.settings.collection != blank %}has_collection{% endif %}">
                    {% render 'product-card',
                      product: product,
                      index: forloop.index,
                      card_bg: section.settings.bg,
                      card_bg_color: section.settings.bg_color,
                      aspect_ratio: section.settings.aspect_ratio,
                      show_badges: settings.show_badges,
                      show_vendor: section.settings.show_vendor,
                      show_options: section.settings.show_options,
                      swatch_shape: settings.swatch_shape,
                      quick_view: section.settings.show_quick_view,
                      quick_view_position: section.settings.quick_view_position,
                      columns: section.settings.columns,
                      spacing: settings.horizontal_spacing,
                      img_size: section.settings.img_size,
                      show_secondary: section.settings.show_secondary,
                      product_title_position: section.settings.product_title_position,
                      title_upcase: section.settings.title_upcase,
                      show_description: section.settings.show_description,
                      back_block: section.settings.back_block,
                      card_color: product.metafields.custom.product_card_color.value,
                      product_content_align: section.settings.product_content_align
                    %}
                  </div>
                {% endfor %}
                {% if section.settings.enable_slider %}
                  </div>
                  <div class="swiper-pagination"></div>
                  </div>
                {% endif %}
              </div>
              <div class="section_buttons_wrapper" style="--swiper-navigation-size: 22px">
                {% if collection != blank and section.settings.show_btn %}
                  {% if section.settings.show_viewall == 'below_product' %}
                    <div
                      class="button__wrapper{% if section.settings.wide_button %} button__wide{% endif %}"
                    >
                      {% if settings.enable_magnet %}<magnetic-button data-radius="200">{% endif %}
                      {% render 'section-button',
                        button_label: 'View All Products',
                        btn_link: collection.url,
                        new_tab: false,
                        style: section.settings.style
                      %}
                      {% if settings.enable_magnet %}</magnetic-button>{% endif %}
                    </div>
                  {% endif %}
                {% endif %}
              </div>
            </div>
          {% else %}
            {% for i in (1..5) %}
              <div class="featured_coll_inner_empt">
                <div class="featured_coll_inner_empt_svg ratio">
                  {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="featured_coll_inner_empt_info">
                  <p class="small-text">{{ 'onboarding.product_title' | t }}</p>
                  <div class="empty_price">
                    <p>{{ 'onboarding.product_price' | t | money }}</p>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </swiper-section>
    </featured-collection>
  </div>
</div>

<script>
(function () {
  var SECTION_ID = 'shopify-section-{{ section.id }}';

  /* ── Replace INR. with ₹ ── */
  function replaceINR() {
    var section = document.getElementById(SECTION_ID);
    if (!section) return;
    section.querySelectorAll('.product_card_price_inner span, .product_card_price_inner .money').forEach(function (el) {
      el.childNodes.forEach(function (node) {
        if (node.nodeType === 3) {
          node.textContent = node.textContent.replace(/INR\.\s*/g, '₹');
        }
      });
    });
  }

  /* ── Autoplay: step-by-step, driven by schema settings ── */
  {% if section.settings.enable_autoplay %}
  var AUTOPLAY_DELAY = {{ section.settings.autoplay_delay | default: 2000 }};

  function startAutoplay() {
    var section = document.getElementById(SECTION_ID);
    if (!section) return;

    var swiperEl = section.querySelector('.swiper');
    if (!swiperEl) return;

    /* Swiper attaches its instance to the DOM element as .swiper */
    if (swiperEl.swiper) {
      initAutoplay(swiperEl.swiper);
    } else {
      /* Swiper not yet initialised — poll until ready */
      var attempts = 0;
      var poll = setInterval(function () {
        attempts++;
        if (swiperEl.swiper) {
          clearInterval(poll);
          initAutoplay(swiperEl.swiper);
        }
        if (attempts > 50) clearInterval(poll); /* give up after 5 s */
      }, 100);
    }
  }

  function initAutoplay(swiper) {
    if (!swiper || !swiper.params) return;
    swiper.params.autoplay = {
      delay: AUTOPLAY_DELAY,
      disableOnInteraction: false,
      pauseOnMouseEnter: true
    };
    /* Swiper 8/9: autoplay is a module — start if available */
    if (swiper.autoplay && typeof swiper.autoplay.start === 'function') {
      swiper.autoplay.start();
    } else {
      /* Fallback: manually advance via setInterval */
      setInterval(function () {
        if (!document.hidden) swiper.slideNext();
      }, AUTOPLAY_DELAY);
    }
  }
  {% endif %}

  /* ── Boot ── */
  function init() {
    replaceINR();
    {% if section.settings.enable_autoplay %}startAutoplay();{% endif %}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

